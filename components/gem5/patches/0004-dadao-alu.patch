+// === field extractors ===
 static inline uint8_t ha(uint32_t w) { return (w >> 18) & 0x3F; }
 static inline uint8_t hb(uint32_t w) { return (w >> 12) & 0x3F; }
 static inline uint8_t hc(uint32_t w) { return (w >> 6)  & 0x3F; }
 static inline uint8_t hd(uint32_t w) { return w & 0x3F; }
-static inline int64_t imm12s(uint32_t w) {
-    int64_t v = w & 0xFFF;
-    return (v & 0x800) ? (v | 0xFFFFFFFFFFFFF000ULL) : v;
-}
-static inline int64_t imm24s(uint32_t w) {
-    int64_t v = w & 0xFFFFFF;
-    return (v & 0x800000) ? (v | 0xFFFFFFFFFF000000ULL) : v;
+static inline int64_t imm12s(uint32_t w) { int64_t v = w & 0xFFF; return (v & 0x800) ? (v | 0xFFFFFFFFFFFFF000ULL) : v; }
+static inline int64_t imm18s(uint32_t w) { int64_t v = w & 0x3FFFF; return (v & 0x20000) ? (v | 0xFFFFFFFFFFFC0000ULL) : v; }
+static inline int64_t imm24s(uint32_t w) { int64_t v = w & 0xFFFFFF; return (v & 0x800000) ? (v | 0xFFFFFFFFFF000000ULL) : v; }
+static inline uint16_t imm16u(uint32_t w) { return ((w & 0xF000) >> 12) << 12 | (hc(w) << 6) | hd(w); }
+static inline int ww(uint32_t w) { return (hb(w) >> 4) & 3; }
+
+// Macro to reduce boilerplate for simple 2R-1R instructions
+#define DECL_RR2R(NAME, MNEM, FN) \
+class NAME : public StaticInst { RegId srcRegs[2], dstRegs[1]; \
+public: NAME(uint8_t d, uint8_t s1, uint8_t s2) : StaticInst(MNEM, enums::No_OpClass) { \
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); \
+  srcRegs[_numSrcRegs++]=intRegId(s1); srcRegs[_numSrcRegs++]=intRegId(s2); if(d) dstRegs[_numDestRegs++]=intRegId(d); } \
+  Fault execute(ExecContext *xc, trace::InstRecord*) const override { uint64_t a=xc->getRegOperand(this,0), b=xc->getRegOperand(this,1); if(_numDestRegs)xc->setRegOperand(this,0,FN); return NoFault; } \
+  std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return MNEM;} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// Macro for 2R-1R with imm
+#define DECL_RI2R(NAME, MNEM, FN) \
+class NAME : public StaticInst { RegId srcRegs[1], dstRegs[1]; int64_t imm_; public: NAME(uint8_t d, uint8_t s, int64_t i) : StaticInst(MNEM, enums::No_OpClass), imm_(i) { \
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); \
+  if(s) srcRegs[_numSrcRegs++]=intRegId(s); if(d) dstRegs[_numDestRegs++]=intRegId(d); } \
+  Fault execute(ExecContext *xc, trace::InstRecord*) const override { uint64_t a=(_numSrcRegs>0)?xc->getRegOperand(this,0):0; if(_numDestRegs)xc->setRegOperand(this,0,FN); return NoFault; } \
+  std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return MNEM;} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// === G1 instructions (halt, addi, add, jump) — unchanged ===
+class HaltInst : public StaticInst { RegId srcRegs[1], dstRegs[0]; public:
+HaltInst(uint8_t rd) : StaticInst("halt", enums::No_OpClass) { setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); if(rd){setSrcRegIdx(_numSrcRegs++,intRegId(rd));} }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { RegVal c=(_numSrcRegs>0)?xc->getRegOperand(this,0):0; dumpFinalState(xc); exitSimLoop("halt",c&0xFF); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"halt";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+DECL_RI2R(AddiInst,"addi", a+imm_)
+DECL_RR2R(AddInst,"add", a+b)
+
+class JumpIIIIInst : public StaticInst { RegId srcRegs[0], dstRegs[0]; int64_t imm_; public:
+JumpIIIIInst(int64_t i) : StaticInst("jump", enums::No_OpClass), imm_(i) { setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { PCState pc=xc->pcState().as<PCState>(); pc.set(pc.instAddr()+4+(imm_<<2)); xc->pcState(pc); return NoFault; } // spec §5.3/§1.3: rb0=PC+4
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return csprintf("jump %d",(int)imm_);} void advancePC(PCStateBase&)const override{}};
+
+class UnknownInst : public StaticInst { RegId srcRegs[0], dstRegs[0]; public:
+UnknownInst() : StaticInst("unknown", enums::No_OpClass) { setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); }
+Fault execute(ExecContext*, trace::InstRecord*) const override { return std::make_shared<DADAOSyscallFault>(); }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"unknown";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// === ALU batch: sub, logic, muls/mulu, divs/divu ===
+// add/sub/muls/mulu are 128-bit dual-dest (ha=hi, hb=lo) — spec §3.5/3.7
+class AddDualInst : public StaticInst { RegId srcRegs[2], dstRegs[2]; public:
+AddDualInst(uint8_t hi, uint8_t lo, uint8_t s1, uint8_t s2) : StaticInst("add", enums::No_OpClass) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++]=intRegId(s1); srcRegs[_numSrcRegs++]=intRegId(s2);
+  if(lo)dstRegs[_numDestRegs++]=intRegId(lo); if(hi)dstRegs[_numDestRegs++]=intRegId(hi); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { __int128 r=(__int128)(int64_t)xc->getRegOperand(this,0)+(__int128)(int64_t)xc->getRegOperand(this,1); if(_numDestRegs>=1)xc->setRegOperand(this,0,(uint64_t)r); if(_numDestRegs>=2)xc->setRegOperand(this,1,(uint64_t)(r>>64)); return NoFault; } // spec §3.5: rdha:rdhb=sext128(rdhc)+sext128(rdhd)
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"add";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+class SubDualInst : public StaticInst { RegId srcRegs[2], dstRegs[2]; public:
+SubDualInst(uint8_t hi, uint8_t lo, uint8_t s1, uint8_t s2) : StaticInst("sub", enums::No_OpClass) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++]=intRegId(s1); srcRegs[_numSrcRegs++]=intRegId(s2);
+  if(lo)dstRegs[_numDestRegs++]=intRegId(lo); if(hi)dstRegs[_numDestRegs++]=intRegId(hi); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { __int128 r=(__int128)(int64_t)xc->getRegOperand(this,0)-(__int128)(int64_t)xc->getRegOperand(this,1); if(_numDestRegs>=1)xc->setRegOperand(this,0,(uint64_t)r); if(_numDestRegs>=2)xc->setRegOperand(this,1,(uint64_t)(r>>64)); return NoFault; } // spec §3.5: rdha:rdhb=sext128(rdhc)-sext128(rdhd)
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"sub";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+class MulsDualInst : public StaticInst { RegId srcRegs[2], dstRegs[2]; public:
+MulsDualInst(uint8_t hi, uint8_t lo, uint8_t s1, uint8_t s2) : StaticInst("muls", enums::No_OpClass) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++]=intRegId(s1); srcRegs[_numSrcRegs++]=intRegId(s2);
+  if(lo)dstRegs[_numDestRegs++]=intRegId(lo); if(hi)dstRegs[_numDestRegs++]=intRegId(hi); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { __int128 a=(int64_t)xc->getRegOperand(this,0), b=(int64_t)xc->getRegOperand(this,1); __int128 p=a*b; if(_numDestRegs>=1)xc->setRegOperand(this,0,(uint64_t)p); if(_numDestRegs>=2)xc->setRegOperand(this,1,(uint64_t)(p>>64)); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"muls";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+class MuluDualInst : public StaticInst { RegId srcRegs[2], dstRegs[2]; public:
+MuluDualInst(uint8_t hi, uint8_t lo, uint8_t s1, uint8_t s2) : StaticInst("mulu", enums::No_OpClass) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++]=intRegId(s1); srcRegs[_numSrcRegs++]=intRegId(s2);
+  if(lo)dstRegs[_numDestRegs++]=intRegId(lo); if(hi)dstRegs[_numDestRegs++]=intRegId(hi); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { unsigned __int128 a= xc->getRegOperand(this,0), b=xc->getRegOperand(this,1); unsigned __int128 p=a*b; if(_numDestRegs>=1)xc->setRegOperand(this,0,(uint64_t)p); if(_numDestRegs>=2)xc->setRegOperand(this,1,(uint64_t)(p>>64)); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"mulu";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+DECL_RR2R(AndInst,"and", a&b)
+DECL_RR2R(OrrInst,"orr", a|b)
+DECL_RR2R(XorInst,"xor", a^b)
+DECL_RR2R(XnorInst,"xnor", ~(a^b))
+
+// divs: signed division with truncation toward zero (spec 3.7)
+class DivsInst : public StaticInst { RegId srcRegs[2], dstRegs[2]; public:
+DivsInst(uint8_t rem, uint8_t quo, uint8_t num, uint8_t den) : StaticInst("divs", enums::No_OpClass) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++]=intRegId(num); srcRegs[_numSrcRegs++]=intRegId(den);
+  if(rem)dstRegs[_numDestRegs++]=intRegId(rem); if(quo)dstRegs[_numDestRegs++]=intRegId(quo); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { int64_t a=xc->getRegOperand(this,0), b=xc->getRegOperand(this,1); if(b==0)return std::make_shared<DADAOSyscallFault>(); if(a==INT64_MIN&&b==-1)return std::make_shared<DADAOSyscallFault>(); int64_t q=a/b, r=a%b; if(_numDestRegs>=1)xc->setRegOperand(this,0,r); if(_numDestRegs>=2)xc->setRegOperand(this,1,q); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"divs";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+class DivuInst : public StaticInst { RegId srcRegs[2], dstRegs[2]; public:
+DivuInst(uint8_t rem, uint8_t quo, uint8_t num, uint8_t den) : StaticInst("divu", enums::No_OpClass) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++]=intRegId(num); srcRegs[_numSrcRegs++]=intRegId(den);
+  if(rem)dstRegs[_numDestRegs++]=intRegId(rem); if(quo)dstRegs[_numDestRegs++]=intRegId(quo); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { uint64_t a=xc->getRegOperand(this,0),b=xc->getRegOperand(this,1); if(b==0)return std::make_shared<DADAOSyscallFault>(); if(_numDestRegs>=1)xc->setRegOperand(this,0,a%b); if(_numDestRegs>=2)xc->setRegOperand(this,1,a/b); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"divu";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// === Shift/extend (orrr: hb=dst, hc=src1, hd=src2) ===
+DECL_RR2R(ShluInst,"shlu", a<<(b&63))
+DECL_RR2R(ShrsInst,"shrs", (int64_t)a>>(b&63))
+DECL_RR2R(ShruInst,"shru", a>>(b&63))
+
+// exts/extz: spec §3.11 — (x<<amt) >>{s,u} amt, amt=hd[5:0] (amt=0 => identity)
+DECL_RR2R(ExtsInst,"exts", ({int s=b&63; ((int64_t)a<<s)>>s;}))
+DECL_RR2R(ExtzInst,"extz", ({int s=b&63; (a<<s)>>s;}))
+
+// Shift/extend immediate (orri: hb=dst, hc=src, hd=imm6)
+DECL_RI2R(ShluIInst,"shlu", a<<(imm_&63))
+DECL_RI2R(ShrsIInst,"shrs", (int64_t)a>>(imm_&63))
+DECL_RI2R(ShruIInst,"shru", a>>(imm_&63))
+DECL_RI2R(ExtsIInst,"exts", ({int s=imm_&63; ((int64_t)a<<s)>>s;}))
+DECL_RI2R(ExtzIInst,"extz", ({int s=imm_&63; (a<<s)>>s;}))
+
+// === Compare ===
+DECL_RR2R(CmpsInst,"cmps", ((int64_t)a<(int64_t)b)?-1ULL:((int64_t)a>(int64_t)b)?1ULL:0)
+DECL_RR2R(CmpuInst,"cmpu", (a<b)?-1ULL:(a>b)?1ULL:0)
+// cmps/cmpu imm (rrii): d=ha, s=hb, imm=imm12
+DECL_RI2R(CmpsIInst,"cmps", ({int64_t x=(int64_t)a, y=imm_; (x<y)?-1ULL:(x>y)?1ULL:0;}))
+DECL_RI2R(CmpuIInst,"cmpu", ({uint64_t x=a, y=imm_; (x<y)?-1ULL:(x>y)?1ULL:0;}))
+
+// Helper: read rd[reg] honoring rd0==0 (idx<0 means reg was rd0 -> value 0).
+static inline uint64_t rdOp(ExecContext *xc, const StaticInst *si, int idx) {
+    return idx < 0 ? 0 : xc->getRegOperand(si, idx);
 }
 
-// === halt (op=0x00, riii): exitSimLoop with rd[ha], spec 3.1 ===
-class HaltInst : public StaticInst {
-    RegId srcRegIdxArr[1];
-    RegId destRegIdxArr[0];
-public:
-    HaltInst(uint8_t rd) : StaticInst("halt", enums::No_OpClass) {
-        setRegIdxArrays(
-            reinterpret_cast<RegIdArrayPtr>(
-                &std::remove_pointer_t<decltype(this)>::srcRegIdxArr),
-            reinterpret_cast<RegIdArrayPtr>(
-                &std::remove_pointer_t<decltype(this)>::destRegIdxArr));
-        if (rd != 0) {
-            setSrcRegIdx(_numSrcRegs++, intRegId(rd));
-        }
-    }
-    Fault execute(ExecContext *xc, trace::InstRecord *t) const override {
-        RegVal code = (_numSrcRegs > 0) ? xc->getRegOperand(this, 0) : 0;
-        dumpFinalState(xc);
-        exitSimLoop("halt", code & 0xFF);
-        return NoFault;
-    }
-    std::string generateDisassembly(Addr pc, const loader::SymbolTable *s) const override {
