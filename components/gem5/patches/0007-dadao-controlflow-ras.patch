+// only for internal distinctness — kept out of FAULT_CODES.
+class RasofFault : public DADAOFault
+{
+  public:
+    RasofFault() : DADAOFault("RASOF", 0x84) {}
+};
+
+class RasufFault : public DADAOFault
+{
