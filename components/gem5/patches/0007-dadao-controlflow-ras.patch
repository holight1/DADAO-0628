+// Register-bank block copy rd2rd/rd2rb/rb2rd/rb2rb (orri, spec §3.14/§4.7).
+// hb=dest first reg, hc=src first reg, hd=immu6. Copy immu6 consecutive regs.
+// Asymmetry (memory feedback): reading an RB *source* yields low 48 bits (RB is
+// a 48-bit effective register); reading an RD source yields full 64; the copied
+// value is written full-width to the destination. So rd2rb stores 64 bits while
+// rb2rd/rb2rb read 48 (dest high 16 = 0). Legality (spec §2.6.3/§3.14/§4.7):
+// immu6=0 / dest reg0 / dest+immu6>64 / src+immu6>64 → ILLI.
+class BlockCopyInst : public StaticInst { RegId srcRegs[63], dstRegs[63]; int count; bool srcRb; bool illegal; public:
+BlockCopyInst(uint8_t hb, uint8_t hc, uint8_t immu6, bool destRb, bool sRb)
+  : StaticInst("blockcopy", enums::No_OpClass), count(immu6), srcRb(sRb),
+    illegal(hb==0 || immu6==0 || hb+immu6>64 || hc+immu6>64) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  RegIndex sBase = sRb ? RB_BASE : RD_BASE, dBase = destRb ? RB_BASE : RD_BASE;
+  for (int i = 0; i < count && i < 63; i++) srcRegs[_numSrcRegs++] = intRegId(sBase + hc + i);
+  for (int i = 0; i < count && i < 63; i++) dstRegs[_numDestRegs++] = intRegId(dBase + hb + i); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override {
+  if (illegal) RET_ILLI;
+  for (int i = 0; i < _numDestRegs; i++) {           // increasing i, read-then-write (§3.14)
+    uint64_t v = xc->getRegOperand(this, i);
+    if (srcRb) v &= MASK48;                           // RB source: 48-bit (§4.7 asymmetry)
+    xc->setRegOperand(this, i, v); }
+  return NoFault; }
 std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"blockcopy";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
 
+// ─── Control flow (spec §5): conditional branches, jump_r, call, ret + RegRAS ──
+// RegRAS push/pop (spec §5.6), accessing ra0..ra63 directly via ThreadContext.
+static inline uint64_t rasR(ThreadContext *tc, int i) { return (uint64_t)tc->getReg(intRegId(RA_BASE + i)); }
+static inline void rasW(ThreadContext *tc, int i, uint64_t v) { tc->setReg(intRegId(RA_BASE + i), (RegVal)v); }
+
+static Fault
+rasPush(ThreadContext *tc, uint64_t new_addr)
+{
+  new_addr &= MASK48;
+  uint64_t top = rasR(tc, 63), cnt = (top >> 48) & 0xFFFF, addr48 = top & MASK48;
+  if (cnt == 0) { rasW(tc, 63, (1ULL << 48) | new_addr); return NoFault; }
+  if (cnt >= 1 && cnt <= 0xFFFE && addr48 == new_addr) {  // recursion collapse
+    rasW(tc, 63, ((cnt + 1) << 48) | addr48); return NoFault; }
+  if (((rasR(tc, 1) >> 48) & 0xFFFF) != 0) return std::make_shared<RasofFault>();
+  for (int i = 2; i < 64; i++) rasW(tc, i - 1, rasR(tc, i));  // shift down
+  rasW(tc, 63, (1ULL << 48) | new_addr); return NoFault;
+}
+
+static Fault
+rasPop(ThreadContext *tc, uint64_t &ret_addr)
+{
+  uint64_t top = rasR(tc, 63), cnt = (top >> 48) & 0xFFFF, addr48 = top & MASK48;
+  if (cnt > 1) { rasW(tc, 63, ((cnt - 1) << 48) | addr48); ret_addr = addr48; return NoFault; }
+  if (cnt == 1) {
+    ret_addr = addr48;
+    for (int i = 62; i >= 1; i--) rasW(tc, i + 1, rasR(tc, i));  // shift up
+    rasW(tc, 1, 0); return NoFault; }
+  return std::make_shared<RasufFault>();
+}
+
+// Single-register conditional branch (riii, spec §5.1). ha=rdha (condition; rd0
+// reads 0), imms18. Taken: PC ← (PC+4 + sext18<<2) mod 2^48; else fall through.
+#define DECL_BR1(NAME, MNEM, COND) \
+class NAME : public StaticInst { RegId srcRegs[1], dstRegs[0]; int64_t imm_; int iC; public: \
+NAME(uint8_t ha, int64_t imm) : StaticInst(MNEM, enums::No_OpClass), imm_(imm), iC(-1) { \
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); \
+  if (ha) { srcRegs[_numSrcRegs] = intRegId(ha); iC = _numSrcRegs++; } } \
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { \
+  int64_t c = (iC < 0) ? 0 : (int64_t)xc->getRegOperand(this, iC); \
+  PCState pc = xc->pcState().as<PCState>(); uint64_t nextSeq = (pc.instAddr() + 4) & MASK48; \
+  pc.set((COND) ? ((nextSeq + (uint64_t)(imm_ << 2)) & MASK48) : nextSeq); xc->pcState(pc); return NoFault; } \
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return MNEM;} void advancePC(PCStateBase&)const override{}};
+
+DECL_BR1(BrnInst,  "brn",  c < 0)     // negative      §Appendix B
+DECL_BR1(BrnnInst, "brnn", c >= 0)    // non-negative
+DECL_BR1(BrzInst,  "brz",  c == 0)    // zero
+DECL_BR1(BrnzInst, "brnz", c != 0)    // non-zero
+DECL_BR1(BrpInst,  "brp",  c > 0)     // positive
+DECL_BR1(BrnpInst, "brnp", c <= 0)    // non-positive
+
+// Dual-register conditional branch (rrii, spec §5.2). ha=rdha, hb=rdhb (rd0→0),
+// imms12. Taken: PC ← (PC+4 + sext12<<2) mod 2^48.
+#define DECL_BR2(NAME, MNEM, COND) \
+class NAME : public StaticInst { RegId srcRegs[2], dstRegs[0]; int64_t imm_; int iA, iB; public: \
+NAME(uint8_t ha, uint8_t hb, int64_t imm) : StaticInst(MNEM, enums::No_OpClass), imm_(imm), iA(-1), iB(-1) { \
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); \
+  if (ha) { srcRegs[_numSrcRegs] = intRegId(ha); iA = _numSrcRegs++; } \
+  if (hb) { srcRegs[_numSrcRegs] = intRegId(hb); iB = _numSrcRegs++; } } \
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { \
+  uint64_t a = (iA < 0) ? 0 : xc->getRegOperand(this, iA), b = (iB < 0) ? 0 : xc->getRegOperand(this, iB); \
+  PCState pc = xc->pcState().as<PCState>(); uint64_t nextSeq = (pc.instAddr() + 4) & MASK48; \
+  pc.set((COND) ? ((nextSeq + (uint64_t)(imm_ << 2)) & MASK48) : nextSeq); xc->pcState(pc); return NoFault; } \
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return MNEM;} void advancePC(PCStateBase&)const override{}};
+
+DECL_BR2(BreqInst, "breq", a == b)
+DECL_BR2(BrneInst, "brne", a != b)
+
+// Register-indirect jump (rrii, spec §5.3). ha=rbha (base; rbha=rb0 ⇒ relative,
+// base=PC+4), hb=rdhb (offset), imms12. Target = (base+rdhb+sext12<<2) mod 2^48.
+class JumpRInst : public StaticInst { RegId srcRegs[2], dstRegs[0]; int64_t imm_; bool baseRb; int iBase, iOff; public:
+JumpRInst(uint8_t ha, uint8_t hb, int64_t imm) : StaticInst("jump", enums::No_OpClass), imm_(imm), baseRb(ha!=0), iBase(-1), iOff(-1) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  if (ha) { srcRegs[_numSrcRegs] = intRegId(RB_BASE + ha); iBase = _numSrcRegs++; }
+  if (hb) { srcRegs[_numSrcRegs] = intRegId(RD_BASE + hb); iOff = _numSrcRegs++; } }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override {
+  PCState pc = xc->pcState().as<PCState>(); uint64_t nextSeq = (pc.instAddr() + 4) & MASK48;
+  uint64_t base = baseRb ? (xc->getRegOperand(this, iBase) & MASK48) : nextSeq;  // rbha=rb0 ⇒ relative §5.3
+  uint64_t off = (iOff < 0) ? 0 : xc->getRegOperand(this, iOff);
+  pc.set((base + off + (uint64_t)(imm_ << 2)) & MASK48); xc->pcState(pc); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"jump";} void advancePC(PCStateBase&)const override{}};
+
+// call relative (iiii, spec §5.4): target=(PC+4+sext24<<2); push rb0(=PC+4).
+class CallIInst : public StaticInst { RegId srcRegs[0], dstRegs[0]; int64_t imm_; public:
+CallIInst(int64_t imm) : StaticInst("call", enums::No_OpClass), imm_(imm) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override {
+  PCState pc = xc->pcState().as<PCState>(); uint64_t nextSeq = (pc.instAddr() + 4) & MASK48;
+  Fault f = rasPush(xc->tcBase(), nextSeq); if (f != NoFault) return f;  // RASOF precise: PC unchanged
+  pc.set((nextSeq + (uint64_t)(imm_ << 2)) & MASK48); xc->pcState(pc); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"call";} void advancePC(PCStateBase&)const override{}};
+
+// call absolute (rrii, spec §5.4): target=(base+rdhb+sext12<<2), base=rbha
+// (rbha=rb0 ⇒ relative). push rb0(=PC+4).
+class CallRInst : public StaticInst { RegId srcRegs[2], dstRegs[0]; int64_t imm_; bool baseRb; int iBase, iOff; public:
+CallRInst(uint8_t ha, uint8_t hb, int64_t imm) : StaticInst("call", enums::No_OpClass), imm_(imm), baseRb(ha!=0), iBase(-1), iOff(-1) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  if (ha) { srcRegs[_numSrcRegs] = intRegId(RB_BASE + ha); iBase = _numSrcRegs++; }
+  if (hb) { srcRegs[_numSrcRegs] = intRegId(RD_BASE + hb); iOff = _numSrcRegs++; } }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override {
+  PCState pc = xc->pcState().as<PCState>(); uint64_t nextSeq = (pc.instAddr() + 4) & MASK48;
+  Fault f = rasPush(xc->tcBase(), nextSeq); if (f != NoFault) return f;
+  uint64_t base = baseRb ? (xc->getRegOperand(this, iBase) & MASK48) : nextSeq;
+  uint64_t off = (iOff < 0) ? 0 : xc->getRegOperand(this, iOff);
+  pc.set((base + off + (uint64_t)(imm_ << 2)) & MASK48); xc->pcState(pc); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"call";} void advancePC(PCStateBase&)const override{}};
+
+// ret (riii, spec §5.5): pop RegRAS → PC; rdha = sext18(imms18) (rd0 discards).
+class RetInst : public StaticInst { RegId srcRegs[0], dstRegs[1]; int64_t imm_; bool haveDst; public:
+RetInst(uint8_t ha, int64_t imm) : StaticInst("ret", enums::No_OpClass), imm_(imm), haveDst(ha!=0) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  if (ha) dstRegs[_numDestRegs++] = intRegId(ha); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override {
+  uint64_t ret_addr; Fault f = rasPop(xc->tcBase(), ret_addr); if (f != NoFault) return f;  // RASUF precise
+  PCState pc = xc->pcState().as<PCState>(); pc.set(ret_addr & MASK48); xc->pcState(pc);
+  if (_numDestRegs) xc->setRegOperand(this, 0, (uint64_t)imm_);  // return value = sext18(imms18)
+  return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"ret";} void advancePC(PCStateBase&)const override{}};
+
