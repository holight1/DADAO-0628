 // divs: signed division with truncation toward zero (spec 3.7)
-class DivsInst : public StaticInst { RegId srcRegs[2], dstRegs[2]; public:
-DivsInst(uint8_t rem, uint8_t quo, uint8_t num, uint8_t den) : StaticInst("divs", enums::No_OpClass) {
+class DivsInst : public StaticInst { RegId srcRegs[2], dstRegs[2]; bool badDst; public:
+DivsInst(uint8_t rem, uint8_t quo, uint8_t num, uint8_t den) : StaticInst("divs", enums::No_OpClass), badDst(dualBadDst(rem,quo)) {
   setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
