+// DG-004c fault shortcuts (spec §2.6 ILLI, §3.1 MALIGN). Defined before the
+// first DECL_RR2R/DECL_RI2R expansion so those macros can use them.
+#define RET_ILLI   return std::make_shared<IlliFault>()
+#define RET_MALIGN return std::make_shared<MalignFault>()
+
 // === field extractors ===
 static inline uint8_t ha(uint32_t w) { return (w >> 18) & 0x3F; }
 static inline uint8_t hb(uint32_t w) { return (w >> 12) & 0x3F; }
@@ -74,21 +79,24 @@ static inline int64_t imm24s(uint32_t w) { int64_t v = w & 0xFFFFFF; return (v &
 static inline uint16_t imm16u(uint32_t w) { return ((w & 0xF000) >> 12) << 12 | (hc(w) << 6) | hd(w); }
 static inline int ww(uint32_t w) { return (hb(w) >> 4) & 3; }
 
-// Macro to reduce boilerplate for simple 2R-1R instructions
+// Macro to reduce boilerplate for simple 2R-1R instructions.
+// Destination field (d) is rdhb (and/orr/xor/…/shift/exts/cmp-reg): d==rd0 →
+// ILLI (spec §2.6.1 rdhb-destination rules).
 #define DECL_RR2R(NAME, MNEM, FN) \
-class NAME : public StaticInst { RegId srcRegs[2], dstRegs[1]; \
-public: NAME(uint8_t d, uint8_t s1, uint8_t s2) : StaticInst(MNEM, enums::No_OpClass) { \
+class NAME : public StaticInst { RegId srcRegs[2], dstRegs[1]; bool destZero; \
+public: NAME(uint8_t d, uint8_t s1, uint8_t s2) : StaticInst(MNEM, enums::No_OpClass), destZero(d==0) { \
   setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); \
   srcRegs[_numSrcRegs++]=intRegId(s1); srcRegs[_numSrcRegs++]=intRegId(s2); if(d) dstRegs[_numDestRegs++]=intRegId(d); } \
-  Fault execute(ExecContext *xc, trace::InstRecord*) const override { uint64_t a=xc->getRegOperand(this,0), b=xc->getRegOperand(this,1); if(_numDestRegs)xc->setRegOperand(this,0,FN); return NoFault; } \
+  Fault execute(ExecContext *xc, trace::InstRecord*) const override { if(destZero) RET_ILLI; uint64_t a=xc->getRegOperand(this,0), b=xc->getRegOperand(this,1); if(_numDestRegs)xc->setRegOperand(this,0,FN); return NoFault; } \
   std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return MNEM;} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
 
-// Macro for 2R-1R with imm
+// Macro for 2R-1R with imm. Destination field (d) is rdha (addi/cmps-i/cmpu-i)
+// or rdhb (shift-i/exts-i): d==rd0 → ILLI (spec §2.6.1).
 #define DECL_RI2R(NAME, MNEM, FN) \
-class NAME : public StaticInst { RegId srcRegs[1], dstRegs[1]; int64_t imm_; public: NAME(uint8_t d, uint8_t s, int64_t i) : StaticInst(MNEM, enums::No_OpClass), imm_(i) { \
+class NAME : public StaticInst { RegId srcRegs[1], dstRegs[1]; int64_t imm_; bool destZero; public: NAME(uint8_t d, uint8_t s, int64_t i) : StaticInst(MNEM, enums::No_OpClass), imm_(i), destZero(d==0) { \
   setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); \
   if(s) srcRegs[_numSrcRegs++]=intRegId(s); if(d) dstRegs[_numDestRegs++]=intRegId(d); } \
-  Fault execute(ExecContext *xc, trace::InstRecord*) const override { uint64_t a=(_numSrcRegs>0)?xc->getRegOperand(this,0):0; if(_numDestRegs)xc->setRegOperand(this,0,FN); return NoFault; } \
+  Fault execute(ExecContext *xc, trace::InstRecord*) const override { if(destZero) RET_ILLI; uint64_t a=(_numSrcRegs>0)?xc->getRegOperand(this,0):0; if(_numDestRegs)xc->setRegOperand(this,0,FN); return NoFault; } \
   std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return MNEM;} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
 
 // === G1 instructions (halt, addi, add, jump) — unchanged ===
@@ -105,43 +113,78 @@ JumpIIIIInst(int64_t i) : StaticInst("jump", enums::No_OpClass), imm_(i) { setRe
 Fault execute(ExecContext *xc, trace::InstRecord*) const override { PCState pc=xc->pcState().as<PCState>(); pc.set(pc.instAddr()+4+(imm_<<2)); xc->pcState(pc); return NoFault; } // spec §5.3/§1.3: rb0=PC+4
 std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return csprintf("jump %d",(int)imm_);} void advancePC(PCStateBase&)const override{}};
 
+// Reserved/unallocated encoding → UNDI (spec §2.5/§2.8.1). NOT ILLI: reserved
+// encoding is UNDI; a known instruction with an illegal operand is ILLI.
 class UnknownInst : public StaticInst { RegId srcRegs[0], dstRegs[0]; public:
-UnknownInst() : StaticInst("unknown", enums::No_OpClass) { setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); }
-Fault execute(ExecContext*, trace::InstRecord*) const override { return std::make_shared<DADAOSyscallFault>(); }
-std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"unknown";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+UnknownInst() : StaticInst("undi", enums::No_OpClass) { setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); }
+Fault execute(ExecContext*, trace::InstRecord*) const override { return std::make_shared<UndiFault>(); }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"undi";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// unimp (MISC-Norm ha=11_1111, spec §2.8.1): a *defined* instruction that always
+// raises ILLI — distinct from reserved (UNDI).
+class UnimpInst : public StaticInst { RegId srcRegs[0], dstRegs[0]; public:
+UnimpInst() : StaticInst("unimp", enums::No_OpClass) { setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); }
+Fault execute(ExecContext*, trace::InstRecord*) const override { RET_ILLI; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"unimp";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// Defined-but-unimplemented opcode (control flow beyond jump-iiii: br*, jump_r,
+// call, ret). NOT reserved — so it must NOT raise UNDI. Abstains via UnimplFault
+// (0x7F) so the adapter reports SKIP-unsupported. Keeps the reserved→UNDI
+// distinction clean and lets the harness abstain on these (incl. the 6 HARNESS
+// control-flow fault vectors the single-instruction model cannot reproduce).
+class AbstainInst : public StaticInst { RegId srcRegs[0], dstRegs[0]; public:
+AbstainInst() : StaticInst("unimpl", enums::No_OpClass) { setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); }
+Fault execute(ExecContext*, trace::InstRecord*) const override { return std::make_shared<UnimplFault>(); }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"unimpl";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// Register-bank block copy rd2rd/rd2rb/rb2rd/rb2rb (orri, spec §4.7). Semantics
+// are out of G2 scope, but the legality check is in-scope: immu6=0 / dest reg0 /
+// first+immu6>64 → ILLI (spec §2.6.3). A legal-but-unimplemented case abstains
+// via UnimplFault so the adapter reports SKIP-unsupported (not a bad result).
+class BlockCopyStub : public StaticInst { RegId srcRegs[0], dstRegs[0]; bool illegal; public:
+BlockCopyStub(uint8_t hb, uint8_t hd) : StaticInst("blockcopy", enums::No_OpClass),
+    illegal(hb==0 || hd==0 || hb+hd>64) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); }
+Fault execute(ExecContext*, trace::InstRecord*) const override { if(illegal) RET_ILLI; return std::make_shared<UnimplFault>(); }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"blockcopy";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
 
 // === ALU batch: sub, logic, muls/mulu, divs/divu ===
 // add/sub/muls/mulu are 128-bit dual-dest (ha=hi, hb=lo) — spec §3.5/3.7
-class AddDualInst : public StaticInst { RegId srcRegs[2], dstRegs[2]; public:
-AddDualInst(uint8_t hi, uint8_t lo, uint8_t s1, uint8_t s2) : StaticInst("add", enums::No_OpClass) {
+// spec §2.6.1 dual-dest legality: both rdha,rdhb=rd0 → ILLI; rdha==rdhb (same
+// non-rd0) → ILLI. (Exactly one rd0 is legal — discards that half.)
+static inline bool dualBadDst(uint8_t hi, uint8_t lo) {
+  return (hi==0 && lo==0) || (hi!=0 && hi==lo);
+}
+class AddDualInst : public StaticInst { RegId srcRegs[2], dstRegs[2]; bool badDst; public:
+AddDualInst(uint8_t hi, uint8_t lo, uint8_t s1, uint8_t s2) : StaticInst("add", enums::No_OpClass), badDst(dualBadDst(hi,lo)) {
   setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
   srcRegs[_numSrcRegs++]=intRegId(s1); srcRegs[_numSrcRegs++]=intRegId(s2);
   if(lo)dstRegs[_numDestRegs++]=intRegId(lo); if(hi)dstRegs[_numDestRegs++]=intRegId(hi); }
-Fault execute(ExecContext *xc, trace::InstRecord*) const override { __int128 r=(__int128)(int64_t)xc->getRegOperand(this,0)+(__int128)(int64_t)xc->getRegOperand(this,1); if(_numDestRegs>=1)xc->setRegOperand(this,0,(uint64_t)r); if(_numDestRegs>=2)xc->setRegOperand(this,1,(uint64_t)(r>>64)); return NoFault; } // spec §3.5: rdha:rdhb=sext128(rdhc)+sext128(rdhd)
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { if(badDst) RET_ILLI; __int128 r=(__int128)(int64_t)xc->getRegOperand(this,0)+(__int128)(int64_t)xc->getRegOperand(this,1); if(_numDestRegs>=1)xc->setRegOperand(this,0,(uint64_t)r); if(_numDestRegs>=2)xc->setRegOperand(this,1,(uint64_t)(r>>64)); return NoFault; } // spec §3.5: rdha:rdhb=sext128(rdhc)+sext128(rdhd)
 std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"add";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
 
