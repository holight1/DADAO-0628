-Fault execute(ExecContext *xc, trace::InstRecord*) const override { int64_t a=xc->getRegOperand(this,0), b=xc->getRegOperand(this,1); if(b==0)return std::make_shared<DADAOSyscallFault>(); if(a==INT64_MIN&&b==-1)return std::make_shared<DADAOSyscallFault>(); int64_t q=a/b, r=a%b; if(_numDestRegs>=1)xc->setRegOperand(this,0,r); if(_numDestRegs>=2)xc->setRegOperand(this,1,q); return NoFault; }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { if(badDst) RET_ILLI; int64_t a=xc->getRegOperand(this,0), b=xc->getRegOperand(this,1); if(b==0) RET_ILLI; if(a==INT64_MIN&&b==-1) RET_ILLI; int64_t q=a/b, r=a%b; if(_numDestRegs>=1)xc->setRegOperand(this,0,r); if(_numDestRegs>=2)xc->setRegOperand(this,1,q); return NoFault; } // spec §3.7: div0 / INT64_MIN÷-1 → ILLI
