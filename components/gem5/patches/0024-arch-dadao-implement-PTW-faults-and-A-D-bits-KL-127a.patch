--- a/src/arch/dadao/isa.hh
+++ b/src/arch/dadao/isa.hh
@@ -38,6 +38,21 @@ constexpr uint8_t CfxCodePower = 63;
 
 // cfx_smon's architecturally non-maskable CFXTRAP cause.
 constexpr uint64_t CfxCauseCfxtrap = 1ULL << 0;
+constexpr uint64_t CfxPtwCauseNuperm = 1ULL << 8;
+constexpr uint64_t CfxPtwCauseNjperm = 1ULL << 9;
+constexpr uint64_t CfxPtwCauseNsperm = 1ULL << 10;
+constexpr uint64_t CfxPtwCauseNhperm = 1ULL << 11;
+constexpr uint64_t CfxPtwCauseNxperm = 1ULL << 12;
+constexpr uint64_t CfxPtwCauseNwperm = 1ULL << 13;
+constexpr uint64_t CfxPtwCauseNrperm = 1ULL << 14;
+constexpr uint64_t CfxPtwCauseIgptrap = 1ULL << 16;
+constexpr uint64_t CfxPtwCauseIsptrap = 1ULL << 17;
+constexpr uint64_t CfxPtwCauseIgpftrap = 1ULL << 18;
+constexpr uint64_t CfxPtwCauseIspftrap = 1ULL << 19;
+constexpr uint64_t CfxPtwCauseDgptrap = 1ULL << 20;
+constexpr uint64_t CfxPtwCauseDsptrap = 1ULL << 21;
+constexpr uint64_t CfxPtwCauseDgpftrap = 1ULL << 22;
+constexpr uint64_t CfxPtwCauseDspftrap = 1ULL << 23;
 
 // HEE §1 cg3/rc12 "hypv cg reg delegation" (per-cfxcode storage)
 // [wiki §DADAO-13-HEE §1 L24].
@@ -121,10 +136,13 @@ class ISA : public BaseISA
         Execute = 2,
     };
 
-    // Successful PTW path only. Failure routing and A/D updates are deferred
-    // to KL-128a; no architectural TLB is populated by this helper.
+    // KL-126a/KL-127a PTW path. No architectural TLB is populated.
     bool ptwTranslate(ThreadContext *tc, Addr virtualAddr, PtwAccess access,
-                      Addr &physicalAddr) const;
+                      Addr &physicalAddr, uint64_t &faultCause) const;
+
+    void cfxPreciseTrapEnter(ThreadContext *tc, uint8_t targetCfxCode,
+                             uint64_t causeId, uint64_t causeInfo,
+                             Addr causeIp, bool stageSequentialAdvance);
 
     RegVal
     readMiscRegNoEffect(RegIndex idx) const override
diff --git a/src/arch/dadao/tlb.cc b/src/arch/dadao/tlb.cc
index d85f3010c9..3c59c6b124 100644
--- a/src/arch/dadao/tlb.cc
+++ b/src/arch/dadao/tlb.cc
@@ -5,6 +5,7 @@
 #include "cpu/thread_context.hh"
 #include "mem/page_table.hh"
 #include "sim/full_system.hh"
+#include "sim/faults.hh"
 #include "sim/process.hh"
 
 namespace gem5
@@ -12,21 +13,34 @@ namespace gem5
 namespace DADAOISA
 {
 
+static Fault
+translateFullSystem(const RequestPtr &req, ThreadContext *tc,
+                    BaseMMU::Mode mode)
+{
+    auto *isa = static_cast<ISA *>(tc->getIsaPtr());
+    const ISA::PtwAccess access =
+        mode == BaseMMU::Execute ? ISA::PtwAccess::Execute :
+        mode == BaseMMU::Write ? ISA::PtwAccess::Write :
+        ISA::PtwAccess::Read;
+    Addr physical;
+    uint64_t faultCause;
+    if (!isa->ptwTranslate(
+            tc, req->getVaddr(), access, physical, faultCause)) {
+        isa->cfxPreciseTrapEnter(
+            tc, CfxCodePtw, faultCause, req->getVaddr(),
+            tc->pcState().instAddr(), false);
+        return std::make_shared<ReExec>();
+    }
+    req->setPaddr(physical);
+    return NoFault;
+}
+
 Fault
 TLB::translateAtomic(const RequestPtr &req, ThreadContext *tc,
                      BaseMMU::Mode mode)
 {
     if (FullSystem) {
-        auto *isa = static_cast<ISA *>(tc->getIsaPtr());
-        const ISA::PtwAccess access =
-            mode == BaseMMU::Execute ? ISA::PtwAccess::Execute :
-            mode == BaseMMU::Write ? ISA::PtwAccess::Write :
-            ISA::PtwAccess::Read;
-        Addr physical;
-        panic_if(!isa->ptwTranslate(tc, req->getVaddr(), access, physical),
-                 "DADAO PTW failure handling is not implemented");
-        req->setPaddr(physical);
-        return NoFault;
+        return translateFullSystem(req, tc, mode);
     }
     return tc->getProcessPtr()->pTable->translate(req);
 }
@@ -36,16 +50,7 @@ TLB::translateFunctional(const RequestPtr &req, ThreadContext *tc,
                          BaseMMU::Mode mode)
 {
     if (FullSystem) {
-        auto *isa = static_cast<ISA *>(tc->getIsaPtr());
-        const ISA::PtwAccess access =
-            mode == BaseMMU::Execute ? ISA::PtwAccess::Execute :
-            mode == BaseMMU::Write ? ISA::PtwAccess::Write :
-            ISA::PtwAccess::Read;
-        Addr physical;
-        panic_if(!isa->ptwTranslate(tc, req->getVaddr(), access, physical),
-                 "DADAO PTW failure handling is not implemented");
-        req->setPaddr(physical);
-        return NoFault;
+        return translateFullSystem(req, tc, mode);
     }
     return tc->getProcessPtr()->pTable->translate(req);
 }
