+// spec §1.3: RB effective addresses are 48-bit.
+static constexpr uint64_t MASK48 = 0xFFFFFFFFFFFFULL;
+
+// DG-004b memory readout window. The gem5 differential adapter maps a fixed RW
+// data segment [MEM_WINDOW_BASE, +MEM_WINDOW_SIZE) into every test ELF so that
+// (a) load inputs / store targets have valid pages and (b) at halt this window
+// can be dumped back for expected_state.memory comparison. All memory test
+// vectors cluster at 0x87FF0000 (RAM), well inside this window. Adapter and
+// gem5 share these constants; keep them in sync with run_gem5_test.py.
+static constexpr uint64_t MEM_WINDOW_BASE = 0x87FEF000ULL;
+static constexpr uint64_t MEM_WINDOW_SIZE = 0x3000ULL;   // 12 KiB
+
 // DG-003a terminal-state readout (restored): at halt, dump the architectural
 // RD (rd0-63) and RB (rb0-63) registers on one line to stdout so the gem5
-// differential adapter can parse the final state. Observability only.
+// differential adapter can parse the final state. DG-004b adds a second line
+// (DADAO_MEMDUMP) with the raw big-endian bytes of the memory window so the
+// adapter can compare expected_state.memory. Observability only.
 static void
 dumpFinalState(ExecContext *xc)
 {
@@ -29,6 +46,21 @@ dumpFinalState(ExecContext *xc)
         line += csprintf(" rb%d=0x%016x", i,
                          (uint64_t)tc->getReg(intRegId(RB_BASE + i)));
     std::cout << line << std::endl;
+
+    // Read the memory window from the process address space (big-endian bytes
+    // as stored) and emit as one hex string: base then contiguous byte hex.
+    // tryReadBlob so workloads that do not map the window (e.g. the G1 smoke
+    // ELFs) simply produce no DADAO_MEMDUMP rather than aborting.
+    std::vector<uint8_t> buf(MEM_WINDOW_SIZE, 0);
+    if (SETranslatingPortProxy(tc).tryReadBlob(MEM_WINDOW_BASE, buf.data(),
+                                               MEM_WINDOW_SIZE)) {
+        std::string mem = csprintf("DADAO_MEMDUMP base=0x%x size=0x%x data=",
+                                   MEM_WINDOW_BASE, MEM_WINDOW_SIZE);
+        mem.reserve(mem.size() + MEM_WINDOW_SIZE * 2);
+        for (uint64_t i = 0; i < MEM_WINDOW_SIZE; i++)
+            mem += csprintf("%02x", buf[i]);
+        std::cout << mem << std::endl;
+    }
 }
 
 // === field extractors ===
@@ -259,6 +291,153 @@ SwymInst() : StaticInst("swym", enums::No_OpClass) { setRegIdxArrays(reinterpret
 Fault execute(ExecContext*, trace::InstRecord*) const override { return NoFault; }
 std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"swym";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
 
+// === Memory access helpers (spec §2.1 big-endian, §3.1-§3.4, §4.1-§4.2) ===
+// Data access is big-endian: byte at the lowest address is the most
+// significant. Assemble/disassemble explicitly so host endianness is
+// irrelevant.
+static inline Fault
+memReadBE(ExecContext *xc, const StaticInst *si, Addr ea, int N, uint64_t &out)
+{
+    uint8_t b[8] = {};
+    std::vector<bool> be(N, true);
+    Fault f = xc->readMem(ea, b, N, Request::Flags(0), be);
+    if (f != NoFault) return f;
+    uint64_t v = 0;
+    for (int i = 0; i < N; i++) v = (v << 8) | b[i];   // big-endian §2.1
+    out = v;
+    return NoFault;
+}
+
+static inline Fault
+memWriteBE(ExecContext *xc, Addr ea, int N, uint64_t val)
+{
+    uint8_t b[8] = {};
+    for (int i = 0; i < N; i++) b[i] = (val >> (8 * (N - 1 - i))) & 0xFF;
+    std::vector<bool> be(N, true);
+    return xc->writeMem(b, N, ea, Request::Flags(0), nullptr, be);
+}
+
+static inline uint64_t
+sextN(uint64_t v, int N)
+{
+    if (N >= 8) return v;
+    uint64_t m = 1ULL << (N * 8 - 1);
+    return (v ^ m) - m;                                // sign-extend N bytes
+}
+
+// === RD/RB single load (rrii, spec §3.1 / §4.1) ===
+// EA = (rbhb[47:0] + sext_12(imms12)) mod 2^48; rd/rb(ha) = extend_N(mem_be).
+// destRb selects the destination bank (RD load vs RB ldo). rbha=0/rdha=0
+// legality (ILLI) is DG-004c; here ha==0 simply performs no register write.
+class LoadInst : public StaticInst { RegId srcRegs[1], dstRegs[1]; int64_t imm_; int N; bool sgn; bool destRb; public:
+LoadInst(uint8_t ha, uint8_t hb, int64_t imm, int width, bool s, bool dRb)
+  : StaticInst("ld", enums::MemRead), imm_(imm), N(width), sgn(s), destRb(dRb) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++] = intRegId(RB_BASE + hb);
+  if (ha) dstRegs[_numDestRegs++] = intRegId((destRb ? RB_BASE : RD_BASE) + ha); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override {
+  uint64_t base = xc->getRegOperand(this, 0) & MASK48;
+  Addr ea = (base + (uint64_t)imm_) & MASK48;
+  uint64_t v; Fault f = memReadBE(xc, this, ea, N, v); if (f != NoFault) return f;
+  if (sgn) v = sextN(v, N);
+  if (_numDestRegs) xc->setRegOperand(this, 0, v); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"ld";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// === RD/RB single store (rrii, spec §3.2 / §4.1) ===
+// mem_be[ea : ea+N-1] = data[N*8-1:0]. dataRb selects source bank (RD st vs RB
+// sto). rdha=0 storing is ILLI (DG-004c); here it stores 0.
+class StoreInst : public StaticInst { RegId srcRegs[2], dstRegs[0]; int64_t imm_; int N; int dataIdx; public:
+StoreInst(uint8_t ha, uint8_t hb, int64_t imm, int width, bool dataRb)
+  : StaticInst("st", enums::MemWrite), imm_(imm), N(width) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++] = intRegId(RB_BASE + hb);   // operand 0 = base
+  dataIdx = -1;
+  if (ha) { srcRegs[_numSrcRegs] = intRegId((dataRb ? RB_BASE : RD_BASE) + ha); dataIdx = _numSrcRegs++; } }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override {
+  uint64_t base = xc->getRegOperand(this, 0) & MASK48;
+  Addr ea = (base + (uint64_t)imm_) & MASK48;
+  uint64_t val = (dataIdx < 0) ? 0 : xc->getRegOperand(this, dataIdx);
+  return memWriteBE(xc, ea, N, val); }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"st";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// === RD/RB multi load (rrri, spec §3.3 / §4.2) ===
+// EA_i = (rbhb[47:0] + rdhc[47:0] + i*N) mod 2^48; reg(ha+i)=extend_N(mem_be).
+class MultiLoadInst : public StaticInst { RegId srcRegs[2], dstRegs[63]; int N; bool sgn; int count; int idxIdx; public:
+MultiLoadInst(uint8_t ha, uint8_t hb, uint8_t hc, uint8_t immu6, int width, bool s, bool destRb)
+  : StaticInst("ldm", enums::MemRead), N(width), sgn(s), count(immu6) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++] = intRegId(RB_BASE + hb);   // operand 0 = base
+  idxIdx = -1;
+  if (hc) { srcRegs[_numSrcRegs] = intRegId(RD_BASE + hc); idxIdx = _numSrcRegs++; }
+  RegIndex destBase = destRb ? RB_BASE : RD_BASE;
+  for (int i = 0; i < count && i < 63; i++) dstRegs[_numDestRegs++] = intRegId(destBase + ha + i); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override {
+  uint64_t base = xc->getRegOperand(this, 0) & MASK48;
+  uint64_t idx = (idxIdx < 0) ? 0 : (xc->getRegOperand(this, idxIdx) & MASK48);
+  for (int i = 0; i < _numDestRegs; i++) {
+    Addr ea = (base + idx + (uint64_t)i * N) & MASK48;
+    uint64_t v; Fault f = memReadBE(xc, this, ea, N, v); if (f != NoFault) return f;
+    if (sgn) v = sextN(v, N);
+    xc->setRegOperand(this, i, v); }
+  return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"ldm";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// === RD/RB multi store (rrri, spec §3.4 / §4.2) ===
+class MultiStoreInst : public StaticInst { RegId srcRegs[65], dstRegs[0]; int N; int count; int idxIdx; int dataStart; public:
+MultiStoreInst(uint8_t ha, uint8_t hb, uint8_t hc, uint8_t immu6, int width, bool dataRb)
+  : StaticInst("stm", enums::MemWrite), N(width), count(immu6) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++] = intRegId(RB_BASE + hb);   // operand 0 = base
+  idxIdx = -1;
+  if (hc) { srcRegs[_numSrcRegs] = intRegId(RD_BASE + hc); idxIdx = _numSrcRegs++; }
+  dataStart = _numSrcRegs;
+  RegIndex dataBase = dataRb ? RB_BASE : RD_BASE;
+  for (int i = 0; i < count && i < 63; i++) srcRegs[_numSrcRegs++] = intRegId(dataBase + ha + i); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override {
+  uint64_t base = xc->getRegOperand(this, 0) & MASK48;
+  uint64_t idx = (idxIdx < 0) ? 0 : (xc->getRegOperand(this, idxIdx) & MASK48);
+  int n = _numSrcRegs - dataStart;
+  for (int i = 0; i < n; i++) {
+    Addr ea = (base + idx + (uint64_t)i * N) & MASK48;
+    uint64_t val = xc->getRegOperand(this, dataStart + i);
+    Fault f = memWriteBE(xc, ea, N, val); if (f != NoFault) return f; }
+  return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"stm";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// === RB wyde immediate (rwii, spec §4.6): setzw/orw/andnw into RB, full 64-bit ===
+class SetzwRbInst : public StaticInst { RegId srcRegs[0], dstRegs[1]; int shift; uint64_t imm16; public:
+SetzwRbInst(uint8_t d, int wyde, uint16_t imm) : StaticInst("setzw.rb", enums::No_OpClass), shift(wyde*16), imm16(imm) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  if(d)dstRegs[_numDestRegs++]=intRegId(RB_BASE+d); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { if(_numDestRegs) xc->setRegOperand(this,0,(uint64_t)imm16<<shift); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"setzw.rb";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+class OrwRbInst : public StaticInst { RegId srcRegs[1], dstRegs[1]; int shift; uint64_t imm16; public:
+OrwRbInst(uint8_t d, int wyde, uint16_t imm) : StaticInst("orw.rb", enums::No_OpClass), shift(wyde*16), imm16(imm) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  if(d){ srcRegs[_numSrcRegs++]=intRegId(RB_BASE+d); dstRegs[_numDestRegs++]=intRegId(RB_BASE+d); } }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { if(_numDestRegs){ uint64_t v=xc->getRegOperand(this,0); xc->setRegOperand(this,0,v|((uint64_t)imm16<<shift)); } return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"orw.rb";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+class AndnwRbInst : public StaticInst { RegId srcRegs[1], dstRegs[1]; int shift; uint64_t imm16; public:
+AndnwRbInst(uint8_t d, int wyde, uint16_t imm) : StaticInst("andnw.rb", enums::No_OpClass), shift(wyde*16), imm16(imm) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  if(d){ srcRegs[_numSrcRegs++]=intRegId(RB_BASE+d); dstRegs[_numDestRegs++]=intRegId(RB_BASE+d); } }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override { if(_numDestRegs){ uint64_t v=xc->getRegOperand(this,0); xc->setRegOperand(this,0,v&~((uint64_t)imm16<<shift)); } return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"andnw.rb";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
+// === RB compare (orrr, spec §4.5): cmp rdhb, rbhc, rbhd; unsigned 48-bit ===
+// rdhb = -1 if rbhc<rbhd, 0 if ==, 1 if >; RB bits[63:48] ignored.
+class CmpRbInst : public StaticInst { RegId srcRegs[2], dstRegs[1]; public:
+CmpRbInst(uint8_t d, uint8_t c, uint8_t e) : StaticInst("cmp.rb", enums::No_OpClass) {
+  setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs));
+  srcRegs[_numSrcRegs++]=intRegId(RB_BASE+c); srcRegs[_numSrcRegs++]=intRegId(RB_BASE+e);
+  if(d)dstRegs[_numDestRegs++]=intRegId(RD_BASE+d); }
+Fault execute(ExecContext *xc, trace::InstRecord*) const override {
+  uint64_t a=xc->getRegOperand(this,0)&MASK48, b=xc->getRegOperand(this,1)&MASK48;
+  if(_numDestRegs) xc->setRegOperand(this,0,(a<b)?-1ULL:(a>b)?1ULL:0); return NoFault; }
+std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"cmp.rb";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
+
 // === Decoder ===
 StaticInstPtr Decoder::decode(DADAOInst inst) {
     uint32_t w = inst.inst; uint8_t op = w >> 24;
@@ -288,7 +467,7 @@ StaticInstPtr Decoder::decode(DADAOInst inst) {
         case 0x29: return StaticInstPtr(new UnknownInst()); // rd2rb
         case 0x2A: return StaticInstPtr(new UnknownInst()); // rb2rd
         case 0x2B: return StaticInstPtr(new UnknownInst()); // rb2rb
-        case 0x2D: return StaticInstPtr(new CmpuInst(hb(w), hc(w), hd(w))); // cmp RB
+        case 0x2D: return StaticInstPtr(new CmpRbInst(hb(w), hc(w), hd(w))); // cmp RB (spec §4.5)
         case 0x2E: return StaticInstPtr(new AddRbInst(hb(w), hc(w), hd(w)));
         case 0x2F: return StaticInstPtr(new SubRbInst(hb(w), hc(w), hd(w)));
         default:  return StaticInstPtr(new UnknownInst());
@@ -312,8 +491,43 @@ StaticInstPtr Decoder::decode(DADAOInst inst) {
     case 0x24: return StaticInstPtr(new CspInst(ha(w), hb(w), hc(w), hd(w)));
     case 0x26: return StaticInstPtr(new CseqInst(ha(w), hb(w), hc(w), hd(w)));
     case 0x27: return StaticInstPtr(new CsneInst(ha(w), hb(w), hc(w), hd(w)));
+    // === RD single load (rrii, spec §3.1) ===
+    case 0x30: return StaticInstPtr(new LoadInst(ha(w), hb(w), imm12s(w), 1, true,  false)); // ldbs
+    case 0x31: return StaticInstPtr(new LoadInst(ha(w), hb(w), imm12s(w), 2, true,  false)); // ldws
+    case 0x32: return StaticInstPtr(new LoadInst(ha(w), hb(w), imm12s(w), 4, true,  false)); // ldts
+    case 0x33: return StaticInstPtr(new LoadInst(ha(w), hb(w), imm12s(w), 8, false, false)); // ldo
+    // === RD multi load (rrri, spec §3.3) ===
+    case 0x34: return StaticInstPtr(new MultiLoadInst(ha(w), hb(w), hc(w), hd(w), 1, true,  false)); // ldmbs
+    case 0x35: return StaticInstPtr(new MultiLoadInst(ha(w), hb(w), hc(w), hd(w), 2, true,  false)); // ldmws
+    case 0x36: return StaticInstPtr(new MultiLoadInst(ha(w), hb(w), hc(w), hd(w), 4, true,  false)); // ldmts
+    case 0x37: return StaticInstPtr(new MultiLoadInst(ha(w), hb(w), hc(w), hd(w), 8, false, false)); // ldmo
+    // === RD single store (rrii, spec §3.2) ===
+    case 0x38: return StaticInstPtr(new StoreInst(ha(w), hb(w), imm12s(w), 1, false)); // stb
+    case 0x39: return StaticInstPtr(new StoreInst(ha(w), hb(w), imm12s(w), 2, false)); // stw
+    case 0x3A: return StaticInstPtr(new StoreInst(ha(w), hb(w), imm12s(w), 4, false)); // stt
+    case 0x3B: return StaticInstPtr(new StoreInst(ha(w), hb(w), imm12s(w), 8, false)); // sto
+    // === RD multi store (rrri, spec §3.4) ===
+    case 0x3C: return StaticInstPtr(new MultiStoreInst(ha(w), hb(w), hc(w), hd(w), 1, false)); // stmb
+    case 0x3D: return StaticInstPtr(new MultiStoreInst(ha(w), hb(w), hc(w), hd(w), 2, false)); // stmw
+    case 0x3E: return StaticInstPtr(new MultiStoreInst(ha(w), hb(w), hc(w), hd(w), 4, false)); // stmt
+    case 0x3F: return StaticInstPtr(new MultiStoreInst(ha(w), hb(w), hc(w), hd(w), 8, false)); // stmo
+    // === RD load unsigned + RB load (row 01000, spec §3.1/§4.1/§3.3/§4.2) ===
+    case 0x40: return StaticInstPtr(new LoadInst(ha(w), hb(w), imm12s(w), 1, false, false)); // ldbu
+    case 0x41: return StaticInstPtr(new LoadInst(ha(w), hb(w), imm12s(w), 2, false, false)); // ldwu
+    case 0x42: return StaticInstPtr(new LoadInst(ha(w), hb(w), imm12s(w), 4, false, false)); // ldtu
+    case 0x43: return StaticInstPtr(new LoadInst(ha(w), hb(w), imm12s(w), 8, false, true));  // ldo-rb
+    case 0x44: return StaticInstPtr(new MultiLoadInst(ha(w), hb(w), hc(w), hd(w), 1, false, false)); // ldmbu
+    case 0x45: return StaticInstPtr(new MultiLoadInst(ha(w), hb(w), hc(w), hd(w), 2, false, false)); // ldmwu
+    case 0x46: return StaticInstPtr(new MultiLoadInst(ha(w), hb(w), hc(w), hd(w), 4, false, false)); // ldmtu
+    case 0x47: return StaticInstPtr(new MultiLoadInst(ha(w), hb(w), hc(w), hd(w), 8, false, true));  // ldmo-rb
     case 0x48: return StaticInstPtr(new RelaInst(ha(w), imm18s(w)));
