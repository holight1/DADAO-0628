--- a/src/arch/dadao/decoder.cc
+++ b/src/arch/dadao/decoder.cc
@@ -706,16 +706,19 @@ cfxIsa(ExecContext *xc)
   return static_cast<ISA *>(xc->tcBase()->getIsaPtr());
 }
 
-// KL-122a shared SEE §5 steps 7-10 carrier for non-maskable synchronous
-// causes. Source routing and mask/pending/priority remain later tasks.
+// KL-131a: routes through the SEE §5 steps 2-6 gate (isa->cfxDispatch()) in
+// front of KL-122a's steps 7-10 carrier. CFXTRAP is nonmaskable in every
+// cfx's cause table, so behavior is unchanged for this real call site except
+// for the new cfxTrapNum counter.
 static void
 cfxPreciseTrapEnter(ExecContext *xc, uint8_t targetCfxCode,
                     uint64_t causeId, uint32_t rawInsn)
 {
   ISA *isa = cfxIsa(xc);
   PCState pc = xc->pcState().as<PCState>();
-  isa->cfxPreciseTrapEnter(
-      xc->tcBase(), targetCfxCode, causeId, rawInsn, pc.instAddr(), true);
+  isa->cfxDispatch(
+      xc->tcBase(), targetCfxCode, causeId, rawInsn, pc.instAddr(), true,
+      true);
 }
 
 // === trap (ciii, op=0x76, spec §系统类指令): cfx_smon(cfxcode=2) responder ===
@@ -733,10 +736,12 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
     // same convention as cfx_smon below -- the handler resumes past the
     // call with escape cfx_ptw,1 (cause_ip+4), matching KL-116a's
     // established "escape cfx_smon,1" trap-as-call pattern. E1 in the PTW
-    // frame restores the cfx_tlb caller.
-    isa->cfxPreciseTrapEnter(
+    // frame restores the cfx_tlb caller. KL-131a: routed through the steps
+    // 2-6 gate; CFXTRAP is nonmaskable so behavior is unchanged except for
+    // the new cfxTrapNum counter.
+    isa->cfxDispatch(
         xc->tcBase(), CfxCodePtw, CfxCauseCfxtrap, rawInsn,
-        pc.instAddr() & MASK48, true);
+        pc.instAddr() & MASK48, true, true);
     return NoFault;
   }
   if (cfxcode == CfxCodeSmon && isa->cfxSmonReal) {
@@ -905,22 +910,9 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
 }
 std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"trap";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
 
-static inline uint64_t
-cfxCommonPendingMask(uint8_t cfxcode)
-{
-  switch (cfxcode & 0x3F) {
-  case 0: case 1: case CfxCodeSmon: case 3:
-    return 1ULL << 32; // monitor FPEXCP
-  case 15:
-    return 1ULL << 8;  // hart IPI
-  case 18: case CfxCodePower:
-    return 1ULL << 10; // timer TIMER / power SOFT_RESET
