--- a/src/arch/dadao/interrupts.hh
+++ b/src/arch/dadao/interrupts.hh
@@ -1,7 +1,10 @@
 #ifndef __ARCH_DADAO_INTERRUPTS_HH__
 #define __ARCH_DADAO_INTERRUPTS_HH__
 
+#include "arch/dadao/faults.hh"
+#include "arch/dadao/isa.hh"
 #include "arch/generic/interrupts.hh"
+#include "cpu/thread_context.hh"
 #include "params/DADAOInterrupts.hh"
 
 namespace gem5
@@ -9,14 +12,44 @@ namespace gem5
 namespace DADAOISA
 {
 
+// KL-131a: the gem5-core-invoked instruction-boundary interrupt hook --
+// BaseCPU::checkInterrupts()/BaseSimpleCPU::checkForInterrupts() call these
+// two methods once per tick() (= once per instruction for AtomicSimpleCPU),
+// the same generic mechanism every other gem5 ISA's Interrupts subclass
+// uses (e.g. RISCV's src/arch/riscv/interrupts.hh checkInterrupts()/
+// getInterrupt()). ISA::cfxAsyncScan() (isa.cc) owns the actual SEE §5
+// steps 2-6 scan and priority selection; these two methods only ask it
+// whether there is anything to deliver right now, mirroring QEMU's
+// dadao_cpu_exec_interrupt() -> dadao_cfx_async_step() split. Only
+// consulted in FullSystem mode (BaseCPU::checkInterrupts()'s own
+// `FullSystem &&` gate) -- see tests/dadao/dadao_fs.py, the FullSystem
+// bare-metal carrier KL-124a added.
 class Interrupts : public BaseInterrupts
 {
   public:
     using Params = DADAOInterruptsParams;
     Interrupts(const Params &p) : BaseInterrupts(p) {}
 
-    bool checkInterrupts() const override { return false; }
-    Fault getInterrupt() override { return NoFault; }
+    bool
+    checkInterrupts() const override
+    {
+        auto *isa = static_cast<ISA *>(tc->getIsaPtr());
+        uint64_t target, cause;
+        return isa->cfxAsyncScan(target, cause);
+    }
+
+    Fault
+    getInterrupt() override
+    {
+        auto *isa = static_cast<ISA *>(tc->getIsaPtr());
+        uint64_t target, cause;
+        if (!isa->cfxAsyncScan(target, cause))
+            return NoFault;
+        isa->cfxAsyncPendingTarget = target;
+        isa->cfxAsyncPendingCause = cause;
+        return std::make_shared<AsyncInterruptFault>();
+    }
+
     void updateIntrInfo() override {}
 };
 
diff --git a/src/arch/dadao/isa.cc b/src/arch/dadao/isa.cc
index 24fd6861fd..5c276ca5d6 100644
--- a/src/arch/dadao/isa.cc
+++ b/src/arch/dadao/isa.cc
@@ -25,10 +25,65 @@ RegClass vecPredRegClass(VecPredRegClass, VecPredRegClassName, 1, debug::IntRegs
 RegClass matRegClass(MatRegClass, MatRegClassName, 0, debug::MatRegs);
 RegClass ccRegClass(CCRegClass, CCRegClassName, 0, debug::IntRegs);
 
+// KL-131a: shared with decoder.cc's CFX2RCInst/CFX2RDInst (cg4/rc7 common
+// pending) and this file's cfxAsyncScan/cfxDispatch -- the per-cfx set of
+// causes that actually exist and may be latched into cfxCommonPending.
+// Mirrors QEMU's dadao_cfx_common_pending_mask() (helper.c) exactly.
+uint64_t
+cfxCommonPendingMask(uint8_t cfxcode)
+{
+    switch (cfxcode & 0x3F) {
+    case 0: case 1: case CfxCodeSmon: case 3:
+        return 1ULL << 32; // monitor FPEXCP
+    case 15:
+        return 1ULL << 8;  // hart IPI
+    case 18: case CfxCodePower:
+        return 1ULL << 10; // timer TIMER / power SOFT_RESET
+    case 62:
+        return ~0ULL << 32; // UART0..31
+    default:
+        return 0;
+    }
+}
+
+// KL-131a: SEE §3 cg5/rc63 excp_cause_nonmaskable, hardware-static per cfx's
+// own cause table [wiki L362]. Mirrors QEMU's dadao_cfx_excp_cause_
+// nonmaskable_for() (cpu.c) exactly -- see that function's comment for the
+// full per-cfx wiki citations independently re-verified for this task.
+static uint64_t
+cfxExcpCauseNonmaskableFor(uint8_t cfxcode)
+{
+    constexpr uint64_t Common = (1ULL << 0) | (1ULL << 1) | (1ULL << 2);
+
+    switch (cfxcode & 0x3F) {
+    case 0: case 1: case CfxCodeSmon: case 3:
+        return Common | (1ULL << 8) | (1ULL << 9) | (1ULL << 10) |
+               (1ULL << 11) | (1ULL << 12) | (1ULL << 13);
+    case CfxCodePtw:
+        return Common | (1ULL << 8) | (1ULL << 9) | (1ULL << 10) |
+               (1ULL << 11) | (1ULL << 12) | (1ULL << 13) | (1ULL << 14) |
+               (1ULL << 16) | (1ULL << 17) | (1ULL << 18) | (1ULL << 19) |
+               (1ULL << 20) | (1ULL << 21) | (1ULL << 22) | (1ULL << 23);
+    case CfxCodeTlb:
+        return Common | (1ULL << 12) | (1ULL << 13) | (1ULL << 14) |
+               (1ULL << 18) | (1ULL << 19) | (1ULL << 22) | (1ULL << 23);
+    case 15: case 18: case 62:
+        return Common;
+    case CfxCodePower:
+        return Common | (1ULL << 8) | (1ULL << 9);
+    default:
+        return Common;
+    }
+}
+
 ISA::ISA(const Params &p)
     : BaseISA(p, "dadao"), cfxSmonReal(p.cfx_smon_real),
       cfxCommonPendingTestCode(p.cfx_common_pending_test_code),
-      cfxCommonPendingTestSeed(p.cfx_common_pending_test_seed)
+      cfxCommonPendingTestSeed(p.cfx_common_pending_test_seed),
+      cfxAsyncTestLevelACode(p.cfx_async_test_level_a_code),
+      cfxAsyncTestLevelASeed(p.cfx_async_test_level_a_seed),
+      cfxAsyncTestLevelBCode(p.cfx_async_test_level_b_code),
+      cfxAsyncTestLevelBSeed(p.cfx_async_test_level_b_seed)
 {
     _regClasses.push_back(&intRegClass);
     _regClasses.push_back(&floatRegClass);
@@ -84,7 +139,22 @@ ISA::clear()
             cfxTlb[i][way] = CfxTlbEntry{};
         for (int m = 0; m < 4; m++)
             cfxEscapeCfxMask[i][m] = ~0ULL;
+        // KL-131a: cg0-3/rc11 excp_cause_mask resets all-1 (blocked) per
+        // cfx/mode, mirroring cfxEscapeCfxMask above [wiki L285/L309/L329].
+        for (int m = 0; m < 4; m++)
+            cfxExcpCauseMask[i][m] = ~0ULL;
+        cfxExcpCauseNonmaskable[i] = cfxExcpCauseNonmaskableFor(i);
+        cfxTrapNum[i] = 0;
+        cfxExcpSyncNum[i] = 0;
+        cfxExcpAsyncNum[i] = 0;
     }
+    // KL-131a: cg0-3/rc1 global_cfx_mask is the SHARED 4-entry array (see
+    // isa.hh's CfxModeGlobalMaskRc comment); reset all-1 per mode [wiki
+    // L275/L287, L299/L311, L319/L331].
+    for (int m = 0; m < 4; m++)
+        cfxModeGlobalCfxMask[m] = ~0ULL;
+    cfxAsyncPendingTarget = 0;
+    cfxAsyncPendingCause = 0;
     cfxFrame[CfxCodePower].prevRunMode = RunModeHypv;
     cfxFrame[CfxCodePower].prevCfxMask = ~0ULL;
     cfxFrame[CfxCodePower].prevCfxCode = CfxCodePower;
@@ -376,6 +446,108 @@ ISA::cfxPreciseTrapEnter(ThreadContext *tc, uint8_t targetCfxCode,
     }
 }
 
+// KL-131a: pure predicate for SEE §5 steps 2-5 -- would `cause` targeting
+// `targetCfx` currently reach step 6 (entry), or is it blocked? No state
+// mutation. Shared by cfxDispatch()'s own gate and cfxAsyncScan()'s
+// candidate-eligibility test, so both use exactly the same arbitration rule
+// (contracts/isa/spec.md §8.5.1; wiki L680-699, L763-786). Mirrors QEMU's
+// dadao_cfx_cause_eligible() (cpu.c) exactly.
+bool
+ISA::cfxCauseEligible(uint64_t targetCfx, uint64_t cause) const
+{
+    if (cfxExcpCauseNonmaskable[targetCfx] & cause)
+        return true;
