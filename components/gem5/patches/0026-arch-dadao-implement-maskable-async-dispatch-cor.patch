-}
+// KL-131a: cfxCommonPendingMask() moved to isa.cc (non-static, declared in
+// isa.hh) so isa.cc's cfxDispatch()/cfxAsyncScan() can share it too --
+// previously local-static to this file only.
 
 // === cfx2rc (crrr, op=0x73, KL-113a hypv<->supv handoff O1+O2 design1/3) ===
 // Centralized CFX state transition, mirroring QEMU helper_cfx2rc()
@@ -1024,6 +1016,30 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
     isa->cfxEscapeCfxMask[cfxcode_][cg_] = value;
     return NoFault;
   }
+  // KL-131a: cfx_<name>_<mode>_global_cfx_mask is a SHARED register -- one
+  // per mode, not one per cfxcode [wiki L275/L287, L299/L311, L319/L331].
+  // cfxcode_ therefore does not select storage here (unlike every other
+  // per-(cfxcode,mode) register above); any cfxcode writes the same
+  // cfxModeGlobalCfxMask[cg_] slot.
+  if (cg_ <= 3 && rc_ == CfxModeGlobalMaskRc) {
+    isa->cfxModeGlobalCfxMask[cg_] = value;
+    return NoFault;
+  }
+  // KL-131a: cfx_<name>_<mode>_excp_cause_mask, per-(cfxcode,mode) [wiki
+  // L285/L309/L329].
+  if (cg_ <= 3 && rc_ == CfxModeExcpCauseMaskRc) {
+    isa->cfxExcpCauseMask[cfxcode_][cg_] = value;
+    return NoFault;
+  }
+  // KL-131a TEST-ONLY: see isa.hh's CfxTestSyncDispatchRc comment. Not real
+  // hardware; never reached by any non-test guest code. stageSequentialAdvance
+  // =true since this write-side-effect happens inside this instruction's own
+  // execute(), whose own post-execute advancePC() still runs afterward.
+  if (cg_ == CfxTestSyncDispatchCg && rc_ == CfxTestSyncDispatchRc) {
+    isa->cfxDispatch(xc->tcBase(), cfxcode_, value, CfxTestCauseInfo,
+                     xc->pcState().as<PCState>().instAddr(), true, true);
+    return NoFault;
+  }
   // KL-112a design 3: cfx_power's cg=8 defines only rc=0 (power_pending)
   // and rc=1 (power_ctrl); every other rc is a genuinely non-existent
   // (cg,rc) combination for cfx_power, not merely unimplemented.
@@ -1056,6 +1072,12 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
   } else if (cg_ == CfxCommonPendingCg && rc_ == CfxCommonPendingRc) {
     value = isa->cfxCommonPending[cfxcode_] &
       cfxCommonPendingMask(cfxcode_);
+  } else if (cg_ == CfxCommonPendingCg && rc_ == CfxTrapNumRc) {
+    value = isa->cfxTrapNum[cfxcode_];
+  } else if (cg_ == CfxCommonPendingCg && rc_ == CfxExcpSyncNumRc) {
+    value = isa->cfxExcpSyncNum[cfxcode_];
+  } else if (cg_ == CfxCommonPendingCg && rc_ == CfxExcpAsyncNumRc) {
+    value = isa->cfxExcpAsyncNum[cfxcode_];
   } else if (cfxcode_ == CfxCodePtw && cg_ == 8 && rc_ < 4) {
     value = isa->cfxPtwPerm[rc_];
   } else if (cfxcode_ == CfxCodePtw && cg_ == 8 && rc_ == 8) {
@@ -1082,12 +1104,19 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
     case 3: value = isa->cfxFrame[cfxcode_].causeIp; break;
     case 4: value = isa->cfxFrame[cfxcode_].causeInfo; break;
     case 5: value = isa->cfxFrame[cfxcode_].prevCfxCode; break;
+    case CfxNonmaskableRc: value = isa->cfxExcpCauseNonmaskable[cfxcode_]; break;
     default: break;
     }
   } else if (cg_ == 2 && rc_ == 10) {
     value = isa->cfxSupvExcpVector[cfxcode_];
   } else if (cg_ <= 3 && rc_ == CfxMaskRegEscape) {
     value = isa->cfxEscapeCfxMask[cfxcode_][cg_];
+  } else if (cg_ <= 3 && rc_ == CfxModeGlobalMaskRc) {
+    // KL-131a: shared register, cfxcode_ does not select storage (see the
+    // write-side comment in CFX2RCInst).
+    value = isa->cfxModeGlobalCfxMask[cg_];
+  } else if (cg_ <= 3 && rc_ == CfxModeExcpCauseMaskRc) {
+    value = isa->cfxExcpCauseMask[cfxcode_][cg_];
   }
   if (writesDest) xc->setRegOperand(this, 0, value);
   return NoFault; }
diff --git a/src/arch/dadao/faults.cc b/src/arch/dadao/faults.cc
index 6d4a489330..f190c577c5 100644
--- a/src/arch/dadao/faults.cc
+++ b/src/arch/dadao/faults.cc
@@ -1,4 +1,6 @@
 #include "arch/dadao/faults.hh"
+
+#include "arch/dadao/isa.hh"
 #include "cpu/thread_context.hh"
 #include "sim/sim_exit.hh"
 
@@ -16,5 +18,24 @@ DADAOFault::invoke(ThreadContext *tc, const StaticInstPtr &inst)
     exitSimLoop(name_, code_);
 }
 
+void
+AsyncInterruptFault::invoke(ThreadContext *tc, const StaticInstPtr &inst)
+{
+    auto *isa = static_cast<ISA *>(tc->getIsaPtr());
+    uint64_t target = isa->cfxAsyncPendingTarget;
+    uint64_t cause = isa->cfxAsyncPendingCause;
+    isa->cfxAsyncPendingTarget = 0;
+    isa->cfxAsyncPendingCause = 0;
+    // cause_ip = the instruction about to be fetched (this method runs from
+    // BaseSimpleCPU::checkForInterrupts(), invoked before fetch, outside any
+    // instruction's own execute()/advancePC() pair -- so tc->pcState() is
+    // already exactly the wiki's "next instruction" address for an async
+    // cause, and no post-execute PC-advance compensation is needed
+    // (stageSequentialAdvance=false), matching the PTW/TLB fault call site's
+    // reasoning in tlb.cc.
+    isa->cfxDispatch(tc, target, cause, 0, tc->pcState().instAddr(), false,
+                     false);
+}
+
 } // namespace DADAOISA
 } // namespace gem5
diff --git a/src/arch/dadao/faults.hh b/src/arch/dadao/faults.hh
index 9c3d79cf8d..1ca1214f45 100644
--- a/src/arch/dadao/faults.hh
+++ b/src/arch/dadao/faults.hh
@@ -92,6 +92,22 @@ class CfxregFault : public DADAOFault
     CfxregFault() : DADAOFault("CFXREG", 0x86) {}
 };
 
+// KL-131a: delivered asynchronous cfx interrupt. Unlike every other fault in
+// this file, invoke() does NOT exit the sim loop -- it calls back into
+// ISA::cfxDispatch() (via the ISA::cfxAsyncPendingTarget/Cause scratch pair
+// Interrupts::getInterrupt() already populated) to perform the real SEE §5
+// steps 2-6+7-10 entry, then returns normally so the CPU model resumes
+// fetch at the vector. Mirrors QEMU's EXCP_CFX_ASYNC (cpu.h/cpu.c) --
+// distinct exception_index there, distinct Fault subclass here, same
+// architectural effect either way.
+class AsyncInterruptFault : public DADAOFault
+{
+  public:
+    AsyncInterruptFault() : DADAOFault("cfx_async_interrupt", 0) {}
+    void invoke(ThreadContext *tc, const StaticInstPtr &inst =
+                nullStaticInstPtr) override;
+};
+
 // Sentinel for opcodes DADAO gem5 has not implemented yet (register-bank block
 // copy was G2; now implemented — this remains for any future gap). NOT an
 // architectural fault — its private exit code lets the adapter report
