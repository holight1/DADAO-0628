diff --git a/src/arch/dadao/DADAOBareMetal.py b/src/arch/dadao/DADAOBareMetal.py
new file mode 100644
index 0000000000..f0d23e11cf
--- /dev/null
+++ b/src/arch/dadao/DADAOBareMetal.py
@@ -0,0 +1,11 @@
+from m5.objects.Workload import Workload
+from m5.params import Param
+
+
+class DADAOBareMetal(Workload):
+    type = "DADAOBareMetal"
+    cxx_class = "gem5::DADAOISA::BareMetal"
+    cxx_header = "arch/dadao/bare_metal.hh"
+
+    image = Param.String("Raw bare-metal image")
+    load_addr = Param.Addr(0x00100000, "Raw image load and reset address")
diff --git a/src/arch/dadao/SConscript b/src/arch/dadao/SConscript
index f00fc8af40..7c42a6d431 100644
--- a/src/arch/dadao/SConscript
+++ b/src/arch/dadao/SConscript
@@ -8,6 +8,7 @@ env.TagImplies('dadao isa', 'gem5 lib')
 env.TagImplies('isa', 'dadao isa')
 
 Source('decoder.cc', tags=['dadao isa'])
+Source('bare_metal.cc', tags=['dadao isa'])
 Source('faults.cc', tags=['dadao isa'])
 Source('interrupts.cc', tags=['dadao isa'])
 Source('isa.cc', tags=['dadao isa'])
@@ -17,6 +18,8 @@ Source('system.cc', tags=['dadao isa'])
 Source('tlb.cc', tags=['dadao isa'])
 
 SimObject('DADAOCPU.py', sim_objects=[], tags=['dadao isa'])
+SimObject('DADAOBareMetal.py', sim_objects=['DADAOBareMetal'],
+          tags=['dadao isa'])
 SimObject('DADAODecoder.py', sim_objects=['DADAODecoder'], tags=['dadao isa'])
