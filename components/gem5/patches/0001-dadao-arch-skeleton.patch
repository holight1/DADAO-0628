+
+#include <cstdint>
+
+#include "cpu/reg_class.hh"
+#include "debug/FloatRegs.hh"
+#include "debug/IntRegs.hh"
+#include "debug/MiscRegs.hh"
+
+namespace gem5
+{
+namespace DADAOISA
+{
+
+// Skeleton register counts. The DADAO register model is fleshed out later.
+constexpr unsigned NumIntRegs = 64;
+constexpr unsigned NumFloatRegs = 64;
+constexpr unsigned NumMiscRegs = 1;
+
+using IntReg = int64_t;
+using FloatReg = uint64_t;
+
+// Scalar register classes provided by the DADAO ISA.
+inline constexpr RegClass intRegClass(IntRegClass, IntRegClassName,
+        NumIntRegs, debug::IntRegs);
+inline constexpr RegClass floatRegClass(FloatRegClass, FloatRegClassName,
+        NumFloatRegs, debug::FloatRegs);
+inline constexpr RegClass miscRegClass(MiscRegClass, MiscRegClassName,
+        NumMiscRegs, debug::MiscRegs);
+
+// ABI register ids used by the process/syscall skeleton. These indices are
+// placeholders for the DADAO calling convention; for the buildable skeleton
+// they only need to be internally consistent.
+inline constexpr RegId
+    ZeroReg = intRegClass[0],
+    ReturnAddrReg = intRegClass[1],
+    StackPointerReg = intRegClass[2],
+    ReturnValueReg = intRegClass[3],
+    SyscallNumReg = intRegClass[10];
+
+} // namespace DADAOISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_REGISTERS_HH__
