+#ifndef __ARCH_DADAO_DECODER_HH__
+#define __ARCH_DADAO_DECODER_HH__
+
+#include "arch/dadao/types.hh"
+#include "arch/generic/decoder.hh"
+#include "cpu/static_inst.hh"
+#include "params/DADAODecoder.hh"
+
+namespace gem5
+{
+namespace DADAOISA
+{
+
+class Decoder : public InstDecoder
+{
+  private:
+    uint32_t machInst;
+
+  public:
+    Decoder(const DADAODecoderParams &p) : InstDecoder(p, &machInst)
+    {
+        reset();
+    }
+
+    void
+    reset() override
+    {
+        InstDecoder::reset();
+        machInst = 0;
+    }
+
+    StaticInstPtr decode(DADAOInst inst);
+
+    // Fixed-length 4-byte instructions: one moreBytes() call fully feeds the
+    // decoder. The raw bytes have already been written to machInst via the
+    // moreBytesPtr the CPU obtained from the base InstDecoder.
+    void
+    moreBytes(const PCStateBase &pc, Addr fetchPC) override
+    {
+        instDone = true;
+        outOfBytes = false;
+    }
+
+    StaticInstPtr
+    decode(PCStateBase &nextPC) override
+    {
+        if (!instDone)
+            return nullptr;
+        instDone = false;
+        return decode(DADAOInst(machInst));
+    }
+};
+
+} // namespace DADAOISA
+} // namespace gem5
+
+#endif // __ARCH_DADAO_DECODER_HH__
