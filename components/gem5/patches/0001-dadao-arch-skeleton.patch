@@ -0,0 +1,58 @@
+"""Minimal DADAO syscall-emulation (SE) smoke config for the buildable skeleton.
+
+Instantiates a DADAO TimingSimpleCPU, loads a DADAO ELF via the SEWorkload /
+Process loader path, and runs. Because the DADAO decoder is a skeleton that maps
+every instruction to a placeholder Noop raising DADAOSyscallFault (which exits
+the sim loop), the CPU fetches/decodes/executes exactly one instruction and the
+simulation terminates cleanly.
+
+Usage:
+    build/DADAO/gem5.opt tests/dadao/dadao_se.py [path/to/dadao.elf]
+If no binary is given, tests/dadao/min.elf (produced by gen_min_elf.py) is used.
+"""
+import os
+import sys
+
+import m5
+from m5.objects import *
+
+thispath = os.path.dirname(os.path.realpath(__file__))
+binary = sys.argv[1] if len(sys.argv) > 1 else os.path.join(thispath, "min.elf")
+
+system = System()
+
+system.clk_domain = SrcClockDomain()
+system.clk_domain.clock = "1GHz"
+system.clk_domain.voltage_domain = VoltageDomain()
+
+system.mem_mode = "timing"
+system.mem_ranges = [AddrRange("512MiB")]
+system.cpu = DADAOTimingSimpleCPU()
+
+system.membus = SystemXBar()
+
+system.cpu.icache_port = system.membus.cpu_side_ports
+system.cpu.dcache_port = system.membus.cpu_side_ports
+
+system.cpu.createInterruptController()
+
+system.mem_ctrl = MemCtrl()
+system.mem_ctrl.dram = DDR3_1600_8x8()
+system.mem_ctrl.dram.range = system.mem_ranges[0]
+system.mem_ctrl.port = system.membus.mem_side_ports
+
+system.system_port = system.membus.cpu_side_ports
+
+system.workload = SEWorkload.init_compatible(binary)
+
+process = Process()
+process.cmd = [binary]
+system.cpu.workload = process
+system.cpu.createThreads()
+
+root = Root(full_system=False, system=system)
+m5.instantiate()
+
+print("Beginning DADAO SE simulation!")
+exit_event = m5.simulate()
+print(f"Exiting @ tick {m5.curTick()} because {exit_event.getCause()}")
diff --git a/tests/dadao/gen_min_elf.py b/tests/dadao/gen_min_elf.py
new file mode 100644
index 0000000000..ca2c55642e
--- /dev/null
+++ b/tests/dadao/gen_min_elf.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Emit a minimal statically-linked DADAO ELF executable for the gem5 skeleton.
+
+The DADAO buildable skeleton decodes every instruction to a placeholder Noop
+that raises DADAOSyscallFault (which exits the sim loop), so the actual segment
+bytes are irrelevant -- we only need a well-formed ELF that gem5's SE loader
+recognises as arch "dadao" (e_machine 0xda0, ELFCLASS64, big-endian) with one
+PT_LOAD segment and an entry point inside it.
+
+Usage: gen_min_elf.py <output-path>
+"""
+import struct
+import sys
+
+EM_DADAO = 0x0DA0
+ENTRY = 0x100000
+SEG_OFF = 0x1000
+SEG_SIZE = 16
+PAGE = 0x1000
+
+
+def main(out_path):
+    # 64-bit, big-endian ELF fields (">").
+    e_ident = bytes([0x7F, ord("E"), ord("L"), ord("F"),
+                     2,   # EI_CLASS = ELFCLASS64
+                     2,   # EI_DATA  = ELFDATA2MSB (big-endian)
+                     1,   # EI_VERSION
+                     0,   # EI_OSABI
+                     0]) + b"\x00" * 7  # EI_ABIVERSION + padding -> 16 bytes
+
+    ehdr = e_ident + struct.pack(
+        ">HHIQQQIHHHHHH",
+        2,          # e_type    = ET_EXEC
+        EM_DADAO,   # e_machine
+        1,          # e_version
+        ENTRY,      # e_entry
+        64,         # e_phoff
+        0,          # e_shoff
+        0,          # e_flags
+        64,         # e_ehsize
+        56,         # e_phentsize
+        1,          # e_phnum
+        0,          # e_shentsize
+        0,          # e_shnum
+        0,          # e_shstrndx
+    )
+
+    phdr = struct.pack(
+        ">IIQQQQQQ",
+        1,          # p_type  = PT_LOAD
+        5,          # p_flags = R + X
+        SEG_OFF,    # p_offset
+        ENTRY,      # p_vaddr
+        ENTRY,      # p_paddr
+        SEG_SIZE,   # p_filesz
+        SEG_SIZE,   # p_memsz
+        PAGE,       # p_align
+    )
+
+    data = bytearray()
+    data += ehdr
+    data += phdr
+    data += b"\x00" * (SEG_OFF - len(data))   # pad to segment file offset
+    data += b"\x00" * SEG_SIZE                # placeholder code (decodes to Noop)
+
+    with open(out_path, "wb") as f:
+        f.write(data)
+    print(f"wrote {out_path} ({len(data)} bytes), e_machine=0x{EM_DADAO:x}, "
+          f"entry=0x{ENTRY:x}")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        sys.exit(__doc__)
+    main(sys.argv[1])
