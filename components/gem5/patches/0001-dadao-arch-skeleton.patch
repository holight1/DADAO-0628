index 0000000000..a0d6d49216
--- /dev/null
+++ b/src/arch/dadao/decoder.cc
@@ -0,0 +1,49 @@
+#include "arch/dadao/decoder.hh"
+
+#include "arch/dadao/faults.hh"
+#include "arch/dadao/pcstate.hh"
+#include "cpu/exec_context.hh"
+#include "cpu/static_inst.hh"
+
+namespace gem5
+{
+namespace DADAOISA
+{
+
+// Placeholder instruction used by the buildable skeleton. It carries no DADAO
+// semantics: executing it raises a DADAOSyscallFault, whose invoke() exits the
+// simulation loop. This lets the CPU model fetch/decode/execute a single
+// instruction and terminate cleanly before any real ISA is implemented.
+class DADAONoopInst : public StaticInst
+{
+  public:
+    DADAONoopInst() : StaticInst("noop", enums::No_OpClass) {}
+
+    Fault
+    execute(ExecContext *xc, trace::InstRecord *trace) const override
+    {
+        return std::make_shared<DADAOSyscallFault>();
+    }
+
+    std::string
+    generateDisassembly(Addr pc,
+                        const loader::SymbolTable *symtab) const override
+    {
+        return "noop";
+    }
+
+    void
+    advancePC(PCStateBase &pc_state) const override
+    {
+        pc_state.as<PCState>().advance();
+    }
+};
+
+StaticInstPtr
+Decoder::decode(DADAOInst inst)
+{
+    return StaticInstPtr(new DADAONoopInst());
+}
+
+} // namespace DADAOISA
+} // namespace gem5
