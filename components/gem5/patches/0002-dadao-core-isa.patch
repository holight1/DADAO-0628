@@ -1,49 +1,181 @@
-#include "arch/dadao/decoder.hh"
+// DG-002a G1: halt, addi (RD), add (rrrr), jump (iiii)
+// Encoding from DADAO-0628 tools/opcodes.yaml + contracts/isa/spec.md
+// Gem5 v25 pattern: member RegId arrays + reinterpret_cast per RISC-V zcmt.cc
 
+#include "arch/dadao/decoder.hh"
 #include "arch/dadao/faults.hh"
 #include "arch/dadao/pcstate.hh"
+#include "arch/dadao/registers.hh"
 #include "cpu/exec_context.hh"
 #include "cpu/static_inst.hh"
+#include "sim/sim_exit.hh"
 
-namespace gem5
-{
-namespace DADAOISA
-{
-
-// Placeholder instruction used by the buildable skeleton. It carries no DADAO
-// semantics: executing it raises a DADAOSyscallFault, whose invoke() exits the
-// simulation loop. This lets the CPU model fetch/decode/execute a single
-// instruction and terminate cleanly before any real ISA is implemented.
-class DADAONoopInst : public StaticInst
-{
-  public:
-    DADAONoopInst() : StaticInst("noop", enums::No_OpClass) {}
-
-    Fault
-    execute(ExecContext *xc, trace::InstRecord *trace) const override
-    {
-        return std::make_shared<DADAOSyscallFault>();
+namespace gem5 { namespace DADAOISA {
+
+static inline uint8_t ha(uint32_t w) { return (w >> 18) & 0x3F; }
+static inline uint8_t hb(uint32_t w) { return (w >> 12) & 0x3F; }
+static inline uint8_t hc(uint32_t w) { return (w >> 6)  & 0x3F; }
+static inline uint8_t hd(uint32_t w) { return w & 0x3F; }
+static inline int64_t imm12s(uint32_t w) {
+    int64_t v = w & 0xFFF;
+    return (v & 0x800) ? (v | 0xFFFFFFFFFFFFF000ULL) : v;
+}
+static inline int64_t imm24s(uint32_t w) {
+    int64_t v = w & 0xFFFFFF;
+    return (v & 0x800000) ? (v | 0xFFFFFFFFFF000000ULL) : v;
+}
+
+// === halt (op=0x00, riii): exitSimLoop with rd[ha], spec 3.1 ===
+class HaltInst : public StaticInst {
+    RegId srcRegIdxArr[1];
+    RegId destRegIdxArr[0];
+public:
+    HaltInst(uint8_t rd) : StaticInst("halt", enums::No_OpClass) {
+        setRegIdxArrays(
+            reinterpret_cast<RegIdArrayPtr>(
+                &std::remove_pointer_t<decltype(this)>::srcRegIdxArr),
+            reinterpret_cast<RegIdArrayPtr>(
+                &std::remove_pointer_t<decltype(this)>::destRegIdxArr));
+        if (rd != 0) {
+            setSrcRegIdx(_numSrcRegs++, intRegId(rd));
+        }
     }
+    Fault execute(ExecContext *xc, trace::InstRecord *t) const override {
+        RegVal code = (_numSrcRegs > 0) ? xc->getRegOperand(this, 0) : 0;
+        exitSimLoop("halt", code & 0xFF);
+        return NoFault;
+    }
+    std::string generateDisassembly(Addr pc, const loader::SymbolTable *s) const override {
+        return "halt";
+    }
+    void advancePC(PCStateBase &pc) const override { pc.as<PCState>().advance(); }
+};
 
-    std::string
-    generateDisassembly(Addr pc,
-                        const loader::SymbolTable *symtab) const override
-    {
-        return "noop";
+// === addi (op=0x19, rrii): rd[ha] = rd[hb] + sext(imm12), spec 3.6 ===
+class AddiInst : public StaticInst {
+    RegId srcRegIdxArr[1];
+    RegId destRegIdxArr[1];
+    int64_t imm_;
+public:
+    AddiInst(uint8_t dst, uint8_t src, int64_t i)
+        : StaticInst("addi", enums::No_OpClass), imm_(i) {
+        setRegIdxArrays(
+            reinterpret_cast<RegIdArrayPtr>(
+                &std::remove_pointer_t<decltype(this)>::srcRegIdxArr),
+            reinterpret_cast<RegIdArrayPtr>(
+                &std::remove_pointer_t<decltype(this)>::destRegIdxArr));
+        if (src != 0) {
+            setSrcRegIdx(_numSrcRegs++, intRegId(src));
+        }
+        if (dst != 0) {
+            setDestRegIdx(_numDestRegs++, intRegId(dst));
+        }
+    }
+    Fault execute(ExecContext *xc, trace::InstRecord *t) const override {
+        RegVal s = (_numSrcRegs > 0) ? xc->getRegOperand(this, 0) : 0;
+        if (_numDestRegs > 0) {
+            xc->setRegOperand(this, 0, s + imm_);
+        }
+        return NoFault;
     }
+    std::string generateDisassembly(Addr pc, const loader::SymbolTable *s) const override {
+        return "addi";
+    }
+    void advancePC(PCStateBase &pc) const override { pc.as<PCState>().advance(); }
+};
 
-    void
-    advancePC(PCStateBase &pc_state) const override
-    {
-        pc_state.as<PCState>().advance();
+// === add (op=0x1A, rrrr): rd[hb]=lo, rd[ha]=hi, spec 3.5 ===
+class AddInst : public StaticInst {
+    RegId srcRegIdxArr[2];
+    RegId destRegIdxArr[2];
+public:
+    AddInst(uint8_t hi, uint8_t lo, uint8_t s1, uint8_t s2)
+        : StaticInst("add", enums::No_OpClass) {
+        setRegIdxArrays(
+            reinterpret_cast<RegIdArrayPtr>(
+                &std::remove_pointer_t<decltype(this)>::srcRegIdxArr),
+            reinterpret_cast<RegIdArrayPtr>(
+                &std::remove_pointer_t<decltype(this)>::destRegIdxArr));
+        setSrcRegIdx(_numSrcRegs++, intRegId(s1));
+        setSrcRegIdx(_numSrcRegs++, intRegId(s2));
+        if (lo != 0) { setDestRegIdx(_numDestRegs++, intRegId(lo)); }
+        if (hi != 0) { setDestRegIdx(_numDestRegs++, intRegId(hi)); }
+    }
+    Fault execute(ExecContext *xc, trace::InstRecord *t) const override {
+        // spec §3.5: rdha:rdhb = rdhc + rdhd, sign-extended to 128 bits.
+        // srcs are dest-order: operand 0 = rdhb (low), operand 1 = rdha (high).
+        __int128 a = (int64_t)xc->getRegOperand(this, 0);
+        __int128 b = (int64_t)xc->getRegOperand(this, 1);
+        __int128 r = a + b;
+        uint64_t lo = (uint64_t)r;
+        uint64_t hi = (uint64_t)(r >> 64);
+        if (_numDestRegs >= 1) { xc->setRegOperand(this, 0, lo); } // rdhb
+        if (_numDestRegs >= 2) { xc->setRegOperand(this, 1, hi); } // rdha
+        return NoFault;
     }
+    std::string generateDisassembly(Addr pc, const loader::SymbolTable *s) const override {
+        return "add";
+    }
+    void advancePC(PCStateBase &pc) const override { pc.as<PCState>().advance(); }
 };
 
-StaticInstPtr
-Decoder::decode(DADAOInst inst)
-{
-    return StaticInstPtr(new DADAONoopInst());
+// === jump (op=0x64, iiii): PC = (PC) + sext(imm24)<<2, spec 5.3 ===
+class JumpIIIIInst : public StaticInst {
+    RegId srcRegIdxArr[0];
+    RegId destRegIdxArr[0];
+    int64_t imm_;
+public:
+    JumpIIIIInst(int64_t i) : StaticInst("jump", enums::No_OpClass), imm_(i) {
+        setRegIdxArrays(
+            reinterpret_cast<RegIdArrayPtr>(
+                &std::remove_pointer_t<decltype(this)>::srcRegIdxArr),
+            reinterpret_cast<RegIdArrayPtr>(
+                &std::remove_pointer_t<decltype(this)>::destRegIdxArr));
+    }
+    Fault execute(ExecContext *xc, trace::InstRecord *t) const override {
+        // spec §5.3 + §1.3: PC_next = rb0 + (sext24(imm) << 2), where rb0 is
+        // the hardware base = current_PC + 4 (address of the next instruction).
+        PCState pc = xc->pcState().as<PCState>();
+        pc.set(pc.instAddr() + 4 + (imm_ << 2));
+        xc->pcState(pc);
+        return NoFault;
+    }
+    std::string generateDisassembly(Addr pc, const loader::SymbolTable *s) const override {
+        return csprintf("jump %d", (int)imm_);
+    }
+    void advancePC(PCStateBase &pc) const override {}
+};
+
+// === unknown -> fault ===
+class UnknownInst : public StaticInst {
+    RegId srcRegIdxArr[0];
+    RegId destRegIdxArr[0];
+public:
+    UnknownInst() : StaticInst("unknown", enums::No_OpClass) {
+        setRegIdxArrays(
+            reinterpret_cast<RegIdArrayPtr>(
+                &std::remove_pointer_t<decltype(this)>::srcRegIdxArr),
+            reinterpret_cast<RegIdArrayPtr>(
+                &std::remove_pointer_t<decltype(this)>::destRegIdxArr));
+    }
+    Fault execute(ExecContext *xc, trace::InstRecord *t) const override {
+        return std::make_shared<DADAOSyscallFault>();
+    }
+    std::string generateDisassembly(Addr pc, const loader::SymbolTable *s) const override {
+        return "unknown";
+    }
+    void advancePC(PCStateBase &pc) const override { pc.as<PCState>().advance(); }
+};
+
+StaticInstPtr Decoder::decode(DADAOInst inst) {
+    uint32_t w = inst.inst;
+    switch (w >> 24) {
+    case 0x00: return StaticInstPtr(new HaltInst(ha(w)));
+    case 0x19: return StaticInstPtr(new AddiInst(ha(w), hb(w), imm12s(w)));
+    case 0x1A: return StaticInstPtr(new AddInst(ha(w), hb(w), hc(w), hd(w)));
+    case 0x64: return StaticInstPtr(new JumpIIIIInst(imm24s(w)));
+    default:   return StaticInstPtr(new UnknownInst());
+    }
 }
 
-} // namespace DADAOISA
-} // namespace gem5
+} }
