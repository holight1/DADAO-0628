     default: break;
     }
-  } else if (cfxcode_ == CfxCodeSmon && cg_ == 5) {
-    switch (rc_) {
-    case 0: value = isa->cfxSmonFrame.prevRunMode; break;
-    case 1: value = isa->cfxSmonFrame.prevCfxMask; break;
-    case 2: value = isa->cfxSmonFrame.causeId; break;
-    case 3: value = isa->cfxSmonFrame.causeIp; break;
-    case 4: value = isa->cfxSmonFrame.causeInfo; break;
-    case 5: value = isa->cfxSmonFrame.prevCfxCode; break;
-    default: break;
-    }
-  } else if (cfxcode_ == CfxCodeSmon && cg_ == 2 && rc_ == 10) {
-    value = isa->cfxSmonSupvExcpVector;
+  } else if (cg_ == 2 && rc_ == 10) {
+    value = isa->cfxSupvExcpVector[cfxcode_];
   } else if (cg_ <= 3 && rc_ == CfxMaskRegEscape) {
     value = isa->cfxEscapeCfxMask[cfxcode_][cg_];
   }
@@ -1076,34 +1077,17 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
     uint64_t mask = isa->cfxEscapeCfxMask[isa->innerCfxCode][(int)isa->innerRunMode];
     if ((mask >> cfxcode_) & 1) RET_ILLI;
   }
-  // KL-117a adds cfx_smon's hardware-written frame alongside cfx_power's
