--- a/src/arch/dadao/decoder.cc
+++ b/src/arch/dadao/decoder.cc
@@ -700,6 +700,55 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
   if(_numDestRegs) xc->setRegOperand(this,0,(a<b)?-1ULL:(a>b)?1ULL:0); return NoFault; }
 std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"cmp.rb";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
 
+static inline ISA *
+cfxIsa(ExecContext *xc)
+{
+  return static_cast<ISA *>(xc->tcBase()->getIsaPtr());
+}
+
+// KL-122a shared SEE §5 steps 7-10 carrier for non-maskable synchronous
+// causes. Source routing and mask/pending/priority remain later tasks.
+static void
+cfxPreciseTrapEnter(ExecContext *xc, uint8_t targetCfxCode,
+                    uint64_t causeId, uint32_t rawInsn)
+{
+  ISA *isa = cfxIsa(xc);
+  targetCfxCode &= 0x3F;
+  CfxFrame &frame = isa->cfxFrame[targetCfxCode];
+  PCState pc = xc->pcState().as<PCState>();
+  uint64_t causeIp = pc.instAddr();
+  RunMode modeBefore = isa->innerRunMode;
+
+  frame.prevRunMode = isa->innerRunMode;
+  frame.prevCfxMask = isa->innerCfxMask;
+  frame.prevCfxCode = isa->innerCfxCode;
+  isa->innerRunMode = RunModeSupv;
+  isa->innerCfxMask = ~0ULL;
+  isa->innerCfxCode = targetCfxCode;
+  frame.causeId = causeId;
+  frame.causeIp = causeIp;
+  frame.causeInfo = rawInsn;
+  uint64_t target = isa->cfxSupvExcpVector[targetCfxCode] & MASK48;
+
+  // Preserve TrapInst's sequential advancePC() contract by staging the
+  // vector as NPC; this is required by the O3 simple/front-end behavior.
+  pc.set(target);
+  pc.pc(target - 4);
+  pc.npc(target);
+  xc->pcState(pc);
+
+  // Keep KL-117a's established O3 trace byte-for-byte stable.
+  if (targetCfxCode == CfxCodeSmon && causeId == CfxCauseCfxtrap) {
+    std::cerr << "dadao: trap cfx_smon mode " << (int)modeBefore
+              << "->" << (int)isa->innerRunMode
+              << " inner_cfx_code=" << (unsigned)isa->innerCfxCode
+              << " cause_id=0x" << std::hex << frame.causeId
+              << " cause_ip=0x" << causeIp
+              << " cause_info=0x" << frame.causeInfo
+              << " vector=0x" << target << std::dec << "\n";
+  }
+}
+
 // === trap (ciii, op=0x76, spec §系统类指令): cfx_smon(cfxcode=2) responder ===
 class TrapInst : public StaticInst { RegId srcRegs[0], dstRegs[0];
   uint8_t cfxcode; uint32_t rawInsn; public:
@@ -707,36 +756,10 @@ TrapInst(uint32_t w)
   : StaticInst("trap", enums::No_OpClass), cfxcode(ha(w)), rawInsn(w) {
   setRegIdxArrays(reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::srcRegs), reinterpret_cast<RegIdArrayPtr>(&std::remove_pointer_t<decltype(this)>::dstRegs)); }
 Fault execute(ExecContext *xc, trace::InstRecord*) const override {
-  ISA *isa = static_cast<ISA *>(xc->tcBase()->getIsaPtr());
+  ISA *isa = cfxIsa(xc);
   if (cfxcode == CfxCodeSmon && isa->cfxSmonReal) {
-    PCState pc = xc->pcState().as<PCState>();
-    uint64_t causeIp = pc.instAddr();
-    RunMode modeBefore = isa->innerRunMode;
-    isa->cfxSmonFrame.prevRunMode = isa->innerRunMode;
-    isa->cfxSmonFrame.prevCfxMask = isa->innerCfxMask;
-    isa->cfxSmonFrame.prevCfxCode = isa->innerCfxCode;
-    isa->innerRunMode = RunModeSupv;
-    isa->innerCfxMask = ~0ULL;
-    isa->innerCfxCode = CfxCodeSmon;
-    isa->cfxSmonFrame.causeId = CfxCauseCfxtrap;
-    isa->cfxSmonFrame.causeIp = causeIp;
-    isa->cfxSmonFrame.causeInfo = rawInsn;
-    uint64_t target = isa->cfxSmonSupvExcpVector & MASK48;
-    // Keep TrapInst's pre-existing sequential advancePC() contract so the
-    // default-off path remains valid for both simple and O3 front ends. For
-    // real entry, make the generic advance land exactly at the vector by
-    // staging target as NPC (including the target==0 wraparound case).
-    pc.set(target);
-    pc.pc(target - 4);
-    pc.npc(target);
-    xc->pcState(pc);
-    std::cerr << "dadao: trap cfx_smon mode " << (int)modeBefore
-              << "->" << (int)isa->innerRunMode
-              << " inner_cfx_code=" << (unsigned)isa->innerCfxCode
-              << " cause_id=0x" << std::hex << isa->cfxSmonFrame.causeId
-              << " cause_ip=0x" << causeIp
-              << " cause_info=0x" << isa->cfxSmonFrame.causeInfo
-              << " vector=0x" << target << std::dec << "\n";
+    cfxPreciseTrapEnter(
+        xc, CfxCodeSmon, CfxCauseCfxtrap, rawInsn);
     return NoFault;
   }
   if (cfxcode == 2) {
@@ -900,10 +923,6 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
 }
 std::string generateDisassembly(Addr,const loader::SymbolTable*)const override{return"trap";} void advancePC(PCStateBase&p)const override{p.uReset();p.advance();}};
 
