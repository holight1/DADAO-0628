-    case 1: isa->cfxSmonFrame.prevCfxMask = value; return NoFault;
-    case 3: isa->cfxSmonFrame.causeIp = value & MASK48; return NoFault;
-    case 5: isa->cfxSmonFrame.prevCfxCode = value & 0x3F; return NoFault;
+    case 0: isa->cfxFrame[cfxcode_].prevRunMode = value & 0x3; return NoFault;
+    case 1: isa->cfxFrame[cfxcode_].prevCfxMask = value; return NoFault;
+    case 3: isa->cfxFrame[cfxcode_].causeIp = value & MASK48; return NoFault;
+    case 5: isa->cfxFrame[cfxcode_].prevCfxCode = value & 0x3F; return NoFault;
     default: return NoFault;
     }
   }
@@ -1020,26 +1029,18 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
   } else if (cg_ == CfxCommonPendingCg && rc_ == CfxCommonPendingRc) {
     value = isa->cfxCommonPending[cfxcode_] &
       cfxCommonPendingMask(cfxcode_);
-  } else if (cfxcode_ == CfxCodePower && cg_ == 5) {
+  } else if (cg_ == 5) {
     switch (rc_) {
-    case 0: value = isa->cfxPowerFrame.prevRunMode; break;
-    case 1: value = isa->cfxPowerFrame.prevCfxMask; break;
-    case 3: value = isa->cfxPowerFrame.causeIp; break;
-    case 5: value = isa->cfxPowerFrame.prevCfxCode; break;
+    case 0: value = isa->cfxFrame[cfxcode_].prevRunMode; break;
+    case 1: value = isa->cfxFrame[cfxcode_].prevCfxMask; break;
