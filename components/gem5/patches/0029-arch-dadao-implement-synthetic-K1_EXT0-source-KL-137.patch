+    const bool k1Ext0TestEnable;
+    const uint64_t k1Ext0AssertRetired;
+    const uint64_t k1Ext0DeassertRetired;
 
     // KL-113a/KL-117a CFX privilege state. Plain ISA-class members rather than
     // miscRegFile entries: miscRegFile (std::vector<RegVal>, NumMiscRegs=1)
@@ -262,6 +275,8 @@ class ISA : public BaseISA
     uint64_t cfxTimerReg0 = 0;
     uint64_t cfxTimerReloadLatch = 0;
     bool cfxTimerArmPending = false;
+    // KL-137a: cfx_uart cg8/rc0 private source latch; K1 implements bit0.
+    uint64_t cfxUartPending = 0;
     // KL-126a: cfx_ptw private storage. PTBR stores PA[63:16], while PTHI
     // and PAHI provide the distinct high 16 bits for page-table structures
     // and final data addresses respectively.
@@ -316,10 +331,10 @@ class ISA : public BaseISA
                      uint64_t causeInfo, Addr causeIp, bool isSync,
                      bool stageSequentialAdvance);
     bool cfxCauseEligible(uint64_t targetCfx, uint64_t cause) const;
