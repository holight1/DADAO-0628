From c82f1b35fc3aa776520b6fcc1789664935421d89 Mon Sep 17 00:00:00 2001
From: suiyan <suiyan@sunmmio.com>
Date: Tue, 28 Jul 2026 18:01:52 +0800
Subject: [PATCH 29/29] arch/dadao: implement synthetic K1_EXT0 source
 (KL-137a)

Add the cfx_uart source0 private pending/exist pair and route the test-machine-only K1_EXT0 level through UART0 common pending and the existing asynchronous dispatcher. Use default-off retired-instruction schedule Params in the FullSystem harness so assert/deassert, relatch, acknowledgement, and cross-CFX priority can be tested without a guest-visible device ABI.
---
 src/arch/dadao/DADAOISA.py |  9 +++++++++
 src/arch/dadao/decoder.cc  | 19 +++++++++++++++++++
 src/arch/dadao/isa.cc      | 34 ++++++++++++++++++++++++++--------
 src/arch/dadao/isa.hh      | 23 +++++++++++++++++++----
 tests/dadao/dadao_fs.py    | 12 ++++++++++++
 5 files changed, 85 insertions(+), 12 deletions(-)

diff --git a/src/arch/dadao/DADAOISA.py b/src/arch/dadao/DADAOISA.py
index 66550180f5..6687f7c129 100644
--- a/src/arch/dadao/DADAOISA.py
+++ b/src/arch/dadao/DADAOISA.py
@@ -23,3 +23,12 @@ class DADAOISA(BaseISA):
         0, "Test-only synthetic level source B target cfxcode")
     cfx_async_test_level_b_seed = Param.UInt64(
         0, "Test-only synthetic level source B cause mask; zero is disabled")
+    # KL-137a TEST-ONLY K1_EXT0 level schedule. These parameters are backend
+    # test infrastructure and do not create a guest-visible control ABI.
+    k1_ext0_test_enable = Param.Bool(
+        False, "Enable the test-only K1_EXT0 retirement schedule")
+    k1_ext0_assert_retired = Param.UInt64(
+        0, "Assert K1_EXT0 at this retired-instruction boundary")
+    k1_ext0_deassert_retired = Param.UInt64(
+        (1 << 64) - 1,
+        "Deassert K1_EXT0 at this retired-instruction boundary")
diff --git a/src/arch/dadao/decoder.cc b/src/arch/dadao/decoder.cc
index 796843f03c..282d74b9dd 100644
--- a/src/arch/dadao/decoder.cc
+++ b/src/arch/dadao/decoder.cc
@@ -1025,6 +1025,19 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
       break; // rc9-15 (counters1-7): K1 non-claim, silent no-op.
     }
   }
+  if (cfxcode_ == CfxCodeUart && cg_ == CfxUartCg) {
+    switch (rc_) {
+    case CfxUartPendingRc:
+      // W0C, only K1_EXT0/source0 is implemented.
+      isa->cfxUartPending &= value & 0x1ULL;
+      return NoFault;
+    case CfxUartExistRc:
+      // RO constant; writes are silent no-ops.
+      return NoFault;
+    default:
+      break; // No cg32-63 UART device-register protocol in K1.
+    }
+  }
   // SEE §3 cg2/rc10: per-cfx supervisor exception-vector address.
   if (cg_ == 2 && rc_ == 10) {
     isa->cfxSupvExcpVector[cfxcode_] = value & MASK48;
@@ -1149,6 +1162,12 @@ Fault execute(ExecContext *xc, trace::InstRecord*) const override {
     case CfxTimerReg0Rc: value = isa->cfxTimerReg0; break;
     default: break; // rc9-15: K1 non-claim, reads zero.
     }
+  } else if (cfxcode_ == CfxCodeUart && cg_ == CfxUartCg) {
+    switch (rc_) {
+    case CfxUartPendingRc: value = isa->cfxUartPending & 0x1ULL; break;
+    case CfxUartExistRc: value = 1; break;
+    default: break;
+    }
   } else if (cg_ == 2 && rc_ == 10) {
     value = isa->cfxSupvExcpVector[cfxcode_];
   } else if (cg_ <= 3 && rc_ == CfxMaskRegEscape) {
diff --git a/src/arch/dadao/isa.cc b/src/arch/dadao/isa.cc
