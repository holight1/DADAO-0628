+++ b/src/arch/dadao/isa.hh
@@ -40,6 +40,7 @@ constexpr uint8_t CfxCodeTlb = 5;
 // table].
 constexpr uint8_t CfxCodeHart = 15;
 constexpr uint8_t CfxCodeTimer = 18;
+constexpr uint8_t CfxCodeUart = 62;
 constexpr uint8_t CfxCodePower = 63;
 
 // cfx_smon's architecturally non-maskable CFXTRAP cause.
@@ -146,6 +147,12 @@ constexpr uint64_t CfxTimerCtrlPeriodic = 1ULL << 1;
 // cfx_timer's one maskable cause, TIMER (bit10) [wiki L600]. Matches
 // cfxCommonPendingMask()'s case 18 exactly.
 constexpr uint64_t CfxTimerCauseTimer = 1ULL << 10;
+// KL-137a: K1_EXT0 uses cfx_uart source0's private cg8 register pair and
+// UART0 common cause. No cg32-63 UART device registers/protocol are in K1.
+constexpr uint8_t CfxUartCg = 8;
+constexpr uint8_t CfxUartPendingRc = 0;
+constexpr uint8_t CfxUartExistRc = 1;
+constexpr uint64_t CfxUartCauseUart0 = 1ULL << 32;
 
 // KL-131a: the per-cfx set of causes that actually exist and may be latched
 // into cfxCommonPending. Defined in isa.cc; shared by decoder.cc's
@@ -214,6 +221,12 @@ class ISA : public BaseISA
     const uint64_t cfxAsyncTestLevelASeed;
     const uint8_t cfxAsyncTestLevelBCode;
     const uint64_t cfxAsyncTestLevelBSeed;
+    // KL-137a TEST-ONLY K1_EXT0 retirement schedule. Immutable backend
