+      cfxAsyncTestLevelBSeed(p.cfx_async_test_level_b_seed),
+      k1Ext0TestEnable(p.k1_ext0_test_enable),
+      k1Ext0AssertRetired(p.k1_ext0_assert_retired),
+      k1Ext0DeassertRetired(p.k1_ext0_deassert_retired)
 {
     _regClasses.push_back(&intRegClass);
     _regClasses.push_back(&floatRegClass);
@@ -164,6 +167,7 @@ ISA::clear()
     cfxTimerReg0 = 0;
     cfxTimerReloadLatch = 0;
     cfxTimerArmPending = false;
+    cfxUartPending = 0;
     cfxFrame[CfxCodePower].prevRunMode = RunModeHypv;
     cfxFrame[CfxCodePower].prevCfxMask = ~0ULL;
     cfxFrame[CfxCodePower].prevCfxCode = CfxCodePower;
@@ -533,11 +537,11 @@ ISA::cfxDispatch(ThreadContext *tc, uint64_t targetCfx, uint64_t cause,
     }
 }
 
-// KL-131a: re-latch the two test-only synthetic level sources (electrics,
-// wiki L656) and select the next async cause to deliver per contracts/isa/
-// spec.md §8.5.1: lowest pending eligible cfxcode first, then lowest set
-// eligible cause bit within that cfx. Mirrors QEMU's dadao_cfx_async_scan()
-// (cpu.c) exactly.
+// KL-131a/KL-137a: re-latch test-only level sources (electrics, wiki L656)
+// and private device-source latches, then select the next async cause per
+// contracts/isa/spec.md §8.5.1: lowest pending eligible cfxcode first, then
+// lowest set eligible cause bit within that cfx. Mirrors QEMU's
+// dadao_cfx_async_scan() (cpu.c) exactly.
 bool
 ISA::cfxAsyncScan(uint64_t &outTarget, uint64_t &outCause)
 {
@@ -564,6 +568,19 @@ ISA::cfxAsyncScan(uint64_t &outTarget, uint64_t &outCause)
         cfxCommonPending[CfxCodeTimer] |= CfxTimerCauseTimer;
     }
 
+    // KL-137a K1_EXT0: the immutable schedule drives only the test-machine
+    // electrical level. Assertion sets private source0; the private latch
+    // reconstructs common UART0 independently of the current level and all
+    // masks. Deasserting therefore never acknowledges architectural state.
+    if (k1Ext0TestEnable &&
+        cfxHartCycleLo >= k1Ext0AssertRetired &&
+        cfxHartCycleLo < k1Ext0DeassertRetired) {
+        cfxUartPending |= 0x1ULL;
+    }
+    if (cfxUartPending & 0x1ULL) {
+        cfxCommonPending[CfxCodeUart] |= CfxUartCauseUart0;
+    }
+
     if (cfxAsyncTestLevelASeed != 0) {
         uint64_t target = cfxAsyncTestLevelACode & 0x3F;
         cfxCommonPending[target] |=
@@ -660,6 +677,7 @@ ISA::copyRegsFrom(ThreadContext *src)
         cfxTimerReg0 = srcIsa->cfxTimerReg0;
         cfxTimerReloadLatch = srcIsa->cfxTimerReloadLatch;
         cfxTimerArmPending = srcIsa->cfxTimerArmPending;
+        cfxUartPending = srcIsa->cfxUartPending;
         for (int i = 0; i < 64; i++) {
             cfxHypvCgRegDeleg[i] = srcIsa->cfxHypvCgRegDeleg[i];
             cfxFrame[i] = srcIsa->cfxFrame[i];
diff --git a/src/arch/dadao/isa.hh b/src/arch/dadao/isa.hh
