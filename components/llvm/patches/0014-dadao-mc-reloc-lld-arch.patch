 };
 
 void DADAOMCCodeEmitter::encodeInstruction(
@@ -122,6 +126,24 @@ unsigned DADAOMCCodeEmitter::getImm12OpValue(
   return 0;
 }
 
+unsigned DADAOMCCodeEmitter::getRelaOpValue(
+    const MCInst &MI, unsigned OpNo,
+    SmallVectorImpl<MCFixup> &Fixups,
+    const MCSubtargetInfo &STI) const {
+  const MCOperand &MO = MI.getOperand(OpNo);
+  if (MO.isImm())
+    return static_cast<unsigned>(MO.getImm());
+
+  const MCExpr *Expr = MO.isExpr() ? MO.getExpr() : nullptr;
+  if (!Expr)
+    llvm_unreachable("getRelaOpValue expects expression or immediate");
+
+  MCFixup Fixup = MCFixup::create(0, Expr,
+                                   MCFixupKind(DADAO::fixup_dadao_rela_page));
+  Fixups.push_back(Fixup);
+  return 0;
+}
+
 unsigned DADAOMCCodeEmitter::getMachineOpValue(
     const MCInst &MI, const MCOperand &MO,
     SmallVectorImpl<MCFixup> &Fixups,
