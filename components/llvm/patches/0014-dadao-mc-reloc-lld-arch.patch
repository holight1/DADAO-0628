+
+#include "InputFiles.h"
+#include "Symbols.h"
+#include "SyntheticSections.h"
+#include "Target.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/Support/Endian.h"
+#include "llvm/Support/LEB128.h"
+
+using namespace llvm;
+using namespace llvm::object;
+using namespace llvm::ELF;
+using namespace llvm::support::endian;
+using namespace lld;
+using namespace lld::elf;
+
+namespace {
+
+enum {
+  R_DADAO_32 = 0,
+  R_DADAO_CALL24 = 1,
+  R_DADAO_BRANCH18 = 2,
+  R_DADAO_BRANCH12 = 3,
+  R_DADAO_RELA_PAGE = 4,
+  R_DADAO_RELA_LO = 5,
+  R_DADAO_NUM = 6,
+};
+
+class DADAO final : public TargetInfo {
+public:
+  DADAO(Ctx &ctx);
+  RelExpr getRelExpr(RelType type, const Symbol &s,
+                     const uint8_t *loc) const override;
+  void relocate(uint8_t *loc, const Relocation &rel,
+                uint64_t val) const override;
+};
+
+} // namespace
+
+DADAO::DADAO(Ctx &ctx) : TargetInfo(ctx) {
+  copyRel = R_DADAO_32;
+  gotRel = R_DADAO_32;
+  pltRel = R_DADAO_32;
+  relativeRel = R_DADAO_32;
+  symbolicRel = R_DADAO_32;
+
+  pltHeaderSize = 0;
+  pltEntrySize = 0;
+  ipltEntrySize = 0;
+
+  defaultMaxPageSize = 4096;
+  defaultCommonPageSize = 4096;
+}
+
+RelExpr DADAO::getRelExpr(RelType type, const Symbol &s,
+                          const uint8_t *loc) const {
+  switch (type) {
+  case R_DADAO_32:
+    return R_ABS;
+  case R_DADAO_CALL24:
+  case R_DADAO_BRANCH18:
+  case R_DADAO_BRANCH12:
+  case R_DADAO_RELA_PAGE:
+  case R_DADAO_RELA_LO:
+    return R_PC;
+  default:
+    Err(ctx) << getErrorLoc(loc) << "unknown relocation: " << type;
+    return R_NONE;
+  }
+}
+
+void DADAO::relocate(uint8_t *loc, const Relocation &rel,
+                     uint64_t val) const {
+  switch (rel.type) {
+  case R_DADAO_32:
+    write32be(loc, static_cast<uint32_t>(val));
+    return;
+
+  case R_DADAO_CALL24: {
+    int64_t imm = (static_cast<int64_t>(val) - 4) >> 2;
+    checkInt(ctx, loc, imm, 24, rel);
+    uint32_t mask = 0xFFFFFF;
+    uint32_t insn = read32be(loc);
+    write32be(loc, (insn & ~mask) | (static_cast<uint32_t>(imm) & mask));
+    return;
+  }
+
+  case R_DADAO_BRANCH18: {
+    int64_t imm = (static_cast<int64_t>(val) - 4) >> 2;
+    checkInt(ctx, loc, imm, 18, rel);
+    uint32_t mask = 0x3FFFF;
+    uint32_t insn = read32be(loc);
+    write32be(loc, (insn & ~mask) | (static_cast<uint32_t>(imm) & mask));
+    return;
+  }
+
+  case R_DADAO_BRANCH12: {
+    int64_t imm = (static_cast<int64_t>(val) - 4) >> 2;
+    checkInt(ctx, loc, imm, 12, rel);
+    uint32_t mask = 0xFFF;
+    uint32_t insn = read32be(loc);
+    write32be(loc, (insn & ~mask) | (static_cast<uint32_t>(imm) & mask));
+    return;
+  }
+
+  case R_DADAO_RELA_PAGE: {
+    int64_t page = (static_cast<int64_t>(val) + 0x800) >> 12;
+    checkInt(ctx, loc, page, 18, rel);
+    uint32_t mask = 0x3FFFF;
+    uint32_t insn = read32be(loc);
+    write32be(loc, (insn & ~mask) | (static_cast<uint32_t>(page) & mask));
+    return;
+  }
+
+  case R_DADAO_RELA_LO: {
+    int64_t lo = static_cast<int64_t>(val) & 0xFFF;
+    uint32_t mask = 0xFFF;
+    uint32_t insn = read32be(loc);
+    write32be(loc, (insn & ~mask) | (static_cast<uint32_t>(lo) & mask));
+    return;
+  }
+
+  default:
+    Err(ctx) << getErrorLoc(loc) << "unrecognized relocation " << rel.type;
+  }
+}
+
+TargetInfo *elf::getDADAOTargetInfo(Ctx &ctx) {
+  static DADAO t(ctx);
+  return &t;
+}
