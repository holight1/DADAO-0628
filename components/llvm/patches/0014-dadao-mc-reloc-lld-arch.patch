     }
 
     if (Kind == DADAO::fixup_dadao_rela_page) {
-      int64_t Target = static_cast<int64_t>(Value);
-      int64_t Page = Target & ~0xFFFULL;
-      int64_t Imm18 = Page >> 12;
+      if (!IsResolved) {
+        Value = 0;
+        maybeAddReloc(F, Fixup, Target, Value, IsResolved);
