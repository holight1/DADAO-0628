diff --git a/llvm/lib/Target/DADAO/DADAORegisterInfo.td b/llvm/lib/Target/DADAO/DADAORegisterInfo.td
new file mode 100644
index 000000000000..d570895f9330
--- /dev/null
+++ b/llvm/lib/Target/DADAO/DADAORegisterInfo.td
@@ -0,0 +1,71 @@
+//===- DADAORegisterInfo.td - DADAO Register definitions -----*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//  Declarations that describe the DADAO register file
+//===----------------------------------------------------------------------===//
+
+let Namespace = "DADAO" in {
+  class DADAOReg<bits<16> num, string n> : Register<n> {
+    let HWEncoding = num;
+  }
+}
+
+// RD bank: 64 data registers
+foreach i = 0-63 in {
+  def RD#i : DADAOReg<i, "rd"#i>;
+}
+
+// RB bank: 64 base registers
+foreach i = 0-63 in {
+  def RB#i : DADAOReg<i, "rb"#i>;
+}
+
+// RF bank: 64 float registers
+foreach i = 0-63 in {
+  def RF#i : DADAOReg<i, "rf"#i>;
+}
+
+// RA bank: 64 return address registers
+foreach i = 0-63 in {
+  def RA#i : DADAOReg<i, "ra"#i>;
+}
+
+// Register aliases
+def RBSP : DADAOReg<1, "rbsp">;
+def RBFP : DADAOReg<2, "rbfp">;
+
+// Register classes - RD bank
+def GPRD : RegisterClass<"DADAO", [i64], 0, (add
+  (sequence "RD%u", 0, 63)
+)>;
+
+def GPRD_Allocatable : RegisterClass<"DADAO", [i64], 0, (add
+  (sequence "RD%u", 8, 63)
+)>;
+
+// Register classes - RB bank
+def GPRB : RegisterClass<"DADAO", [i64], 0, (add
+  (sequence "RB%u", 0, 63)
+)>;
+
+def GPRB_Allocatable : RegisterClass<"DADAO", [i64], 0, (add
+  (sequence "RB%u", 8, 63)
+)>;
+
+// Register classes - RF bank (all non-allocatable)
+def GPRF : RegisterClass<"DADAO", [i64], 0, (add
+  (sequence "RF%u", 0, 63)
+)> {
+  let isAllocatable = 0;
+}
+
+// Register classes - RA bank (not used by register allocator)
+def GPRA : RegisterClass<"DADAO", [i64], 0, (add
+  (sequence "RA%u", 0, 63)
+)> {
+  let isAllocatable = 0;
+}
