+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCFixup.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/MCInstrInfo.h"
+#include "llvm/MC/MCRegisterInfo.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/Support/Casting.h"
+#include "llvm/Support/EndianStream.h"
+
+using namespace llvm;
+
+#define DEBUG_TYPE "mccodeemitter"
+
+namespace {
+
+class DADAOMCCodeEmitter : public MCCodeEmitter {
+  DADAOMCCodeEmitter(const DADAOMCCodeEmitter &) = delete;
+  void operator=(const DADAOMCCodeEmitter &) = delete;
+  MCContext &Ctx;
+
+public:
+  DADAOMCCodeEmitter(MCContext &Ctx) : Ctx(Ctx) {}
+
+  ~DADAOMCCodeEmitter() override = default;
+
+  void encodeInstruction(const MCInst &MI, SmallVectorImpl<char> &CB,
+                         SmallVectorImpl<MCFixup> &Fixups,
+                         const MCSubtargetInfo &STI) const override;
+
+  uint64_t getMachineOpValue(const MCInst &MI, const MCOperand &MO,
+                             SmallVectorImpl<MCFixup> &Fixups,
+                             const MCSubtargetInfo &STI) const;
+};
+
+} // end anonymous namespace
+
+void DADAOMCCodeEmitter::encodeInstruction(const MCInst &MI,
+                                           SmallVectorImpl<char> &CB,
+                                           SmallVectorImpl<MCFixup> &Fixups,
+                                           const MCSubtargetInfo &STI) const {
+  // FIXME: Implement once instruction encoding is properly defined
+  (void)Fixups;
+  (void)STI;
+  (void)Ctx;
+  support::endian::write<uint32_t>(CB, 0, llvm::endianness::big);
+}
+
+uint64_t
+DADAOMCCodeEmitter::getMachineOpValue(const MCInst &MI, const MCOperand &MO,
+                                      SmallVectorImpl<MCFixup> &Fixups,
+                                      const MCSubtargetInfo &STI) const {
+  if (MO.isReg())
+    return Ctx.getRegisterInfo()->getEncodingValue(MO.getReg());
+  if (MO.isImm())
+    return static_cast<uint64_t>(MO.getImm());
+  llvm_unreachable("Unhandled expression!");
+  return 0;
+}
+
+MCCodeEmitter *llvm::createDADAOMCCodeEmitter(const MCInstrInfo &,
+                                              MCContext &Ctx) {
+  return new DADAOMCCodeEmitter(Ctx);
+}
