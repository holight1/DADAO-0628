+
+#include "MCTargetDesc/DADAOMCTargetDesc.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/MCParser/AsmLexer.h"
+#include "llvm/MC/MCParser/MCAsmParser.h"
+#include "llvm/MC/MCParser/MCParsedAsmOperand.h"
+#include "llvm/MC/MCParser/MCTargetAsmParser.h"
+#include "llvm/MC/MCStreamer.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/Casting.h"
+#include "llvm/Support/MathExtras.h"
+#include "llvm/Support/SMLoc.h"
+#include "llvm/Support/raw_ostream.h"
+#include <cassert>
+#include <cstdint>
+#include <memory>
+
+using namespace llvm;
+
+namespace {
+
+struct DADAOOperand;
+
+class DADAOAsmParser : public MCTargetAsmParser {
+  SMLoc getLoc() const { return Parser.getTok().getLoc(); }
+
+  bool parseRegister(MCRegister &Reg, SMLoc &StartLoc, SMLoc &EndLoc) override;
+  ParseStatus tryParseRegister(MCRegister &Reg, SMLoc &StartLoc,
+                               SMLoc &EndLoc) override;
+
+  ParseStatus parseImmediate(OperandVector &Operands);
+  ParseStatus parseRegister(OperandVector &Operands);
+
+  bool parseInstruction(ParseInstructionInfo &Info, StringRef Name,
+                        SMLoc NameLoc, OperandVector &Operands) override;
+
+  bool matchAndEmitInstruction(SMLoc IdLoc, unsigned &Opcode,
+                               OperandVector &Operands, MCStreamer &Out,
+                               uint64_t &ErrorInfo,
+                               bool MatchingInlineAsm) override;
+
+#define GET_ASSEMBLER_HEADER
+#include "DADAOGenAsmMatcher.inc"
+
+public:
+  DADAOAsmParser(const MCSubtargetInfo &STI, MCAsmParser &Parser,
+                 const MCInstrInfo &MII, const MCTargetOptions &Options)
+      : MCTargetAsmParser(Options, STI, MII), Parser(Parser),
+        Lexer(Parser.getLexer()) {
+    setAvailableFeatures(
+        ComputeAvailableFeatures(STI.getFeatureBits()));
+  }
+
+private:
+  MCAsmParser &Parser;
+  AsmLexer &Lexer;
+};
+
+struct DADAOOperand : public MCParsedAsmOperand {
+  enum KindTy { Token, Register, Immediate } Kind;
+
+  SMLoc StartLoc, EndLoc;
+
+  struct Token {
+    const char *Data;
+    unsigned Length;
+  };
+
+  struct RegOp {
+    MCRegister RegNum;
+  };
+
+  struct ImmOp {
+    const MCExpr *Value;
+  };
+
+  union {
+    struct Token Tok;
+    struct RegOp Reg;
+    struct ImmOp Imm;
+  };
+
+  explicit DADAOOperand(KindTy K) : Kind(K) {}
+
+public:
+  SMLoc getStartLoc() const override { return StartLoc; }
+  SMLoc getEndLoc() const override { return EndLoc; }
+
+  MCRegister getReg() const override {
+    assert(isReg() && "Invalid type access!");
+    return Reg.RegNum;
+  }
+
+  const MCExpr *getImm() const {
+    assert(isImm() && "Invalid type access!");
+    return Imm.Value;
+  }
+
+  StringRef getToken() const {
+    assert(isToken() && "Invalid type access!");
+    return StringRef(Tok.Data, Tok.Length);
+  }
+
+  bool isReg() const override { return Kind == Register; }
+  bool isImm() const override { return Kind == Immediate; }
+  bool isToken() const override { return Kind == Token; }
+
+  bool isImms12() const {
+    if (!isImm()) return false;
+    if (const MCConstantExpr *CE = dyn_cast<MCConstantExpr>(Imm.Value))
+      return isInt<12>(CE->getValue());
+    return true;
+  }
+
+  bool isImmu12() const {
+    if (!isImm()) return false;
+    if (const MCConstantExpr *CE = dyn_cast<MCConstantExpr>(Imm.Value))
+      return isUInt<12>(CE->getValue());
+    return true;
+  }
+
+  bool isImms18() const {
+    if (!isImm()) return false;
+    if (const MCConstantExpr *CE = dyn_cast<MCConstantExpr>(Imm.Value))
+      return isInt<18>(CE->getValue());
+    return true;
+  }
+
+  bool isImmu16() const {
+    if (!isImm()) return false;
+    if (const MCConstantExpr *CE = dyn_cast<MCConstantExpr>(Imm.Value))
+      return isUInt<16>(CE->getValue());
+    return true;
+  }
+
+  bool isImmu6() const {
+    if (!isImm()) return false;
+    if (const MCConstantExpr *CE = dyn_cast<MCConstantExpr>(Imm.Value))
+      return isUInt<6>(CE->getValue());
+    return true;
+  }
+
+  bool isImms24() const {
+    if (!isImm()) return false;
+    if (const MCConstantExpr *CE = dyn_cast<MCConstantExpr>(Imm.Value))
+      return isInt<24>(CE->getValue());
+    return true;
+  }
+
+  bool isWydepos() const {
+    if (!isImm()) return false;
+    if (const MCConstantExpr *CE = dyn_cast<MCConstantExpr>(Imm.Value))
+      return isUInt<2>(CE->getValue());
+    return true;
+  }
+
+  void addExpr(MCInst &Inst, const MCExpr *Expr) const {
+    if (const MCConstantExpr *CE = dyn_cast<MCConstantExpr>(Expr))
+      Inst.addOperand(MCOperand::createImm(CE->getValue()));
+    else
+      Inst.addOperand(MCOperand::createExpr(Expr));
+  }
+
+  void addRegOperands(MCInst &Inst, unsigned N) const {
+    assert(N == 1 && "Invalid number of operands!");
+    Inst.addOperand(MCOperand::createReg(getReg()));
+  }
+
+  void addImms12Operands(MCInst &Inst, unsigned N) const {
+    assert(N == 1 && "Invalid number of operands!");
+    addExpr(Inst, getImm());
+  }
+
+  void addImmu12Operands(MCInst &Inst, unsigned N) const {
+    assert(N == 1 && "Invalid number of operands!");
+    addExpr(Inst, getImm());
+  }
+
+  void addImms18Operands(MCInst &Inst, unsigned N) const {
+    assert(N == 1 && "Invalid number of operands!");
+    addExpr(Inst, getImm());
+  }
+
+  void addImmu16Operands(MCInst &Inst, unsigned N) const {
+    assert(N == 1 && "Invalid number of operands!");
+    addExpr(Inst, getImm());
+  }
+
+  void addImmu6Operands(MCInst &Inst, unsigned N) const {
+    assert(N == 1 && "Invalid number of operands!");
+    addExpr(Inst, getImm());
+  }
+
+  void addImms24Operands(MCInst &Inst, unsigned N) const {
+    assert(N == 1 && "Invalid number of operands!");
+    addExpr(Inst, getImm());
+  }
+
+  void addWydeposOperands(MCInst &Inst, unsigned N) const {
+    assert(N == 1 && "Invalid number of operands!");
+    addExpr(Inst, getImm());
+  }
+
+  void print(raw_ostream &OS, const MCAsmInfo &) const override {
+    switch (Kind) {
+    case Immediate:
+      OS << "Imm: " << *getImm();
+      break;
+    case Token:
+      OS << "Token: " << getToken();
+      break;
+    case Register:
+      OS << "Reg: " << getReg();
+      break;
+    }
+  }
+
+  static std::unique_ptr<DADAOOperand> CreateToken(StringRef Str, SMLoc S) {
+    auto Op = std::make_unique<DADAOOperand>(Token);
+    Op->Tok.Data = Str.data();
+    Op->Tok.Length = Str.size();
+    Op->StartLoc = S;
+    Op->EndLoc = S;
+    return Op;
+  }
+
+  static std::unique_ptr<DADAOOperand> createReg(MCRegister Reg, SMLoc S,
+                                                  SMLoc E) {
+    auto Op = std::make_unique<DADAOOperand>(Register);
+    Op->Reg.RegNum = Reg;
+    Op->StartLoc = S;
+    Op->EndLoc = E;
+    return Op;
+  }
+
+  static std::unique_ptr<DADAOOperand> createImm(const MCExpr *Val, SMLoc S,
+                                                  SMLoc E) {
+    auto Op = std::make_unique<DADAOOperand>(Immediate);
+    Op->Imm.Value = Val;
+    Op->StartLoc = S;
+    Op->EndLoc = E;
+    return Op;
+  }
+};
+
+} // end anonymous namespace
+
+bool DADAOAsmParser::matchAndEmitInstruction(SMLoc IdLoc, unsigned &Opcode,
+                                              OperandVector &Operands,
+                                              MCStreamer &Out,
+                                              uint64_t &ErrorInfo,
+                                              bool MatchingInlineAsm) {
+  MCInst Inst;
+  SMLoc ErrorLoc;
+
+  switch (MatchInstructionImpl(Operands, Inst, ErrorInfo, MatchingInlineAsm)) {
+  case Match_Success:
+    Out.emitInstruction(Inst, STI);
+    Opcode = Inst.getOpcode();
+    return false;
+  case Match_MissingFeature:
+    return Error(IdLoc, "Instruction use requires option to be enabled");
+  case Match_MnemonicFail:
+    return Error(IdLoc, "Unrecognized instruction mnemonic");
+  case Match_InvalidOperand: {
+    ErrorLoc = IdLoc;
+    if (ErrorInfo != ~0U) {
+      if (ErrorInfo >= Operands.size())
+        return Error(IdLoc, "Too few operands for instruction");
+      ErrorLoc = Operands[ErrorInfo]->getStartLoc();
+      if (ErrorLoc == SMLoc())
+        ErrorLoc = IdLoc;
+    }
+    return Error(ErrorLoc, "Invalid operand for instruction");
+  }
+  }
+  llvm_unreachable("Unknown match type detected!");
+}
+
+bool DADAOAsmParser::parseRegister(MCRegister &Reg, SMLoc &StartLoc,
+                                    SMLoc &EndLoc) {
+  const AsmToken &Tok = Parser.getTok();
+  StartLoc = Tok.getLoc();
+  EndLoc = Tok.getEndLoc();
+
+  if (Lexer.getKind() != AsmToken::Identifier)
+    return true;
+
+  MCRegister RegNum = MatchRegisterName(Tok.getIdentifier());
+  if (RegNum == 0)
+    return true;
+
+  Parser.Lex();
+  Reg = RegNum;
+  return false;
+}
+
+ParseStatus DADAOAsmParser::tryParseRegister(MCRegister &Reg, SMLoc &StartLoc,
+                                              SMLoc &EndLoc) {
+  if (!parseRegister(Reg, StartLoc, EndLoc))
+    return ParseStatus::Success;
+  return ParseStatus::NoMatch;
+}
+
+ParseStatus DADAOAsmParser::parseRegister(OperandVector &Operands) {
+  SMLoc S = getLoc();
+  SMLoc E = SMLoc::getFromPointer(Parser.getTok().getLoc().getPointer() - 1);
+
+  if (Lexer.getKind() != AsmToken::Identifier)
+    return ParseStatus::NoMatch;
+
+  MCRegister RegNum = MatchRegisterName(Lexer.getTok().getIdentifier());
+  if (RegNum == 0)
+    return ParseStatus::NoMatch;
+
+  Parser.Lex();
+  Operands.push_back(DADAOOperand::createReg(RegNum, S, E));
+  return ParseStatus::Success;
+}
+
+ParseStatus DADAOAsmParser::parseImmediate(OperandVector &Operands) {
+  SMLoc S = getLoc();
+  SMLoc E = SMLoc::getFromPointer(Parser.getTok().getLoc().getPointer() - 1);
+
+  const MCExpr *Expr;
+  if (Parser.parseExpression(Expr))
+    return ParseStatus::Failure;
+
+  Operands.push_back(DADAOOperand::createImm(Expr, S, E));
+  return ParseStatus::Success;
+}
+
+bool DADAOAsmParser::parseInstruction(ParseInstructionInfo &, StringRef Name,
+                                       SMLoc NameLoc,
+                                       OperandVector &Operands) {
+  Operands.push_back(DADAOOperand::CreateToken(Name, NameLoc));
+
+  if (Lexer.is(AsmToken::EndOfStatement))
+    return false;
+
+  while (true) {
+    if (Lexer.is(AsmToken::EndOfStatement))
+      break;
+
+    ParseStatus Res = parseRegister(Operands);
+    if (!Res.isSuccess())
+      Res = parseImmediate(Operands);
+    if (!Res.isSuccess()) {
+      Error(getLoc(), "unknown operand");
+      return true;
+    }
+
+    if (Lexer.is(AsmToken::EndOfStatement))
+      break;
+
+    if (Lexer.isNot(AsmToken::Comma)) {
+      Error(getLoc(), "expected comma");
+      return true;
+    }
+    Parser.Lex();
+  }
+
+  return false;
+}
+
