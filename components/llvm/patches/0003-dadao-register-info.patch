diff --git a/llvm/lib/Target/DADAO/DADAO.td b/llvm/lib/Target/DADAO/DADAO.td
new file mode 100644
index 000000000000..0bbe4f8174d2
--- /dev/null
+++ b/llvm/lib/Target/DADAO/DADAO.td
@@ -0,0 +1,41 @@
+//===- DADAO.td - Describe the DADAO Target Machine ----------*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+//===----------------------------------------------------------------------===//
+// Target-independent interfaces which we are implementing
+//===----------------------------------------------------------------------===//
+
+include "llvm/Target/Target.td"
+
+//===----------------------------------------------------------------------===//
+// Register File, Calling Conv, Instruction Descriptions
+//===----------------------------------------------------------------------===//
+
+include "DADAORegisterInfo.td"
+include "DADAOInstrInfo.td"
+
+def DADAOInstrInfo : InstrInfo;
+
+//===----------------------------------------------------------------------===//
+// DADAO processors supported.
+//===----------------------------------------------------------------------===//
+
+def : ProcessorModel<"generic", NoSchedModel, []>;
+
+def DADAOInstPrinter : AsmWriter {
+  string AsmWriterClassName  = "InstPrinter";
+  bit isMCAsmWriter = 1;
+}
+
+//===----------------------------------------------------------------------===//
+// Declare the target which we are implementing
+//===----------------------------------------------------------------------===//
+
+def DADAO : Target {
+  let InstructionSet = DADAOInstrInfo;
+  let AssemblyWriters = [DADAOInstPrinter];
+}
diff --git a/llvm/lib/Target/DADAO/DADAORegisterInfo.cpp b/llvm/lib/Target/DADAO/DADAORegisterInfo.cpp
new file mode 100644
index 000000000000..afb7df5a788d
--- /dev/null
+++ b/llvm/lib/Target/DADAO/DADAORegisterInfo.cpp
@@ -0,0 +1,61 @@
+//===-- DADAORegisterInfo.cpp - DADAO Register Information ------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file contains the DADAO implementation of the TargetRegisterInfo class.
+//
+//===----------------------------------------------------------------------===//
+
+#include "DADAORegisterInfo.h"
+#include "llvm/ADT/BitVector.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/Support/ErrorHandling.h"
+
+#define GET_REGINFO_TARGET_DESC
+#include "DADAOGenRegisterInfo.inc"
+
+using namespace llvm;
+
+DADAORegisterInfo::DADAORegisterInfo() : DADAOGenRegisterInfo(0) {}
+
+const uint16_t *
+DADAORegisterInfo::getCalleeSavedRegs(const MachineFunction * /*MF*/) const {
+  return nullptr;
+}
+
+BitVector DADAORegisterInfo::getReservedRegs(const MachineFunction &MF) const {
+  BitVector Reserved(getNumRegs());
+
+  Reserved.set(DADAO::RD0);
+  Reserved.set(DADAO::RD1);
+  Reserved.set(DADAO::RD2);
+  Reserved.set(DADAO::RD3);
+  Reserved.set(DADAO::RD4);
+  Reserved.set(DADAO::RD5);
+  Reserved.set(DADAO::RD6);
+  Reserved.set(DADAO::RD7);
+  Reserved.set(DADAO::RB0);
+  Reserved.set(DADAO::RB1);
+  Reserved.set(DADAO::RB2);
+  Reserved.set(DADAO::RB3);
+  Reserved.set(DADAO::RB4);
+  Reserved.set(DADAO::RB5);
+  Reserved.set(DADAO::RB6);
+  Reserved.set(DADAO::RB7);
+
+  return Reserved;
+}
+
+bool DADAORegisterInfo::eliminateFrameIndex(MachineBasicBlock::iterator II,
+                                            int SPAdj, unsigned FIOperandNum,
+                                            RegScavenger *RS) const {
+  llvm_unreachable("Not yet implemented");
+}
+
+Register DADAORegisterInfo::getFrameRegister(const MachineFunction &MF) const {
+  return DADAO::RBSP;
+}
