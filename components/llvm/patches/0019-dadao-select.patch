From b4f88e5f98ad390b3eb6e5971c876df4f7ad437f Mon Sep 17 00:00:00 2001
From: suiyan <suiyan@sunmmio.com>
Date: Sun, 12 Jul 2026 09:36:46 +0800
Subject: [PATCH] target/dadao: select -> cs* conditional assign (DL-063a)

---
 llvm/lib/Target/DADAO/DADAOISelLowering.h | 1 +
 llvm/lib/Target/DADAO/DADAOInstrInfo.td   | 9 +++++++++
 2 files changed, 10 insertions(+)

diff --git a/llvm/lib/Target/DADAO/DADAOISelLowering.h b/llvm/lib/Target/DADAO/DADAOISelLowering.h
index fc7b0885bcb2..e5b58b639739 100644
--- a/llvm/lib/Target/DADAO/DADAOISelLowering.h
+++ b/llvm/lib/Target/DADAO/DADAOISelLowering.h
@@ -21,6 +21,7 @@ enum NodeType {
   BRNP,   // (chain, val, dest) — brnp  branch if val<=0 (non-positive)
   CMP,    // (lhs, rhs) → i64  cmps result (−1/0/1)
   CMPU,   // (lhs, rhs) → i64  cmpu result (−1/0/1)
+  SEL,    // (cond, false, true) → i64  conditional select via csz
   FI_ADDR, // (TargetFrameIndex) → i64  frame address in GPRB
   PCREL_HI, // (GlobalAddress) → i64  page-aligned PC-relative address in RB
 };
diff --git a/llvm/lib/Target/DADAO/DADAOInstrInfo.td b/llvm/lib/Target/DADAO/DADAOInstrInfo.td
index 2d50e93902e4..2a226f7f2820 100644
--- a/llvm/lib/Target/DADAO/DADAOInstrInfo.td
+++ b/llvm/lib/Target/DADAO/DADAOInstrInfo.td
@@ -355,3 +355,12 @@ def : Pat<(sext_inreg GPRD:$src, i16),
           (EXTS_ORRI GPRD:$src, 48)>;
 def : Pat<(sext_inreg GPRD:$src, i32),
           (EXTS_ORRI GPRD:$src, 32)>;
+
+//===----------------------------------------------------------------------===//
+// CodeGen patterns — conditional select (§3.12)
+//===----------------------------------------------------------------------===//
+
+// plain select: csz(cond, dst, false_val, true_val)
+// csz: rdha==0 ? rdhc : rdhd.  cond==0 → take b (false), else a (true)
+def : Pat<(select GPRD:$cond, GPRD:$a, GPRD:$b),
+          (CSZ_RRRR GPRD:$cond, GPRD:$b, GPRD:$a)>;
-- 
2.43.0

