+    ; CHECK:       $rb5 = ADDRB_ORRR $rb1, killed $rd{{[0-9]+}}
+    ; CHECK-NEXT:  STO_RRII killed $rd8, killed $rb5, 0
+    ; CHECK:       $rb5 = ADDRB_ORRR $rb1, killed $rd{{[0-9]+}}
+    ; CHECK-NEXT:  $rb9 = LDO_RBRRII killed $rb5, 0
+    ; CHECK:       $rb5 = ADDRB_ORRR $rb1, killed $rd{{[0-9]+}}
+    ; CHECK-NEXT:  STO_RBRRII killed $rb9, killed $rb5, 0
+    ; Negative Total=FrameOff+GEPOff coverage for both RD memory pseudos.
+    ; CHECK:       ORW_RWII
+    ; CHECK:       $rb5 = ADDRB_ORRR $rb1, killed $rd{{[0-9]+}}
+    ; CHECK-NEXT:  $rd10 = LDO_RRII killed $rb5, 0
+    ; CHECK:       ORW_RWII
+    ; CHECK:       $rb5 = ADDRB_ORRR $rb1, killed $rd{{[0-9]+}}
+    ; CHECK-NEXT:  STO_RRII killed $rd10, killed $rb5, 0
+    ; CHECK:       $rd2 = frame-destroy SETZW_RWII
+    ; CHECK:       $rb1 = frame-destroy ADDRB_ORRR $rb1, killed $rd2
+
+    $rb8 = ADDI_RB_FI $rb1, %fixed-stack.0
+    $rd8 = LDO_FI $rb1, 0, %fixed-stack.0
+    STO_FI killed $rd8, $rb1, 0, %fixed-stack.0
+    $rb9 = LDO_RB_FI $rb1, 0, %fixed-stack.0
+    STO_RB_FI killed $rb9, $rb1, 0, %fixed-stack.0
+    $rd10 = LDO_FI $rb1, -8192, %stack.0.large
+    STO_FI killed $rd10, $rb1, -8192, %stack.0.large
+    RET_PSEUDO
+...
