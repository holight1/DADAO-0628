diff --git a/llvm/test/CodeGen/DADAO/large-frame-offsets.ll b/llvm/test/CodeGen/DADAO/large-frame-offsets.ll
new file mode 100644
index 000000000000..621d82bd0456
--- /dev/null
+++ b/llvm/test/CodeGen/DADAO/large-frame-offsets.ll
@@ -0,0 +1,48 @@
+; RUN: llc -mtriple=dadao-unknown-elf -O0 < %s | FileCheck %s
+
+; Large frames must not silently wrap signed 12-bit stack adjustments or
+; frame-index offsets.  Volatile accesses keep both the near and far objects
+; observable, and the pointer slot forces RB-bank spill/reload coverage.
+define i64 @large_frame_offsets(i64 %seed, ptr %pointer) {
+; CHECK-LABEL: large_frame_offsets:
+; CHECK:       setzw rd2,
+; CHECK:       add rb1, rb1, rd2
+; CHECK:       stb
+; CHECK:       ldbu
+; CHECK:       setzw rd2,
+; CHECK:       add rb1, rb1, rd2
+entry:
+  %large = alloca [4096 x i8], align 8
+  %scalar = alloca i64, align 8
+  %pointer.slot = alloca ptr, align 8
+  %near = getelementptr inbounds [4096 x i8], ptr %large, i64 0, i64 0
+  %far = getelementptr inbounds [4096 x i8], ptr %large, i64 0, i64 4095
+  store volatile i8 17, ptr %near, align 1
+  store volatile i8 29, ptr %far, align 1
+  store volatile i64 %seed, ptr %scalar, align 8
+  %loaded.seed = load volatile i64, ptr %scalar, align 8
+  store volatile ptr %pointer, ptr %pointer.slot, align 8
+  %loaded.pointer = load volatile ptr, ptr %pointer.slot, align 8
+  %pointer.value = ptrtoint ptr %loaded.pointer to i64
+  %near.value = load volatile i8, ptr %near, align 1
+  %far.value = load volatile i8, ptr %far, align 1
+  %near.ext = zext i8 %near.value to i64
+  %far.ext = zext i8 %far.value to i64
+  %sum.0 = add i64 %loaded.seed, %pointer.value
+  %sum.1 = add i64 %sum.0, %near.ext
+  %sum.2 = add i64 %sum.1, %far.ext
+  ret i64 %sum.2
+}
+
+; A genuinely small frame remains on the original single-immediate path.
+define i64 @small_frame_unchanged(i64 %seed) {
+; CHECK-LABEL: small_frame_unchanged:
+; CHECK:       addi rb1, rb1, -8
+; CHECK-NOT:   add rb1, rb1, rd2
+; CHECK:       addi rb1, rb1, 8
+entry:
+  %slot = alloca i64, align 8
+  store volatile i64 %seed, ptr %slot, align 8
+  %value = load volatile i64, ptr %slot, align 8
+  ret i64 %value
+}
