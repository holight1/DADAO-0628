   uint64_t StackSize = getDADAOFrameSize(MF);
   if (StackSize == 0)
@@ -40,15 +40,28 @@ void DADAOFrameLowering::emitPrologue(MachineFunction &MF,
   MachineBasicBlock::iterator MBBI = MBB.begin();
   DebugLoc DL = MBBI != MBB.end() ? MBBI->getDebugLoc() : DebugLoc();
 
-  BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDI_RBRRII), DADAO::RB1)
+  int64_t Adjustment = -static_cast<int64_t>(StackSize);
+  if (isInt<12>(Adjustment)) {
+    BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDI_RBRRII), DADAO::RB1)
+        .addReg(DADAO::RB1)
+        .addImm(Adjustment);
+    return;
+  }
+
+  // RD2 is ABI-reserved and never allocated.  Integer arguments start at
+  // RD16, so using RD2 before any callee code cannot destroy an incoming
+  // argument.
+  TII->materializeImm64(MBB, MBBI, DL, DADAO::RD2, Adjustment,
+                        MachineInstr::FrameSetup);
+  BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDRB_ORRR), DADAO::RB1)
       .addReg(DADAO::RB1)
-      .addImm(-static_cast<int64_t>(StackSize));
+      .addReg(DADAO::RD2, RegState::Kill)
+      .setMIFlag(MachineInstr::FrameSetup);
 }
 
 void DADAOFrameLowering::emitEpilogue(MachineFunction &MF,
-                                       MachineBasicBlock &MBB) const {
-  const DADAOInstrInfo *TII =
-      MF.getSubtarget<DADAOSubtarget>().getInstrInfo();
+                                      MachineBasicBlock &MBB) const {
+  const DADAOInstrInfo *TII = MF.getSubtarget<DADAOSubtarget>().getInstrInfo();
 
   uint64_t StackSize = getDADAOFrameSize(MF);
   if (StackSize == 0)
@@ -57,13 +70,40 @@ void DADAOFrameLowering::emitEpilogue(MachineFunction &MF,
   MachineBasicBlock::iterator MBBI = MBB.getFirstTerminator();
   DebugLoc DL = MBBI != MBB.end() ? MBBI->getDebugLoc() : DebugLoc();
 
-  BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDI_RBRRII), DADAO::RB1)
+  int64_t Adjustment = static_cast<int64_t>(StackSize);
+  if (isInt<12>(Adjustment)) {
+    BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDI_RBRRII), DADAO::RB1)
+        .addReg(DADAO::RB1)
+        .addImm(Adjustment);
+    return;
+  }
+
+  // RD2 is also safe here: scalar return values use RD31, and RD2 is
+  // non-allocatable with no ABI return role.
+  TII->materializeImm64(MBB, MBBI, DL, DADAO::RD2, Adjustment,
+                        MachineInstr::FrameDestroy);
+  BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDRB_ORRR), DADAO::RB1)
       .addReg(DADAO::RB1)
-      .addImm(static_cast<int64_t>(StackSize));
+      .addReg(DADAO::RD2, RegState::Kill)
+      .setMIFlag(MachineInstr::FrameDestroy);
+}
+
+void DADAOFrameLowering::processFunctionBeforeFrameFinalized(
+    MachineFunction &MF, RegScavenger *RS) const {
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+  if (!RS || MFI.estimateStackSize(MF) <= 2047)
+    return;
+
+  // Large frame-index elimination may need to spill its scavenged RD
+  // temporary.  PEI places this emergency slot closest to the final SP, so
+  // the spill/reload itself remains reachable with a small frame offset.
+  int FI = MFI.CreateSpillStackObject(8, Align(8));
+  RS->addScavengingFrameIndex(FI);
 }
 
