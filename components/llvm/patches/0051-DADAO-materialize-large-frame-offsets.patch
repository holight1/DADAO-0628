+    ; CHECK:       $rb1 = frame-setup ADDRB_ORRR $rb1, killed $rd2
+    ; CHECK:       $rd{{[0-9]+}} = SETZW_RWII 0, {{8[0-9]+}}
+    ; CHECK-NEXT:  $rb8 = ADDRB_ORRR $rb1, killed $rd{{[0-9]+}}
+    ; CHECK:       $rb5 = ADDRB_ORRR $rb1, killed $rd{{[0-9]+}}
