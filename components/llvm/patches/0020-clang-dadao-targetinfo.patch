   case Triple::spirv64:
     return computeSPIRVDataLayout(*this);
   case Triple::dadao:
-    return "E-m:e-i64:64-n64-S64";
+    return "E-m:e-i64:64-i128:128-n64-S64";
   case Triple::lanai:
     return computeLanaiDataLayout();
   case Triple::wasm32:
