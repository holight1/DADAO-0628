diff --git a/clang/lib/Basic/Targets/DADAO.cpp b/clang/lib/Basic/Targets/DADAO.cpp
new file mode 100644
index 000000000000..e4be81ca1d21
--- /dev/null
+++ b/clang/lib/Basic/Targets/DADAO.cpp
@@ -0,0 +1,60 @@
+//===--- DADAO.cpp - Implement DADAO target feature support ----------------===//
+#include "DADAO.h"
+#include "clang/Basic/MacroBuilder.h"
+#include "llvm/ADT/StringRef.h"
+
+using namespace clang;
+using namespace clang::targets;
+
+void DADAOTargetInfo::getTargetDefines(const LangOptions &Opts,
+                                       MacroBuilder &Builder) const {
+  Builder.defineMacro("__dadao__");
+  Builder.defineMacro("__DADAO__");
+  Builder.defineMacro("__ELF__");
+
+  Builder.defineMacro("_LP64", "1");
+  Builder.defineMacro("__LP64__", "1");
+
+  Builder.defineMacro("__SIZEOF_SIZE_T__", "8");
+  Builder.defineMacro("__SIZEOF_POINTER__", "8");
+  Builder.defineMacro("__SIZEOF_LONG__", "8");
+  Builder.defineMacro("__SIZEOF_INT__", "4");
+  Builder.defineMacro("__SIZEOF_SHORT__", "2");
+  Builder.defineMacro("__SIZEOF_WCHAR_T__", "4");
+  Builder.defineMacro("__SIZEOF_WINT_T__", "4");
+
+  Builder.defineMacro("__BYTE_ORDER__", "__ORDER_BIG_ENDIAN__");
+  Builder.defineMacro("__ORDER_LITTLE_ENDIAN__", "1234");
+  Builder.defineMacro("__ORDER_BIG_ENDIAN__", "4321");
+  Builder.defineMacro("__FLOAT_WORD_ORDER__", "__ORDER_BIG_ENDIAN__");
+
+  Builder.defineMacro("__CHAR_BIT__", "8");
+  Builder.defineMacro("__INT_MAX__", "2147483647");
+  Builder.defineMacro("__LONG_MAX__", "9223372036854775807L");
+  Builder.defineMacro("__LONG_LONG_MAX__", "9223372036854775807LL");
+
+  Builder.defineMacro("__WCHAR_MAX__", "4294967295U");
+  Builder.defineMacro("__WCHAR_UNSIGNED__");
+  Builder.defineMacro("__WINT_MAX__", "4294967295U");
+  Builder.defineMacro("__WINT_UNSIGNED__");
+
+  Builder.defineMacro("__PTRDIFF_TYPE__", "long");
+  Builder.defineMacro("__SIZE_TYPE__", "unsigned long");
+  Builder.defineMacro("__INTPTR_TYPE__", "long");
+  Builder.defineMacro("__UINTPTR_TYPE__", "unsigned long");
+
+  Builder.defineMacro("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_1");
+  Builder.defineMacro("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_2");
+  Builder.defineMacro("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_4");
+  Builder.defineMacro("__GCC_HAVE_SYNC_COMPARE_AND_SWAP_8");
+}
+
+ArrayRef<const char *> DADAOTargetInfo::getGCCRegNames() const {
+  static const char *const GCCRegNames[] = {
+      "rd0",  "rd1",  "rd2",  "rd3",  "rd4",  "rd5",  "rd6",  "rd7",
+      "rd8",  "rd9",  "rd10", "rd11", "rd12", "rd13", "rd14", "rd15",
+      "rd16", "rd17", "rd18", "rd19", "rd20", "rd21", "rd22", "rd23",
+      "rd24", "rd25", "rd26", "rd27", "rd28", "rd29", "rd30", "rd31",
+  };
+  return llvm::ArrayRef(GCCRegNames);
+}
diff --git a/clang/lib/Basic/Targets/DADAO.h b/clang/lib/Basic/Targets/DADAO.h
new file mode 100644
index 000000000000..2008126382e1
--- /dev/null
+++ b/clang/lib/Basic/Targets/DADAO.h
@@ -0,0 +1,74 @@
+//===--- DADAO.h - Declare DADAO target feature support ---------*- C++ -*-===//
+#ifndef LLVM_CLANG_LIB_BASIC_TARGETS_DADAO_H
+#define LLVM_CLANG_LIB_BASIC_TARGETS_DADAO_H
+
+#include "clang/Basic/TargetInfo.h"
+#include "clang/Basic/TargetOptions.h"
+#include "llvm/Support/Compiler.h"
+#include "llvm/TargetParser/Triple.h"
+
+namespace clang {
+namespace targets {
+
+class LLVM_LIBRARY_VISIBILITY DADAOTargetInfo : public TargetInfo {
+public:
+  DADAOTargetInfo(const llvm::Triple &Triple, const TargetOptions &)
+      : TargetInfo(Triple) {
+    BigEndian = true;
+    NoAsmVariants = true;
+    TLSSupported = false;
+    IntWidth = 32;
+    IntAlign = 32;
+    LongWidth = 64;
+    LongLongWidth = 64;
+    LongAlign = LongLongAlign = 64;
+    PointerWidth = 64;
+    PointerAlign = 64;
+    SuitableAlign = 64;
+    SizeType = UnsignedLong;
+    IntMaxType = SignedLong;
+    IntPtrType = SignedLong;
+    PtrDiffType = SignedLong;
+    SigAtomicType = SignedLong;
+    FloatWidth = 32;
+    FloatAlign = 32;
+    DoubleWidth = DoubleAlign = 64;
+    LongDoubleWidth = LongDoubleAlign = 64;
+    WCharType = UnsignedInt;
+    WIntType = UnsignedInt;
+    resetDataLayout("E-m:e-i64:64-i128:128-n64-S64");
+  }
+
+  void getTargetDefines(const LangOptions &Opts,
+                        MacroBuilder &Builder) const override;
+
+  llvm::SmallVector<Builtin::InfosShard> getTargetBuiltins() const override {
+    return {};
+  }
+
+  bool allowsLargerPreferedTypeAlignment() const override { return false; }
+
+  bool hasFeature(StringRef Feature) const override {
+    return Feature == "dadao";
+  }
+
+  BuiltinVaListKind getBuiltinVaListKind() const override {
+    return TargetInfo::CharPtrBuiltinVaList;
+  }
+
+  std::string_view getClobbers() const override { return ""; }
+
+  bool validateAsmConstraint(const char *&Name,
+                             TargetInfo::ConstraintInfo &info) const override {
+    return false;
+  }
+
+  ArrayRef<const char *> getGCCRegNames() const override;
+  ArrayRef<GCCRegAlias> getGCCRegAliases() const override {
+    return {};
+  }
+};
+
+} // namespace targets
+} // namespace clang
+#endif
