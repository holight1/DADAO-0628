+namespace llvm {
+
+class DADAOTargetMachine;
+
+class DADAOSubtarget : public DADAOGenSubtargetInfo {
+  DADAOFrameLowering FrameLowering;
+  DADAOInstrInfo InstrInfo;
+
+public:
+  DADAOSubtarget(const Triple &TT, StringRef CPU, StringRef FS,
+                 const DADAOTargetMachine &TM);
+
+  void ParseSubtargetFeatures(StringRef CPU, StringRef TuneCPU, StringRef FS);
+
+  const DADAOInstrInfo *getInstrInfo() const override { return &InstrInfo; }
+  const DADAORegisterInfo *getRegisterInfo() const override {
+    return &InstrInfo.getRegisterInfo();
+  }
+  const DADAOFrameLowering *getFrameLowering() const override {
+    return &FrameLowering;
+  }
+  const DADAOTargetLowering *getTargetLowering() const override {
+    return TLInfo.get();
+  }
+  const SelectionDAGTargetInfo *getSelectionDAGInfo() const override {
+    return &TSInfo;
+  }
+
+  void setTargetLowering(std::unique_ptr<DADAOTargetLowering> TL) {
+    TLInfo = std::move(TL);
+  }
+
+private:
+  SelectionDAGTargetInfo TSInfo;
+  std::unique_ptr<DADAOTargetLowering> TLInfo;
+};
+
+} // namespace llvm
+#endif
