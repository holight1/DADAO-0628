+SDValue DADAOTargetLowering::lowerGlobalAddress(SDValue Op,
+                                                SelectionDAG &DAG) const {
+  SDLoc DL(Op);
+  GlobalAddressSDNode *GN = cast<GlobalAddressSDNode>(Op);
+  SDValue GA = DAG.getTargetGlobalAddress(GN->getGlobal(), DL, MVT::i64,
+                                          GN->getOffset());
+  return DAG.getNode(DADAOISD::PCREL_HI, DL, MVT::i64, GA);
+}
