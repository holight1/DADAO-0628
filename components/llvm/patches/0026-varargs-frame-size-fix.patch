From 7ddd622bc97a291c64e5e7794f7d73f94fcc7030 Mon Sep 17 00:00:00 2001
From: suiyan <suiyan@sunmmio.com>
Date: Tue, 14 Jul 2026 10:38:09 +0800
Subject: [PATCH] target/dadao: fix varargs stack frame size omission (ML-003g)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

DADAOFrameLowering's emitPrologue/emitEpilogue/getFrameIndexReference
only used MFI.getStackSize(), never DADAOMachineFunctionInfo's
VarArgsSaveSize. The varargs register-save area is created via
CreateFixedObject(..., true) with a positive offset — MachineFrameInfo
convention excludes such objects from getStackSize() (they represent
incoming-argument space), so the frame allocation never grew to cover
it. Any variadic function's register-save stores wrote past the
allocated frame into the caller's stack.

Verified via picolibc's real printf.c: prologue changed from
`addi rb1,rb1,-48` to `-168`, matching the varargs save loop's actual
max offset (160, needs 168) — previously overflowed by 120 bytes.

Fix mirrors RISC-V's RISCVFrameLowering.cpp pattern (explicit
`+= VarArgsSaveSize` at each stack-size use site), with care to exclude
the varargs save area's own FrameIndex from the addition (it's already
positioned relative to the incoming-argument region, not the local
frame).

E2E 27/27, differential AGREE(4-way)=200/DIVERGE=0, no regression.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 llvm/lib/Target/DADAO/DADAOFrameLowering.cpp | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/llvm/lib/Target/DADAO/DADAOFrameLowering.cpp b/llvm/lib/Target/DADAO/DADAOFrameLowering.cpp
index ce0ff4ab45dc..91a002662afb 100644
--- a/llvm/lib/Target/DADAO/DADAOFrameLowering.cpp
+++ b/llvm/lib/Target/DADAO/DADAOFrameLowering.cpp
@@ -1,5 +1,6 @@
 //===-- DADAOFrameLowering.cpp - DADAO Frame Lowering ---------------------===//
 #include "DADAOFrameLowering.h"
+#include "DADAOMachineFunctionInfo.h"
 #include "DADAOSubtarget.h"
 #include "DADAOInstrInfo.h"
 #include "llvm/CodeGen/MachineFrameInfo.h"
@@ -22,6 +23,9 @@ void DADAOFrameLowering::emitPrologue(MachineFunction &MF,
       MF.getSubtarget<DADAOSubtarget>().getInstrInfo();
 
   uint64_t StackSize = MFI.getStackSize();
+  DADAOMachineFunctionInfo *DFI = MF.getInfo<DADAOMachineFunctionInfo>();
+  if (DFI)
+    StackSize += DFI->getVarArgsSaveSize();
   if (StackSize == 0)
     return;
 
@@ -40,6 +44,9 @@ void DADAOFrameLowering::emitEpilogue(MachineFunction &MF,
       MF.getSubtarget<DADAOSubtarget>().getInstrInfo();
 
   uint64_t StackSize = MFI.getStackSize();
+  DADAOMachineFunctionInfo *DFI = MF.getInfo<DADAOMachineFunctionInfo>();
+  if (DFI)
+    StackSize += DFI->getVarArgsSaveSize();
   if (StackSize == 0)
     return;
 
@@ -55,6 +62,13 @@ StackOffset DADAOFrameLowering::getFrameIndexReference(
     const MachineFunction &MF, int FI, Register &FrameReg) const {
   const MachineFrameInfo &MFI = MF.getFrameInfo();
   FrameReg = DADAO::RB1;
-  return StackOffset::getFixed(MFI.getObjectOffset(FI) +
-                                MFI.getStackSize());
+
+  uint64_t StackSize = MFI.getStackSize();
+  const DADAOMachineFunctionInfo *DFI =
+      MF.getInfo<DADAOMachineFunctionInfo>();
+  unsigned VarSave = 0;
+  if (DFI && FI != DFI->getVarArgsFrameIndex())
+    VarSave = DFI->getVarArgsSaveSize();
+
+  return StackOffset::getFixed(MFI.getObjectOffset(FI) + StackSize + VarSave);
 }
\ No newline at end of file
