+SDValue DADAOTargetLowering::lowerDYNAMIC_STACKALLOC(SDValue Op,
+                                                     SelectionDAG &DAG) const {
+  SDLoc DL(Op);
+  SDValue Chain = Op.getOperand(0);
+  SDValue Size = Op.getOperand(1);
+
+  // Serialize the real rb1 update with other stack users.  This is a genuine
+  // SP change; the surrounding zero-sized call-sequence markers only carry
+  // ordering and are erased by frame lowering.
+  Chain = DAG.getCALLSEQ_START(Chain, 0, 0, DL);
+  SDValue SP = DAG.getCopyFromReg(Chain, DL, DADAO::RB1, MVT::i64);
+  Chain = SP.getValue(1);
+
+  SDValue NewSP = DAG.getNode(ISD::SUB, DL, MVT::i64, SP, Size);
+  Align Alignment = cast<ConstantSDNode>(Op.getOperand(2))->getAlignValue();
+  if (Alignment > Align(8))
+    NewSP =
+        DAG.getNode(ISD::AND, DL, MVT::i64, NewSP,
+                    DAG.getSignedConstant(-Alignment.value(), DL, MVT::i64));
+
+  Chain = DAG.getCopyToReg(Chain, DL, DADAO::RB1, NewSP);
+  Chain = DAG.getCALLSEQ_END(Chain, 0, 0, SDValue(), DL);
+
+  // Keep the outgoing-argument area below the returned dynamic object.  The
+  // final offset is not known until frame layout, so defer it to a pseudo.
+  SDValue Address = DAG.getNode(DADAOISD::ADJDYNALLOC, DL, MVT::i64, NewSP);
+  return DAG.getMergeValues({Address, Chain}, DL);
+}
+
+SDValue DADAOTargetLowering::lowerFRAMEADDR(SDValue Op,
+                                            SelectionDAG &DAG) const {
+  MachineFrameInfo &MFI = DAG.getMachineFunction().getFrameInfo();
+  MFI.setFrameAddressIsTaken(true);
+
+  SDLoc DL(Op);
+  EVT VT = Op.getValueType();
+  SDValue FrameAddr =
+      DAG.getCopyFromReg(DAG.getEntryNode(), DL, DADAO::RB2, VT);
+
+  // rb2 points directly at the slot containing the caller's saved rb2.
+  // Following that zero-offset chain therefore walks older frames.
+  unsigned Depth = Op.getConstantOperandVal(0);
+  while (Depth--)
+    FrameAddr = DAG.getLoad(VT, DL, DAG.getEntryNode(), FrameAddr,
+                            MachinePointerInfo());
+  return FrameAddr;
+}
+
 SDValue DADAOTargetLowering::LowerBR_CC(SDValue Op, SelectionDAG &DAG) const {
   SDValue Chain = Op.getOperand(0);
   ISD::CondCode CC = cast<CondCodeSDNode>(Op.getOperand(1))->get();
