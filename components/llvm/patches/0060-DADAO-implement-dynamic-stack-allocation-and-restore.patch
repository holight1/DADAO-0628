@@ -20,6 +21,21 @@ using namespace llvm;
 
 char llvm::DADAOMachineFunctionInfo::ID = 0;
 
+static SDValue getOutgoingStackAddress(SelectionDAG &DAG, const SDLoc &DL,
+                                       uint64_t Offset) {
+  SDValue SP = DAG.getRegister(DADAO::RB1, MVT::i64);
+  SDValue PtrOff = DAG.getIntPtrConstant(Offset, DL);
+
+  // Small offsets are folded into the load/store's native imms12 addressing
+  // mode by DADAODAGToDAGISel.  A generic ADD cannot represent the large
+  // case: i64 arithmetic is allocated to GPRD, so feeding physical rb1 to it
+  // silently reads the same-numbered RD register.  Keep the base in GPRB and
+  // materialize the large constant in GPRD for the ISA's add-rb operation.
+  if (isInt<12>(static_cast<int64_t>(Offset)))
+    return DAG.getNode(ISD::ADD, DL, MVT::i64, SP, PtrOff);
+  return DAG.getNode(DADAOISD::ADDRB, DL, MVT::i64, SP, PtrOff);
+}
