diff --git a/llvm/lib/Target/DADAO/DADAOFrameLowering.cpp b/llvm/lib/Target/DADAO/DADAOFrameLowering.cpp
index 0181cd0b8d84..9df43912586d 100644
--- a/llvm/lib/Target/DADAO/DADAOFrameLowering.cpp
+++ b/llvm/lib/Target/DADAO/DADAOFrameLowering.cpp
@@ -22,6 +22,11 @@ namespace {
 
 constexpr uint64_t DADAOFrameAlignment = 8;
 
+bool needsDADAOFramePointer(const MachineFunction &MF) {
+  const MachineFrameInfo &MFI = MF.getFrameInfo();
+  return MFI.hasVarSizedObjects() || MFI.isFrameAddressTaken();
+}
+
 bool mayNeedFrameOffsetScavenging(const MachineFunction &MF,
                                   uint64_t EstimatedFrameSize) {
   const MachineFrameInfo &MFI = MF.getFrameInfo();
@@ -74,39 +79,111 @@ bool mayNeedFrameOffsetScavenging(const MachineFunction &MF,
 
 uint64_t getDADAOFrameSize(const MachineFunction &MF) {
   const MachineFrameInfo &MFI = MF.getFrameInfo();
-  return alignTo(MFI.getStackSize(), DADAOFrameAlignment);
+  // An FP frame has one ABI-mandated slot at incoming_sp - 8 for the
+  // caller's rb2.  It is managed explicitly in the prologue/epilogue and
+  // therefore is not represented by a MachineFrameInfo object.
+  uint64_t FPSlot = needsDADAOFramePointer(MF) ? 8 : 0;
+  return alignTo(MFI.getStackSize() + FPSlot, DADAOFrameAlignment);
 }
 
 } // namespace
 
+bool DADAOFrameLowering::hasFPImpl(const MachineFunction &MF) const {
+  // Once a dynamic allocation moves rb1, fixed objects and spills need a
+  // stable base.  The ABI-designated frame pointer is rb2.
+  return needsDADAOFramePointer(MF);
+}
+
+void DADAOFrameLowering::replaceAdjDynAllocPseudo(MachineFunction &MF) const {
+  const DADAOInstrInfo *TII = MF.getSubtarget<DADAOSubtarget>().getInstrInfo();
+  uint64_t MaxCallFrameSize = MF.getFrameInfo().getMaxCallFrameSize();
+
+  for (MachineBasicBlock &MBB : MF) {
+    for (MachineInstr &MI : llvm::make_early_inc_range(MBB)) {
+      if (MI.getOpcode() != DADAO::ADJDYNALLOC)
+        continue;
+
+      DebugLoc DL = MI.getDebugLoc();
+      Register Dst = MI.getOperand(0).getReg();
+      Register Src = MI.getOperand(1).getReg();
+
+      // The actual SP stays below the reserved outgoing-argument area.
+      // Return a pointer above that area so later calls cannot overwrite the
+      // dynamic object.  Src is in RD because the runtime subtraction is
+      // ordinary i64 arithmetic; bridge the final address back to RB.
+      BuildMI(MBB, MI, DL, TII->get(DADAO::RD2RB_ORRI), Dst)
+          .addReg(Src)
+          .addImm(1);
+      if (MaxCallFrameSize) {
+        if (isInt<12>(MaxCallFrameSize)) {
+          BuildMI(MBB, MI, DL, TII->get(DADAO::ADDI_RBRRII), Dst)
+              .addReg(Dst)
+              .addImm(MaxCallFrameSize);
+        } else {
+          TII->materializeImm64(MBB, MI, DL, DADAO::RD2, MaxCallFrameSize);
+          BuildMI(MBB, MI, DL, TII->get(DADAO::ADDRB_ORRR), Dst)
+              .addReg(Dst)
+              .addReg(DADAO::RD2, RegState::Kill);
+        }
+      }
+      MI.eraseFromParent();
+    }
+  }
+}
+
 void DADAOFrameLowering::emitPrologue(MachineFunction &MF,
                                       MachineBasicBlock &MBB) const {
   const DADAOInstrInfo *TII = MF.getSubtarget<DADAOSubtarget>().getInstrInfo();
 
   uint64_t StackSize = getDADAOFrameSize(MF);
+  bool HasFP = hasFP(MF);
   if (StackSize == 0)
     return;
 
   MachineBasicBlock::iterator MBBI = MBB.begin();
   DebugLoc DL = MBBI != MBB.end() ? MBBI->getDebugLoc() : DebugLoc();
 
+  if (HasFP) {
+    // contracts/abi/spec.md §5.2:
+    //   [incoming_sp - 8] = old rb2
+    //   rb2 = incoming_sp - 8
+    BuildMI(MBB, MBBI, DL, TII->get(DADAO::STO_RBRRII))
+        .addReg(DADAO::RB2)
+        .addReg(DADAO::RB1)
+        .addImm(-8)
+        .setMIFlag(MachineInstr::FrameSetup);
+    BuildMI(MBB, MBBI, DL, TII->get(DADAO::RB2RB_ORRI), DADAO::RB2)
+        .addReg(DADAO::RB1)
+        .addImm(1)
+        .setMIFlag(MachineInstr::FrameSetup);
+    BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDI_RBRRII), DADAO::RB2)
+        .addReg(DADAO::RB2)
+        .addImm(-8)
+        .setMIFlag(MachineInstr::FrameSetup);
+  }
+
   int64_t Adjustment = -static_cast<int64_t>(StackSize);
   if (isInt<12>(Adjustment)) {
-    BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDI_RBRRII), DADAO::RB1)
+    MachineInstrBuilder MIB =
+        BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDI_RBRRII), DADAO::RB1)
+            .addReg(DADAO::RB1)
+            .addImm(Adjustment);
+    if (HasFP)
+      MIB.setMIFlag(MachineInstr::FrameSetup);
+  } else {
+    // RD2 is ABI-reserved and never allocated.  Integer arguments start at
+    // RD16, so using RD2 before any callee code cannot destroy an incoming
+    // argument.
+    TII->materializeImm64(MBB, MBBI, DL, DADAO::RD2, Adjustment,
+                          MachineInstr::FrameSetup);
+    BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDRB_ORRR), DADAO::RB1)
         .addReg(DADAO::RB1)
-        .addImm(Adjustment);
-    return;
+        .addReg(DADAO::RD2, RegState::Kill)
+        .setMIFlag(MachineInstr::FrameSetup);
   }
 
-  // RD2 is ABI-reserved and never allocated.  Integer arguments start at
-  // RD16, so using RD2 before any callee code cannot destroy an incoming
-  // argument.
-  TII->materializeImm64(MBB, MBBI, DL, DADAO::RD2, Adjustment,
-                        MachineInstr::FrameSetup);
-  BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDRB_ORRR), DADAO::RB1)
-      .addReg(DADAO::RB1)
-      .addReg(DADAO::RD2, RegState::Kill)
-      .setMIFlag(MachineInstr::FrameSetup);
+  if (HasFP)
+    replaceAdjDynAllocPseudo(MF);
 }
 
 void DADAOFrameLowering::emitEpilogue(MachineFunction &MF,
@@ -114,12 +191,28 @@ void DADAOFrameLowering::emitEpilogue(MachineFunction &MF,
   const DADAOInstrInfo *TII = MF.getSubtarget<DADAOSubtarget>().getInstrInfo();
 
   uint64_t StackSize = getDADAOFrameSize(MF);
+  bool HasFP = hasFP(MF);
   if (StackSize == 0)
     return;
 
   MachineBasicBlock::iterator MBBI = MBB.getFirstTerminator();
   DebugLoc DL = MBBI != MBB.end() ? MBBI->getDebugLoc() : DebugLoc();
 
+  if (HasFP) {
+    // Dynamic allocations may still be live at function exit, so restore
+    // rb1 from the stable frame pointer instead of adding a fixed size to a
+    // moving SP.  Then recover the caller's rb2 from its ABI slot.
+    BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDI_RBRRII), DADAO::RB1)
+        .addReg(DADAO::RB2)
+        .addImm(8)
+        .setMIFlag(MachineInstr::FrameDestroy);
+    BuildMI(MBB, MBBI, DL, TII->get(DADAO::LDO_RBRRII), DADAO::RB2)
+        .addReg(DADAO::RB1)
+        .addImm(-8)
+        .setMIFlag(MachineInstr::FrameDestroy);
+    return;
+  }
+
   int64_t Adjustment = static_cast<int64_t>(StackSize);
   if (isInt<12>(Adjustment)) {
     BuildMI(MBB, MBBI, DL, TII->get(DADAO::ADDI_RBRRII), DADAO::RB1)
@@ -145,6 +238,8 @@ void DADAOFrameLowering::processFunctionBeforeFrameFinalized(
     return;
 
   uint64_t EstimatedFrameSize = MFI.estimateStackSize(MF);
+  if (hasFP(MF))
+    EstimatedFrameSize += 8;
   if (!mayNeedFrameOffsetScavenging(MF, EstimatedFrameSize))
     return;
 
@@ -161,6 +256,18 @@ StackOffset
 DADAOFrameLowering::getFrameIndexReference(const MachineFunction &MF, int FI,
                                            Register &FrameReg) const {
   const MachineFrameInfo &MFI = MF.getFrameInfo();
+  if (hasFP(MF)) {
+    FrameReg = DADAO::RB2;
+
+    // rb2 points at incoming_sp - 8.  Incoming fixed objects therefore gain
+    // 8, while ordinary locals retain their negative MFI offset and are
+    // naturally placed below the saved-FP slot.
+    int64_t Offset = MFI.getObjectOffset(FI);
+    if (MFI.isFixedObjectIndex(FI))
+      Offset += 8;
+    return StackOffset::getFixed(Offset);
+  }
+
   FrameReg = DADAO::RB1;
 
   int64_t FrameSize = static_cast<int64_t>(getDADAOFrameSize(MF));
