   // Call lowering writes outgoing stack arguments (including the unified
   // varargs save area) at SP-relative offsets.  Reserve the largest such
@@ -33,6 +33,9 @@ public:
                                 MachineBasicBlock::iterator MI) const override {
     return MBB.erase(MI);
   }
+
+private:
+  void replaceAdjDynAllocPseudo(MachineFunction &MF) const;
 };
 
