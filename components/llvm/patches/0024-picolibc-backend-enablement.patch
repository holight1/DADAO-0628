+SDValue DADAOTargetLowering::lowerBRCOND(SDValue Op,
+                                          SelectionDAG &DAG) const {
+  SDLoc DL(Op);
+  SDValue Cond = Op.getOperand(1);
+  SDValue Dest = Op.getOperand(2);
+  EVT VT = Cond.getValueType();
+  if (VT == MVT::i1)
+    Cond = DAG.getNode(ISD::ZERO_EXTEND, DL, MVT::i64, Cond);
+  return DAG.getNode(ISD::BR_CC, DL, MVT::Other,
+                     Op.getOperand(0),
+                     DAG.getCondCode(ISD::SETNE),
+                     Cond,
+                     DAG.getConstant(0, DL, MVT::i64),
+                     Dest);
+}
+
+SDValue DADAOTargetLowering::lowerBRIND(SDValue Op,
+                                        SelectionDAG &DAG) const {
+  SDLoc DL(Op);
+  return DAG.getNode(DADAOISD::BRIND, DL, MVT::Other,
+                     Op.getOperand(0), Op.getOperand(1));
+}
+
+SDValue DADAOTargetLowering::lowerJumpTable(SDValue Op,
+                                             SelectionDAG &DAG) const {
+  SDLoc DL(Op);
+  JumpTableSDNode *N = cast<JumpTableSDNode>(Op);
+  SDValue TJT = DAG.getTargetJumpTable(N->getIndex(), MVT::i64);
+  return DAG.getNode(DADAOISD::JT_ADDR, DL, MVT::i64, TJT);
+}
+
+SDValue DADAOTargetLowering::lowerConstantPool(SDValue Op,
+                                               SelectionDAG &DAG) const {
+  SDLoc DL(Op);
+  ConstantPoolSDNode *N = cast<ConstantPoolSDNode>(Op);
+  SDValue TCP = DAG.getTargetConstantPool(N->getConstVal(), MVT::i64,
+                                           N->getAlign(), N->getOffset());
+  return DAG.getNode(DADAOISD::CP_ADDR, DL, MVT::i64, TCP);
+}
+
+SDValue DADAOTargetLowering::lowerVASTART(SDValue Op,
+                                          SelectionDAG &DAG) const {
+  MachineFunction &MF = DAG.getMachineFunction();
+  DADAOMachineFunctionInfo *FuncInfo =
+      MF.getInfo<DADAOMachineFunctionInfo>();
+
+  SDLoc DL(Op);
+  SDValue FI = DAG.getFrameIndex(FuncInfo->getVarArgsFrameIndex(),
+                                 getPointerTy(MF.getDataLayout()));
+
+  const Value *SV = cast<SrcValueSDNode>(Op.getOperand(2))->getValue();
+  return DAG.getStore(Op.getOperand(0), DL, FI, Op.getOperand(1),
+                      MachinePointerInfo(SV));
+}
+
 SDValue DADAOTargetLowering::PerformDAGCombine(SDNode *N,
                                                 DAGCombinerInfo &DCI) const {
   SelectionDAG &DAG = DCI.DAG;
