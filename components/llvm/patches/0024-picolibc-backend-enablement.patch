+// Indirect-call pseudo (expandPostRAPseudo resolves to real CALL_RRII, same
+// two-stage scheme as ADD_PSEUDO/RET_PSEUDO above). Direct calls (callee is
+// a GlobalAddress/ExternalSymbol) stay on the pre-existing manual DAGToDAG
+// construction of CALL_IIII (ML-003d ground-truth: binding tglobaladdr /
+// texternalsym directly as a Pat<> operand for a chain+glue DADAOcall node
+// — pseudo or not — trips a DAG scheduler BuildSchedUnits assertion; a plain
+// Pseudo indirect call — uses F_IIII format (imm24 field unused, carries no
+// explicit result; chain+glue come from isCall). DADAOPseudo was avoided because
+// it infers a spurious MVT::i64 result from the first input operand.
+let isCall = 1,
+    Defs = [RD31],
+    Uses = [RD16, RD17, RD18, RD19, RD20, RD21, RD22, RD23,
+            RD24, RD25, RD26, RD27, RD28, RD29, RD30],
+    isPseudo = 1,
+    isCodeGenOnly = 1,
