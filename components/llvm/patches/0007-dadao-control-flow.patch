+#include "MCTargetDesc/DADAOMCTargetDesc.h"
+#include "llvm/MC/MCAsmBackend.h"
+#include "llvm/MC/MCELFObjectWriter.h"
+#include "llvm/MC/MCFixup.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/MC/MCObjectWriter.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/Support/EndianStream.h"
+#include "llvm/Support/ErrorHandling.h"
+#include "llvm/Support/raw_ostream.h"
+
+using namespace llvm;
+
+namespace {
+
+class DADAOAsmBackend : public MCAsmBackend {
+public:
+  DADAOAsmBackend(const Target &T, Triple::OSType OST)
+      : MCAsmBackend(llvm::endianness::big) {}
+
+  void applyFixup(const MCFragment &F, const MCFixup &Fixup,
+                  const MCValue &Target, uint8_t *Data, uint64_t Value,
+                  bool IsResolved) override {
+    unsigned Offset = Fixup.getOffset();
+    unsigned Kind = Fixup.getKind();
+
+    if (Kind == DADAO::fixup_dadao_call24) {
+      int64_t Imm24 = (static_cast<int64_t>(Value) - 4) >> 2;
+      uint32_t Mask = 0xFFFFFF;
+      uint32_t Enc = (Imm24 & Mask) | (support::endian::read32be(Data) & ~Mask);
+      support::endian::write32be(Data, Enc);
+      return;
+    }
+
+    if (Kind == DADAO::fixup_dadao_branch18) {
+      int64_t Imm18 = (static_cast<int64_t>(Value) - 4) >> 2;
+      uint32_t Mask = 0x3FFFF;
+      uint32_t Enc = (Imm18 & Mask) | (support::endian::read32be(Data) & ~Mask);
+      support::endian::write32be(Data, Enc);
+      return;
+    }
+
+    if (Kind == DADAO::fixup_dadao_branch12) {
+      int64_t Imm12 = (static_cast<int64_t>(Value) - 4) >> 2;
+      uint32_t Mask = 0xFFF;
+      uint32_t Enc = (Imm12 & Mask) | (support::endian::read32be(Data) & ~Mask);
+      support::endian::write32be(Data, Enc);
+      return;
+    }
+
+    if (IsResolved)
+      support::endian::write32be(Data + Offset,
+                                  static_cast<uint32_t>(Value) & 0xFFFFFFFF);
+  }
+
+  std::unique_ptr<MCObjectTargetWriter>
+  createObjectTargetWriter() const override {
+    return createDADAOELFObjectWriter(ELF::ELFOSABI_NONE);
+  }
+
+  MCFixupKindInfo getFixupKindInfo(MCFixupKind Kind) const override {
+    if (Kind < FirstTargetFixupKind)
+      return MCAsmBackend::getFixupKindInfo(Kind);
+    if (Kind == DADAO::fixup_dadao_call24) {
+      MCFixupKindInfo Info;
+      Info.Name = "fixup_dadao_call24";
+      Info.TargetOffset = 0;
+      Info.TargetSize = 24;
+      Info.Flags = 0;
+      return Info;
+    }
+    if (Kind == DADAO::fixup_dadao_branch18) {
+      MCFixupKindInfo Info;
+      Info.Name = "fixup_dadao_branch18";
+      Info.TargetOffset = 0;
+      Info.TargetSize = 18;
+      Info.Flags = 0;
+      return Info;
+    }
+    if (Kind == DADAO::fixup_dadao_branch12) {
+      MCFixupKindInfo Info;
+      Info.Name = "fixup_dadao_branch12";
+      Info.TargetOffset = 0;
+      Info.TargetSize = 12;
+      Info.Flags = 0;
+      return Info;
+    }
+    llvm_unreachable("Unknown fixup kind");
+  }
+
+  bool writeNopData(raw_ostream &OS, uint64_t Count,
+                    const MCSubtargetInfo *STI) const override {
+    if ((Count % 4) != 0)
+      return false;
+    for (uint64_t i = 0; i < Count; i += 4)
+      OS.write("\x15\x00\x00\x00", 4);
+    return true;
+  }
+};
+
+} // end anonymous namespace
+
+MCAsmBackend *llvm::createDADAOAsmBackend(const Target &T,
+                                          const MCSubtargetInfo &STI,
+                                          const MCRegisterInfo &,
+                                          const MCTargetOptions &) {
+  const Triple &TT = STI.getTargetTriple();
+  if (!TT.isOSBinFormatELF())
+    llvm_unreachable("OS not supported");
+  return new DADAOAsmBackend(T, TT.getOS());
+}
