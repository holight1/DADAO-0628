@@ -0,0 +1,57 @@
+//===-- DADAOISelLowering.h - DADAO DAG Lowering Interface ------*- C++ -*-===//
+#ifndef LLVM_LIB_TARGET_DADAO_DADAOISELLOWERING_H
+#define LLVM_LIB_TARGET_DADAO_DADAOISELLOWERING_H
+
+#include "llvm/CodeGen/TargetLowering.h"
+
+namespace llvm {
+
+namespace DADAOISD {
+enum NodeType {
+  FIRST_NUMBER = ISD::BUILTIN_OP_END,
+  RET_GLUE,
+  CALL,
+  BREQ,   // (chain, lhs, rhs, dest) — breq  two-reg compare-equal branch
+  BRNE,   // (chain, lhs, rhs, dest) — brne  two-reg compare-not-equal branch
+  BRZ,    // (chain, val, dest) — brz   branch if val==0
+  BRNZ,   // (chain, val, dest) — brnz  branch if val!=0
+  BRN,    // (chain, val, dest) — brn   branch if val<0  (negative)
+  BRNN,   // (chain, val, dest) — brnn  branch if val>=0 (non-negative)
+  BRP,    // (chain, val, dest) — brp   branch if val>0  (positive)
+  BRNP,   // (chain, val, dest) — brnp  branch if val<=0 (non-positive)
+  CMP,    // (lhs, rhs) → i64  cmps result (−1/0/1)
+};
+} // namespace DADAOISD
+
+class DADAOSubtarget;
+class DADAOTargetMachine;
+
+class DADAOTargetLowering : public TargetLowering {
+public:
+  explicit DADAOTargetLowering(const TargetMachine &TM,
+                               const DADAOSubtarget &STI);
+
+  SDValue LowerFormalArguments(SDValue Chain, CallingConv::ID CallConv,
+                               bool IsVarArg,
+                               const SmallVectorImpl<ISD::InputArg> &Ins,
+                               const SDLoc &DL, SelectionDAG &DAG,
+                               SmallVectorImpl<SDValue> &InVals) const override;
+
+  SDValue LowerReturn(SDValue Chain, CallingConv::ID CallConv, bool IsVarArg,
+                      const SmallVectorImpl<ISD::OutputArg> &Outs,
+                      const SmallVectorImpl<SDValue> &OutVals,
+                      const SDLoc &DL, SelectionDAG &DAG) const override;
+
+  SDValue LowerCall(TargetLowering::CallLoweringInfo &CLI,
+                    SmallVectorImpl<SDValue> &InVals) const override;
+
+  SDValue LowerOperation(SDValue Op, SelectionDAG &DAG) const override;
+
+  SDValue PerformDAGCombine(SDNode *N, DAGCombinerInfo &DCI) const override;
+
+private:
+  SDValue LowerBR_CC(SDValue Op, SelectionDAG &DAG) const;
+};
+
+} // namespace llvm
+#endif
