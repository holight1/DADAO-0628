+             Opcode == DADAO::BRP_RIII || Opcode == DADAO::BRNP_RIII)
+      Kind = MCFixupKind(DADAO::fixup_dadao_branch18);
+    else if (Opcode == DADAO::BREQ_RRII || Opcode == DADAO::BRNE_RRII)
+      Kind = MCFixupKind(DADAO::fixup_dadao_branch12);
+    else
+      Kind = MCFixupKind(FK_SecRel_4);
+    Fixups.push_back(MCFixup::create(0, MO.getExpr(), Kind));
+    return 0;
+  }
+  llvm_unreachable("Unknown operand type");
 }
 
