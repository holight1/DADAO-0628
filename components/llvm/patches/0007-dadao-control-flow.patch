+//===-- DADAOInstrInfo.cpp - DADAO Instruction Information ----------------===//
+#include "DADAOInstrInfo.h"
+#include "DADAOSubtarget.h"
+#include "MCTargetDesc/DADAOMCTargetDesc.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineInstrBuilder.h"
+#include "llvm/CodeGen/MachineMemOperand.h"
+
+using namespace llvm;
+
+#define GET_INSTRINFO_CTOR_DTOR
+#include "DADAOGenInstrInfo.inc"
+
+DADAOInstrInfo::DADAOInstrInfo(const DADAOSubtarget &STI)
+    : DADAOGenInstrInfo(STI, RI, /*CFSetup=*/0, /*CFDestroy=*/0,
+                        /*CatchRet=*/0, /*ReturnOpcode=*/0) {}
+
+void DADAOInstrInfo::copyPhysReg(MachineBasicBlock &MBB,
+                                  MachineBasicBlock::iterator MBBI,
+                                  const DebugLoc &DL, Register DstReg,
+                                  Register SrcReg, bool KillSrc,
+                                  bool RenamableDest,
+                                  bool RenamableSrc) const {
+  if (DADAO::GPRBRegClass.contains(DstReg) &&
+      DADAO::GPRDRegClass.contains(SrcReg)) {
+    BuildMI(MBB, MBBI, DL, get(DADAO::RD2RB_ORRI), DstReg)
+        .addReg(SrcReg, getKillRegState(KillSrc))
+        .addImm(1);
+    return;
+  }
+  if (DADAO::GPRDRegClass.contains(DstReg) &&
+      DADAO::GPRBRegClass.contains(SrcReg)) {
+    BuildMI(MBB, MBBI, DL, get(DADAO::RB2RD_ORRI), DstReg)
+        .addReg(SrcReg, getKillRegState(KillSrc))
+        .addImm(1);
+    return;
+  }
+  if (DADAO::GPRDRegClass.contains(DstReg) &&
+      DADAO::GPRDRegClass.contains(SrcReg)) {
+    BuildMI(MBB, MBBI, DL, get(DADAO::ADDI_RRII), DstReg)
+        .addReg(SrcReg, getKillRegState(KillSrc))
+        .addImm(0);
+    return;
+  }
+  if (DADAO::GPRBRegClass.contains(DstReg) &&
+      DADAO::GPRBRegClass.contains(SrcReg)) {
+    BuildMI(MBB, MBBI, DL, get(DADAO::ADDI_RBRRII), DstReg)
+        .addReg(SrcReg, getKillRegState(KillSrc))
+        .addImm(0);
+    return;
+  }
+  llvm_unreachable("copyPhysReg: unsupported register class pair");
+}
+
+bool DADAOInstrInfo::expandPostRAPseudo(MachineInstr &MI) const {
+  MachineBasicBlock &MBB = *MI.getParent();
+  DebugLoc DL = MI.getDebugLoc();
+
+  switch (MI.getOpcode()) {
+  case DADAO::ADD_PSEUDO: {
+    Register Dst = MI.getOperand(0).getReg();
+    Register Src1 = MI.getOperand(1).getReg();
+    Register Src2 = MI.getOperand(2).getReg();
+    MachineInstrBuilder MIB =
+        BuildMI(MBB, MI, DL, get(DADAO::ADD_RRRR))
+            .addReg(DADAO::RD0) // rdha = rd0 (discard high)
+            .addReg(Dst)        // rdhb = dst
+            .addReg(Src1)       // rdhc = src1
+            .addReg(Src2);      // rdhd = src2
+    MI.eraseFromParent();
+    return true;
+  }
+  case DADAO::SUB_PSEUDO: {
+    Register Dst = MI.getOperand(0).getReg();
+    Register Src1 = MI.getOperand(1).getReg();
+    Register Src2 = MI.getOperand(2).getReg();
+    BuildMI(MBB, MI, DL, get(DADAO::SUB_RRRR))
+        .addReg(DADAO::RD0) // rdha = rd0 (discard high)
+        .addReg(Dst)        // rdhb = dst
+        .addReg(Src1)       // rdhc = src1
+        .addReg(Src2);      // rdhd = src2
+    MI.eraseFromParent();
+    return true;
+  }
+  case DADAO::RET_PSEUDO: {
+    BuildMI(MBB, MI, DL, get(DADAO::RET_RIII))
+        .addReg(DADAO::RD0) // rdha = rd0 (value already in $rd31)
+        .addImm(0);          // imm18 = 0
+    MI.eraseFromParent();
+    return true;
+  }
+  }
+  return false;
+}
+
+void DADAOInstrInfo::storeRegToStackSlot(
+    MachineBasicBlock &MBB, MachineBasicBlock::iterator MBBI, Register SrcReg,
+    bool IsKill, int FrameIndex, const TargetRegisterClass *RC, Register VReg,
+    MachineInstr::MIFlag Flags) const {
+  DebugLoc DL = MBB.findDebugLoc(MBBI);
+  MachineFunction &MF = *MBB.getParent();
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+  MachineMemOperand *MMO = MF.getMachineMemOperand(
+      MachinePointerInfo::getFixedStack(MF, FrameIndex),
+      MachineMemOperand::MOStore, MFI.getObjectSize(FrameIndex),
+      Align(8));
+  if (RC == &DADAO::GPRDRegClass || RC == &DADAO::GPRD_AllocatableRegClass) {
+    BuildMI(MBB, MBBI, DL, get(DADAO::STO_FI))
+        .addReg(SrcReg, getKillRegState(IsKill))
+        .addReg(DADAO::RB1)
+        .addImm(0)
+        .addFrameIndex(FrameIndex)
+        .addMemOperand(MMO);
+  } else {
+    llvm_unreachable("storeRegToStackSlot: unsupported register class");
+  }
+}
+
+void DADAOInstrInfo::loadRegFromStackSlot(
+    MachineBasicBlock &MBB, MachineBasicBlock::iterator MBBI, Register DstReg,
+    int FrameIndex, const TargetRegisterClass *RC, Register VReg,
+    unsigned SubReg, MachineInstr::MIFlag Flags) const {
+  DebugLoc DL = MBB.findDebugLoc(MBBI);
+  MachineFunction &MF = *MBB.getParent();
+  MachineFrameInfo &MFI = MF.getFrameInfo();
+  MachineMemOperand *MMO = MF.getMachineMemOperand(
+      MachinePointerInfo::getFixedStack(MF, FrameIndex),
+      MachineMemOperand::MOLoad, MFI.getObjectSize(FrameIndex),
+      Align(8));
+  if (RC == &DADAO::GPRDRegClass || RC == &DADAO::GPRD_AllocatableRegClass) {
+    BuildMI(MBB, MBBI, DL, get(DADAO::LDO_FI))
+        .addDef(DstReg)
+        .addReg(DADAO::RB1)
+        .addImm(0)
+        .addFrameIndex(FrameIndex)
+        .addMemOperand(MMO);
+  } else {
+    llvm_unreachable("loadRegFromStackSlot: unsupported register class");
+  }
+}
