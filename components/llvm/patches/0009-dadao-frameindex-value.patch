+//===-- DADAOISelDAGToDAG.cpp - DADAO DAG to DAG Instruction Selector ------===//
+#include "DADAO.h"
+#include "DADAOISelLowering.h"
+#include "DADAOTargetMachine.h"
+#include "MCTargetDesc/DADAOMCTargetDesc.h"
+#include "llvm/CodeGen/MachineFrameInfo.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/SelectionDAGISel.h"
+
+using namespace llvm;
+
+namespace {
+
+class DADAODAGToDAGISel : public SelectionDAGISel {
+public:
+  DADAODAGToDAGISel(DADAOTargetMachine &TM)
+      : SelectionDAGISel(TM) {}
+
+  void Select(SDNode *Node) override;
+  bool SelectInlineAsmMemoryOperand(const SDValue &Op,
+                                    InlineAsm::ConstraintCode ConstraintID,
+                                    std::vector<SDValue> &OutOps) override {
+    return false;
+  }
+
+// Provides SelectCode() from the generated matcher table.
+#include "DADAOGenDAGISel.inc"
+};
+
+void DADAODAGToDAGISel::Select(SDNode *Node) {
+  if (Node->isMachineOpcode()) {
+    Node->setNodeId(-1);
+    return;
+  }
+
+  unsigned Opc = Node->getOpcode();
+  if (Opc == ISD::CALLSEQ_START || Opc == ISD::CALLSEQ_END) {
+    ReplaceUses(SDValue(Node, 0), Node->getOperand(0));
+    CurDAG->RemoveDeadNode(Node);
+    return;
+  }
+
+  if (Opc == ISD::Constant) {
+    ConstantSDNode *C = cast<ConstantSDNode>(Node);
+    int64_t Val = C->getSExtValue();
+    SDNode *New = CurDAG->getMachineNode(DADAO::ADDI_RRII, SDLoc(Node),
+                                          MVT::i64,
+                                          {CurDAG->getRegister(DADAO::RD0, MVT::i64),
+                                           CurDAG->getTargetConstant(Val, SDLoc(Node), MVT::i64)});
+    ReplaceNode(Node, New);
+    return;
+  }
+
+  if (Opc == DADAOISD::FI_ADDR) {
+    SDLoc DL(Node);
+    SDValue TFI = Node->getOperand(0);
+    SDValue RB1 = CurDAG->getRegister(DADAO::RB1, MVT::i64);
+    SDNode *New = CurDAG->getMachineNode(DADAO::ADDI_RB_FI, DL, MVT::i64,
+                                          {RB1, TFI});
+    ReplaceNode(Node, New);
+    return;
+  }
+
+  if (Opc != ISD::LOAD && Opc != ISD::STORE) {
+    if (Opc == DADAOISD::CALL) {
+      SDLoc DLC(Node);
+      SDValue Chain = Node->getOperand(0);
+      SDValue Callee = Node->getOperand(1);
+      SDValue Glue = Node->getOperand(2);
+      MachineSDNode *Call = CurDAG->getMachineNode(
+          DADAO::CALL_IIII, DLC, MVT::Other, MVT::Glue,
+          {Callee, Chain, Glue});
+      ReplaceNode(Node, Call);
+      return;
+    }
+    SelectCode(Node);
+    return;
+  }
+
+  SDLoc DL(Node);
+  bool IsLoad = (Opc == ISD::LOAD);
+
+  SDValue Chain, Val, Addr;
+  if (IsLoad) {
+    LoadSDNode *LD = cast<LoadSDNode>(Node);
+    Chain = LD->getChain();
+    Addr = LD->getBasePtr();
+  } else {
+    StoreSDNode *ST = cast<StoreSDNode>(Node);
+    Chain = ST->getChain();
+    Val = ST->getValue();
+    Addr = ST->getBasePtr();
+  }
+
+  int64_t GEPOff = 0;
+  SDValue BaseAddr = Addr;
+
+  if (Addr.getOpcode() == ISD::ADD &&
+      isa<ConstantSDNode>(Addr.getOperand(1))) {
+    BaseAddr = Addr.getOperand(0);
+    GEPOff = cast<ConstantSDNode>(Addr.getOperand(1))->getSExtValue();
+  }
+
+  if (BaseAddr.getOpcode() == ISD::FrameIndex) {
+    int FI = cast<FrameIndexSDNode>(BaseAddr)->getIndex();
+    unsigned DADAOOpc = IsLoad ? DADAO::LDO_FI : DADAO::STO_FI;
+    SDValue BaseReg = CurDAG->getRegister(DADAO::RB1, MVT::i64);
+    SDValue FiOp = CurDAG->getTargetFrameIndex(FI, MVT::i64);
+
+    if (IsLoad) {
+      SDValue Ops[] = {BaseReg,
+                       CurDAG->getTargetConstant(GEPOff, DL, MVT::i64), FiOp,
+                       Chain};
+      SDNode *New = CurDAG->getMachineNode(DADAOOpc, DL, MVT::i64, MVT::Other,
+                                            Ops);
+      ReplaceNode(Node, New);
+    } else {
+      SDValue Ops[] = {Val, BaseReg,
+                       CurDAG->getTargetConstant(GEPOff, DL, MVT::i64), FiOp,
+                       Chain};
+      SDNode *New = CurDAG->getMachineNode(DADAOOpc, DL, MVT::Other, Ops);
+      ReplaceNode(Node, New);
+    }
+    return;
+  }
+
+  // Non-FrameIndex address: use real LDO/STO directly
+  unsigned DADAOOpc = IsLoad ? DADAO::LDO_RRII : DADAO::STO_RRII;
+  SDValue ImmOp = CurDAG->getTargetConstant(GEPOff, DL, MVT::i64);
+
+  if (IsLoad) {
+    SDValue Ops[] = {BaseAddr, ImmOp, Chain};
+    SDNode *New = CurDAG->getMachineNode(DADAOOpc, DL, MVT::i64, MVT::Other,
+                                          Ops);
+    ReplaceNode(Node, New);
+  } else {
+    SDValue Ops[] = {Val, BaseAddr, ImmOp, Chain};
+    SDNode *New = CurDAG->getMachineNode(DADAOOpc, DL, MVT::Other, Ops);
+    ReplaceNode(Node, New);
+  }
+}
+
+class DADAODAGToDAGISelLegacy : public SelectionDAGISelLegacy {
+public:
+  static char ID;
+  explicit DADAODAGToDAGISelLegacy(DADAOTargetMachine &TM)
+      : SelectionDAGISelLegacy(ID,
+            std::make_unique<DADAODAGToDAGISel>(TM)) {}
+
+  StringRef getPassName() const override {
+    return "DADAO DAG->DAG Pattern Instruction Selection";
+  }
+};
+
+char DADAODAGToDAGISelLegacy::ID = 0;
+
+} // namespace
+
+INITIALIZE_PASS(DADAODAGToDAGISelLegacy, "dadao-isel",
+                "DADAO DAG->DAG Pattern Instruction Selection", false, false)
+
+FunctionPass *llvm::createDADAOISelDag(DADAOTargetMachine &TM) {
+  return new DADAODAGToDAGISelLegacy(TM);
+}
