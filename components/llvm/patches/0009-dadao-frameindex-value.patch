+
+const uint32_t *
+DADAORegisterInfo::getCallPreservedMask(const MachineFunction &MF,
+                                         CallingConv::ID /*CC*/) const {
+  // Compute mask: callee-saved + reserved registers are preserved across calls
+  BitVector Saved(getNumRegs());
+  const uint16_t *CS = getCalleeSavedRegs(&MF);
+  for (unsigned i = 0; CS[i]; ++i)
+    Saved.set(CS[i]);
+  BitVector Reserved = getReservedRegs(MF);
+  Saved |= Reserved;
+
+  static uint32_t Mask[10];
+  unsigned Count = (getNumRegs() + 31) / 32;
+  assert(Count <= 10 && "RegMask too small for DADAO");
+  for (unsigned i = 0; i < Count; ++i) {
+    uint32_t M = 0;
+    for (unsigned b = 0; b < 32; ++b) {
+      unsigned Reg = i * 32 + b;
+      if (Reg < getNumRegs() && Saved.test(Reg))
+        M |= (1U << b);
+    }
+    Mask[i] = M;
+  }
+  return Mask;
 }
 
