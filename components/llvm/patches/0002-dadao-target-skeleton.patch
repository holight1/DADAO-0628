@@ -0,0 +1,68 @@
+//===-- DADAOMCTargetDesc.cpp - DADAO Target Descriptions -----------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file provides DADAO specific target descriptions.
+//
+//===----------------------------------------------------------------------===//
+
+#include "DADAOMCTargetDesc.h"
+#include "DADAOAsmInfo.h"
+#include "DADAOInstPrinter.h"
+#include "TargetInfo/DADAOTargetInfo.h"
+#include "llvm/MC/MCInstPrinter.h"
+#include "llvm/MC/MCInstrInfo.h"
+#include "llvm/MC/MCRegisterInfo.h"
+#include "llvm/MC/MCSubtargetInfo.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/Compiler.h"
+#include "llvm/TargetParser/Triple.h"
+
+using namespace llvm;
+
+static MCInstrInfo *createDADAOMCInstrInfo() {
+  MCInstrInfo *X = new MCInstrInfo();
+  return X;
+}
+
+static MCRegisterInfo *createDADAOMCRegisterInfo(const Triple & /*TT*/) {
+  MCRegisterInfo *X = new MCRegisterInfo();
+  return X;
+}
+
+static MCSubtargetInfo *
+createDADAOMCSubtargetInfo(const Triple &TT, StringRef CPU, StringRef FS) {
+  return new MCSubtargetInfo(TT, CPU, /*TuneCPU*/ CPU, FS, {}, {}, {}, nullptr,
+                             nullptr, nullptr, nullptr, nullptr, nullptr);
+}
+
+static MCInstPrinter *createDADAOMCInstPrinter(const Triple & /*T*/,
+                                                unsigned SyntaxVariant,
+                                                const MCAsmInfo &MAI,
+                                                const MCInstrInfo &MII,
+                                                const MCRegisterInfo &MRI) {
+  if (SyntaxVariant == 0)
+    return new DADAOInstPrinter(MAI, MII, MRI);
+  return nullptr;
+}
+
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
+LLVMInitializeDADAOTargetMC() {
+  RegisterMCAsmInfo<DADAOAsmInfo> X(getTheDADAOTarget());
+
+  TargetRegistry::RegisterMCInstrInfo(getTheDADAOTarget(),
+                                      createDADAOMCInstrInfo);
+
+  TargetRegistry::RegisterMCRegInfo(getTheDADAOTarget(),
+                                    createDADAOMCRegisterInfo);
+
+  TargetRegistry::RegisterMCSubtargetInfo(getTheDADAOTarget(),
+                                          createDADAOMCSubtargetInfo);
+
+  TargetRegistry::RegisterMCInstPrinter(getTheDADAOTarget(),
+                                        createDADAOMCInstPrinter);
+}
