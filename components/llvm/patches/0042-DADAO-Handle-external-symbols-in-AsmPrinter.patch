From 10690fc4d40dd7d30757b344c2e259cd9c89a5c4 Mon Sep 17 00:00:00 2001
From: suiyan <suiyan@sunmmio.com>
Date: Tue, 21 Jul 2026 17:40:13 +0800
Subject: [PATCH 42/45] [DADAO] Handle external symbols in AsmPrinter

---
 llvm/lib/Target/DADAO/DADAOAsmPrinter.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/llvm/lib/Target/DADAO/DADAOAsmPrinter.cpp b/llvm/lib/Target/DADAO/DADAOAsmPrinter.cpp
index af9d4557bc09..58c4509c9363 100644
--- a/llvm/lib/Target/DADAO/DADAOAsmPrinter.cpp
+++ b/llvm/lib/Target/DADAO/DADAOAsmPrinter.cpp
@@ -109,6 +109,10 @@ private:
         MCOp = MCOperand::createExpr(Expr);
         break;
       }
+      case MachineOperand::MO_ExternalSymbol:
+        MCOp = MCOperand::createExpr(MCSymbolRefExpr::create(
+            GetExternalSymbolSymbol(MO.getSymbolName()), OutContext));
+        break;
       case MachineOperand::MO_JumpTableIndex:
         MCOp = MCOperand::createExpr(
             MCSymbolRefExpr::create(
@@ -130,4 +134,4 @@ private:
 extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void
 LLVMInitializeDADAOAsmPrinter() {
   RegisterAsmPrinter<DADAOAsmPrinter> X(getTheDADAOTarget());
-}
\ No newline at end of file
+}
