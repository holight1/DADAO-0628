diff --git a/hw/dadao/dadao-machine.c b/hw/dadao/dadao-machine.c
new file mode 100644
index 0000000..2fb17da
--- /dev/null
+++ b/hw/dadao/dadao-machine.c
@@ -0,0 +1,105 @@
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "hw/boards.h"
+#include "hw/loader.h"
+#include "hw/qdev-properties.h"
+#include "system/runstate.h"
+#include "system/system.h"
+#include "target/dadao/cpu.h"
+
+#define TYPE_DADAO_M1 "dadao-m1"
+
+static const uint64_t rom_base   = 0x00100000;
+static const uint64_t rom_size   = 64 * KiB;
+static const uint64_t exit_base  = 0x10000000;
+static const uint64_t exit_size  = 8;
+static const uint64_t ram_base   = 0x80000000;
+static const uint64_t ram_size   = 128 * MiB;
+
+static uint64_t exit_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    return 0;
+}
+
+static void exit_write(void *opaque, hwaddr addr,
+                       uint64_t val64, unsigned int size)
+{
+    if (addr == 0 && size == 8) {
+        int code = val64 & 0xff;
+        qemu_system_shutdown_request_with_code(
+            code == 0 ? SHUTDOWN_CAUSE_GUEST_SHUTDOWN
+                      : SHUTDOWN_CAUSE_GUEST_PANIC,
+            code);
+    }
+}
+
+static const MemoryRegionOps exit_ops = {
+    .read = exit_read,
+    .write = exit_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid = {
+        .min_access_size = 8,
+        .max_access_size = 8,
+    },
+};
+
+static void dadao_machine_init(MachineState *machine)
+{
+    MemoryRegion *sys_mem = get_system_memory();
+    MemoryRegion *rom = g_new(MemoryRegion, 1);
+    MemoryRegion *exit_mmio = g_new(MemoryRegion, 1);
+
+    memory_region_init_ram(rom, NULL, "dadao.rom", rom_size, &error_fatal);
+    memory_region_set_readonly(rom, true);
+    memory_region_add_subregion(sys_mem, rom_base, rom);
+
+    memory_region_init_io(exit_mmio, NULL, &exit_ops, NULL,
+                          "dadao.exit", exit_size);
+    memory_region_add_subregion(sys_mem, exit_base, exit_mmio);
+
+    if (machine->ram_size == 0) {
+        machine->ram_size = ram_size;
+    }
+    if (machine->ram_size != ram_size) {
+        error_report("Invalid RAM size, must be %" PRIu64, (uint64_t)ram_size);
+        exit(EXIT_FAILURE);
+    }
+    memory_region_add_subregion(sys_mem, ram_base, machine->ram);
+
+    if (machine->firmware) {
+        load_image_targphys(machine->firmware, rom_base, rom_size);
+    }
+    if (machine->kernel_filename) {
+        load_image_targphys(machine->kernel_filename, ram_base, ram_size);
+    }
+}
+
+static void dadao_machine_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "DADAO M1 test machine";
+    mc->init = dadao_machine_init;
+    mc->max_cpus = 1;
+    mc->min_cpus = 1;
+    mc->default_cpus = 1;
+    mc->is_default = true;
+    mc->default_cpu_type = TYPE_DADAO_CPU;
+    mc->default_ram_size = ram_size;
+    mc->default_ram_id = "dadao.ram";
+}
+
+static const TypeInfo dadao_machine_type = {
+    .name = TYPE_DADAO_M1,
+    .parent = TYPE_MACHINE,
+    .class_init = dadao_machine_class_init,
+};
+
+static void dadao_machine_register_types(void)
+{
+    type_register_static(&dadao_machine_type);
+}
+
+type_init(dadao_machine_register_types)
