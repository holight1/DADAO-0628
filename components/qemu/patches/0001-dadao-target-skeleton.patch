diff --git a/target/dadao/cpu.c b/target/dadao/cpu.c
new file mode 100644
index 0000000..e437632
--- /dev/null
+++ b/target/dadao/cpu.c
@@ -0,0 +1,133 @@
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "cpu.h"
+#include "exec/exec-all.h"
+#include "qapi/error.h"
+#include "migration/vmstate.h"
+#include "system/runstate.h"
+#include "system/system.h"
+#include "hw/qdev-properties.h"
+#include "accel/tcg/cpu-ops.h"
+
+extern const TCGCPUOps dadao_tcg_ops;
+
+void cpu_get_tb_cpu_state(CPUDADAOState *env, vaddr *pc,
+                          uint64_t *cs_base, uint32_t *pflags)
+{
+    *pc = env->pc;
+    *cs_base = 0;
+    *pflags = 0;
+}
+
+static void dadao_cpu_set_pc(CPUState *cs, vaddr value)
+{
+    DADAOCPU *cpu = DADAO_CPU(cs);
+    cpu->env.pc = value;
+}
+
+static vaddr dadao_cpu_get_pc(CPUState *cs)
+{
+    DADAOCPU *cpu = DADAO_CPU(cs);
+    return cpu->env.pc;
+}
+
+static void dadao_cpu_reset_hold(Object *obj, ResetType type)
+{
+    CPUState *cs = CPU(obj);
+    DADAOCPU *cpu = DADAO_CPU(cs);
+    CPUDADAOState *env = &cpu->env;
+    int i;
+
+    for (i = 0; i < 64; i++) {
+        env->rd[i] = 0;
+        env->rb[i] = 0;
+        env->rf[i] = 0;
+        env->ra[i] = 0;
+    }
+    /* rf[0] reset = QNaN per ISA spec §1.2 (contracts/isa/spec.md) */
+    env->rf[0] = UINT64_C(0x7FF800007FC00000);
+    env->pc = 0;
+    cs->exception_index = -1;
+}
+
+static void dadao_cpu_realize(DeviceState *dev, Error **errp)
+{
+    CPUState *cs = CPU(dev);
+    DADAOCPUClass *dcc = DADAO_CPU_GET_CLASS(dev);
+    Error *local_err = NULL;
+
+    cpu_exec_realizefn(cs, &local_err);
+    if (local_err != NULL) {
+        error_propagate(errp, local_err);
+        return;
+    }
+
+    qemu_init_vcpu(cs);
+    cpu_reset(cs);
+    dcc->parent_realize(dev, errp);
+}
+
+static void dadao_cpu_init(Object *obj)
+{
+}
+
+static ObjectClass *dadao_cpu_class_by_name(const char *cpu_model)
+{
+    ObjectClass *oc;
+    char *typename;
+    char **cpuname;
+
+    cpuname = g_strsplit(cpu_model, ",", 1);
+    typename = g_strdup_printf(DADAO_CPU_TYPE_NAME("%s"), cpuname[0]);
+    oc = object_class_by_name(typename);
+    g_strfreev(cpuname);
+    g_free(typename);
+    return oc;
+}
+
+#ifndef CONFIG_USER_ONLY
+void dadao_cpu_do_interrupt(CPUState *cs)
+{
+    qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC, 0x82);
+}
+
+bool dadao_cpu_tlb_fill(CPUState *cs, vaddr address, int size,
+                        MMUAccessType access_type, int mmu_idx,
+                        bool probe, uintptr_t retaddr)
+{
+    qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC, 0x8F);
+    return true;
+}
+#endif
+
+static void dadao_cpu_class_init(ObjectClass *oc, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    CPUClass *cc = CPU_CLASS(oc);
+    DADAOCPUClass *dcc = DADAO_CPU_CLASS(oc);
+    ResettableClass *rc = RESETTABLE_CLASS(oc);
+
+    device_class_set_parent_realize(dc, dadao_cpu_realize,
+                                    &dcc->parent_realize);
+    rc->phases.hold = dadao_cpu_reset_hold;
+
+    cc->class_by_name = dadao_cpu_class_by_name;
+    cc->get_pc = dadao_cpu_get_pc;
+    cc->set_pc = dadao_cpu_set_pc;
+    cc->tcg_ops = &dadao_tcg_ops;
+}
+
+static const TypeInfo dadao_cpu_type_info = {
+    .name = TYPE_DADAO_CPU,
+    .parent = TYPE_CPU,
+    .instance_size = sizeof(DADAOCPU),
+    .instance_init = dadao_cpu_init,
+    .abstract = false,
+    .class_size = sizeof(DADAOCPUClass),
+    .class_init = dadao_cpu_class_init,
+};
+
+static void dadao_cpu_register_types(void)
+{
+    type_register_static(&dadao_cpu_type_info);
+}
+
+type_init(dadao_cpu_register_types)
diff --git a/target/dadao/cpu.h b/target/dadao/cpu.h
new file mode 100644
index 0000000..b8ab68a
--- /dev/null
+++ b/target/dadao/cpu.h
@@ -0,0 +1,62 @@
+#ifndef DADAO_CPU_H
+#define DADAO_CPU_H
+
+#include "hw/core/cpu.h"
+#include "exec/cpu-defs.h"
+#include "qom/object.h"
+
+#define EXCP_ILLI  1
+#define EXCP_UNDI  2
+
+#define CPU_RESOLVING_TYPE TYPE_DADAO_CPU
+
+#define DADAO_CPU_TYPE_SUFFIX "-" TYPE_DADAO_CPU
+#define DADAO_CPU_TYPE_NAME(name) (name DADAO_CPU_TYPE_SUFFIX)
+
+#define TARGET_INSN_START_EXTRA_WORDS 1
+
+typedef struct CPUArchState CPUDADAOState;
+typedef struct ArchCPU DADAOCPU;
+typedef struct DADAOCPUClass DADAOCPUClass;
+
+#define TYPE_DADAO_CPU "dadao-cpu"
+#define DADAO_CPU_CLASS(klass) \
+    OBJECT_CLASS_CHECK(DADAOCPUClass, (klass), TYPE_DADAO_CPU)
+#define DADAO_CPU(obj) \
+    OBJECT_CHECK(DADAOCPU, (obj), TYPE_DADAO_CPU)
+#define DADAO_CPU_GET_CLASS(obj) \
+    OBJECT_GET_CLASS(DADAOCPUClass, (obj), TYPE_DADAO_CPU)
+
+struct CPUArchState {
+    target_ulong rd[64];
+    target_ulong rb[64];
+    target_ulong rf[64];
+    target_ulong ra[64];
+    target_ulong pc;
+};
+
+struct ArchCPU {
+    CPUState parent_obj;
+    CPUDADAOState env;
+};
+
+struct DADAOCPUClass {
+    CPUClass parent_class;
+    DeviceRealize parent_realize;
+    ResettablePhases parent_phases;
+};
+
+void dadao_cpu_do_interrupt(CPUState *cpu);
+bool dadao_cpu_tlb_fill(CPUState *cs, vaddr address, int size,
+                        MMUAccessType access_type, int mmu_idx,
+                        bool probe, uintptr_t retaddr);
+G_NORETURN void dadao_raise_exception(CPUDADAOState *env,
+                                      uint32_t exception,
+                                      uintptr_t pc);
+void dadao_translate_init(void);
+void dadao_translate_code(CPUState *cs, TranslationBlock *tb,
+                          int *max_insns, vaddr pc, void *host_pc);
+
+#include "exec/cpu-all.h"
+
+#endif
