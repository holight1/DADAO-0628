diff --git a/target/dadao/translate.c b/target/dadao/translate.c
new file mode 100644
index 0000000..872ce72
--- /dev/null
+++ b/target/dadao/translate.c
@@ -0,0 +1,144 @@
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "cpu.h"
+#include "tcg/tcg-op.h"
+#include "exec/exec-all.h"
+#include "exec/helper-proto.h"
+#include "exec/helper-gen.h"
+#include "exec/translator.h"
+#include "exec/translation-block.h"
+#include "exec/log.h"
+#include "accel/tcg/cpu-ops.h"
+
+#define HELPER_H "helper.h"
+#include "exec/helper-info.c.inc"
+#undef  HELPER_H
+
+static TCGv cpu_rd[64];
+static TCGv cpu_rb[64];
+static TCGv cpu_ra[64];
+static TCGv cpu_pc;
+
+typedef struct DisasContext {
+    DisasContextBase base;
+    target_ulong pc_save;
+    uint32_t opcode;
+    CPUState *cs;
+} DisasContext;
+
+static void gen_exception_illegal(DisasContext *ctx)
+{
+    gen_helper_raise_exception(tcg_env, tcg_constant_i32(EXCP_ILLI));
+    ctx->base.is_jmp = DISAS_NORETURN;
+}
+
+static void decode_opc(CPUDADAOState *env, DisasContext *ctx)
+{
+    ctx->opcode = translator_ldl_swap(env, &ctx->base, ctx->base.pc_next, true);
+    gen_exception_illegal(ctx);
+}
+
+static void dadao_tr_init_disas_context(DisasContextBase *dcbase, CPUState *cs)
+{
+    DisasContext *ctx = container_of(dcbase, DisasContext, base);
+    ctx->pc_save = ctx->base.pc_first;
+    ctx->cs = cs;
+}
+
+static void dadao_tr_tb_start(DisasContextBase *db, CPUState *cpu)
+{
+}
+
+static void dadao_tr_insn_start(DisasContextBase *dcbase, CPUState *cpu)
+{
+    DisasContext *ctx = container_of(dcbase, DisasContext, base);
+    tcg_gen_insn_start(ctx->base.pc_next, 0);
+}
+
+static void dadao_tr_translate_insn(DisasContextBase *dcbase, CPUState *cpu)
+{
+    DisasContext *ctx = container_of(dcbase, DisasContext, base);
+    CPUDADAOState *env = cpu_env(cpu);
+
+    decode_opc(env, ctx);
+    ctx->base.pc_next += 4;
+
+    if (ctx->base.is_jmp == DISAS_NEXT) {
+        if (!translator_is_same_page(&ctx->base, ctx->base.pc_next)) {
+            ctx->base.is_jmp = DISAS_TOO_MANY;
+        }
+    }
+}
+
+static void dadao_tr_tb_stop(DisasContextBase *dcbase, CPUState *cpu)
+{
+    DisasContext *ctx = container_of(dcbase, DisasContext, base);
+
+    switch (ctx->base.is_jmp) {
+    case DISAS_TOO_MANY:
+        tcg_gen_lookup_and_goto_ptr();
+        break;
+    case DISAS_NORETURN:
+        break;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static const TranslatorOps dadao_tr_ops = {
+    .init_disas_context = dadao_tr_init_disas_context,
+    .tb_start           = dadao_tr_tb_start,
+    .insn_start         = dadao_tr_insn_start,
+    .translate_insn     = dadao_tr_translate_insn,
+    .tb_stop            = dadao_tr_tb_stop,
+};
+
+void dadao_translate_code(CPUState *cs, TranslationBlock *tb,
+                          int *max_insns, vaddr pc, void *host_pc)
+{
+    DisasContext ctx;
+
+    translator_loop(cs, tb, max_insns, pc, host_pc, &dadao_tr_ops, &ctx.base);
+}
+
+static void dadao_tcg_init(void)
+{
+    dadao_translate_init();
+}
+
+static void dadao_restore_state_to_opc(CPUState *cs,
+                                        const TranslationBlock *tb,
+                                        const uint64_t *data)
+{
+    DADAOCPU *cpu = DADAO_CPU(cs);
+    cpu->env.pc = data[0];
+}
+
+const TCGCPUOps dadao_tcg_ops = {
+    .initialize = dadao_tcg_init,
+    .translate_code = dadao_translate_code,
+    .restore_state_to_opc = dadao_restore_state_to_opc,
+#ifndef CONFIG_USER_ONLY
+    .tlb_fill = dadao_cpu_tlb_fill,
+    .do_interrupt = dadao_cpu_do_interrupt,
+#endif
+};
+
+void dadao_translate_init(void)
+{
+    int i;
+
+    for (i = 0; i < 64; i++) {
+        cpu_rd[i] = tcg_global_mem_new(tcg_env,
+            offsetof(CPUDADAOState, rd[i]),
+            NULL);
+        cpu_rb[i] = tcg_global_mem_new(tcg_env,
+            offsetof(CPUDADAOState, rb[i]),
+            NULL);
+        cpu_ra[i] = tcg_global_mem_new(tcg_env,
+            offsetof(CPUDADAOState, ra[i]),
+            NULL);
+    }
+    cpu_pc = tcg_global_mem_new(tcg_env,
+                                offsetof(CPUDADAOState, pc), "pc");
+}
