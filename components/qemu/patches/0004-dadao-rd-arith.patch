From b6ce101d7ec31cad3dc46fd4cb868d94d9202f48 Mon Sep 17 00:00:00 2001
From: suiyan <suiyan@sunmmio.com>
Date: Tue, 30 Jun 2026 09:03:45 +0800
Subject: [PATCH] target/dadao: implement RD integer arithmetic TCG translation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Replace ILLI stubs with real TCG code for all RD scalar integer
instruction groups covered by ISA spec §3.5–§3.14:

  - §3.5  add/sub 128-bit (tcg_gen_add2_i64/sub2_i64)
  - §3.6  addi (tcg_gen_addi_i64)
  - §3.7  muls/mulu/divs/divu (muls2/mulu2/div/rem)
  - §3.8  cmps/cmpu immediate (3-way result via movcond)
  - §3.9  cmps/cmpu register form
  - §3.10 and/or/xor/xnor logical
  - §3.11 shift/extend register & immediate forms
  - §3.12 conditional assign csn/csz/csp/cseq/csne
  - §3.13 wyde immediate orw/andnw/setzw/setow
  - §3.14 rd2rd block copy

Adds load_rd/store_rd helper functions with rd0=0 hardening.
Dual-destination legality checks per §2.6.1.
---
 target/dadao/translate.c | 554 ++++++++++++++++++++++++++++++++++++---
 1 file changed, 517 insertions(+), 37 deletions(-)

diff --git a/target/dadao/translate.c b/target/dadao/translate.c
index 9bd3d5b..733008d 100644
--- a/target/dadao/translate.c
+++ b/target/dadao/translate.c
@@ -40,12 +40,36 @@ static void gen_exception_undi(DisasContext *ctx)
     ctx->base.is_jmp = DISAS_NORETURN;
 }
 
+/* Helper: load rd[reg] into a new temp */
+static TCGv_i64 load_rd(DisasContext *ctx, int reg)
+{
+    TCGv_i64 t = tcg_temp_new_i64();
+    tcg_gen_ld_i64(t, tcg_env, offsetof(CPUDADAOState, rd[reg]));
+    return t;
+}
+
+/* Helper: store val to rd[reg]; rd0 is hardwired zero */
+static void store_rd(DisasContext *ctx, int reg, TCGv_i64 val)
+{
+    if (reg == 0) return;
+    tcg_gen_st_i64(val, tcg_env, offsetof(CPUDADAOState, rd[reg]));
+}
+
+/* Helper: sign-extend 64-bit to 128-bit (high part) */
+static TCGv_i64 sext64h(TCGv_i64 src)
+{
+    TCGv_i64 h = tcg_temp_new_i64();
+    tcg_gen_sari_i64(h, src, 63);
+    return h;
+}
+
 /* swym is a NOP */
 static bool trans_swym(DisasContext *ctx, arg_swym *a)
 {
     return true;
 }
 
