+/* === §3.10 RD Logical (orrr) — hb=dest, hc=src1, hd=src2 === */
+
+static bool trans_and_log(DisasContext *ctx, arg_and_log *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = load_rd(ctx, a->hc);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_and_i64(d, s1, s2);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_orr(DisasContext *ctx, arg_orr *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = load_rd(ctx, a->hc);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_or_i64(d, s1, s2);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_xor_bit(DisasContext *ctx, arg_xor_bit *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = load_rd(ctx, a->hc);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_xor_i64(d, s1, s2);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_xnor(DisasContext *ctx, arg_xnor *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = load_rd(ctx, a->hc);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_xor_i64(d, s1, s2);
+    tcg_gen_not_i64(d, d);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+/* === §3.11 RD Shift/Extend — Register Form (orrr) === */
+
+static bool trans_shlu_r(DisasContext *ctx, arg_shlu_r *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hc);
+    TCGv_i64 amt = load_rd(ctx, a->hd);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_andi_i64(amt, amt, 0x3F);
+    tcg_gen_shl_i64(d, src, amt);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_shrs_r(DisasContext *ctx, arg_shrs_r *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hc);
+    TCGv_i64 amt = load_rd(ctx, a->hd);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_andi_i64(amt, amt, 0x3F);
+    tcg_gen_sar_i64(d, src, amt);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_shru_r(DisasContext *ctx, arg_shru_r *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hc);
+    TCGv_i64 amt = load_rd(ctx, a->hd);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_andi_i64(amt, amt, 0x3F);
+    tcg_gen_shr_i64(d, src, amt);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_exts_r(DisasContext *ctx, arg_exts_r *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hc);
+    TCGv_i64 amt = load_rd(ctx, a->hd);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_andi_i64(amt, amt, 0x3F);
+    tcg_gen_shl_i64(d, src, amt);
+    tcg_gen_sar_i64(d, d, amt);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_extz_r(DisasContext *ctx, arg_extz_r *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hc);
+    TCGv_i64 amt = load_rd(ctx, a->hd);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_andi_i64(amt, amt, 0x3F);
+    tcg_gen_shl_i64(d, src, amt);
+    tcg_gen_shr_i64(d, d, amt);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+/* === §3.11 RD Shift/Extend — Immediate Form (orri) === */
+
+static bool trans_shlu_i(DisasContext *ctx, arg_shlu_i *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hc);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_shli_i64(d, src, a->hd);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_shrs_i(DisasContext *ctx, arg_shrs_i *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hc);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_sari_i64(d, src, a->hd);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_shru_i(DisasContext *ctx, arg_shru_i *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hc);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_shri_i64(d, src, a->hd);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_exts_i(DisasContext *ctx, arg_exts_i *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hc);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_shli_i64(d, src, a->hd);
+    tcg_gen_sari_i64(d, d, a->hd);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_extz_i(DisasContext *ctx, arg_extz_i *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hc);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_shli_i64(d, src, a->hd);
+    tcg_gen_shri_i64(d, d, a->hd);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+/* === §3.9 RD Compare — Register Form (orrr) hb=dest, hc=a, hd=b === */
+
+static bool do_cmps_r(DisasContext *ctx, arg_cmps_r *a, bool is_unsigned)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = load_rd(ctx, a->hc);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    TCGv_i64 d = tcg_temp_new_i64();
+    TCGv_i64 zero = tcg_constant_i64(0);
+    TCGv_i64 mone = tcg_constant_i64(-1);
+    TCGCond cond_lt = is_unsigned ? TCG_COND_LTU : TCG_COND_LT;
+    tcg_gen_movi_i64(d, 1);
+    tcg_gen_movcond_i64(TCG_COND_EQ, d, s1, s2, zero, d);
+    tcg_gen_movcond_i64(cond_lt, d, s1, s2, mone, d);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+static bool trans_cmps_r(DisasContext *ctx, arg_cmps_r *a)
+{
+    return do_cmps_r(ctx, a, false);
+}
+
+static bool trans_cmpu_r(DisasContext *ctx, arg_cmpu_r *a)
+{
+    return do_cmps_r(ctx, a, true);
+}
+
+/* === §3.14 RD Block Copy — rd2rd (orri) hb=dest, hc=src, hd=count === */
+
+static bool trans_rd2rd(DisasContext *ctx, arg_rd2rd *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->hd == 0 || a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    if (a->hb + a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    if (a->hc + a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    for (int i = 0; i < a->hd; i++) {
+        TCGv_i64 v = load_rd(ctx, a->hc + i);
+        store_rd(ctx, a->hb + i, v);
+    }
+    return true;
+}
+
+/* === §3.8 RD Compare — Immediate Form (rrii) ha=dest, hb=src, imm12=imm === */
+
+static bool do_cmps_i(DisasContext *ctx, int ha, int hb, int64_t imm, bool is_unsigned)
+{
+    if (ha == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, hb);
+    TCGv_i64 imm_tmp = tcg_constant_i64(imm);
+    TCGv_i64 d = tcg_temp_new_i64();
+    TCGv_i64 zero = tcg_constant_i64(0);
+    TCGv_i64 mone = tcg_constant_i64(-1);
+    TCGCond cond_lt = is_unsigned ? TCG_COND_LTU : TCG_COND_LT;
+    tcg_gen_movi_i64(d, 1);
+    tcg_gen_movcond_i64(TCG_COND_EQ, d, src, imm_tmp, zero, d);
+    tcg_gen_movcond_i64(cond_lt, d, src, imm_tmp, mone, d);
+    store_rd(ctx, ha, d);
+    return true;
+}
+
+static bool trans_cmps_i(DisasContext *ctx, arg_cmps_i *a)
+{
+    return do_cmps_i(ctx, a->ha, a->hb, a->imm12, false);
+}
+
+static bool trans_cmpu_i(DisasContext *ctx, arg_cmpu_i *a)
+{
+    uint64_t imm = (uint64_t)(a->imm12) & 0xFFF;
+    return do_cmps_i(ctx, a->ha, a->hb, imm, true);
+}
+
+/* === §3.13 RD Wyde Immediate (rwii) ha=dest, hb[5:4]=ww, hb[3:0]=imm[15:12], hc=imm[11:6], hd=imm[5:0] === */
+
+static void gen_wyde_op(DisasContext *ctx, arg_rwii *a,
+                         void (*fn)(TCGv_i64, TCGv_i64, int64_t))
+{
+    int ww = (a->hb >> 4) & 3;
+    unsigned shift = ww * 16;
+    uint64_t imm16 = ((uint64_t)(a->hb & 0xF) << 12) | ((uint64_t)a->hc << 6) | (uint64_t)a->hd;
+    TCGv_i64 src = load_rd(ctx, a->ha);
+    TCGv_i64 d = tcg_temp_new_i64();
+    fn(d, src, imm16 << shift);
+    store_rd(ctx, a->ha, d);
+}
+
+static bool trans_orw(DisasContext *ctx, arg_orw *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    gen_wyde_op(ctx, a, tcg_gen_ori_i64);
+    return true;
+}
+
+static bool trans_andnw(DisasContext *ctx, arg_andnw *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    int ww = (a->hb >> 4) & 3;
+    unsigned shift = ww * 16;
+    uint64_t imm16 = ((uint64_t)(a->hb & 0xF) << 12) | ((uint64_t)a->hc << 6) | (uint64_t)a->hd;
+    uint64_t mask = ~(imm16 << shift);
+    TCGv_i64 src = load_rd(ctx, a->ha);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_andi_i64(d, src, mask);
+    store_rd(ctx, a->ha, d);
+    return true;
+}
+
+static bool trans_setzw(DisasContext *ctx, arg_setzw *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    int ww = (a->hb >> 4) & 3;
+    unsigned shift = ww * 16;
+    uint64_t imm16 = ((uint64_t)(a->hb & 0xF) << 12) | ((uint64_t)a->hc << 6) | (uint64_t)a->hd;
+    TCGv_i64 d = tcg_constant_i64(imm16 << shift);
+    store_rd(ctx, a->ha, d);
+    return true;
+}
+
+static bool trans_setow(DisasContext *ctx, arg_setow *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    int ww = (a->hb >> 4) & 3;
+    unsigned shift = ww * 16;
+    uint64_t imm16 = ((uint64_t)(a->hb & 0xF) << 12) | ((uint64_t)a->hc << 6) | (uint64_t)a->hd;
+    uint64_t ones = ~(0xFFFFULL << shift);
+    TCGv_i64 d = tcg_constant_i64(ones | (imm16 << shift));
+    store_rd(ctx, a->ha, d);
+    return true;
+}
+
+/* === §3.6 RD addi (rrii) ha=dest, hb=src, imm12=imm === */
+
+static bool trans_addi(DisasContext *ctx, arg_addi *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 src = load_rd(ctx, a->hb);
+    TCGv_i64 d = tcg_temp_new_i64();
+    tcg_gen_addi_i64(d, src, a->imm12);
+    store_rd(ctx, a->ha, d);
+    return true;
+}
+
+/* === §3.5 RD 128-bit add/sub (rrrr) ha=hi, hb=lo, hc=src1, hd=src2 === */
+
+static bool trans_add(DisasContext *ctx, arg_add *a)
+{
+    if (a->ha == 0 && a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->ha != 0 && a->hb != 0 && a->ha == a->hb) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = load_rd(ctx, a->hc);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    TCGv_i64 s1h = sext64h(s1);
+    TCGv_i64 s2h = sext64h(s2);
+    TCGv_i64 lo = tcg_temp_new_i64();
+    TCGv_i64 hi = tcg_temp_new_i64();
+    tcg_gen_add2_i64(lo, hi, s1, s1h, s2, s2h);
+    store_rd(ctx, a->hb, lo);
+    store_rd(ctx, a->ha, hi);
+    return true;
+}
+
+static bool trans_sub(DisasContext *ctx, arg_sub *a)
+{
+    if (a->ha == 0 && a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->ha != 0 && a->hb != 0 && a->ha == a->hb) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = load_rd(ctx, a->hc);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    TCGv_i64 s1h = sext64h(s1);
+    TCGv_i64 s2h = sext64h(s2);
+    TCGv_i64 lo = tcg_temp_new_i64();
+    TCGv_i64 hi = tcg_temp_new_i64();
+    tcg_gen_sub2_i64(lo, hi, s1, s1h, s2, s2h);
+    store_rd(ctx, a->hb, lo);
+    store_rd(ctx, a->ha, hi);
+    return true;
+}
+
+/* === §3.7 RD Multiply/Divide (rrrr) === */
+
+static bool trans_muls(DisasContext *ctx, arg_muls *a)
+{
+    if (a->ha == 0 && a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->ha != 0 && a->hb != 0 && a->ha == a->hb) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = load_rd(ctx, a->hc);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    TCGv_i64 lo = tcg_temp_new_i64();
+    TCGv_i64 hi = tcg_temp_new_i64();
+    tcg_gen_muls2_i64(lo, hi, s1, s2);
+    store_rd(ctx, a->hb, lo);
+    store_rd(ctx, a->ha, hi);
+    return true;
+}
+
+static bool trans_mulu(DisasContext *ctx, arg_mulu *a)
+{
+    if (a->ha == 0 && a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->ha != 0 && a->hb != 0 && a->ha == a->hb) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = load_rd(ctx, a->hc);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    TCGv_i64 lo = tcg_temp_new_i64();
+    TCGv_i64 hi = tcg_temp_new_i64();
+    tcg_gen_mulu2_i64(lo, hi, s1, s2);
+    store_rd(ctx, a->hb, lo);
+    store_rd(ctx, a->ha, hi);
+    return true;
+}
+
