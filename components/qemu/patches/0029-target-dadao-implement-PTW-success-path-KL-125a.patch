+++ b/hw/dadao/dadao-machine.c
@@ -17,6 +17,16 @@ static const uint64_t exit_base  = 0x10000000;
 static const uint64_t exit_size  = 0x1000;  /* full page for TLB */
 static const uint64_t ram_base   = 0x80000000;
 static const uint64_t ram_size   = 128 * MiB;
+/* KL-125a test-machine windows for one high-physical L2 page table and one
+ * high-physical leaf. Their backings are deliberately not the numerically
+ * corresponding low addresses, allowing the PTW probes to distinguish
+ * PTHI from PAHI and to exercise PA[63:48] != 0. */
+static const uint64_t ptw_l2_alias_base = UINT64_C(0x0002000084000000);
+static const uint64_t ptw_l2_alias_size = 64 * KiB;
+static const uint64_t ptw_l2_backing_offset = 1 * MiB;
+static const uint64_t ptw_leaf_alias_base = UINT64_C(0x0001000080200000);
+static const uint64_t ptw_leaf_alias_size = 64 * KiB;
+static const uint64_t ptw_leaf_backing_offset = 3 * MiB;
 
 static uint64_t exit_read(void *opaque, hwaddr addr, unsigned int size)
 {
@@ -58,6 +68,8 @@ static void dadao_machine_init(MachineState *machine)
     MemoryRegion *rom = g_new(MemoryRegion, 1);
     MemoryRegion *exit_mmio = g_new(MemoryRegion, 1);
     MemoryRegion *mmap_arena = g_new(MemoryRegion, 1);
+    MemoryRegion *ptw_l2_alias = g_new(MemoryRegion, 1);
+    MemoryRegion *ptw_leaf_alias = g_new(MemoryRegion, 1);
 
     memory_region_init_ram(rom, NULL, "dadao.rom", rom_size, &error_fatal);
     memory_region_set_readonly(rom, true);
@@ -81,6 +93,14 @@ static void dadao_machine_init(MachineState *machine)
         exit(EXIT_FAILURE);
     }
     memory_region_add_subregion(sys_mem, ram_base, machine->ram);
+    memory_region_init_alias(ptw_l2_alias, NULL, "dadao.ptw-l2-alias",
+                             machine->ram, ptw_l2_backing_offset,
+                             ptw_l2_alias_size);
+    memory_region_add_subregion(sys_mem, ptw_l2_alias_base, ptw_l2_alias);
+    memory_region_init_alias(ptw_leaf_alias, NULL, "dadao.ptw-leaf-alias",
+                             machine->ram, ptw_leaf_backing_offset,
+                             ptw_leaf_alias_size);
+    memory_region_add_subregion(sys_mem, ptw_leaf_alias_base, ptw_leaf_alias);
 
     if (machine->firmware) {
         load_image_targphys(machine->firmware, rom_base, rom_size);
