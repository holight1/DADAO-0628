From 83f9a3eb6242cdb4d14a4d1a30e6c0aa5557fe07 Mon Sep 17 00:00:00 2001
From: DADAO Architecture <dadao@example.com>
Date: Tue, 30 Jun 2026 09:30:59 +0800
Subject: [PATCH] target/dadao: implement RD load/store TCG translation + MALIGN

Replace stubs with real TCG code for all RD load/store instruction
groups covered by ISA spec §3.15–§3.16.

Fixes:
- Add MO_ALIGN_2/4/8 flags to all non-byte loads/stores so that
  misaligned accesses trigger do_unaligned_access.
- Add EXCP_MALIGN exception (value 3) and dadao_cpu_do_unaligned_access
  handler that writes exit code 0x02 to the DADAO_EXIT_PORT MMIO region.
- Register do_unaligned_access in TCGCPUOps.

---
 target/dadao/cpu.c       |  20 +++-
 target/dadao/cpu.h       |  10 +-
 target/dadao/translate.c | 260 +++++++++++++++++++++++++++++++++++++--
 3 files changed, 265 insertions(+), 25 deletions(-)

diff --git a/target/dadao/cpu.c b/target/dadao/cpu.c
index 1fa443f..1c98de5 100644
--- a/target/dadao/cpu.c
+++ b/target/dadao/cpu.c
@@ -7,6 +7,7 @@
 #include "system/runstate.h"
 #include "system/system.h"
 #include "hw/qdev-properties.h"
+#include "exec/address-spaces.h"
 #include "accel/tcg/cpu-ops.h"
 
 extern const TCGCPUOps dadao_tcg_ops;
@@ -86,9 +87,26 @@ static ObjectClass *dadao_cpu_class_by_name(const char *cpu_model)
 }
 
 #ifndef CONFIG_USER_ONLY
+void dadao_cpu_do_unaligned_access(CPUState *cs, vaddr addr,
+                                   MMUAccessType access_type,
+                                   int mmu_idx, uintptr_t retaddr)
+{
+    cpu_restore_state(cs, retaddr);
+    cs->exception_index = EXCP_MALIGN;
+    cpu_loop_exit(cs);
+}
+
 void dadao_cpu_do_interrupt(CPUState *cs)
 {
-    qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC, 0x82);
+    switch (cs->exception_index) {
+    case EXCP_MALIGN:
+        cpu_physical_memory_write(DADAO_EXIT_PORT, &(uint64_t){0x02}, 8);
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+        break;
+    default:
+        qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC, 0x82);
+        break;
+    }
 }
 
 bool dadao_cpu_tlb_fill(CPUState *cs, vaddr address, int size,
