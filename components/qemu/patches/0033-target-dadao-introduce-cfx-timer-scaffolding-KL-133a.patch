 }
 
@@ -1457,6 +1474,12 @@ static void dadao_tr_translate_insn(DisasContextBase *dcbase, CPUState *cpu)
     DisasContext *ctx = container_of(dcbase, DisasContext, base);
     CPUDADAOState *env = cpu_env(cpu);
 
+    /* KL-133a: hart-cycle tick, emitted BEFORE this instruction's own
+     * semantic ops -- see helper_dadao_tick()'s comment (helper.c) for why
+     * this ordering matters (guarantees the tick still happens even when
