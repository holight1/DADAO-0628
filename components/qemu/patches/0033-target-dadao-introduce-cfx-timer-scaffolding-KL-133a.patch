@@ -1524,6 +1547,29 @@ void dadao_translate_code(CPUState *cs, TranslationBlock *tb,
     if (dadao_cfx_async_active(cpu_env(cs))) {
         *max_insns = MIN(*max_insns, 1);
     }
+    /* KL-133a: same rationale as the PTW/KL-131a checks above -- while
+     * cfx_timer is enabled, dadao_cpu_exec_interrupt() (this file, below)
+     * must be consulted at every real instruction boundary so a
+     * newly-expired, newly-unmasked TIMER cause is delivered precisely
+     * (not delayed until the next several-instruction TB happens to end). */
+    if (cpu_env(cs)->cfx_timer_ctrl & DADAO_CFX_TIMER_CTRL_ENABLE) {
+        *max_insns = MIN(*max_insns, 1);
+    }
+    /* KL-133a: also force it while a TIMER cause is latched-but-undelivered
+     * (e.g. expired while cfx_timer_mask still blocked it, and ctrl has
+     * since auto-disabled on a one-shot expiry -- the ENABLE check above no
+     * longer holds, but software clearing cfx_timer_mask/excp_cause_mask/
+     * inner_cfx_mask afterwards must still be observed at the very next
+     * instruction boundary, not delayed until an arbitrarily-sized TB
+     * happens to end). Without this, a TB translated *before* this bit was
+     * set could keep batching several post-expiry instructions together,
+     * and the newly-unmasking write and the instruction right after it
+     * could land in the very same TB with no intervening
+     * cpu_exec_interrupt() check between them. */
+    if (cpu_env(cs)->cfx_common_pending[DADAO_CFX_CODE_TIMER] &
+        DADAO_CFX_TIMER_CAUSE_TIMER) {
+        *max_insns = MIN(*max_insns, 1);
+    }
     translator_loop(cs, tb, max_insns, pc, host_pc, &dadao_tr_ops, &ctx.base);
 }
 
