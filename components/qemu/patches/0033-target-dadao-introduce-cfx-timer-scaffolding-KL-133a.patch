+/* KL-133a discovery (not a regression -- a previously-unobserved property,
+ * since no register before cfx_hart_cycle_lo changed value merely from
+ * being re-read): qemu_system_shutdown_request_with_code() only *requests*
+ * a shutdown; it does not stop this vCPU's execution loop immediately.
+ * cpu_loop_exit() below unwinds to cpu_exec()'s main loop, which -- since
+ * the shutdown has not actually been serviced by the top-level loop yet --
+ * can re-enter and re-execute the *same* `halt`-containing TB one or more
+ * times (env->pc was never advanced past this TB's start, because a
+ * DISAS_NORETURN TB's epilogue never runs) before the requested shutdown
+ * actually takes effect; the exact repeat count is a host-scheduling race,
+ * observed to vary run-to-run. Every pre-existing K1 probe is unaffected
+ * because it only reads *idempotent* state (plain registers whose value is
+ * unchanged by being re-read) in this tail. A monotonic counter like
+ * cfx_hart_cycle_lo is not idempotent under this re-entry -- any read of
+ * it (or of cfx_timer's ctrl/regs0 while still enabled) MUST happen in an
+ * earlier, already-completed TB, not in the same TB as the final `halt`.
+ * tests/scripts/run_kl133a_cfx_timer_probes.py's tb_break() (a no-op
+ * `jump_i +0`, which forces a clean DISAS_JUMP TB boundary) is the
+ * work-around every KL-133a probe uses immediately before its final
+ * emit_final_halt() call. */
 void helper_exit(CPUDADAOState *env, uint64_t code)
 {
     int exit_code = (int)(code & 0xff);
@@ -161,6 +181,27 @@ uint64_t dadao_cfx_common_pending_mask(uint64_t cfxcode)
     }
 }
 
+/* KL-133a: per-instruction hart-cycle tick. Called once per translated
+ * instruction from dadao_tr_translate_insn() (translate.c), BEFORE that
+ * instruction's own semantic ops are emitted -- so at runtime this always
+ * executes exactly once per instruction that begins execution, regardless
+ * of whether that same instruction goes on to raise a noreturn exception
+ * (helper_raise_exception/helper_trap/helper_exit all longjmp via
+ * cpu_loop_exit(), which would make any *later*-emitted code in the same TB
+ * unreachable -- placing this call first is what guarantees the increment
+ * still happens for those instructions too). This is what makes
+ * cfx_hart_cycle_lo a monotonic "one tick per architecturally-visible
+ * instruction" counter rather than one that silently stalls whenever a trap
+ * fires. This is ONLY the cycle_lo increment -- see
+ * dadao_cfx_timer_tick() (cpu.c) for why the timer's own decrement/expiry
+ * math deliberately does NOT live here too (a TB-boundary-timing
+ * subtlety), even though both conceptually advance "once per tick".
+ */
+void helper_dadao_tick(CPUDADAOState *env)
+{
+    env->cfx_hart_cycle_lo++;
+}
