+/* KL-133a: cfx_hart cg8/rc2 cycle_lo (RO, 64-bit, per-hart tick counter --
+ * one increment per architecturally-retired instruction, mod 2^64). [wiki
+ * §DADAO-12-SEE-主管系统运行环境.md L525 cfx_hart 专有寄存器表]. cg8/rc3
+ * cycle_hi is deliberately not implemented (K1 non-claim, contracts/isa/
+ * spec.md §8.5.2) -- there is no (cg,rc) dispatch branch for it at all, so
+ * it falls through to the existing "unimplemented register -> silent no-op
+ * write / reads zero" convention, not a fabricated nonzero high word. */
+#define DADAO_CFX_HART_CYCLE_LO_CG 8
+#define DADAO_CFX_HART_CYCLE_LO_RC 2
+/* KL-133a: cfx_timer cg10 register group. [wiki §DADAO-12-SEE-主管系统
+ * 运行环境.md L582-600 cfx_timer 专有寄存器表]. Only counter0 (rc8) is in
+ * scope; rc9-15 (counters1-7) are a K1 non-claim per contracts/isa/spec.md
+ * §8.5.2 and have no dispatch branch (silent no-op/reads zero, same
+ * unimplemented-register convention as cycle_hi above). */
+#define DADAO_CFX_TIMER_CG 10
+#define DADAO_CFX_TIMER_PENDING_RC 0
+#define DADAO_CFX_TIMER_MASK_RC 1
+#define DADAO_CFX_TIMER_CTRL_RC 7
+#define DADAO_CFX_TIMER_REG0_RC 8
+/* cfx_timer_ctrl bit assignments [wiki L590]. */
+#define DADAO_CFX_TIMER_CTRL_ENABLE (1ULL << 0)
+#define DADAO_CFX_TIMER_CTRL_PERIODIC (1ULL << 1)
+/* cfx_timer's one maskable cause, TIMER (bit10) [wiki L600]. Matches the
+ * existing dadao_cfx_common_pending_mask() case 18 in helper.c exactly. */
+#define DADAO_CFX_TIMER_CAUSE_TIMER (1ULL << 10)
+
 typedef struct DADAOCfxTlbEntry {
     bool valid;
     bool superpage;
@@ -259,6 +290,29 @@ struct CPUArchState {
      * trap_cfxcode/trap_func's helper->do_interrupt handoff pattern below. */
     target_ulong cfx_async_pending_target;
     target_ulong cfx_async_pending_cause;
+    /* KL-133a: cfx_hart cg8/rc2 cycle_lo -- one increment per
+     * architecturally-retired instruction, RO, mod 2^64. This is the shared
+     * timebase cfx_timer's decrement math is built on
