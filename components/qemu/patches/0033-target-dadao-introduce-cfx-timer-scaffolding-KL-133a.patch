            cpu->cfx_async_test_level_b_seed != 0;
 }
 
+/* KL-133a: cfx_timer decrement/expiry, called once per TB-boundary check
+ * from dadao_cfx_async_scan() below -- deliberately NOT from
+ * helper_dadao_tick() (the per-instruction-embedded cycle_lo counter),
+ * even though both conceptually fire "once per tick".
+ *
+ * Why the split: QEMU only checks for an asynchronous interrupt BETWEEN
+ * TBs (dadao_cpu_exec_interrupt(), translate.c), never mid-TB. While
+ * cfx_timer_ctrl is enabled, dadao_translate_code() forces single-
+ * instruction TBs specifically so that boundary check runs before every
+ * real instruction -- matching gem5's Interrupts::checkInterrupts(), which
+ * runs before every instruction unconditionally (see isa.hh's
+ * cfxHartTick() comment). If this decrement instead lived inside
+ * helper_dadao_tick() (executed as part of the SAME TB as the
+ * about-to-run instruction, i.e. AFTER that TB was already scheduled to
+ * run), an expiry discovered there would be one instruction too late to
+ * preempt that instruction -- it would already be committed to executing
+ * by the time the expiry became visible, unlike gem5 where the tick runs
+ * strictly BEFORE the corresponding instruction is even fetched. Running
+ * the decrement here instead (called immediately before the SAME
+ * eligibility scan that decides whether to redirect the *next* TB) gives
+ * QEMU byte-for-byte the same "N ticks after arming" delivery boundary as
+ * gem5. trans_cfx2rc() (translate.c) forces a TB exit right after any
+ * write to cfx_timer_ctrl, so the very first boundary check after an
+ * enabling write already sees single-instruction-TB granularity from that
+ * point on.
+ */
+static void dadao_cfx_timer_tick(DADAOCPU *cpu)
+{
+    CPUDADAOState *env = &cpu->env;
+
+    if (!(env->cfx_timer_ctrl & DADAO_CFX_TIMER_CTRL_ENABLE)) {
+        return;
+    }
+
+    bool expired;
+    if (env->cfx_timer_regs0 == 0) {
+        /* Already-expired counter (timeout=0 arm, or a periodic reload of a
+         * zero reload-latch value) -- no decrement needed, expires again
+         * this tick. */
+        expired = true;
+    } else {
+        env->cfx_timer_regs0--;
+        expired = (env->cfx_timer_regs0 == 0);
+    }
+
+    if (!expired) {
+        return;
+    }
+
+    /* Private source pending set unconditionally of cfx_timer_mask, and
+     * TIMER OR'd into the common cause latch unconditionally of every
+     * mask, per contracts/isa/spec.md §8.5.2. Delivery still goes through
+     * cfx_timer_mask + KL-131a's generic three-level check in the scan
+     * loop below -- this function never itself decides eligibility. */
+    env->cfx_timer_pending |= 0x1ULL;
+    env->cfx_common_pending[DADAO_CFX_CODE_TIMER] |= DADAO_CFX_TIMER_CAUSE_TIMER;
+
+    if (env->cfx_timer_ctrl & DADAO_CFX_TIMER_CTRL_PERIODIC) {
+        /* Periodic: reload from the last value written to counter0, keep
+         * enabled. */
+        env->cfx_timer_regs0 = env->cfx_timer_reload_latch;
+    } else {
+        /* One-shot: auto-disable. */
+        env->cfx_timer_ctrl &= ~(target_ulong)DADAO_CFX_TIMER_CTRL_ENABLE;
+    }
+}
+
 /* KL-131a: re-latch the two test-only synthetic level sources (electrics,
  * wiki L656) and select the next async cause to deliver per contracts/isa/
  * spec.md §8.5.1: lowest pending eligible cfxcode first, then lowest set
@@ -458,6 +546,10 @@ static bool dadao_cfx_async_scan(DADAOCPU *cpu, uint64_t *out_target,
 {
     CPUDADAOState *env = &cpu->env;
 
+    /* KL-133a: exactly one tick's worth of timer decrement/expiry per
+     * boundary check -- see dadao_cfx_timer_tick()'s comment above. */
+    dadao_cfx_timer_tick(cpu);
+
     if (cpu->cfx_async_test_level_a_seed != 0) {
         uint64_t target = cpu->cfx_async_test_level_a_code & 0x3F;
         env->cfx_common_pending[target] |=
