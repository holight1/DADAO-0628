+    uint64_t cfx_hart_cycle_lo;
+    /* KL-133a: cfx_timer private state (cg10). cfx_timer_pending/mask are
+     * only 1 bit wide architecturally (bit0=TIMER source), stored as
+     * target_ulong for register-width consistency with every other
+     * (cg,rc)-addressed register in this file; higher bits are always kept
+     * zero by the read/write dispatch in helper.c. cfx_timer_ctrl bits 0-2
+     * are defined (enable/mode/dir); bits[63:3] are stored as written
+     * (reserved, RW, no defined read-back masking per wiki). cfx_timer_regs0
+     * is the live down-counting counter0 (cg10/rc8, directly guest-readable
