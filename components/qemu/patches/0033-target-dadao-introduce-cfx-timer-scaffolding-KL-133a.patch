 target/dadao/cpu.h       | 54 +++++++++++++++++++++++
 target/dadao/helper.c    | 91 +++++++++++++++++++++++++++++++++++++++
 target/dadao/helper.h    |  1 +
 target/dadao/translate.c | 46 ++++++++++++++++++++
 5 files changed, 284 insertions(+)

