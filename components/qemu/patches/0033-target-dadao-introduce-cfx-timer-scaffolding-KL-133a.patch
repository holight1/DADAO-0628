+     * latch) -- it has no (cg,rc) address of its own and is never directly
+     * guest-readable; periodic-mode expiry reloads counter0 from it. */
+    target_ulong cfx_timer_pending;
+    target_ulong cfx_timer_mask;
+    target_ulong cfx_timer_ctrl;
+    uint64_t cfx_timer_regs0;
+    uint64_t cfx_timer_reload_latch;
     /* Scratch for a pending trap (cfx) syscall, passed helper -> do_interrupt.
        Must NOT reuse rb[1]/rb[2] — rb1 is the stack pointer (ADR-0004). */
     target_ulong trap_cfxcode;
