+            env->cfx_timer_reload_latch = value;
+            return;
+        default:
+            /* rc9-15 (counters1-7): K1 non-claim, silent no-op. */
+            break;
+        }
+    }
+
     if (cg == 5) {
         /* KL-122a common frame carrier. rc2/rc4 are hardware-written and
          * intentionally read-only; rc5 is project-local E1. */
@@ -443,6 +518,22 @@ uint64_t helper_cfx2rd(CPUDADAOState *env, uint64_t cfxcode, uint64_t cg,
