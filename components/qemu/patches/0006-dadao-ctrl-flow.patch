+/* MISC-Norm RB register move (orri) */
+static bool trans_rd2rb(DisasContext *ctx, arg_rd2rb *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->hd == 0 || a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    if (a->hb + a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    if (a->hc + a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    for (int i = 0; i < a->hd; i++) {
+        TCGv_i64 v = load_rd(ctx, a->hc + i);
+        tcg_gen_st_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->hb + i]));
+    }
+    return true;
+}
+
+static bool trans_rb2rd(DisasContext *ctx, arg_rb2rd *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->hd == 0 || a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    if (a->hb + a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    if (a->hc + a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    for (int i = 0; i < a->hd; i++) {
+        TCGv_i64 v = tcg_temp_new_i64();
+        tcg_gen_ld_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->hc + i]));
+        store_rd(ctx, a->hb + i, v);
+    }
+    return true;
+}
+
+static bool trans_rb2rb(DisasContext *ctx, arg_rb2rb *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->hd == 0 || a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    if (a->hb + a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    if (a->hc + a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    for (int i = 0; i < a->hd; i++) {
+        TCGv_i64 v = tcg_temp_new_i64();
+        tcg_gen_ld_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->hc + i]));
+        tcg_gen_st_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->hb + i]));
+    }
+    return true;
+}
+
+/* MISC-Norm RB compare (orrr) */
+static bool trans_cmp_rb(DisasContext *ctx, arg_cmp_rb *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = tcg_temp_new_i64();
+    tcg_gen_ld_i64(s1, tcg_env, offsetof(CPUDADAOState, rb[a->hc]));
+    tcg_gen_andi_i64(s1, s1, 0x0000FFFFFFFFFFFFULL);
+    TCGv_i64 s2 = tcg_temp_new_i64();
+    tcg_gen_ld_i64(s2, tcg_env, offsetof(CPUDADAOState, rb[a->hd]));
+    tcg_gen_andi_i64(s2, s2, 0x0000FFFFFFFFFFFFULL);
+    TCGv_i64 d = tcg_temp_new_i64();
+    TCGv_i64 zero = tcg_constant_i64(0);
+    TCGv_i64 mone = tcg_constant_i64(-1);
+    tcg_gen_movi_i64(d, 1);
+    tcg_gen_movcond_i64(TCG_COND_EQ, d, s1, s2, zero, d);
+    tcg_gen_movcond_i64(TCG_COND_LT, d, s1, s2, mone, d);
+    store_rd(ctx, a->hb, d);
+    return true;
+}
+
+/* MISC-Norm RB add/sub (orrr) hb=dest RB, hc=RB src1, hd=RD src2 */
+static bool trans_add_rb(DisasContext *ctx, arg_add_rb *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = tcg_temp_new_i64();
+    tcg_gen_ld_i64(s1, tcg_env, offsetof(CPUDADAOState, rb[a->hc]));
+    tcg_gen_andi_i64(s1, s1, 0x0000FFFFFFFFFFFFULL);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    tcg_gen_add_i64(s1, s1, s2);
+    tcg_gen_andi_i64(s1, s1, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_st_i64(s1, tcg_env, offsetof(CPUDADAOState, rb[a->hb]));
+    return true;
+}
+
+static bool trans_sub_rb(DisasContext *ctx, arg_sub_rb *a)
+{
+    if (a->hb == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 s1 = tcg_temp_new_i64();
+    tcg_gen_ld_i64(s1, tcg_env, offsetof(CPUDADAOState, rb[a->hc]));
+    tcg_gen_andi_i64(s1, s1, 0x0000FFFFFFFFFFFFULL);
+    TCGv_i64 s2 = load_rd(ctx, a->hd);
+    tcg_gen_sub_i64(s1, s1, s2);
+    tcg_gen_andi_i64(s1, s1, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_st_i64(s1, tcg_env, offsetof(CPUDADAOState, rb[a->hb]));
+    return true;
+}
