+/* === §4.8 RB Relative Address (riii) === */
+
+static bool trans_rela(DisasContext *ctx, arg_rela *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 base = tcg_temp_new_i64();
+    tcg_gen_ld_i64(base, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    tcg_gen_andi_i64(base, base, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_andi_i64(base, base, ~0xFFFULL);
+    tcg_gen_addi_i64(base, base, (int64_t)a->imm18 << 12);
+    tcg_gen_andi_i64(base, base, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_st_i64(base, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    return true;
+}
+
+/* === §4.4 RB Add Immediate (rrii) === */
+
+static bool trans_addi_rb(DisasContext *ctx, arg_addi_rb *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 old = tcg_temp_new_i64();
+    tcg_gen_ld_i64(old, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    tcg_gen_andi_i64(old, old, 0xFFFF000000000000ULL);
+    TCGv_i64 v = tcg_temp_new_i64();
+    tcg_gen_ld_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->hb]));
+    tcg_gen_andi_i64(v, v, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_addi_i64(v, v, a->imm12);
+    tcg_gen_andi_i64(v, v, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_or_i64(v, v, old);
+    tcg_gen_st_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    return true;
+}
+
+/* === §4.1 RB Store (rrii) === */
+
+static bool trans_sto_rb(DisasContext *ctx, arg_sto_rb *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 ea = gen_ea(ctx, a->hb, a->imm12);
+    TCGv_i64 v = tcg_temp_new_i64();
+    tcg_gen_ld_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    tcg_gen_qemu_st_i64(v, ea, ctx->mem_idx, MO_BE | MO_64 | MO_ALIGN_8);
+    return true;
+}
+
+/* === §4.9 RB Wyde Immediate (rwii) === */
+
+static bool trans_orw_rb(DisasContext *ctx, arg_orw_rb *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    int ww = (a->hb >> 4) & 3;
+    unsigned shift = ww * 16;
+    uint64_t imm16 = ((uint64_t)(a->hb & 0xF) << 12) | ((uint64_t)a->hc << 6) | (uint64_t)a->hd;
+    TCGv_i64 v = tcg_temp_new_i64();
+    tcg_gen_ld_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    tcg_gen_andi_i64(v, v, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_ori_i64(v, v, (imm16 << shift) & 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_st_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    return true;
+}
+
+static bool trans_andnw_rb(DisasContext *ctx, arg_andnw_rb *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    int ww = (a->hb >> 4) & 3;
+    unsigned shift = ww * 16;
+    uint64_t imm16 = ((uint64_t)(a->hb & 0xF) << 12) | ((uint64_t)a->hc << 6) | (uint64_t)a->hd;
+    uint64_t mask = ~(imm16 << shift);
+    TCGv_i64 v = tcg_temp_new_i64();
+    tcg_gen_ld_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    tcg_gen_andi_i64(v, v, mask);
+    tcg_gen_st_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    return true;
+}
+
+static bool trans_setzw_rb(DisasContext *ctx, arg_setzw_rb *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    int ww = (a->hb >> 4) & 3;
+    unsigned shift = ww * 16;
+    uint64_t imm16 = ((uint64_t)(a->hb & 0xF) << 12) | ((uint64_t)a->hc << 6) | (uint64_t)a->hd;
+    TCGv_i64 v = tcg_constant_i64(imm16 << shift);
+    tcg_gen_st_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    return true;
+}
+
+/* === §4.2 RB Multi-Store (rrri) === */
+
+static bool trans_stmo_rb(DisasContext *ctx, arg_stmo_rb *a)
+{
+    if (a->ha == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->hd == 0) { gen_exception_illegal(ctx); return true; }
+    if (a->ha + a->hd > 64) { gen_exception_illegal(ctx); return true; }
+    TCGv_i64 base = tcg_temp_new_i64();
+    tcg_gen_ld_i64(base, tcg_env, offsetof(CPUDADAOState, rb[a->hb]));
+    tcg_gen_andi_i64(base, base, 0x0000FFFFFFFFFFFFULL);
+    TCGv_i64 idx = tcg_temp_new_i64();
+    tcg_gen_ld_i64(idx, tcg_env, offsetof(CPUDADAOState, rd[a->hc]));
+    tcg_gen_andi_i64(idx, idx, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_add_i64(base, base, idx);
+    tcg_gen_andi_i64(base, base, 0x0000FFFFFFFFFFFFULL);
+    for (int i = 0; i < a->hd; i++) {
+        TCGv_i64 ea = tcg_temp_new_i64();
+        tcg_gen_mov_i64(ea, base);
+        if (i) {
+            tcg_gen_addi_i64(ea, ea, i * 8);
+            tcg_gen_andi_i64(ea, ea, 0x0000FFFFFFFFFFFFULL);
+        }
+        TCGv_i64 v = tcg_temp_new_i64();
+        tcg_gen_ld_i64(v, tcg_env, offsetof(CPUDADAOState, rb[a->ha + i]));
+        tcg_gen_qemu_st_i64(v, ea, ctx->mem_idx, MO_BE | MO_64 | MO_ALIGN_8);
+    }
+    return true;
+}
+
+/* === §5.3 Jump / Call / Ret — Control Flow === */
+
+static bool trans_jump_i(DisasContext *ctx, arg_jump_i *a)
+{
+    uint64_t target = (ctx->base.pc_next - 4) + (int64_t)a->imm24 * 4;
+    tcg_gen_st_i64(tcg_constant_i64(target), tcg_env, offsetof(CPUDADAOState, pc));
+    ctx->base.is_jmp = DISAS_JUMP;
+    return true;
+}
+
+static bool trans_jump_r(DisasContext *ctx, arg_jump_r *a)
+{
+    TCGv_i64 base = tcg_temp_new_i64();
+    tcg_gen_ld_i64(base, tcg_env, offsetof(CPUDADAOState, rb[a->ha]));
+    tcg_gen_andi_i64(base, base, 0x0000FFFFFFFFFFFFULL);
+    TCGv_i64 idx = tcg_temp_new_i64();
+    tcg_gen_ld_i64(idx, tcg_env, offsetof(CPUDADAOState, rd[a->hb]));
+    if (a->imm12) {
+        tcg_gen_addi_i64(idx, idx, a->imm12);
+    }
+    tcg_gen_add_i64(base, base, idx);
+    tcg_gen_andi_i64(base, base, 0x0000FFFFFFFFFFFFULL);
+    tcg_gen_st_i64(base, tcg_env, offsetof(CPUDADAOState, pc));
+    ctx->base.is_jmp = DISAS_JUMP;
+    return true;
+}
+
+static bool trans_call_i(DisasContext *ctx, arg_call_i *a)
+{
+    /* push return address: ra[63] = PC+4 */
+    tcg_gen_st_i64(tcg_constant_i64(ctx->base.pc_next), tcg_env, offsetof(CPUDADAOState, ra[63]));
+    uint64_t target = (ctx->base.pc_next - 4) + (int64_t)a->imm24 * 4;
+    tcg_gen_st_i64(tcg_constant_i64(target), tcg_env, offsetof(CPUDADAOState, pc));
