+++ b/target/dadao/cpu.c
@@ -17,6 +17,11 @@
 #include <stdlib.h>
 extern const TCGCPUOps dadao_tcg_ops;
 
+/* KL-131a: forward declaration -- used by dadao_cpu_reset_hold() below,
+ * defined further down next to the rest of the steps 2-6 arbitration logic
+ * it belongs with. */
+static uint64_t dadao_cfx_excp_cause_nonmaskable_for(uint64_t cfxcode);
+
 void cpu_get_tb_cpu_state(CPUDADAOState *env, vaddr *pc,
                           uint64_t *cs_base, uint32_t *pflags)
 {
@@ -82,7 +87,25 @@ static void dadao_cpu_reset_hold(Object *obj, ResetType type)
         for (int m = 0; m < 4; m++) {
             env->cfx_escape_cfx_mask[i][m] = DADAO_CFX_MASK_ALL;
         }
+        /* KL-131a: cg0-3/rc11 excp_cause_mask resets all-1 (blocked) per
+         * cfx/mode, mirroring escape_cfx_mask above [wiki L285/L309/L329]. */
+        for (int m = 0; m < 4; m++) {
