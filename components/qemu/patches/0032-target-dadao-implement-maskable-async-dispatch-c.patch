+    env->cfx_async_pending_cause = 0;
     env->cfx_ptw_perm[DADAO_RUN_MODE_USER] = 0;
     env->cfx_ptw_perm[DADAO_RUN_MODE_JAIL] = 0;
     env->cfx_ptw_perm[DADAO_RUN_MODE_SUPV] = UINT64_MAX;
@@ -116,6 +139,23 @@ static void dadao_cpu_reset_hold(Object *obj, ResetType type)
                       cpu->cfx_common_pending_test_code & 0x3F,
                       cpu->cfx_common_pending_test_seed);
     }
+    /* KL-131a: always live, matching gem5's BaseCPU::checkInterrupts()
+     * FullSystem-mode polling (called once per instruction unconditionally,
+     * not gated on whether a test source happens to be configured).
+     * dadao_cpu_exec_interrupt() -> dadao_cfx_async_step() is cheap when
+     * nothing is pending (a 64-entry scan that bails immediately on an
+     * all-zero cfx_common_pending, the overwhelmingly common case for every
+     * pre-KL-131a regression scenario), so this is safe to assert
+     * unconditionally rather than only when this task's own test-only level
+     * sources are configured. It must not be conditional: a genuinely
+     * pending-and-newly-unmasked cause can arise from plain guest cfx2rc
+     * writes alone (no test source involved -- see KL-131a's own A4 sync
+     * probe, which does exactly this), and QEMU must detect that the same
+     * way real hardware and gem5's Interrupts::checkInterrupts() both would.
+     * Only the max_insns=1 instruction-boundary-precision forcing in
+     * dadao_translate_code() stays gated on dadao_cfx_async_active() --
+     * that one IS a real per-TB performance cost, unlike this cheap scan. */
+    cpu_interrupt(cs, CPU_INTERRUPT_HARD);
     env->pc = 0x00100000;
     cs->exception_index = -1;
 
@@ -255,6 +295,217 @@ static void dadao_cfx_precise_trap_enter(DADAOCPU *cpu,
     }
 }
 
+/* KL-131a: SEE §3 cg5/rc63 excp_cause_nonmaskable, hardware-static per cfx's
+ * own cause table [wiki §DADAO-12-SEE-主管系统运行环境.md L362]. Common
+ * CFXTRAP/CFXMEM/CFXREG (bits 0-2) are nonmaskable in every cfx's cause
+ * table without exception -- verified against every cause table in §4
+ * (L396-648). Independently cross-checked against dadao_cfx_common_pending_
+ * mask()'s maskable set for each cfx below; every other cfx (cache/llc/pmem,
+ * every reserved cfxcode) defines no maskable cause at all, so its
+ * nonmaskable set is exactly the common three -- the switch's default arm
+ * covers all of them without needing every cfxcode enumerated. */
+static uint64_t dadao_cfx_excp_cause_nonmaskable_for(uint64_t cfxcode)
+{
+    const uint64_t common = (1ULL << 0) | (1ULL << 1) | (1ULL << 2);
+
+    switch (cfxcode & 0x3F) {
+    case 0: /* umon */
+    case 1: /* jmon */
+    case DADAO_CFX_CODE_SMON:
+    case 3: /* hmon */
+        /* [wiki L396-411]: ILLI/UNDI/RASOF/RASUF/MALIGN/IALIGN (bits 8-13)
+         * nonmaskable; only FPEXCP (bit32) is maskable. */
+        return common | (1ULL << 8) | (1ULL << 9) | (1ULL << 10) |
+               (1ULL << 11) | (1ULL << 12) | (1ULL << 13);
+    case DADAO_CFX_CODE_PTW:
+        /* [wiki L440-461]: all 18 listed causes nonmaskable. */
+        return common | (1ULL << 8) | (1ULL << 9) | (1ULL << 10) |
+               (1ULL << 11) | (1ULL << 12) | (1ULL << 13) | (1ULL << 14) |
+               (1ULL << 16) | (1ULL << 17) | (1ULL << 18) | (1ULL << 19) |
+               (1ULL << 20) | (1ULL << 21) | (1ULL << 22) | (1ULL << 23);
+    case DADAO_CFX_CODE_TLB:
+        /* [wiki L480-493]: all 10 listed causes nonmaskable (KL-131a task
+         * text's "8" undercounts the wiki table by the 2 common CFXMEM/
+         * CFXREG rows; the wiki table itself, independently re-read for
+         * this task, is authoritative and lists all 10 as nonmaskable). */
+        return common | (1ULL << 12) | (1ULL << 13) | (1ULL << 14) |
+               (1ULL << 18) | (1ULL << 19) | (1ULL << 22) | (1ULL << 23);
+    case 15: /* hart: [wiki L529-536] IPI (bit8) maskable */
+    case 18: /* timer: [wiki L593-600] TIMER (bit10) maskable */
+    case 62: /* uart: [wiki L617-628] UART0-31 (bits32-63) maskable */
+        return common;
+    case DADAO_CFX_CODE_POWER:
+        /* [wiki L639-648]: POWEROFF(8)/HARD_RESET(9) nonmaskable;
+         * SOFT_RESET(10) maskable. */
+        return common | (1ULL << 8) | (1ULL << 9);
+    default:
+        /* cache/llc/pmem and every reserved cfxcode: only CFXTRAP/CFXMEM/
+         * CFXREG are defined, all nonmaskable [wiki L507-514, L549-555,
+         * L572-578]. */
+        return common;
+    }
+}
+
+/* KL-131a: pure predicate for SEE §5 steps 2-5 -- would `cause` targeting
+ * `target_cfx` currently reach step 6 (entry), or is it blocked? No state
+ * mutation. Shared by dadao_cfx_dispatch()'s own gate and the async
+ * instruction-boundary scan's candidate-eligibility test, so both use
+ * exactly the same arbitration rule (contracts/isa/spec.md §8.5.1; wiki
+ * L680-699, L763-786). */
+static bool dadao_cfx_cause_eligible(CPUDADAOState *env, uint64_t target_cfx,
+                                     uint64_t cause)
+{
+    if (env->cfx_excp_cause_nonmaskable[target_cfx] & cause) {
+        return true;
+    }
+    if (target_cfx != env->inner_cfx_code &&
+        (env->inner_cfx_mask & (1ULL << target_cfx))) {
+        return false;
+    }
+    if (target_cfx != env->inner_cfx_code &&
+        (env->cfx_mode_global_cfx_mask[env->inner_run_mode] &
+         (1ULL << target_cfx))) {
+        return false;
+    }
+    if (env->cfx_excp_cause_mask[target_cfx][env->inner_run_mode] & cause) {
+        return false;
+    }
+    return true;
+}
+
+/* KL-131a: SEE §5 steps 2-6 -- mask/pending/priority arbitration gating the
+ * KL-122a dadao_cfx_precise_trap_enter() carrier (steps 7-10). Synchronous
+ * callers (is_sync=true) get ILLI-redirect-to-monitor on a steps 3-4 routing
+ * block (retried once; ILLI is nonmaskable at every monitor cfx, so the
+ * second pass always enters); a step 5 cause-mask block (only FPEXCP reaches
+ * this among M1's real sync causes) just ORs into pending like every async
+ * block does. [wiki L680-807] */
+bool dadao_cfx_dispatch(DADAOCPU *cpu, uint64_t target_cfx, uint64_t cause,
+                        uint64_t cause_info, target_ulong cause_ip,
+                        bool is_sync)
+{
+    CPUDADAOState *env = &cpu->env;
+
+    target_cfx &= 0x3F;
+
+    for (int pass = 0; pass < 2; pass++) {
+        if (dadao_cfx_cause_eligible(env, target_cfx, cause)) {
+            /* Step 6: trap counters. [wiki L699, L787-793] */
+            if (cause == DADAO_CFX_CAUSE_CFXTRAP) {
+                env->cfx_trap_num[target_cfx]++;
+            } else if (!is_sync) {
+                env->cfx_excp_async_num[target_cfx]++;
+            } else {
+                env->cfx_excp_sync_num[target_cfx]++;
+            }
+            dadao_cfx_precise_trap_enter(cpu, target_cfx, cause, cause_info,
+                                         cause_ip);
+            return true;
+        }
+
+        bool routing_blocked =
+            target_cfx != env->inner_cfx_code &&
+            ((env->inner_cfx_mask & (1ULL << target_cfx)) ||
+             (env->cfx_mode_global_cfx_mask[env->inner_run_mode] &
+              (1ULL << target_cfx)));
+
+        if (is_sync && routing_blocked && pass == 0) {
+            /* Steps 3-4: sync exception redirected to ILLI @ current-mode
+             * monitor, mirroring step 1's reserved-cfxcode redirect (wiki
+             * L713-728, L770/L777). DADAORunMode's numeric values already
+             * equal the monitor cfxcodes 1:1 (0=umon..3=hmon). */
+            target_cfx = (uint64_t)env->inner_run_mode;
+            cause = DADAO_CFX_MONITOR_CAUSE_ILLI;
+            continue;
+        }
+
+        /* Step 5 cause-mask block, any async block, or (defensively
+         * unreachable, per the comment above) a sync routing-mask block on
+         * pass 1: OR into pending, no entry. [wiki L697-698, L781-785] */
+        env->cfx_common_pending[target_cfx] |=
+            cause & dadao_cfx_common_pending_mask(target_cfx);
+        return false;
+    }
+    return false;
+}
+
+/* KL-131a: true while any test-only synthetic async source is configured.
+ * Gates forcing single-instruction TBs (dadao_translate_code()) so every
+ * pre-existing test/regression scenario that never touches these test-only
+ * properties keeps its normal multi-instruction TB batching -- this task's
+ * instruction-boundary precision requirement only costs anything for
+ * scenarios that actually opt into it. */
+bool dadao_cfx_async_active(CPUDADAOState *env)
+{
+    DADAOCPU *cpu = container_of(env, DADAOCPU, env);
+    /* Deliberately does NOT include cfx_common_pending_test_seed (KL-120a's
+     * unrelated one-shot register-injection mechanism, used to probe cfx2rd/
+     * cfx2rc access, not delivery) -- keeping this scoped to only KL-131a's
+     * two new level sources means every pre-existing KL-120a probe keeps its
+     * exact prior TB granularity and never enters this task's async-delivery
+     * machinery at all. */
+    return cpu->cfx_async_test_level_a_seed != 0 ||
+           cpu->cfx_async_test_level_b_seed != 0;
+}
+
+/* KL-131a: re-latch the two test-only synthetic level sources (electrics,
+ * wiki L656) and select the next async cause to deliver per contracts/isa/
+ * spec.md §8.5.1: lowest pending eligible cfxcode first, then lowest set
+ * eligible cause bit within that cfx. Returns false if nothing is eligible
+ * right now (blocked bits stay latched in cfx_common_pending). */
+static bool dadao_cfx_async_scan(DADAOCPU *cpu, uint64_t *out_target,
+                                 uint64_t *out_cause)
+{
+    CPUDADAOState *env = &cpu->env;
+
+    if (cpu->cfx_async_test_level_a_seed != 0) {
+        uint64_t target = cpu->cfx_async_test_level_a_code & 0x3F;
+        env->cfx_common_pending[target] |=
+            cpu->cfx_async_test_level_a_seed &
+            dadao_cfx_common_pending_mask(target);
+    }
+    if (cpu->cfx_async_test_level_b_seed != 0) {
+        uint64_t target = cpu->cfx_async_test_level_b_code & 0x3F;
+        env->cfx_common_pending[target] |=
+            cpu->cfx_async_test_level_b_seed &
+            dadao_cfx_common_pending_mask(target);
+    }
+
+    for (uint64_t cfx = 0; cfx < 64; cfx++) {
+        uint64_t pending = env->cfx_common_pending[cfx] &
+                           dadao_cfx_common_pending_mask(cfx);
+        while (pending != 0) {
+            uint64_t bit = pending & (-pending);
+            if (dadao_cfx_cause_eligible(env, cfx, bit)) {
+                *out_target = cfx;
+                *out_cause = bit;
+                return true;
+            }
+            pending &= ~bit;
+        }
+    }
+    return false;
+}
+
+/* KL-131a: instruction-boundary async dispatch entry, called from
+ * dadao_cpu_exec_interrupt() (translate.c) the same way any other QEMU
+ * target's cpu_exec_interrupt hook would call its own do_interrupt(). */
+bool dadao_cfx_async_step(CPUState *cs)
+{
+    DADAOCPU *cpu = DADAO_CPU(cs);
+    CPUDADAOState *env = &cpu->env;
+    uint64_t target, cause;
+
+    if (!dadao_cfx_async_scan(cpu, &target, &cause)) {
+        return false;
+    }
+    env->cfx_async_pending_target = target;
+    env->cfx_async_pending_cause = cause;
+    cs->exception_index = EXCP_CFX_ASYNC;
+    dadao_cpu_do_interrupt(cs);
+    return true;
+}
+
 void dadao_cpu_do_interrupt(CPUState *cs)
 {
     DADAOCPU *cpu = DADAO_CPU(cs);
@@ -460,10 +711,14 @@ void dadao_cpu_do_interrupt(CPUState *cs)
             env->rd[31] = ret;
         } else if (cfxcode == 2 && cpu->cfx_smon_real) {
             /* KL-116a Oracle O3: real SEE §5 entry-flow subset, cfx_smon
-             * target, now routed through KL-122a's shared precise carrier. */
-            dadao_cfx_precise_trap_enter(cpu, DADAO_CFX_CODE_SMON,
-                                         DADAO_CFX_CAUSE_CFXTRAP,
-                                         raw_insn, env->pc - 4);
+             * target, now routed through KL-131a's steps 2-6 gate in front
+             * of KL-122a's shared precise carrier. CFXTRAP is nonmaskable in
+             * every cfx's cause table, so this is behaviorally identical to
+             * the direct carrier call it replaces except for now also
+             * incrementing cfx_trap_num (step 6, previously unimplemented). */
+            dadao_cfx_dispatch(cpu, DADAO_CFX_CODE_SMON,
+                               DADAO_CFX_CAUSE_CFXTRAP, raw_insn,
+                               env->pc - 4, true);
         } else if (cfxcode == DADAO_CFX_CODE_PTW) {
             /*
              * KL-129a SBI-style functional delegation. CFXTRAP's cause_ip
@@ -472,11 +727,13 @@ void dadao_cpu_do_interrupt(CPUState *cs)
              * the handler resumes past the call with escape cfx_ptw,1
              * (cause_ip+4), matching KL-116a's established
              * "escape cfx_smon,1" trap-as-call pattern. E1 in the PTW
-             * frame restores the cfx_tlb caller.
+             * frame restores the cfx_tlb caller. KL-131a: routed through the
+             * steps 2-6 gate; CFXTRAP is nonmaskable so behavior is
+             * unchanged except for the new cfx_trap_num counter.
              */
-            dadao_cfx_precise_trap_enter(cpu, DADAO_CFX_CODE_PTW,
-                                         DADAO_CFX_CAUSE_CFXTRAP,
-                                         raw_insn, env->pc - 4);
+            dadao_cfx_dispatch(cpu, DADAO_CFX_CODE_PTW,
+                               DADAO_CFX_CAUSE_CFXTRAP, raw_insn,
+                               env->pc - 4, true);
         } else {
             /* unknown cfxcode → ILLI */
             qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC, 0x82);
@@ -485,6 +742,22 @@ void dadao_cpu_do_interrupt(CPUState *cs)
         cs->exception_index = -1;
         return;
     }
+    case EXCP_CFX_ASYNC: {
+        /* KL-131a: dadao_cfx_async_step() already ran the full steps 2-6
+         * scan and confirmed eligibility; re-run dadao_cfx_dispatch() here
+         * (not a direct precise_trap_enter call) so a mask changed by a
+         * racing... there is no race in this single-threaded interpreter,
+         * but re-running the shared gate keeps exactly one code path
+         * responsible for step 6's counters and the steps 7-10 carrier
+         * call, matching every other cfx entry route in this switch. */
+        uint64_t target = env->cfx_async_pending_target;
+        uint64_t cause = env->cfx_async_pending_cause;
+        env->cfx_async_pending_target = 0;
+        env->cfx_async_pending_cause = 0;
+        dadao_cfx_dispatch(cpu, target, cause, 0, env->pc, false);
+        cs->exception_index = -1;
+        return;
+    }
     case 0x84: /* RASOF */
         qemu_system_shutdown_request_with_code(SHUTDOWN_CAUSE_GUEST_PANIC, 0x84);
         break;
@@ -893,10 +1166,23 @@ bool dadao_cpu_tlb_fill(CPUState *cs, vaddr address, int size,
             return false;
         }
         cpu_restore_state(cs, retaddr);
-        dadao_cfx_precise_trap_enter(
+        /* KL-131a: routed through the steps 2-6 gate; every cfx_ptw/cfx_tlb
+         * cause is nonmaskable (KL-118a, re-confirmed against the wiki cause
+         * tables for this task: dadao_cfx_excp_cause_nonmaskable_for()
+         * always sets all 18 cfx_ptw / all 10 cfx_tlb cause bits), so
+         * dadao_cfx_dispatch() is guaranteed to return true (entered) here
+         * -- the unconditional cpu_loop_exit() below is safe. A blocked/
+         * no-entry result would need more than skipping this call (physical/
+         * prot below are only valid on the entered path, and env->pc still
+         * points at the faulting access, so a bare "skip the exit" fallback
+         * would both use uninitialized state and risk the identical
+         * infinite-refault bug this task's TEST-ONLY sync trigger hit and
+         * fixed in helper_cfx2rc() -- not a defensible partial fix for a
+         * path that cannot currently be reached). */
+        dadao_cfx_dispatch(
             DADAO_CPU(cs), fault_cfxcode, fault_cause,
             address & UINT64_C(0x0000ffffffffffff),
-            DADAO_CPU(cs)->env.pc);
+            DADAO_CPU(cs)->env.pc, true);
         cpu_loop_exit(cs);
     }
     physical_page = physical & TARGET_PAGE_MASK;
@@ -925,6 +1211,16 @@ static const Property dadao_cpu_properties[] = {
                       cfx_common_pending_test_code, 18),
     DEFINE_PROP_UINT64("cfx-common-pending-test-seed", DADAOCPU,
                        cfx_common_pending_test_seed, 0),
+    /* KL-131a TEST-ONLY: two independent synthetic level sources. See
+     * cpu.h's ArchCPU field comment. Defaults are inert (seed=0). */
+    DEFINE_PROP_UINT8("cfx-async-test-level-a-code", DADAOCPU,
+                      cfx_async_test_level_a_code, 0),
+    DEFINE_PROP_UINT64("cfx-async-test-level-a-seed", DADAOCPU,
+                       cfx_async_test_level_a_seed, 0),
+    DEFINE_PROP_UINT8("cfx-async-test-level-b-code", DADAOCPU,
+                      cfx_async_test_level_b_code, 0),
+    DEFINE_PROP_UINT64("cfx-async-test-level-b-seed", DADAOCPU,
+                       cfx_async_test_level_b_seed, 0),
 };
 
 static void dadao_cpu_class_init(ObjectClass *oc, void *data)
diff --git a/target/dadao/cpu.h b/target/dadao/cpu.h
index 5479388..3ddf22d 100644
--- a/target/dadao/cpu.h
+++ b/target/dadao/cpu.h
@@ -16,6 +16,12 @@
  * existing 0x81-0x85 QEMU-fault exit code scheme contiguously (ADR-0004
  * §Summary of Exit Code Layout). */
 #define EXCP_CFXREG 6
