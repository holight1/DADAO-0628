-typedef struct DADAOCfxSmonFrame {
+/* KL-122a: common SEE §3 cg5 exception-frame carrier. Every cfxcode owns
+ * one slot; software writes rc0/1/3/5 while precise trap entry owns the
+ * hardware cause fields rc2/4. */
+typedef struct DADAOCfxFrame {
     target_ulong prev_run_mode;
     target_ulong prev_cfx_mask;
     target_ulong cause_id;
     target_ulong cause_ip;
     target_ulong cause_info;
     target_ulong prev_cfx_code;
-} DADAOCfxSmonFrame;
+} DADAOCfxFrame;
 
 /* SEE §3 cg5 cause id for CFXTRAP: bit 0, one-hot.
  * [wiki §DADAO-12-SEE-主管系统运行环境.md L402] */
@@ -129,8 +118,10 @@ struct CPUArchState {
     DADAORunMode inner_run_mode;
     DADAOCfxCode inner_cfx_code;
     target_ulong inner_cfx_mask;
-    DADAOCfxPowerFrame cfx_power_frame;
     target_ulong cfx_hypv_cg_reg_deleg[64];
+    DADAOCfxFrame cfx_frame[64];
+    /* SEE §3 cg2/rc10 supervisor exception vector, one per cfxcode. */
+    target_ulong cfx_supv_excp_vector[64];
     /* KL-120a: project-local K1 common cause-pending register, cg4/rc7.
      * One slot per raw cfxcode keeps the generic carrier shape; reserved
      * codes and cfxes without maskable causes always read zero. */
@@ -151,12 +142,6 @@ struct CPUArchState {
      * cfx_smon_real profile's entry state machine (excp_cause_info, SEE §5
      * step 9); the always-on host/SE syscall shortcut never reads it. */
     target_ulong trap_insn;
-    /* KL-116a Oracle O3: cfx_smon exception frame + its supv-mode excp
-     * vector (SEE §3 cg2/rc10, [wiki §DADAO-12-SEE §3 L328]). Written by
-     * dadao_cfx_smon_trap_enter() / read back by cfx2rc's rc=10 branch and
-     * by helper_escape()'s new DADAO_CFX_CODE_SMON restore branch. */
-    DADAOCfxSmonFrame cfx_smon_frame;
-    target_ulong cfx_smon_supv_excp_vector;
 };
 
