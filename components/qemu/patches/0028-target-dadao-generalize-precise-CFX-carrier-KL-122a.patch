@@ -167,7 +152,7 @@ struct ArchCPU {
      * (host/SE syscall shortcut, cpu.c EXCP_CFXTRAP case) -- byte-identical
      * to every pre-KL-116a build. When explicitly enabled, the same
      * cfxcode==2 case instead runs the real SEE §5 entry-flow subset
-     * (dadao_cfx_smon_trap_enter()). See KL-115a report §4.4 option A. */
+     * through dadao_cfx_precise_trap_enter(). See KL-115a report §4.4. */
     bool cfx_smon_real;
     /* KL-120a test-harness-only raw common-pending injection. Both
      * properties default to inert; normal architectural reset remains zero.
