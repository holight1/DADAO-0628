@@ -53,6 +53,13 @@ static void dadao_cpu_reset_hold(Object *obj, ResetType type)
          * to hypv only, until software clears bits via cfx2rc). */
         env->cfx_hypv_cg_reg_deleg[i] = DADAO_CFX_MASK_ALL;
         env->cfx_common_pending[i] = 0;
+        env->cfx_frame[i].prev_run_mode = DADAO_RUN_MODE_USER;
+        env->cfx_frame[i].prev_cfx_mask = 0;
+        env->cfx_frame[i].cause_id = 0;
+        env->cfx_frame[i].cause_ip = 0;
+        env->cfx_frame[i].cause_info = 0;
+        env->cfx_frame[i].prev_cfx_code = 0;
+        env->cfx_supv_excp_vector[i] = 0;
         /* KL-112a design 1: escape_cfx_mask reset value = all-ones for
          * every (cfxcode, mode) pair [wiki §DADAO-13-HEE §1 L19;
          * §DADAO-12-SEE §3 L281/L305/L325]. */
@@ -65,28 +72,14 @@ static void dadao_cpu_reset_hold(Object *obj, ResetType type)
     env->inner_run_mode = DADAO_RUN_MODE_HYPV;
     env->inner_cfx_code = DADAO_CFX_CODE_POWER;
     env->inner_cfx_mask = DADAO_CFX_MASK_ALL;
-    env->cfx_power_frame.prev_run_mode = DADAO_RUN_MODE_HYPV;
-    env->cfx_power_frame.prev_cfx_mask = DADAO_CFX_MASK_ALL;
-    env->cfx_power_frame.cause_ip = 0;
+    env->cfx_frame[DADAO_CFX_CODE_POWER].prev_run_mode =
+        DADAO_RUN_MODE_HYPV;
+    env->cfx_frame[DADAO_CFX_CODE_POWER].prev_cfx_mask =
+        DADAO_CFX_MASK_ALL;
     /* Preserve the pre-E1 O1 handoff result when software does not
      * explicitly populate the new rc5 carrier. */
-    env->cfx_power_frame.prev_cfx_code = DADAO_CFX_CODE_POWER;
-    /* KL-116a Oracle O3: cfx_smon frame + its cg2/rc10 excp vector reset to
