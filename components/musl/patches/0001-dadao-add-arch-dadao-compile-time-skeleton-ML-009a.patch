diff --git a/arch/dadao/bits/stat.h b/arch/dadao/bits/stat.h
new file mode 100644
index 00000000..a55e6365
--- /dev/null
+++ b/arch/dadao/bits/stat.h
@@ -0,0 +1,27 @@
+/*
+ * Generic 64-bit `struct stat` layout (Linux asm-generic/stat.h shape).
+ * Verified identical between arch/aarch64/bits/stat.h and
+ * arch/riscv64/bits/stat.h -- both are, like DADAO (ADR-0014 D2), plain
+ * asm-generic-syscall-numbering LP64 ports with no legacy 32-bit stat
+ * variant, so the same field layout applies (this is the `newfstatat`/
+ * `fstat` (asm-generic __NR_fstat=80) struct shape, matching the syscall
+ * numbers already implemented by the cfx_smon responders).
+ */
+struct stat {
+	dev_t st_dev;
+	ino_t st_ino;
+	mode_t st_mode;
+	nlink_t st_nlink;
+	uid_t st_uid;
+	gid_t st_gid;
+	dev_t st_rdev;
+	unsigned long __pad;
+	off_t st_size;
+	blksize_t st_blksize;
+	int __pad2;
+	blkcnt_t st_blocks;
+	struct timespec st_atim;
+	struct timespec st_mtim;
+	struct timespec st_ctim;
+	unsigned __unused[2];
+};
diff --git a/arch/dadao/bits/stdint.h b/arch/dadao/bits/stdint.h
new file mode 100644
index 00000000..7cba435a
--- /dev/null
+++ b/arch/dadao/bits/stdint.h
@@ -0,0 +1,26 @@
+/*
+ * Identical across every LP64 musl arch (aarch64/x86_64/powerpc64/...):
+ * these values depend only on "long is 64-bit, int_fast16/32 map to
+ * int32_t," which holds for DADAO too (contracts/abi/spec.md: 64-bit
+ * registers, standard C int is 32-bit).
+ */
+typedef int32_t int_fast16_t;
+typedef int32_t int_fast32_t;
+typedef uint32_t uint_fast16_t;
+typedef uint32_t uint_fast32_t;
+
+#define INT_FAST16_MIN  INT32_MIN
+#define INT_FAST32_MIN  INT32_MIN
+
+#define INT_FAST16_MAX  INT32_MAX
+#define INT_FAST32_MAX  INT32_MAX
+
+#define UINT_FAST16_MAX UINT32_MAX
+#define UINT_FAST32_MAX UINT32_MAX
+
+#define INTPTR_MIN      INT64_MIN
+#define INTPTR_MAX      INT64_MAX
+#define UINTPTR_MAX     UINT64_MAX
+#define PTRDIFF_MIN     INT64_MIN
+#define PTRDIFF_MAX     INT64_MAX
+#define SIZE_MAX        UINT64_MAX
