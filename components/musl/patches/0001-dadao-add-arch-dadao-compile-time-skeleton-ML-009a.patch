diff --git a/arch/dadao/kstat.h b/arch/dadao/kstat.h
new file mode 100644
index 00000000..7f41f2f6
--- /dev/null
+++ b/arch/dadao/kstat.h
@@ -0,0 +1,27 @@
+/*
+ * Kernel-facing raw stat struct (used internally by src/stat/ to translate
+ * the fstat/newfstatat syscall result into the public `struct stat` in
+ * bits/stat.h). Verified identical between arch/aarch64/kstat.h and
+ * arch/riscv64/kstat.h -- same generic-syscall-ABI reasoning as bits/stat.h.
+ */
+struct kstat {
+	dev_t st_dev;
+	ino_t st_ino;
+	mode_t st_mode;
+	nlink_t st_nlink;
+	uid_t st_uid;
+	gid_t st_gid;
+	dev_t st_rdev;
+	unsigned long __pad;
+	off_t st_size;
+	blksize_t st_blksize;
+	int __pad2;
+	blkcnt_t st_blocks;
+	long st_atime_sec;
+	long st_atime_nsec;
+	long st_mtime_sec;
+	long st_mtime_nsec;
+	long st_ctime_sec;
+	long st_ctime_nsec;
+	unsigned __unused[2];
+};
diff --git a/arch/dadao/reloc.h b/arch/dadao/reloc.h
new file mode 100644
index 00000000..f8d861c6
--- /dev/null
+++ b/arch/dadao/reloc.h
@@ -0,0 +1,58 @@
+/*
+ * DADAO relocation types map to contracts/elf/spec.md SS2 (10 types,
+ * ADR-0003 SSD2) -- NOT the legacy ~/toolchain/musl numbering
+ * (R_DADAO_ABS=13 / R_DADAO_JUMP=17 / R_DADAO_32=4), which predates this
+ * greenfield ABI and must not be reused (see ML-006a recon SS1.2).
+ *
+ * ADR-0014 D5 (musl builds static-only for the foreseeable future) means
+ * none of the dynamic-linking-only macros below (REL_GOT/REL_PLT/
+ * REL_RELATIVE/REL_COPY) are exercised by the static-link path this task
+ * validates; they are filled in with the closest current spec-defined type
+ * for future-proofing and documented per-macro. The TLS macros
+ * (REL_DTPMOD/REL_DTPOFF/REL_TPOFF/REL_TLSDESC) are likewise unreachable in
+ * the static single-threaded phase (ML-006a SS3.3: musl itself never uses
+ * compiler-generated TLS access reloc types -- __pthread_self() derives
+ * everything from rb4/rbtp read via ordinary register-copy instructions).
+ * contracts/elf/spec.md currently defines NO dedicated TLS relocation type,
+ * so these four are mapped to R_DADAO_NONE (0) as an explicit placeholder,
+ * per this task's brief -- not a guess at a future real encoding.
+ */
+
+#define LDSO_ARCH "dadao"
+
+#define TPOFF_K 0
+
+/* R_DADAO_64 (#1): S+A into a full 64-bit field -- the only type able to
+ * hold an absolute pointer-sized value, so it is musl's REL_SYMBOLIC (used
+ * by ldso for absolute symbolic relocations in .data/.got-like slots) and
+ * also stands in for REL_GOT/REL_PLT/REL_RELATIVE/REL_COPY below: none of
+ * the M1 relocation types were designed with GOT/PLT semantics (no dynamic
+ * linker exists yet -- ADR-0014 D5, ML-006a SS3.4), so R_DADAO_64 is the
+ * only type that is even shape-compatible (8-byte field, no PC-relative
+ * computation) and is used as a placeholder until a real dynamic-linking
+ * ABI is designed. */
+#define REL_SYMBOLIC    1  /* R_DADAO_64 */
+#define REL_GOT         1  /* R_DADAO_64 (placeholder; no real GOT reloc type yet) */
+#define REL_PLT         1  /* R_DADAO_64 (placeholder; no real PLT reloc type yet) */
+#define REL_RELATIVE    1  /* R_DADAO_64 (placeholder; no real B+A reloc type yet) */
+#define REL_COPY        1  /* R_DADAO_64 (placeholder; no copy-reloc type yet) */
+
+/* No TLS relocation type in contracts/elf/spec.md (M1 scope) -- static
+ * single-threaded musl never reaches these (ML-006a SS3.3). Mapped to
+ * R_DADAO_NONE (0) as an explicit unreachable placeholder. */
+#define REL_DTPMOD      0  /* R_DADAO_NONE (placeholder; unreachable in M1) */
+#define REL_DTPOFF      0  /* R_DADAO_NONE (placeholder; unreachable in M1) */
+#define REL_TPOFF       0  /* R_DADAO_NONE (placeholder; unreachable in M1) */
+#define REL_TLSDESC     0  /* R_DADAO_NONE (placeholder; unreachable in M1) */
+
+/* CRTJMP: transfer control to `pc` with stack pointer `sp` set first (used
+ * by ldso to jump into the loaded program's entry point). rb1 = rbsp per
+ * contracts/abi/spec.md SS1.2; rb0 = rbip is read-only (PC), so control
+ * transfer must go through an indirect jump register, not a write to rb0.
+ * [OPEN: DADAO has no dynamic linker yet (ADR-0014 D5) and this macro is
+ * only referenced by ldso/dynlink.c, which is not part of the static-link
+ * path exercised by this task; the exact indirect-jump instruction to use
+ * is left for the dynamic-linking milestone -- not guessed here.]
+ */
+#define CRTJMP(pc,sp) __asm__ __volatile__( \
+	"rb2rb rb1, %1, 1\n\tret %0, 0" : : "r"(pc), "r"(sp) : "memory" )
diff --git a/arch/dadao/syscall_arch.h b/arch/dadao/syscall_arch.h
new file mode 100644
index 00000000..b345948d
--- /dev/null
+++ b/arch/dadao/syscall_arch.h
@@ -0,0 +1,124 @@
+/*
+ * DADAO syscall ABI (docs/adr/0014-libc-syscall-charter.md D2, spec-first
+ * per contracts/isa/spec.md SEE trap mechanism):
+ *
+ *   rd16        = syscall number (input only)
+ *   rd17..rd22  = arg0..arg5     (input only)
+ *   rd31        = return value   (output only)
+ *   trap 2, 0   = "trap cfx_smon" -- crrr-format trap instruction with
+ *                 cfxcode=2 (cfx_smon, the User->S-mode syscall monitor
+ *                 entry point). The assembler accepts `trap` with a literal
+ *                 cfxcode immediate (see tests/scripts/pico_stubs.s); there
+ *                 is no symbolic `cfx_smon` mnemonic in the current AsmParser.
+ *
+ * Unlike e.g. riscv64/arm64 (single a0 register reused for both an input
+ * argument and the output value via a "+r"/"0(...)" constraint), DADAO's ABI
+ * gives the return value its own dedicated register (rd31), so each named
+ * register below is either purely input or purely output -- no read-modify
+ * aliasing is needed.
+ *
+ * Verified (ML-009a): clang --target=dadao honors GCC/clang extended-asm
+ * named-register variables (`register long x __asm__("rd16") = ...`) by
+ * placing the value directly in the requested physical register before the
+ * asm block, and reads "=r" outputs back from the requested register
+ * afterward -- confirmed by inspecting the emitted .s for multi-register
+ * probes (rd16/rd17/rd20 inputs, rd31 output) with `clang -O2 -S`.
+ */
+
+#define __SYSCALL_LL_E(x) (x)
+#define __SYSCALL_LL_O(x) (x)
+
+static inline long __syscall0(long n)
+{
+	register long rd16 __asm__("rd16") = n;
+	register long rd31 __asm__("rd31");
+	__asm__ __volatile__ ("trap 2, 0\n\t"
+		: "=r"(rd31) : "r"(rd16) : "memory");
+	return rd31;
+}
+
+static inline long __syscall1(long n, long a)
+{
+	register long rd16 __asm__("rd16") = n;
+	register long rd17 __asm__("rd17") = a;
+	register long rd31 __asm__("rd31");
+	__asm__ __volatile__ ("trap 2, 0\n\t"
+		: "=r"(rd31) : "r"(rd16), "r"(rd17) : "memory");
+	return rd31;
+}
+
+static inline long __syscall2(long n, long a, long b)
+{
+	register long rd16 __asm__("rd16") = n;
+	register long rd17 __asm__("rd17") = a;
+	register long rd18 __asm__("rd18") = b;
+	register long rd31 __asm__("rd31");
+	__asm__ __volatile__ ("trap 2, 0\n\t"
+		: "=r"(rd31) : "r"(rd16), "r"(rd17), "r"(rd18) : "memory");
+	return rd31;
+}
+
+static inline long __syscall3(long n, long a, long b, long c)
+{
+	register long rd16 __asm__("rd16") = n;
+	register long rd17 __asm__("rd17") = a;
+	register long rd18 __asm__("rd18") = b;
+	register long rd19 __asm__("rd19") = c;
+	register long rd31 __asm__("rd31");
+	__asm__ __volatile__ ("trap 2, 0\n\t"
+		: "=r"(rd31) : "r"(rd16), "r"(rd17), "r"(rd18), "r"(rd19) : "memory");
+	return rd31;
+}
+
+static inline long __syscall4(long n, long a, long b, long c, long d)
+{
+	register long rd16 __asm__("rd16") = n;
+	register long rd17 __asm__("rd17") = a;
+	register long rd18 __asm__("rd18") = b;
+	register long rd19 __asm__("rd19") = c;
+	register long rd20 __asm__("rd20") = d;
+	register long rd31 __asm__("rd31");
+	__asm__ __volatile__ ("trap 2, 0\n\t"
+		: "=r"(rd31)
+		: "r"(rd16), "r"(rd17), "r"(rd18), "r"(rd19), "r"(rd20)
+		: "memory");
+	return rd31;
+}
+
+static inline long __syscall5(long n, long a, long b, long c, long d, long e)
+{
+	register long rd16 __asm__("rd16") = n;
+	register long rd17 __asm__("rd17") = a;
+	register long rd18 __asm__("rd18") = b;
+	register long rd19 __asm__("rd19") = c;
+	register long rd20 __asm__("rd20") = d;
+	register long rd21 __asm__("rd21") = e;
+	register long rd31 __asm__("rd31");
+	__asm__ __volatile__ ("trap 2, 0\n\t"
+		: "=r"(rd31)
+		: "r"(rd16), "r"(rd17), "r"(rd18), "r"(rd19), "r"(rd20), "r"(rd21)
+		: "memory");
+	return rd31;
+}
+
+static inline long __syscall6(long n, long a, long b, long c, long d, long e, long f)
+{
+	register long rd16 __asm__("rd16") = n;
+	register long rd17 __asm__("rd17") = a;
+	register long rd18 __asm__("rd18") = b;
+	register long rd19 __asm__("rd19") = c;
+	register long rd20 __asm__("rd20") = d;
+	register long rd21 __asm__("rd21") = e;
+	register long rd22 __asm__("rd22") = f;
+	register long rd31 __asm__("rd31");
+	__asm__ __volatile__ ("trap 2, 0\n\t"
+		: "=r"(rd31)
+		: "r"(rd16), "r"(rd17), "r"(rd18), "r"(rd19), "r"(rd20), "r"(rd21),
+		  "r"(rd22)
+		: "memory");
+	return rd31;
+}
+
+/* No vDSO on DADAO (bare cfx_smon trap responder, MVP per ADR-0014 D4). */
+
+#define IPC_64 0
