diff --git a/arch/dadao/bits/alltypes.h.in b/arch/dadao/bits/alltypes.h.in
new file mode 100644
index 00000000..db8a0c3a
--- /dev/null
+++ b/arch/dadao/bits/alltypes.h.in
@@ -0,0 +1,25 @@
+/*
+ * DADAO M1: 64-bit registers/pointers (contracts/abi/spec.md), big-endian
+ * instruction fetch and data access (contracts/elf/spec.md 1.2, EI_DATA =
+ * ELFDATA2MSB). __BYTE_ORDER = 4321 is NOT copy-pasted from a little-endian
+ * arch -- it is the deliberate, explicit choice for this target (see
+ * arch/s390x and arch/powerpc64 big-endian variant for the same pattern,
+ * which this file otherwise mirrors: 64-bit long/pointer, no 32-on-64
+ * historical baggage).
+ */
+
+#define _Addr long
+#define _Int64 long
+#define _Reg long
+
+#define __BYTE_ORDER 4321
+#define __LONG_MAX 0x7fffffffffffffffL
+
+#ifndef __cplusplus
+TYPEDEF int wchar_t;
+#endif
+
+TYPEDEF float float_t;
+TYPEDEF double double_t;
+
+TYPEDEF struct { long long __ll; long double __ld; } max_align_t;
diff --git a/arch/dadao/bits/float.h b/arch/dadao/bits/float.h
new file mode 100644
index 00000000..7e34679a
--- /dev/null
+++ b/arch/dadao/bits/float.h
@@ -0,0 +1,26 @@
+/*
+ * DADAO M1 excludes the RF (float) register bank and all hardware
+ * floating-point (contracts/isa/spec.md M1 scope; ADR-0014). Clang's
+ * `dadao` target therefore defines `long double` identically to `double`
+ * (verified: `__LDBL_MANT_DIG__ == 53` and `__SIZEOF_LONG_DOUBLE__ == 8`
+ * for `--target=dadao`, matching the IEEE-754 binary64 values below).
+ * This is the same "long double == double" shape used by other
+ * soft-float/no-extended-format ports (e.g. arch/or1k/bits/float.h).
+ */
+
+#define FLT_EVAL_METHOD 0
+
+#define LDBL_TRUE_MIN 4.94065645841246544177e-324L
+#define LDBL_MIN 2.22507385850720138309e-308L
+#define LDBL_MAX 1.79769313486231570815e+308L
+#define LDBL_EPSILON 2.22044604925031308085e-16L
+
+#define LDBL_MANT_DIG 53
+#define LDBL_MIN_EXP (-1021)
+#define LDBL_MAX_EXP 1024
+
+#define LDBL_DIG 15
+#define LDBL_MIN_10_EXP (-307)
+#define LDBL_MAX_10_EXP 308
+
+#define DECIMAL_DIG 17
diff --git a/arch/dadao/bits/posix.h b/arch/dadao/bits/posix.h
new file mode 100644
index 00000000..0fbd151b
--- /dev/null
+++ b/arch/dadao/bits/posix.h
@@ -0,0 +1,10 @@
+/*
+ * Pure LP64 conformance macros (64-bit long, 64-bit off_t) -- these describe
+ * the C *programming environment* (XSI conformance), not any DADAO-specific
+ * register/ABI detail, so the same values apply as every other pure-LP64
+ * musl port (riscv64, the only other arch that bothers to state them
+ * explicitly; most 64-bit archs omit this file and get the same effect via
+ * <bits/alltypes.h> alone).
+ */
+#define _POSIX_V6_LP64_OFF64 1
+#define _POSIX_V7_LP64_OFF64 1
diff --git a/arch/dadao/bits/setjmp.h b/arch/dadao/bits/setjmp.h
new file mode 100644
index 00000000..3a3f1f00
--- /dev/null
+++ b/arch/dadao/bits/setjmp.h
@@ -0,0 +1,15 @@
+/*
+ * [OPEN: size-only placeholder, NOT a reviewed DADAO setjmp/longjmp frame
+ * layout. Every musl arch's __jmp_buf size is derived from that arch's own
+ * setjmp.s (how many callee-saved registers it actually spills) -- DADAO
+ * has no arch/dadao/src/setjmp/*.s yet (ML-006a SS5 phase-B follow-up,
+ * explicitly out of scope for this task, which is a compile-time-only
+ * skeleton). Sized generously to cover the full M1 callee-saved register
+ * set (rd32-63 + rb32-63 = 64 registers, contracts/abi/spec.md SS1) plus
+ * slack, so it compiles; the real save/restore sequence (including how the
+ * hardware RegRAS return-address stack -- which is not a plain memory
+ * location, contracts/abi/spec.md SS1.4 -- interacts with a non-local jump)
+ * is a design question for whoever implements the real setjmp.s, not
+ * decided here. Do not size anything against this value.]
+ */
+typedef unsigned long __jmp_buf[72];
diff --git a/arch/dadao/bits/signal.h b/arch/dadao/bits/signal.h
new file mode 100644
index 00000000..fe9ba39c
--- /dev/null
+++ b/arch/dadao/bits/signal.h
@@ -0,0 +1,101 @@
+/*
+ * Signal numbers, SA_* flags and _NSIG below are the standard Linux
+ * numbering shared verbatim by every modern 64-bit musl port (verified:
+ * arch/aarch64/bits/signal.h and arch/riscv64/bits/signal.h agree on every
+ * one of these values) -- they are a Linux ABI constant, not a DADAO
+ * register/ABI decision, so the same numbers apply here.
+ *
+ * [OPEN: gregset_t/mcontext_t/ucontext_t below are a size-only placeholder,
+ * NOT a reviewed DADAO signal-frame ABI. rt_sigaction/rt_sigreturn are not
+ * implemented by the cfx_smon trap responder yet (ML-006a SS2.3 lists them
+ * P3, explicitly deferred past the static single-threaded phase this task
+ * targets), so no real DADAO sigcontext layout exists to encode yet. This
+ * is sized loosely off the M1 allocatable general-purpose register count
+ * (rd32-63 + rb32-63 = 64 registers, contracts/abi/spec.md SS1) purely so
+ * `sizeof(mcontext_t)`/`sizeof(ucontext_t)` are stable and <signal.h> is
+ * includable; the real layout (including how the hardware RegRAS return-
+ * address stack -- which has no memory address of its own, see
+ * contracts/abi/spec.md SS1.4 -- gets represented in a saved signal frame)
+ * is a design question for whoever implements real signal delivery, not
+ * decided here. Do not treat any field name/offset below as load-bearing.]
+ */
+
+#if defined(_POSIX_SOURCE) || defined(_POSIX_C_SOURCE) \
+ || defined(_XOPEN_SOURCE) || defined(_GNU_SOURCE) || defined(_BSD_SOURCE)
+
+#if defined(_XOPEN_SOURCE) || defined(_GNU_SOURCE) || defined(_BSD_SOURCE)
+#define MINSIGSTKSZ 2048
+#define SIGSTKSZ 8192
+#endif
+
+typedef unsigned long __dadao_mc_gp_state[64]; /* [OPEN: placeholder, see above */
+
+#if defined(_GNU_SOURCE) || defined(_BSD_SOURCE)
+typedef unsigned long greg_t;
+typedef unsigned long gregset_t[64]; /* [OPEN: placeholder, see above */
+#endif
+
+typedef struct mcontext_t {
+	__dadao_mc_gp_state __gregs; /* [OPEN: placeholder, see above */
+} mcontext_t;
+
+struct sigaltstack {
+	void *ss_sp;
+	int ss_flags;
+	size_t ss_size;
+};
+
+typedef struct __ucontext {
+	unsigned long uc_flags;
+	struct __ucontext *uc_link;
+	stack_t uc_stack;
+	sigset_t uc_sigmask;
+	mcontext_t uc_mcontext;
+} ucontext_t;
+
+#define SA_NOCLDSTOP 1
+#define SA_NOCLDWAIT 2
+#define SA_SIGINFO   4
+#define SA_ONSTACK   0x08000000
+#define SA_RESTART   0x10000000
+#define SA_NODEFER   0x40000000
+#define SA_RESETHAND 0x80000000
+
+#endif
+
+#define SIGHUP     1
+#define SIGINT     2
+#define SIGQUIT    3
+#define SIGILL     4
+#define SIGTRAP    5
+#define SIGABRT    6
+#define SIGIOT     SIGABRT
+#define SIGBUS     7
+#define SIGFPE     8
