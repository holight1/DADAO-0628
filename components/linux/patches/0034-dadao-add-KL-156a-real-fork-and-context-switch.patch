+#define DADAO_M1_PROGRESS_EXEC_INIT_ATTEMPT		0x87fd00b8UL
+#define DADAO_M1_PROGRESS_SWITCH_FROM_IDLE		0x87fd00c0UL
+#define DADAO_M1_PROGRESS_SWITCH_TO_IDLE		0x87fd00c8UL
+#define DADAO_M1_PROGRESS_SWITCH_COUNT			0x87fd00d0UL
+
+#define DADAO_M1_PROGRESS_ROOT_MOUNT_ATTEMPT_VALUE	0x4b4c313536524d41ULL /* KL156RMA */
+#define DADAO_M1_PROGRESS_EXEC_INIT_ATTEMPT_VALUE	0x4b4c313536494558ULL /* KL156IEX */
+#define DADAO_M1_PROGRESS_SWITCH_FROM_IDLE_VALUE	0x4b4c313536534649ULL /* KL156SFI */
+#define DADAO_M1_PROGRESS_SWITCH_TO_IDLE_VALUE		0x4b4c313536535449ULL /* KL156STI */
+
