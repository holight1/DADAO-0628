 #define DADAO_M1_PROGRESS_TIMER_IRQ_COUNT		0x87fd00a8UL
 
+/*
+ * KL-156a: real fork/context-switch evidence (next free offsets
+ * +0xb0..+0xd0). Four ASCII-magic words + one raw incrementing counter.
+ * SWITCH_FROM_IDLE / SWITCH_TO_IDLE are written by __switch_to() when it
