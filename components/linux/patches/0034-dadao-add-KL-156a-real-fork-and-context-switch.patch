diff --git a/arch/dadao/include/asm/dadao-switch.h b/arch/dadao/include/asm/dadao-switch.h
new file mode 100644
index 000000000..831064533
--- /dev/null
+++ b/arch/dadao/include/asm/dadao-switch.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_SWITCH_H
+#define _ASM_DADAO_SWITCH_H
+
+/*
+ * KL-156a: kernel context-switch frame constants.
+ *
+ * Byte-for-byte the KL-140a §2.1 cooperative task frame (135 words = 0x438
+ * = 1080 bytes), minus the bare-metal probe's resume_pc/asid/ptbr fields:
+ * those three words (w0/w1/w2) are padding here, and copy_thread()'s fake
+ * frame reuses w0/w1 to carry the kernel thread's fn/arg to ret_from_fork.
+ * Shared between the assembly switch primitive (switch.S) and the C side
+ * (process.c), so the two can never drift apart.
+ *
+ * | offset | field                      | offset | field         |
+ * |-------:|----------------------------|-------:|---------------|
+ * |   0x000| w0 (fake frame: fn)        |   0x138| rb32..rb63    |
+ * |   0x008| w1 (fake frame: arg)       |   0x238| ra0..ra62     |
+ * |   0x010| w2 (unused)                |   0x430| ra63          |
+ * |   0x018| rb1 (SP)  0x020 rb2        |   0x438| end           |
+ * |   0x028| rb3       0x030 rb4        |         |               |
+ */
+#define DADAO_SWITCH_FRAME_SIZE	0x438
+#define DADAO_SWITCH_FN_OFF	0x000
+#define DADAO_SWITCH_ARG_OFF	0x008
+#define DADAO_SWITCH_RB1_OFF	0x018
+#define DADAO_SWITCH_RB2_OFF	0x020
+#define DADAO_SWITCH_RB3_OFF	0x028
+#define DADAO_SWITCH_RB4_OFF	0x030
+#define DADAO_SWITCH_RD_BASE	0x038
+#define DADAO_SWITCH_RB32_BASE	0x138
+#define DADAO_SWITCH_RA_BASE	0x238
+#define DADAO_SWITCH_RA63_OFF	0x430
+
+#endif /* _ASM_DADAO_SWITCH_H */
