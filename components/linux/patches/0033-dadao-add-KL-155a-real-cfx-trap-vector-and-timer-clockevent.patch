 #define DADAO_M1_PROGRESS_IDLE_ENTER_VALUE		0x4b4c31353449444cULL /* KL154IDL */
 #define DADAO_M1_PROGRESS_CALIBRATE_CONVERGE_ENTER_VALUE	0x4b4c3135344a464cULL /* KL154JFL (jiffies loop) */
 
+/*
+ * KL-155a: raw (non-ASCII-magic) incrementing count of real timer
+ * interrupts serviced by dadao_timer_interrupt() (arch/dadao/kernel/
+ * time.c) -- direct, non-inferential evidence that the CFX async dispatch
+ * -> cfx_timer real vector entry -> clockevent path actually fired one or
+ * more times, independent of and in addition to observing that jiffies
+ * itself advances.
+ */
+#define DADAO_M1_PROGRESS_TIMER_IRQ_COUNT		0x87fd00a8UL
+
 static inline void dadao_m1_progress_write(unsigned long address, u64 value)
 {
 	*(volatile u64 *)address = value;
 }
 
+static inline void dadao_m1_progress_increment(unsigned long address)
+{
+	volatile u64 *slot = (volatile u64 *)address;
+
+	*slot = *slot + 1;
+}
+
 #endif /* _ASM_DADAO_M1_H */
