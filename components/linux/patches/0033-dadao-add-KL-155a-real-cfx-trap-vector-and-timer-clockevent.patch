diff --git a/arch/dadao/include/asm/dadao-cfx.h b/arch/dadao/include/asm/dadao-cfx.h
new file mode 100644
index 000000000..06d6b3bb7
--- /dev/null
+++ b/arch/dadao/include/asm/dadao-cfx.h
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_CFX_H
+#define _ASM_DADAO_CFX_H
+
+/*
+ * KL-155a: register/cfxcode/(cg,rc) constants for the real CFX exception
+ * entry (entry.S) and the C trap/timer dispatch (traps.c, time.c).
+ *
+ * Every constant here is a plain, verified-against-source numeral, not a
+ * guess: cross-checked against contracts/isa/spec.md §8.1-§8.5 and against
+ * .work/source/qemu/target/dadao/cpu.h / cpu.c (dadao_cfx_precise_trap_enter,
+ * dadao_cfx_cause_eligible, dadao_cfx_async_scan) as of the KL-155a
+ * implementation date. This header intentionally has no C-only or
+ * assembly-only syntax so it can be included from both traps.c/time.c/irq.c
+ * and entry.S (preprocessed).
+ */
+
+/* cfxcode values (contracts/isa/spec.md §8, QEMU cpu.h DADAO_CFX_CODE_*) */
+#define DADAO_CFX_CODE_SMON	2
+#define DADAO_CFX_CODE_HART	15
+#define DADAO_CFX_CODE_TIMER	18
+
+/* run_mode values; only supv (2) is used by this port */
+#define DADAO_MODE_SUPV		2
+
+/*
+ * cg5: the common per-cfx exception frame (excp_prev_run_mode/_cfx_mask/
+ * _cause_id/_cause_ip/_cause_info/_prev_cfx_code -- spec.md §8.3/§8.4/§8.5.5,
+ * verified against dadao_cfx_precise_trap_enter()/DADAOCfxFrame).
+ */
+#define DADAO_CG_FRAME			5
+#define DADAO_RC_PREV_RUN_MODE		0
+#define DADAO_RC_PREV_CFX_MASK		1
+#define DADAO_RC_CAUSE_ID		2
+#define DADAO_RC_CAUSE_IP		3
+#define DADAO_RC_CAUSE_INFO		4
+#define DADAO_RC_PREV_CFX_CODE		5
+
+/* cg2/rc10: cfx_<name>_supv_excp_vector (spec.md §8.4 step 10) */
+#define DADAO_CG_VECTOR			2
+#define DADAO_RC_EXCP_VECTOR		10
+
+/*
+ * cg{mode}/rc1: <mode>_global_cfx_mask -- SHARED across every cfxcode for a
+ * given mode (KL-131a; the cfxcode operand of cfx2rc/cfx2rd is ignored for
+ * this register). cg{mode}/rc11: <mode>_excp_cause_mask -- per (cfx, mode).
+ * "mode" is encoded as the cg index (0=user,1=jail,2=supv,3=hypv).
+ */
+#define DADAO_RC_GLOBAL_CFX_MASK	1
+#define DADAO_RC_EXCP_CAUSE_MASK	11
+
+/* cg4/rc7: cfx_<name>_pending (common, W0C) -- spec.md §8.5.1 */
+#define DADAO_CG_COMMON			4
+#define DADAO_RC_COMMON_PENDING		7
+
+/* cg10: cfx_timer private device registers -- spec.md §8.5.2 */
+#define DADAO_CG_TIMER			10
+#define DADAO_RC_TIMER_PENDING		0
+#define DADAO_RC_TIMER_MASK		1
+#define DADAO_RC_TIMER_CTRL		7
+#define DADAO_RC_TIMER_COUNTER0		8
+
+#define DADAO_TIMER_CTRL_ENABLE		0x1
+#define DADAO_TIMER_CTRL_PERIODIC	0x2
+
+/* cg8/rc2: cfx_hart_cycle_lo (RO, monotonic, +1 per retired instruction) */
+#define DADAO_CG_HART			8
+#define DADAO_RC_HART_CYCLE_LO		2
+
+/* Cause bits (one-hot, cg5/rc2 excp_cause_id and cg4/rc7 common pending) */
+#define DADAO_CAUSE_CFXTRAP		(1ULL << 0)
+#define DADAO_CAUSE_TIMER		(1ULL << 10)
+
+/* Reset-default / "block everything" mask value, also used as the
+ * reentrancy-guard constant (see entry.S). */
+#define DADAO_MASK_ALL			0xFFFFFFFFFFFFFFFFULL
+
+#ifndef __ASSEMBLY__
+
+#include <linux/stringify.h>
+#include <linux/types.h>
+
+/*
+ * cfx2rc/cfx2rd's cfxcode/cg/rc operands are embedded as literal TEXT in the
+ * asm string via __stringify(), not passed as inline-asm "i" (immediate)
+ * operands substituted at codegen time. Two independent reasons, both
+ * confirmed empirically while building KL-155a:
+ *   1. This whole port builds at KCFLAGS=-O0 (KL-153a/dadao_defconfig), and
+ *      at -O0 Clang does not reliably constant-fold a literal passed
+ *      through a function-parameter boundary before checking inline-asm "i"
+ *      constraints, even through an __always_inline function.
+ *   2. More fundamentally, the DADAO backend's inline-asm immediate-operand
+ *      printing path itself does not work yet ("cfx2rc , , , " -- every "i"
+ *      operand printed as empty text) -- unsurprising since no prior task
+ *      exercised inline C asm with "i" constraints on this young backend
+ *      (existing DADAO .S files like head.S only ever use literal
+ *      mnemonics, never inline C asm). __stringify() sidesteps this
+ *      entirely by relying purely on preprocessor text substitution, the
+ *      same mechanism traps.c's dadao_cfx_craft_inner_mask() already uses
+ *      for its `trap` instruction.
+ * This is a real, load-bearing toolchain finding, not a style choice --
+ * recorded in the KL-155a task completion record.
+ *
+ * The register operand (cfx2rc's rdhd) hits the identical gap: printing a
+ * "r"-constrained operand via %0 also emits empty text ("cfx2rc 2, 2, 1, "
+ * with nothing after the last comma, confirmed empirically). The fix is the
+ * same GCC/Clang local-register-variable idiom traps.c's
+ * dadao_cfx_craft_inner_mask() already uses for `trap`'s rd16 payload:
+ * pin the value into a literal, named register (rd5 -- chosen from the
+ * globally-reserved RD0-7 set, excluding rd0/zero, rd1/dadao_cfx2rd's own
+ * destination, rd2/DADAOFrameLowering's transient prologue-adjustment
+ * scratch, and rd3/the entry.S reentrancy guard) and reference that name
+ * directly in the asm string; listing it as a "r" input still creates the
+ * dependency edge the compiler needs (ordering the register write before
+ * the asm executes), even though the substituted text is never printed.
+ */
+
+/* cfx2rc is a real assembler mnemonic (KL-114a). */
+#define dadao_cfx2rc(cfxcode, cg, rc, val)				\
+	do {								\
+		register unsigned long __val asm("rd5") = (u64)(val);	\
+		asm volatile("cfx2rc " __stringify(cfxcode) ", "	\
+			     __stringify(cg) ", " __stringify(rc)	\
+			     ", rd5\n\t"				\
+			     :: "r" (__val)				\
+			     : "memory");				\
+	} while (0)
+
+/*
+ * cfx2rd has no assembler mnemonic yet (KL-114a's scope stopped at
+ * ldmo-ra/stmo-ra/cfx2rc/escape; see entry.S's identical note and head.S's
+ * original comment). Raw CRRR encoding, destination pinned to rd1 (globally
+ * reserved from the LLVM register allocator,
+ * DADAORegisterInfo::getReservedRegs(), and otherwise untouched by this
+ * port) so the instruction's 6-bit rd field is a compile-time literal.
+ */
+#define dadao_cfx2rd(cfxcode, cg, rc)					\
+	({								\
+		register unsigned long __v asm("rd1");			\
+		asm volatile(						\
+			".4byte (0x72 << 24) | ((("			\
+			__stringify(cfxcode) ") & 0x3F) << 18) | ((("	\
+			__stringify(cg) ") & 0x3F) << 12) | ((("	\
+			__stringify(rc) ") & 0x3F) << 6) | 1\n\t"	\
+			: "=r" (__v));					\
+		__v;							\
+	})
+
+#endif /* __ASSEMBLY__ */
+
+#endif /* _ASM_DADAO_CFX_H */
