From 06c3d571a8ae249e451dc4f2151e6bfd8e8a5873 Mon Sep 17 00:00:00 2001
From: suiyan <suiyan@sunmmio.com>
Date: Wed, 29 Jul 2026 19:30:12 +0800
Subject: [PATCH] dadao: harden K3 O0 early boot progress

---
 arch/dadao/kernel/early-console.c |  8 ++++++++
 arch/dadao/kernel/setup.c         |  5 ++++-
 include/linux/mm.h                | 10 ++++++++--
 include/linux/moduleparam.h       | 12 ++++++++++--
 init/main.c                       | 10 ++++++++--
 kernel/locking/mutex.c            | 18 +++++++++++++++---
 kernel/params.c                   |  6 +++---
 kernel/printk/printk.c            | 16 ++++++++++++++--
 mm/memblock.c                     | 15 ++++++++++++++-
 9 files changed, 84 insertions(+), 16 deletions(-)

diff --git a/arch/dadao/kernel/early-console.c b/arch/dadao/kernel/early-console.c
index 3c57a9b77..ffcb72577 100644
--- a/arch/dadao/kernel/early-console.c
+++ b/arch/dadao/kernel/early-console.c
@@ -36,3 +36,11 @@ void __init dadao_m1_debug_console_init(void)
 				     sizeof(online) - 1);
 	register_console(&dadao_m1_debug_console);
 }
+
+void __init dadao_m1_debug_console_setup_done(void)
+{
+	static const char done[] = "DADAO M1 setup_arch complete\n";
+
+	dadao_m1_debug_console_write(&dadao_m1_debug_console, done,
+				     sizeof(done) - 1);
+}
diff --git a/arch/dadao/kernel/setup.c b/arch/dadao/kernel/setup.c
index c4df31230..e96a184cf 100644
--- a/arch/dadao/kernel/setup.c
+++ b/arch/dadao/kernel/setup.c
@@ -25,6 +25,7 @@ extern char _start[];
 
 #ifdef CONFIG_DADAO_M1_DEBUG_CONSOLE
 extern void dadao_m1_debug_console_init(void);
+extern void dadao_m1_debug_console_setup_done(void);
 #endif
 
 void __init setup_arch(char **cmdline_p)
@@ -58,7 +59,9 @@ void __init setup_arch(char **cmdline_p)
 	paging_init();
 	dadao_m1_progress_write(DADAO_M1_PROGRESS_SETUP_DONE,
 				DADAO_M1_PROGRESS_SETUP_DONE_VALUE);
-	pr_notice("DADAO M1 setup_arch complete\n");
+#ifdef CONFIG_DADAO_M1_DEBUG_CONSOLE
+	dadao_m1_debug_console_setup_done();
+#endif
 }
 
 static void *dadao_cpuinfo_start(struct seq_file *m, loff_t *pos)
diff --git a/include/linux/mm.h b/include/linux/mm.h
index a2adf95b3..10ccf6fde 100644
--- a/include/linux/mm.h
+++ b/include/linux/mm.h
@@ -2647,7 +2647,13 @@ DECLARE_STATIC_KEY_TRUE(init_on_alloc);
 #else
 DECLARE_STATIC_KEY_FALSE(init_on_alloc);
 #endif
-static inline bool want_init_on_alloc(gfp_t flags)
+#ifdef CONFIG_DADAO_K3_O0_LINK_COMPAT
+typedef unsigned long page_init_result_t;
+#else
+typedef bool page_init_result_t;
+#endif
+
+static inline page_init_result_t want_init_on_alloc(gfp_t flags)
 {
 	if (static_branch_unlikely(&init_on_alloc) &&
 	    !page_poisoning_enabled())
@@ -2660,7 +2666,7 @@ DECLARE_STATIC_KEY_TRUE(init_on_free);
 #else
 DECLARE_STATIC_KEY_FALSE(init_on_free);
 #endif
-static inline bool want_init_on_free(void)
+static inline page_init_result_t want_init_on_free(void)
 {
 	return static_branch_unlikely(&init_on_free) &&
 	       !page_poisoning_enabled();
diff --git a/include/linux/moduleparam.h b/include/linux/moduleparam.h
index 5ba250d91..f35b47174 100644
--- a/include/linux/moduleparam.h
+++ b/include/linux/moduleparam.h
@@ -297,7 +297,14 @@ static inline void kernel_param_unlock(struct module *mod)
  * Returns true if the two parameter names are equal.
  * Dashes (-) are considered equal to underscores (_).
  */
-extern bool parameq(const char *name1, const char *name2);
+/* Natural-width carrier for the DADAO K3 -O0 bool-load workaround. */
+#ifdef CONFIG_DADAO_K3_O0_LINK_COMPAT
+typedef unsigned long kernel_param_match_t;
+#else
+typedef bool kernel_param_match_t;
+#endif
+
+extern kernel_param_match_t parameq(const char *name1, const char *name2);
 
 /**
  * parameqn - checks if two parameter names match
@@ -307,7 +314,8 @@ extern bool parameq(const char *name1, const char *name2);
  *
  * Similar to parameq(), except it compares @n characters.
  */
-extern bool parameqn(const char *name1, const char *name2, size_t n);
+extern kernel_param_match_t
+parameqn(const char *name1, const char *name2, size_t n);
 
 /* Called on module insert or kernel boot */
 extern char *parse_args(const char *name,
diff --git a/init/main.c b/init/main.c
index 91f6ebb30..0f7c956e8 100644
--- a/init/main.c
+++ b/init/main.c
@@ -175,10 +175,16 @@ static const char *panic_later, *panic_param;
 
 extern const struct obs_kernel_param __setup_start[], __setup_end[];
 
-static bool __init obsolete_checksetup(char *line)
+#ifdef CONFIG_DADAO_K3_O0_LINK_COMPAT
+typedef unsigned long obsolete_setup_result_t;
+#else
+typedef bool obsolete_setup_result_t;
+#endif
+
+static obsolete_setup_result_t __init obsolete_checksetup(char *line)
 {
 	const struct obs_kernel_param *p;
-	bool had_early_param = false;
+	obsolete_setup_result_t had_early_param = false;
 
 	p = __setup_start;
 	do {
diff --git a/kernel/locking/mutex.c b/kernel/locking/mutex.c
index 468a9b842..655042200 100644
--- a/kernel/locking/mutex.c
+++ b/kernel/locking/mutex.c
@@ -147,7 +147,17 @@ static inline struct task_struct *__mutex_trylock_or_owner(struct mutex *lock)
 /*
  * Actual trylock that will work on any unlocked state.
  */
-static inline bool __mutex_trylock(struct mutex *lock)
+/*
+ * Keep the KL-150a -O0 fastpath result naturally aligned.  A one-byte bool
+ * temporary is otherwise reloaded with ldo by the bring-up backend.
+ */
+#ifdef CONFIG_DADAO_K3_O0_LINK_COMPAT
+typedef unsigned long mutex_fast_result_t;
+#else
+typedef bool mutex_fast_result_t;
+#endif
+
+static inline mutex_fast_result_t __mutex_trylock(struct mutex *lock)
 {
 	return !__mutex_trylock_or_owner(lock);
 }
@@ -163,7 +173,8 @@ static inline bool __mutex_trylock(struct mutex *lock)
  * Optimistic trylock that only works in the uncontended case. Make sure to
  * follow with a __mutex_trylock() before failing.
  */
-static __always_inline bool __mutex_trylock_fast(struct mutex *lock)
+static __always_inline mutex_fast_result_t
+__mutex_trylock_fast(struct mutex *lock)
 {
 	unsigned long curr = (unsigned long)current;
 	unsigned long zero = 0UL;
@@ -174,7 +185,8 @@ static __always_inline bool __mutex_trylock_fast(struct mutex *lock)
 	return false;
 }
 
-static __always_inline bool __mutex_unlock_fast(struct mutex *lock)
+static __always_inline mutex_fast_result_t
+__mutex_unlock_fast(struct mutex *lock)
 {
 	unsigned long curr = (unsigned long)current;
 
diff --git a/kernel/params.c b/kernel/params.c
index 8e56f8b12..22a3ffc71 100644
--- a/kernel/params.c
+++ b/kernel/params.c
@@ -81,7 +81,7 @@ static char dash2underscore(char c)
 	return c;
 }
 
-bool parameqn(const char *a, const char *b, size_t n)
+kernel_param_match_t parameqn(const char *a, const char *b, size_t n)
 {
 	size_t i;
 
@@ -92,12 +92,12 @@ bool parameqn(const char *a, const char *b, size_t n)
 	return true;
 }
 
-bool parameq(const char *a, const char *b)
+kernel_param_match_t parameq(const char *a, const char *b)
 {
 	return parameqn(a, b, strlen(a)+1);
 }
 
-static bool param_check_unsafe(const struct kernel_param *kp)
+static kernel_param_match_t param_check_unsafe(const struct kernel_param *kp)
 {
 	if (kp->flags & KERNEL_PARAM_FL_HWPARAM &&
 	    security_locked_down(LOCKDOWN_MODULE_PARAMETERS))
diff --git a/kernel/printk/printk.c b/kernel/printk/printk.c
index ca65327a6..7e34a09bf 100644
--- a/kernel/printk/printk.c
+++ b/kernel/printk/printk.c
@@ -1838,8 +1838,20 @@ static void cont_flush(void)
 	cont.len = 0;
 }
 
-static bool cont_add(u32 caller_id, int facility, int level,
-		     enum log_flags flags, const char *text, size_t len)
+/*
+ * Match the naturally aligned KL-150a memblock workaround: the bring-up
+ * DADAO backend's -O0 bool-return lowering otherwise reloads a byte stack
+ * slot with ldo and raises MALIGN while printk processes early records.
+ */
+#ifdef CONFIG_DADAO_K3_O0_LINK_COMPAT
+typedef unsigned long printk_cont_result_t;
+#else
+typedef bool printk_cont_result_t;
+#endif
+
+static printk_cont_result_t
+cont_add(u32 caller_id, int facility, int level,
+	 enum log_flags flags, const char *text, size_t len)
 {
 	/* If the line gets too long, split it up in separate records. */
 	if (cont.len + len > sizeof(cont.buf)) {
diff --git a/mm/memblock.c b/mm/memblock.c
index c4b16cae2..fc191bf24 100644
--- a/mm/memblock.c
+++ b/mm/memblock.c
@@ -962,7 +962,20 @@ void __init_memblock __next_reserved_mem_region(u64 *idx,
 	*idx = ULLONG_MAX;
 }
 
-static bool should_skip_region(struct memblock_region *m, int nid, int flags)
+/*
+ * The bring-up DADAO backend at -O0 lowers a bool return through an
+ * unaligned byte stack slot followed by an eight-byte load.  Keep this
+ * KL-149/KL-150 O0-only compatibility path naturally aligned without
+ * changing the helper's true/false semantics or the normal optimized build.
+ */
+#ifdef CONFIG_DADAO_K3_O0_LINK_COMPAT
+typedef unsigned long memblock_skip_region_t;
+#else
+typedef bool memblock_skip_region_t;
+#endif
+
+static memblock_skip_region_t
+should_skip_region(struct memblock_region *m, int nid, int flags)
 {
 	int m_nid = memblock_get_region_node(m);
 
-- 
