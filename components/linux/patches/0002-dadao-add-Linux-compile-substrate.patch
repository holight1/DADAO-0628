--- /dev/null
+++ b/arch/dadao/include/asm/current.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_CURRENT_H
+#define _ASM_DADAO_CURRENT_H
+
+#include <linux/compiler.h>
+
+#ifndef __ASSEMBLY__
+struct task_struct;
+
+/*
+ * The K3 contract is single-CPU.  Keep current in an explicit architecture
+ * variable until SMP introduces a per-CPU register or hardware mechanism.
+ */
+extern struct task_struct *dadao_current;
+
+static __always_inline struct task_struct *get_current(void)
+{
+	return READ_ONCE(dadao_current);
+}
+
+#define current get_current()
+#endif
+
+#endif
