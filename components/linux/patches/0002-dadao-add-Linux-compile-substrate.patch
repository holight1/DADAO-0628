diff --git a/arch/dadao/include/asm/page.h b/arch/dadao/include/asm/page.h
new file mode 100644
index 000000000..81dcb4cbe
--- /dev/null
+++ b/arch/dadao/include/asm/page.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_PAGE_H
+#define _ASM_DADAO_PAGE_H
+
+#include <linux/const.h>
+#include <linux/pfn.h>
+
+#define PAGE_SHIFT 16
+#define PAGE_SIZE (_AC(1, UL) << PAGE_SHIFT)
+#define PAGE_MASK (~(PAGE_SIZE - 1))
+#define PAGE_OFFSET _AC(CONFIG_PAGE_OFFSET, UL)
+#define KERNELBASE PAGE_OFFSET
+
+#ifndef __ASSEMBLY__
+
+#define clear_page(page) memset((page), 0, PAGE_SIZE)
+#define copy_page(to, from) memcpy((to), (from), PAGE_SIZE)
+#define clear_user_page(page, vaddr, pg) clear_page(page)
+#define copy_user_page(to, from, vaddr, pg) copy_page(to, from)
+
+typedef struct { unsigned long pte; } pte_t;
+typedef struct { unsigned long pmd; } pmd_t;
+typedef struct { unsigned long pud; } pud_t;
+typedef struct { unsigned long p4d; } p4d_t;
+typedef struct { unsigned long pgd; } pgd_t;
+typedef struct { unsigned long pgprot; } pgprot_t;
+typedef struct page *pgtable_t;
+
+#define pte_val(x) ((x).pte)
+#define pmd_val(x) ((x).pmd)
+#define pud_val(x) ((x).pud)
+#define p4d_val(x) ((x).p4d)
+#define pgd_val(x) ((x).pgd)
+#define pgprot_val(x) ((x).pgprot)
+
+#define __pte(x) ((pte_t) { (x) })
+#define __pmd(x) ((pmd_t) { (x) })
+#define __pud(x) ((pud_t) { (x) })
+#define __p4d(x) ((p4d_t) { (x) })
+#define __pgd(x) ((pgd_t) { (x) })
+#define __pgprot(x) ((pgprot_t) { (x) })
+
+#define __pa(x) ((unsigned long)(x))
+#define __va(x) ((void *)((unsigned long)(x)))
+#define virt_to_pfn(addr) PFN_DOWN(__pa(addr))
+#define pfn_to_virt(pfn) __va(PFN_PHYS(pfn))
+#define virt_to_page(addr) pfn_to_page(virt_to_pfn(addr))
+#define page_to_virt(page) pfn_to_virt(page_to_pfn(page))
+#define page_to_phys(page) PFN_PHYS(page_to_pfn(page))
+#define phys_to_page(addr) pfn_to_page(PFN_DOWN(addr))
+#define virt_addr_valid(addr) pfn_valid(virt_to_pfn(addr))
+
+#endif
+
+#define VM_DATA_DEFAULT_FLAGS \
+	(VM_READ | VM_WRITE | VM_MAYREAD | VM_MAYWRITE | VM_MAYEXEC)
+
+#include <asm-generic/memory_model.h>
+#include <asm-generic/getorder.h>
+
+#endif
diff --git a/arch/dadao/include/asm/pgtable-prot.h b/arch/dadao/include/asm/pgtable-prot.h
new file mode 100644
index 000000000..1d3f82ebc
--- /dev/null
+++ b/arch/dadao/include/asm/pgtable-prot.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_PGTABLE_PROT_H
+#define _ASM_DADAO_PGTABLE_PROT_H
+
+#include <linux/const.h>
+
+#define DADAO_PRESENT		(_AC(1, UL) << 0)
+#define DADAO_SUPERPAGE		(_AC(1, UL) << 1)
+#define DADAO_DIRTY		(_AC(1, UL) << 2)
+#define DADAO_ACCESSED		(_AC(1, UL) << 3)
+#define DADAO_EXEC		(_AC(1, UL) << 5)
+#define DADAO_WRITE		(_AC(1, UL) << 6)
+#define DADAO_READ		(_AC(1, UL) << 7)
+#define DADAO_FRAGMENT_ALL	(_AC(0xff, UL) << 56)
+
+#define DADAO_PROT_RWX \
+	(DADAO_PRESENT | DADAO_FRAGMENT_ALL | DADAO_READ | DADAO_WRITE | \
+	 DADAO_EXEC)
+#define DADAO_PROT_RW \
+	(DADAO_PRESENT | DADAO_FRAGMENT_ALL | DADAO_READ | DADAO_WRITE)
+#define DADAO_PROT_RX \
+	(DADAO_PRESENT | DADAO_FRAGMENT_ALL | DADAO_READ | DADAO_EXEC)
+#define DADAO_PROT_R \
+	(DADAO_PRESENT | DADAO_FRAGMENT_ALL | DADAO_READ)
+
+#ifndef __ASSEMBLY__
+#include <asm/page.h>
+
+#define PAGE_KERNEL	__pgprot(DADAO_PROT_RWX)
+#define PAGE_KERNEL_RO	__pgprot(DADAO_PROT_RX)
+#define PAGE_SHARED	__pgprot(DADAO_PROT_RW)
+#define PAGE_COPY	__pgprot(DADAO_PROT_R)
+#define PAGE_READONLY	__pgprot(DADAO_PROT_R)
+#define PAGE_NONE	__pgprot(0)
+
+#define __P000 PAGE_NONE
+#define __P001 PAGE_READONLY
+#define __P010 PAGE_READONLY
+#define __P011 PAGE_READONLY
+#define __P100 PAGE_NONE
+#define __P101 PAGE_READONLY
+#define __P110 PAGE_READONLY
+#define __P111 PAGE_READONLY
+
+#define __S000 PAGE_NONE
+#define __S001 PAGE_READONLY
+#define __S010 PAGE_SHARED
+#define __S011 PAGE_SHARED
+#define __S100 PAGE_NONE
+#define __S101 PAGE_READONLY
+#define __S110 PAGE_SHARED
+#define __S111 PAGE_SHARED
+#endif
+
+#endif
diff --git a/arch/dadao/include/asm/pgtable.h b/arch/dadao/include/asm/pgtable.h
new file mode 100644
index 000000000..b33c62ccf
--- /dev/null
+++ b/arch/dadao/include/asm/pgtable.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_PGTABLE_H
+#define _ASM_DADAO_PGTABLE_H
+
+#include <asm/page.h>
+#include <asm/pgtable-prot.h>
+
+/*
+ * The hardware table geometry is fixed by the K2 PTW contract:
+ * VA[41:29] selects an L1 entry and VA[28:16] an L2 entry.
+ */
+#define PGDIR_SHIFT	29
+#define PTRS_PER_PGD	8192
+#define PTRS_PER_PTE	8192
+#define PGDIR_SIZE	(_AC(1, UL) << PGDIR_SHIFT)
+#define PGDIR_MASK	(~(PGDIR_SIZE - 1))
+#define PTE_ADDR_MASK	_AC(0x0000ffffffff0000, UL)
+
+#define PTRS_PER_P4D	1
+#define PTRS_PER_PUD	1
+#define PTRS_PER_PMD	1
+#define __PAGETABLE_P4D_FOLDED
+#define __PAGETABLE_PUD_FOLDED
+#define __PAGETABLE_PMD_FOLDED
+#define P4D_SHIFT	PGDIR_SHIFT
+#define PUD_SHIFT	PGDIR_SHIFT
+#define PMD_SHIFT	PGDIR_SHIFT
+#define P4D_SIZE	PGDIR_SIZE
+#define PUD_SIZE	PGDIR_SIZE
