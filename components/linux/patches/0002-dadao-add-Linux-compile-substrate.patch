diff --git a/arch/dadao/include/asm/atomic.h b/arch/dadao/include/asm/atomic.h
new file mode 100644
index 000000000..29022d1e8
--- /dev/null
+++ b/arch/dadao/include/asm/atomic.h
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_ATOMIC_H
+#define _ASM_DADAO_ATOMIC_H
+
+#include <linux/irqflags.h>
+#include <asm/cmpxchg.h>
+#include <asm-generic/atomic.h>
+
+/*
+ * K3 starts as a single-CPU port.  Until an LL/SC contract is introduced,
+ * masking local interrupts gives the generic kernel code a real UP atomic
+ * implementation instead of compile-only stubs.
+ */
+#define ATOMIC64_INIT(i) { (i) }
+
+static __always_inline s64 atomic64_read(const atomic64_t *v)
+{
+	return READ_ONCE(v->counter);
+}
+#define atomic64_read atomic64_read
+
+static __always_inline void atomic64_set(atomic64_t *v, s64 i)
+{
+	WRITE_ONCE(v->counter, i);
+}
+#define atomic64_set atomic64_set
+#define atomic64_set_release(v, i) atomic64_set((v), (i))
+
+#define DADAO_ATOMIC64_OP(name, op)					\
+static __always_inline void atomic64_##name(s64 i, atomic64_t *v)	\
+{									\
+	unsigned long flags;						\
+	raw_local_irq_save(flags);					\
+	v->counter op i;						\
+	raw_local_irq_restore(flags);					\
+}
+
+#define DADAO_ATOMIC64_OP_RETURN(name, op)				\
+static __always_inline s64 atomic64_##name##_return(s64 i, atomic64_t *v) \
+{									\
+	unsigned long flags;						\
+	s64 result;							\
+	raw_local_irq_save(flags);					\
+	result = (v->counter op i);					\
+	raw_local_irq_restore(flags);					\
+	return result;							\
+}
+
+#define DADAO_ATOMIC64_FETCH_OP(name, op)				\
+static __always_inline s64 atomic64_fetch_##name(s64 i, atomic64_t *v)	\
+{									\
+	unsigned long flags;						\
+	s64 old;							\
+	raw_local_irq_save(flags);					\
+	old = v->counter;						\
+	v->counter op i;						\
+	raw_local_irq_restore(flags);					\
+	return old;							\
+}
+
+DADAO_ATOMIC64_OP(add, +=)
+DADAO_ATOMIC64_OP(sub, -=)
+DADAO_ATOMIC64_OP(and, &=)
+DADAO_ATOMIC64_OP(or, |=)
+DADAO_ATOMIC64_OP(xor, ^=)
+DADAO_ATOMIC64_OP_RETURN(add, +=)
+DADAO_ATOMIC64_OP_RETURN(sub, -=)
+DADAO_ATOMIC64_FETCH_OP(add, +=)
+DADAO_ATOMIC64_FETCH_OP(sub, -=)
+DADAO_ATOMIC64_FETCH_OP(and, &=)
+DADAO_ATOMIC64_FETCH_OP(or, |=)
+DADAO_ATOMIC64_FETCH_OP(xor, ^=)
+
+#undef DADAO_ATOMIC64_FETCH_OP
+#undef DADAO_ATOMIC64_OP_RETURN
+#undef DADAO_ATOMIC64_OP
+
+#define atomic64_add atomic64_add
+#define atomic64_sub atomic64_sub
+#define atomic64_and atomic64_and
+#define atomic64_or atomic64_or
+#define atomic64_xor atomic64_xor
+#define atomic64_add_return atomic64_add_return
+#define atomic64_sub_return atomic64_sub_return
+#define atomic64_fetch_add atomic64_fetch_add
+#define atomic64_fetch_sub atomic64_fetch_sub
+#define atomic64_fetch_and atomic64_fetch_and
+#define atomic64_fetch_or atomic64_fetch_or
+#define atomic64_fetch_xor atomic64_fetch_xor
+
+static __always_inline s64 atomic64_xchg(atomic64_t *v, s64 new)
+{
+	unsigned long flags;
+	s64 old;
+
+	raw_local_irq_save(flags);
+	old = v->counter;
+	v->counter = new;
+	raw_local_irq_restore(flags);
+	return old;
+}
+#define atomic64_xchg atomic64_xchg
+
+static __always_inline s64 atomic64_cmpxchg(atomic64_t *v, s64 old, s64 new)
+{
+	unsigned long flags;
+	s64 observed;
+
+	raw_local_irq_save(flags);
+	observed = v->counter;
+	if (observed == old)
+		v->counter = new;
+	raw_local_irq_restore(flags);
+	return observed;
+}
+#define atomic64_cmpxchg atomic64_cmpxchg
+
+static __always_inline s64
+atomic64_fetch_add_unless(atomic64_t *v, s64 add, s64 unless)
+{
+	unsigned long flags;
+	s64 old;
+
+	raw_local_irq_save(flags);
+	old = v->counter;
+	if (old != unless)
+		v->counter += add;
+	raw_local_irq_restore(flags);
+	return old;
+}
+#define atomic64_fetch_add_unless atomic64_fetch_add_unless
+
+static __always_inline s64 atomic64_dec_if_positive(atomic64_t *v)
+{
+	unsigned long flags;
+	s64 result;
+
+	raw_local_irq_save(flags);
+	result = v->counter - 1;
+	if (result >= 0)
+		v->counter = result;
+	raw_local_irq_restore(flags);
+	return result;
+}
+#define atomic64_dec_if_positive atomic64_dec_if_positive
+
+#endif
