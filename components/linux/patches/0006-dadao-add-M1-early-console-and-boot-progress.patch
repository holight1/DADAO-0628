From fdfdb9ca682c8839a7d59595a1b9d5fc9c46da5b Mon Sep 17 00:00:00 2001
From: suiyan <suiyan@sunmmio.com>
Date: Wed, 29 Jul 2026 19:04:46 +0800
Subject: [PATCH] dadao: add M1 early console and boot progress

---
 arch/dadao/Kconfig                 |  9 +++++++
 arch/dadao/configs/dadao_defconfig |  1 +
 arch/dadao/include/asm/dadao-m1.h  | 29 +++++++++++++++++++++++
 arch/dadao/kernel/Makefile         |  1 +
 arch/dadao/kernel/early-console.c  | 38 ++++++++++++++++++++++++++++++
 arch/dadao/kernel/setup.c          | 14 +++++++++++
 arch/dadao/mm/init.c               |  3 +++
 7 files changed, 95 insertions(+)
 create mode 100644 arch/dadao/include/asm/dadao-m1.h
 create mode 100644 arch/dadao/kernel/early-console.c

diff --git a/arch/dadao/Kconfig b/arch/dadao/Kconfig
index 6c3c67691..296940bbf 100644
--- a/arch/dadao/Kconfig
+++ b/arch/dadao/Kconfig
@@ -84,6 +84,15 @@ config DADAO_K3_EARLY_MARKER
 	  bring-up scratch window before entering start_kernel.  This is a
 	  test-machine gate and may be disabled without changing kernel entry.
 
+config DADAO_M1_DEBUG_CONSOLE
+	bool "DADAO M1 test-machine early debug console"
+	depends on DADAO_M1 && PRINTK
+	help
+	  Register the write-only byte sink at the DADAO M1 test-machine
+	  address 0x10001000 during setup_arch.  This is a pre-MMU,
+	  identity-mapped K3 bring-up transport only.  It is not cfx_uart,
+	  a 16550-compatible UART, a TTY, or an interrupt-capable device.
+
 config CMDLINE
 	string "Built-in kernel command line"
 	default "console=dadao0 init=/init panic=-1"
diff --git a/arch/dadao/configs/dadao_defconfig b/arch/dadao/configs/dadao_defconfig
index f662c649d..de2b8e824 100644
--- a/arch/dadao/configs/dadao_defconfig
+++ b/arch/dadao/configs/dadao_defconfig
@@ -14,6 +14,7 @@ CONFIG_PRINTK_TIME=y
 CONFIG_EMBEDDED=y
 CONFIG_EXPERT=y
 CONFIG_DADAO_K3_EARLY_MARKER=y
+CONFIG_DADAO_M1_DEBUG_CONSOLE=y
 # CONFIG_KALLSYMS is not set
 # CONFIG_SMP is not set
 # CONFIG_MODULES is not set
diff --git a/arch/dadao/include/asm/dadao-m1.h b/arch/dadao/include/asm/dadao-m1.h
new file mode 100644
index 000000000..a4adc0dc1
--- /dev/null
+++ b/arch/dadao/include/asm/dadao-m1.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_M1_H
+#define _ASM_DADAO_M1_H
+
+#include <linux/types.h>
+
+/*
+ * DADAO M1 test-machine-only bring-up contract.
+ *
+ * The debug console at 0x10001000 is a pre-MMU, identity-mapped, write-only
+ * byte transport.  It is not cfx_uart and is not 16550-compatible.
+ */
+#define DADAO_M1_DEBUG_CONSOLE_TX	0x10001000UL
+
+/* KL-149a owns +0x00/+0x08; KL-150a uses the next three scratch words. */
+#define DADAO_M1_PROGRESS_SETUP_ENTER	0x87fd0010UL
+#define DADAO_M1_PROGRESS_SETUP_DONE	0x87fd0018UL
+#define DADAO_M1_PROGRESS_MEM_INIT	0x87fd0020UL
+
+#define DADAO_M1_PROGRESS_SETUP_ENTER_VALUE	0x4b4c313530534145ULL
+#define DADAO_M1_PROGRESS_SETUP_DONE_VALUE	0x4b4c313530534144ULL
+#define DADAO_M1_PROGRESS_MEM_INIT_VALUE		0x4b4c3135304d494eULL
+
+static inline void dadao_m1_progress_write(unsigned long address, u64 value)
+{
+	*(volatile u64 *)address = value;
+}
+
+#endif /* _ASM_DADAO_M1_H */
diff --git a/arch/dadao/kernel/Makefile b/arch/dadao/kernel/Makefile
index 1a4211ac4..864716589 100644
--- a/arch/dadao/kernel/Makefile
+++ b/arch/dadao/kernel/Makefile
@@ -3,3 +3,4 @@
 extra-y := head.o vmlinux.lds
 
 obj-y := setup.o process.o ptrace.o traps.o irq.o time.o
+obj-$(CONFIG_DADAO_M1_DEBUG_CONSOLE) += early-console.o
diff --git a/arch/dadao/kernel/early-console.c b/arch/dadao/kernel/early-console.c
new file mode 100644
index 000000000..3c57a9b77
--- /dev/null
+++ b/arch/dadao/kernel/early-console.c
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/types.h>
+
+#include <asm/dadao-m1.h>
+
+static void dadao_m1_debug_console_write(struct console *console,
+					 const char *text, unsigned int count)
+{
+	volatile u8 *tx = (volatile u8 *)DADAO_M1_DEBUG_CONSOLE_TX;
+
+	while (count--)
+		*tx = *text++;
+}
+
+static struct console dadao_m1_debug_console = {
+	.name	= "dadaom1",
+	.write	= dadao_m1_debug_console_write,
+	.flags	= CON_PRINTBUFFER | CON_BOOT | CON_ANYTIME,
+	.index	= -1,
+};
+
+void __init dadao_m1_debug_console_init(void)
+{
+	static const char online[] =
+		"DADAO M1 test-machine early console online\n";
+
+	/*
+	 * Emit the transport identity before register_console() replays the
+	 * already-buffered Linux banner.  This also keeps the online anchor
+	 * independent of printk registration success.
+	 */
+	dadao_m1_debug_console_write(&dadao_m1_debug_console, online,
+				     sizeof(online) - 1);
+	register_console(&dadao_m1_debug_console);
+}
diff --git a/arch/dadao/kernel/setup.c b/arch/dadao/kernel/setup.c
index e014a47f6..c4df31230 100644
--- a/arch/dadao/kernel/setup.c
+++ b/arch/dadao/kernel/setup.c
@@ -8,6 +8,7 @@
 #include <linux/seq_file.h>
 #include <linux/string.h>
 
+#include <asm/dadao-m1.h>
 #include <asm/page.h>
 #include <asm/sections.h>
 #include <asm/setup.h>
@@ -22,10 +23,20 @@ struct task_struct *dadao_current = &init_task;
 extern void paging_init(void);
 extern char _start[];
 
+#ifdef CONFIG_DADAO_M1_DEBUG_CONSOLE
+extern void dadao_m1_debug_console_init(void);
+#endif
+
 void __init setup_arch(char **cmdline_p)
 {
 	unsigned long ram_end = DADAO_RAM_BASE + DADAO_RAM_SIZE;
 
+	dadao_m1_progress_write(DADAO_M1_PROGRESS_SETUP_ENTER,
+				DADAO_M1_PROGRESS_SETUP_ENTER_VALUE);
+#ifdef CONFIG_DADAO_M1_DEBUG_CONSOLE
+	dadao_m1_debug_console_init();
+#endif
+
 	strlcpy(boot_command_line, CONFIG_CMDLINE, COMMAND_LINE_SIZE);
 	*cmdline_p = boot_command_line;
 
@@ -45,6 +56,9 @@ void __init setup_arch(char **cmdline_p)
 	init_mm.brk = (unsigned long)_end;
 
 	paging_init();
+	dadao_m1_progress_write(DADAO_M1_PROGRESS_SETUP_DONE,
+				DADAO_M1_PROGRESS_SETUP_DONE_VALUE);
+	pr_notice("DADAO M1 setup_arch complete\n");
 }
 
 static void *dadao_cpuinfo_start(struct seq_file *m, loff_t *pos)
diff --git a/arch/dadao/mm/init.c b/arch/dadao/mm/init.c
index bfd12844c..1fd7a00e5 100644
--- a/arch/dadao/mm/init.c
+++ b/arch/dadao/mm/init.c
@@ -4,6 +4,7 @@
 #include <linux/memblock.h>
 #include <linux/mm.h>
 
+#include <asm/dadao-m1.h>
 #include <asm/page.h>
 #include <asm/pgtable.h>
 
@@ -21,6 +22,8 @@ void __init paging_init(void)
 
 void __init mem_init(void)
 {
+	dadao_m1_progress_write(DADAO_M1_PROGRESS_MEM_INIT,
+				DADAO_M1_PROGRESS_MEM_INIT_VALUE);
 	high_memory = __va(max_low_pfn << PAGE_SHIFT);
 	memblock_free_all();
 	mem_init_print_info(NULL);
-- 
2.43.0

