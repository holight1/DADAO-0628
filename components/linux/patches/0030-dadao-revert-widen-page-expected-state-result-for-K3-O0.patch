From: suiyan <suiyan@sunmmio.com>
Date: Thu, 30 Jul 2026 17:36:54 +0800
Subject: [PATCH 10/11] Revert "dadao: widen page expected-state result for K3
 O0"

This reverts commit 3e83c7744f5d093eba3a46284416b8409f3d452c.
---
 mm/page_alloc.c | 10 ++--------
 1 file changed, 2 insertions(+), 8 deletions(-)

diff --git a/mm/page_alloc.c b/mm/page_alloc.c
index b060ceb52..6bf96623f 100644
--- a/mm/page_alloc.c
+++ b/mm/page_alloc.c
@@ -1015,14 +1015,8 @@ static inline void __free_one_page(struct page *page,
  * try and check multiple fields with one check. The caller must do a detailed
  * check if necessary.
  */
-#ifdef CONFIG_DADAO_K3_O0_LINK_COMPAT
-typedef unsigned long page_expected_state_result_t;
-#else
-typedef bool page_expected_state_result_t;
-#endif
-
-static inline page_expected_state_result_t
-page_expected_state(struct page *page, unsigned long check_flags)
+static inline bool page_expected_state(struct page *page,
+					unsigned long check_flags)
 {
 	if (unlikely(atomic_read(&page->_mapcount) != -1))
 		return false;
