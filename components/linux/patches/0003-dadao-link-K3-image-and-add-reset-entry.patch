diff --git a/arch/dadao/Kconfig b/arch/dadao/Kconfig
index d4f4becd9..6c3c67691 100644
--- a/arch/dadao/Kconfig
+++ b/arch/dadao/Kconfig
@@ -4,10 +4,7 @@ config DADAO
 	def_bool y
 	select 64BIT
 	select ARCH_WANT_FRAME_POINTERS
-	select GENERIC_CALIBRATE_DELAY
-	select GENERIC_CSUM
-	select GENERIC_HWEIGHT
-	select GENERIC_IRQ_SHOW
+	select DMA_DIRECT_REMAP
 	select GENERIC_SMP_IDLE_THREAD
 	select HAVE_MEMBLOCK
 	select MODULES_USE_ELF_RELA if MODULES
@@ -25,6 +22,18 @@ config MMU
 config CPU_BIG_ENDIAN
 	def_bool y
 
+config GENERIC_CALIBRATE_DELAY
+	def_bool y
+
+config GENERIC_CSUM
+	def_bool y
+
+config GENERIC_HWEIGHT
+	def_bool y
+
+config GENERIC_IRQ_SHOW
+	def_bool y
+
 config GENERIC_BUG
 	def_bool y
 	depends on BUG
@@ -57,6 +66,24 @@ config DADAO_M1
 	  Select the single-hart DADAO M1 virtual platform used by the K3
 	  QEMU and gem5 bring-up contract.
 
+config DADAO_K3_O0_LINK_COMPAT
+	def_bool y
+	help
+	  Provide the disabled-feature fallbacks needed while the DADAO LLVM
+	  backend is restricted to KCFLAGS=-O0.  Linux normally relies on
+	  optimization to remove calls guarded by constant-false helpers.  The
+	  fallback object is rejected if any represented feature is enabled or
+	  if the architecture is built with optimization.
+
+config DADAO_K3_EARLY_MARKER
+	bool "Write the K3 linked-image marker before start_kernel"
+	depends on DADAO_M1
+	default y
+	help
+	  Write the KL-149a guest-authored marker into the reserved M1
+	  bring-up scratch window before entering start_kernel.  This is a
+	  test-machine gate and may be disabled without changing kernel entry.
+
 config CMDLINE
 	string "Built-in kernel command line"
 	default "console=dadao0 init=/init panic=-1"
diff --git a/arch/dadao/Makefile b/arch/dadao/Makefile
index 3529de86f..7b701054e 100644
--- a/arch/dadao/Makefile
+++ b/arch/dadao/Makefile
@@ -5,8 +5,22 @@ UTS_MACHINE := dadao
 
 KBUILD_CFLAGS += -D__linux__ -fno-pic -fno-pie -integrated-as
 KBUILD_AFLAGS += -D__linux__ -integrated-as
-KBUILD_LDFLAGS += -m elf64dadao
+# LLD identifies the DADAO target from EM_DADAO input objects.  There is no
+# GNU-compatible -m emulation name for this project-specific ELF machine.
 
-# KL-147a intentionally stops at Kconfig. The boot entry and architecture
-# object directories are introduced by KL-148a, once compile/link contracts
-# are executable.
+head-y := arch/dadao/kernel/head.o
+core-y += arch/dadao/kernel/ arch/dadao/mm/
+
+boot := arch/dadao/boot
+
+all: Image
+
+Image: vmlinux
+	$(Q)$(MAKE) $(build)=$(boot) $(boot)/$@
+
+archclean:
+	$(Q)$(MAKE) $(clean)=$(boot)
+
+define archhelp
+  echo  '  Image        - Uncompressed DADAO M1 kernel image'
+endef
