+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_TLBFLUSH_H
+#define _ASM_DADAO_TLBFLUSH_H
+
+#include <linux/bug.h>
+
+/*
+ * The cfx_tlb range-invalidate sequence is a later K3 milestone.  Every
+ * accidental early caller must trap instead of observing a fake flush.
+ */
+static inline void local_flush_tlb_all(void)
+{
+	BUG();
+}
+
+#define flush_tlb_all() local_flush_tlb_all()
+#define flush_tlb_mm(mm) local_flush_tlb_all()
+#define flush_tlb_page(vma, addr) local_flush_tlb_all()
+#define flush_tlb_range(vma, start, end) local_flush_tlb_all()
+#define flush_tlb_kernel_range(start, end) local_flush_tlb_all()
+
+#endif
