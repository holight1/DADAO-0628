+
+void __init trap_init(void)
+{
+	/* CFX exception vectors are installed by the later Linux trap task. */
+}
+
+void show_regs(struct pt_regs *regs)
+{
+	int i;
+
+	show_regs_print_info(KERN_DEFAULT);
+	pr_info("pc=%016lx mode=%lu cfx=%lu mask=%016lx cause=%lu/%016lx\n",
+		regs->pc, regs->run_mode, regs->cfx_code, regs->cfx_mask,
+		regs->cause_id, regs->cause_info);
+	for (i = 0; i < 64; i += 4)
+		pr_info("rd%02d=%016lx rd%02d=%016lx rd%02d=%016lx rd%02d=%016lx\n",
+			i, regs->rd[i], i + 1, regs->rd[i + 1],
+			i + 2, regs->rd[i + 2], i + 3, regs->rd[i + 3]);
+}
+
+void show_stack(struct task_struct *task, unsigned long *sp)
+{
+	pr_info("DADAO stack trace unavailable (task=%p sp=%p)\n", task, sp);
+}
+
+int is_valid_bugaddr(unsigned long addr)
+{
+	return !(addr & 3) && addr >= (unsigned long)_stext &&
+	       addr < (unsigned long)_etext;
+}
diff --git a/arch/dadao/kernel/vmlinux.lds.S b/arch/dadao/kernel/vmlinux.lds.S
