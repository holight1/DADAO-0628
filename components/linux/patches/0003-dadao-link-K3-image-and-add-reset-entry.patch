+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_IO_H
+#define _ASM_DADAO_IO_H
+
+#include <linux/types.h>
+
+/*
+ * The DADAO M1 platform has no IOMMU and the initial kernel mapping is
+ * physical-address identity.  MMIO therefore uses the same address value.
+ */
+#define ioremap ioremap
+static inline void __iomem *ioremap(phys_addr_t offset, size_t size)
+{
+	return (void __iomem *)(unsigned long)offset;
+}
+
+#define iounmap iounmap
+static inline void iounmap(void __iomem *addr)
+{
+}
+
+#define ioremap_nocache ioremap
+#define ioremap_wc ioremap
+#define ioremap_wt ioremap
+
+#include <asm-generic/io.h>
+
+#endif /* _ASM_DADAO_IO_H */
