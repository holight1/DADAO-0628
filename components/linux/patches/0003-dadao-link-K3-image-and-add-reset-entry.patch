diff --git a/arch/dadao/include/asm/pgalloc.h b/arch/dadao/include/asm/pgalloc.h
new file mode 100644
index 000000000..4ad4d0bcd
--- /dev/null
+++ b/arch/dadao/include/asm/pgalloc.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_PGALLOC_H
+#define _ASM_DADAO_PGALLOC_H
+
+#include <linux/mm.h>
+#include <asm-generic/pgalloc.h>
+
+static inline pgd_t *pgd_alloc(struct mm_struct *mm)
+{
+	pgd_t *pgd = (pgd_t *)__get_free_page(GFP_KERNEL | __GFP_ZERO);
+
+	if (pgd)
+		memcpy(pgd + USER_PTRS_PER_PGD,
+		       swapper_pg_dir + USER_PTRS_PER_PGD,
+		       (PTRS_PER_PGD - USER_PTRS_PER_PGD) * sizeof(*pgd));
+	return pgd;
+}
+
+static inline void pgd_free(struct mm_struct *mm, pgd_t *pgd)
+{
+	free_page((unsigned long)pgd);
+}
+
+#define __pte_free_tlb(tlb, pte, address)	\
+do {						\
+	pgtable_pte_page_dtor(pte);		\
+	tlb_remove_page((tlb), (pte));		\
+} while (0)
+
+#endif
