diff --git a/arch/dadao/kernel/head.S b/arch/dadao/kernel/head.S
new file mode 100644
index 000000000..9bd3404a8
--- /dev/null
+++ b/arch/dadao/kernel/head.S
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+	.section ".head.text", "ax"
+	.globl _start
+	.type _start, @function
+_start:
+	/* Temporary boot stack: top of the 128 MiB dadao-m1 RAM window. */
+	setzw rb1, 1, 0x87ff
+
+#ifdef CONFIG_DADAO_K3_EARLY_MARKER
+	/* Guest-authored KL149AHE marker at reserved bring-up scratch RAM. */
+	setzw rd1, 3, 0x4b4c
+	orw rd1, 2, 0x3134
+	orw rd1, 1, 0x3941
+	orw rd1, 0, 0x4845
+	setzw rb2, 1, 0x87fd
+	sto rd1, rb2, 0
+#endif
+
+	call start_kernel
+1:
+	jump 1b
+	.size _start, . - _start
diff --git a/arch/dadao/kernel/irq.c b/arch/dadao/kernel/irq.c
new file mode 100644
index 000000000..d5e3e0b9a
--- /dev/null
+++ b/arch/dadao/kernel/irq.c
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/init.h>
+
+/*
+ * KL-149a enters supervisor mode with every asynchronous CFX source masked.
+ * Until the Linux CFX interrupt controller is installed, retain that hardware
+ * state and track the Linux local-IRQ state in software for UP critical
+ * sections.  No interrupt-delivery support is claimed by this task.
+ */
+static unsigned long dadao_irq_enabled;
+
+unsigned long arch_local_save_flags(void)
+{
+	return READ_ONCE(dadao_irq_enabled);
+}
+
+void arch_local_irq_restore(unsigned long flags)
+{
+	WRITE_ONCE(dadao_irq_enabled, !!flags);
+	barrier();
+}
+
+void __init init_IRQ(void)
+{
+	dadao_irq_enabled = 0;
+}
diff --git a/arch/dadao/kernel/process.c b/arch/dadao/kernel/process.c
new file mode 100644
index 000000000..d75f9190d
--- /dev/null
+++ b/arch/dadao/kernel/process.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/errno.h>
+#include <linux/init_task.h>
+#include <linux/kernel.h>
+#include <linux/reboot.h>
+#include <linux/sched.h>
+#include <linux/sched/debug.h>
+#include <linux/sched/task_stack.h>
+
+#include <asm/processor.h>
+#include <asm/ptrace.h>
+
+void start_thread(struct pt_regs *regs, unsigned long pc, unsigned long sp)
+{
+	memset(regs, 0, sizeof(*regs));
+	regs->pc = pc;
+	regs->rb[1] = sp;
+	regs->run_mode = 0;
+}
+
+void flush_thread(void)
+{
+}
+
+unsigned long get_wchan(struct task_struct *task)
+{
+	return 0;
+}
+
+int copy_thread(unsigned long clone_flags, unsigned long usp,
+		unsigned long arg, struct task_struct *task)
+{
+	/*
+	 * Context creation is intentionally fail-closed until the assembly
+	 * ret_from_fork path exists; callers receive an honest error.
+	 */
+	return -ENOSYS;
+}
+
+struct task_struct *__switch_to(struct task_struct *prev,
+				struct task_struct *next)
+{
+	BUG_ON(prev != next);
+	WRITE_ONCE(dadao_current, next);
+	return prev;
+}
+
+void machine_restart(char *command)
+{
+	for (;;)
+		cpu_relax();
+}
+
+void machine_halt(void)
+{
+	for (;;)
+		cpu_relax();
+}
+
+void machine_power_off(void)
+{
+	for (;;)
+		cpu_relax();
+}
+
+void (*pm_power_off)(void) = machine_power_off;
+
+void __xchg_called_with_bad_pointer(void)
+{
+	BUG();
+}
+
+unsigned long wrong_size_cmpxchg(volatile void *ptr)
+{
+	BUG();
+	unreachable();
+}
diff --git a/arch/dadao/kernel/ptrace.c b/arch/dadao/kernel/ptrace.c
new file mode 100644
index 000000000..9f40561d1
--- /dev/null
+++ b/arch/dadao/kernel/ptrace.c
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/elf.h>
+#include <linux/ptrace.h>
+#include <linux/regset.h>
+#include <linux/sched.h>
+#include <linux/sched/task_stack.h>
+
+#include <asm/processor.h>
+
+static int dadao_gpr_get(struct task_struct *target,
+			 const struct user_regset *regset,
+			 unsigned int pos, unsigned int count,
+			 void *kbuf, void __user *ubuf)
+{
+	const struct pt_regs *regs = task_pt_regs(target);
+
+	return user_regset_copyout(&pos, &count, &kbuf, &ubuf, regs, 0,
+				   sizeof(struct user_regs_struct));
+}
+
+static int dadao_gpr_set(struct task_struct *target,
+			 const struct user_regset *regset,
+			 unsigned int pos, unsigned int count,
+			 const void *kbuf, const void __user *ubuf)
+{
+	struct pt_regs *regs = task_pt_regs(target);
+
+	return user_regset_copyin(&pos, &count, &kbuf, &ubuf, regs, 0,
+				  sizeof(struct user_regs_struct));
+}
+
+static const struct user_regset dadao_regsets[] = {
+	{
+		.core_note_type = NT_PRSTATUS,
+		.n = sizeof(struct user_regs_struct) / sizeof(unsigned long),
+		.size = sizeof(unsigned long),
+		.align = sizeof(unsigned long),
+		.get = dadao_gpr_get,
+		.set = dadao_gpr_set,
+	},
+};
+
+static const struct user_regset_view dadao_user_view = {
+	.name = "dadao",
+	.e_machine = ELF_ARCH,
+	.ei_osabi = ELF_OSABI,
+	.regsets = dadao_regsets,
+	.n = ARRAY_SIZE(dadao_regsets),
+};
+
+const struct user_regset_view *task_user_regset_view(struct task_struct *task)
+{
+	return &dadao_user_view;
+}
+
+void ptrace_disable(struct task_struct *child)
+{
+}
+
+long arch_ptrace(struct task_struct *child, long request,
+		 unsigned long addr, unsigned long data)
+{
+	return ptrace_request(child, request, addr, data);
+}
diff --git a/arch/dadao/kernel/setup.c b/arch/dadao/kernel/setup.c
new file mode 100644
index 000000000..e014a47f6
--- /dev/null
+++ b/arch/dadao/kernel/setup.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/init.h>
+#include <linux/init_task.h>
+#include <linux/kernel.h>
+#include <linux/memblock.h>
+#include <linux/mm.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+
+#include <asm/page.h>
+#include <asm/sections.h>
+#include <asm/setup.h>
+
+#define DADAO_RAM_BASE		0x80000000UL
+#define DADAO_RAM_SIZE		0x08000000UL
+#define DADAO_BRINGUP_SCRATCH	0x87fd0000UL
+#define DADAO_BRINGUP_SIZE	0x00030000UL
+
+struct task_struct *dadao_current = &init_task;
+
+extern void paging_init(void);
+extern char _start[];
+
+void __init setup_arch(char **cmdline_p)
+{
+	unsigned long ram_end = DADAO_RAM_BASE + DADAO_RAM_SIZE;
+
+	strlcpy(boot_command_line, CONFIG_CMDLINE, COMMAND_LINE_SIZE);
+	*cmdline_p = boot_command_line;
+
+	memblock_add(DADAO_RAM_BASE, DADAO_RAM_SIZE);
+	memblock_reserve(__pa(_start), PAGE_ALIGN((unsigned long)_end -
+						  (unsigned long)_start));
+	memblock_reserve(DADAO_BRINGUP_SCRATCH, DADAO_BRINGUP_SIZE);
+
+	min_low_pfn = PFN_UP(DADAO_RAM_BASE);
+	max_low_pfn = PFN_DOWN(ram_end);
+	max_pfn = max_low_pfn;
+	max_mapnr = max_low_pfn - min_low_pfn;
+
+	init_mm.start_code = (unsigned long)_text;
+	init_mm.end_code = (unsigned long)_etext;
+	init_mm.end_data = (unsigned long)_edata;
+	init_mm.brk = (unsigned long)_end;
+
+	paging_init();
+}
+
+static void *dadao_cpuinfo_start(struct seq_file *m, loff_t *pos)
+{
+	return *pos == 0 ? (void *)1 : NULL;
+}
+
+static void *dadao_cpuinfo_next(struct seq_file *m, void *v, loff_t *pos)
+{
+	++*pos;
+	return NULL;
+}
+
+static void dadao_cpuinfo_stop(struct seq_file *m, void *v)
+{
+}
+
+static int dadao_cpuinfo_show(struct seq_file *m, void *v)
+{
+	seq_puts(m, "processor\t: 0\n"
+		    "model name\t: DADAO M1\n"
+		    "byte order\t: big endian\n");
+	return 0;
+}
+
+const struct seq_operations cpuinfo_op = {
+	.start = dadao_cpuinfo_start,
+	.next = dadao_cpuinfo_next,
+	.stop = dadao_cpuinfo_stop,
+	.show = dadao_cpuinfo_show,
+};
diff --git a/arch/dadao/kernel/time.c b/arch/dadao/kernel/time.c
new file mode 100644
index 000000000..42e34fdb7
--- /dev/null
+++ b/arch/dadao/kernel/time.c
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/param.h>
+
+#include <asm/processor.h>
+
+void __init time_init(void)
+{
+	/*
+	 * The CFX timer clocksource/clockevent is introduced after the linked
+	 * image gate.  Linux can still enter start_kernel with time disabled.
+	 */
+}
+
+void __delay(unsigned long loops)
+{
+	while (loops--)
+		cpu_relax();
+}
+
+void __const_udelay(unsigned long xloops)
+{
+	__delay(xloops);
+}
+
+void __udelay(unsigned long usecs)
+{
+	__delay(usecs * loops_per_jiffy / (1000000 / HZ));
+}
