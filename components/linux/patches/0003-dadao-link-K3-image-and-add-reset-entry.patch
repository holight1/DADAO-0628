diff --git a/arch/dadao/include/asm/syscall.h b/arch/dadao/include/asm/syscall.h
new file mode 100644
index 000000000..1ce95c334
--- /dev/null
+++ b/arch/dadao/include/asm/syscall.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_DADAO_SYSCALL_H
+#define _ASM_DADAO_SYSCALL_H
+
+#include <uapi/linux/audit.h>
+#include <linux/err.h>
+
+static inline int syscall_get_nr(struct task_struct *task,
+				 struct pt_regs *regs)
+{
+	return regs->rd[16];
+}
+
+static inline void syscall_set_nr(struct task_struct *task,
+				  struct pt_regs *regs, int sysno)
+{
+	regs->rd[16] = sysno;
+}
+
+static inline void syscall_rollback(struct task_struct *task,
+				    struct pt_regs *regs)
+{
+	regs->rd[17] = regs->orig_rd17;
+}
+
+static inline long syscall_get_error(struct task_struct *task,
+				     struct pt_regs *regs)
+{
+	unsigned long error = regs->rd[31];
+
+	return IS_ERR_VALUE(error) ? error : 0;
+}
+
+static inline long syscall_get_return_value(struct task_struct *task,
+					    struct pt_regs *regs)
+{
+	return regs->rd[31];
+}
+
+static inline void syscall_set_return_value(struct task_struct *task,
+					    struct pt_regs *regs,
+					    int error, long val)
+{
+	regs->rd[31] = (long)error ?: val;
+}
+
+static inline void syscall_get_arguments(struct task_struct *task,
+					 struct pt_regs *regs,
+					 unsigned long *args)
+{
+	args[0] = regs->orig_rd17;
+	memcpy(args + 1, &regs->rd[18], 5 * sizeof(args[0]));
+}
+
+static inline void syscall_set_arguments(struct task_struct *task,
+					 struct pt_regs *regs,
+					 const unsigned long *args)
+{
+	regs->orig_rd17 = args[0];
+	memcpy(&regs->rd[18], args + 1, 5 * sizeof(args[0]));
+}
+
+static inline int syscall_get_arch(struct task_struct *task)
+{
+	return AUDIT_ARCH_DADAO;
+}
+
+#endif /* _ASM_DADAO_SYSCALL_H */
diff --git a/arch/dadao/include/asm/timex.h b/arch/dadao/include/asm/timex.h
index 95a8d2a12..cd0fd86d9 100644
