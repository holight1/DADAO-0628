// llvm-test-suite SingleSource slice (ADR-0012 D4, ML-004d). See
// Inputs/sign_conversions.c header for upstream provenance. Previously
// reported as gem5-sign-conversions-backend-divergence (ML-004b: QEMU
// PASS, gem5 SIGABRT / page fault @ address 0); ML-004d re-verified against
// the post-ML-004c toolchain and found it already passes both backends,
// matching host (tried 5 independent getSC()/getUC() input values, no
// divergence) — incidentally fixed by ML-004c's CALL RegMask attach + GPRB
// spill/reload fix.
// RUN: %llvm-mc -triple=dadao -filetype=obj -o %t.crt0.o %S/../../../scripts/crt0.s
// RUN: %clang --target=dadao-unknown-elf -nostdlib -Wl,-T,%S/../../../scripts/dadao.ld %t.crt0.o %S/Inputs/sign_conversions.c -o %t.elf
// RUN: %llvm-objcopy -O binary %t.elf %t.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.bin >/dev/null 2>&1; test $? -eq 55'
// RUN: bash -c '%gem5 %gem5_se %t.elf >/dev/null 2>&1; test $? -eq 55'
