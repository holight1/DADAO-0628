// llvm-test-suite SingleSource slice (ADR-0012 D4, ML-004a). Adapted from
// SingleSource/UnitTests/2003-05-12-MinIntProblem.c @ 68d03c39d (printf ->
// boolean exit code, see Inputs/minint.c header). foo(INT_MIN): X+1 < 0 holds -> 1.
// RUN: %llvm-mc -triple=dadao -filetype=obj -o %t.crt0.o %S/../../../scripts/crt0.s
// RUN: %clang --target=dadao-unknown-elf -nostdlib -Wl,-T,%S/../../../scripts/dadao.ld %t.crt0.o %S/Inputs/minint.c -o %t.elf
// RUN: %llvm-objcopy -O binary %t.elf %t.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.bin >/dev/null 2>&1; test $? -eq 1'
