// llvm-test-suite SingleSource slice (ADR-0012 D4, ML-004a). Adapted from
// SingleSource/UnitTests/2002-10-09-ArrayResolution.c @ 68d03c39d (printf ->
// exit code, see Inputs/arrayresolution.c header). Foo must stay 0 after the
// Array[] fill loop (tentative-then-sized array redeclaration must not alias Foo).
// RUN: %llvm-mc -triple=dadao -filetype=obj -o %t.crt0.o %S/../../../scripts/crt0.s
// RUN: %clang --target=dadao-unknown-elf -nostdlib -Wl,-T,%S/../../../scripts/dadao.ld %t.crt0.o %S/Inputs/arrayresolution.c -o %t.elf
// RUN: %llvm-objcopy -O binary %t.elf %t.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.bin >/dev/null 2>&1; test $? -eq 0'
// RUN: bash -c '%gem5 %gem5_se %t.elf >/dev/null 2>&1; test $? -eq 0'
