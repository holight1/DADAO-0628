// llvm-test-suite SingleSource slice (ADR-0012 D4, ML-004a/DL-068b/ML-004b).
// Adapted from SingleSource/UnitTests/2006-02-04-DivRem.c @ 68d03c39d
// (printf -> exit-code polynomial accumulator, see Inputs/divrem.c header).
// Originally blocked by codegen-global-byte-mask-load-wrong-endian-offset
// (ML-004a); passes both backends after DL-068b's AsmPrinter fix. Unlike
// bitops/minint/arrayresolution (QEMU-only), this one is verified dual-
// backend since DL-068b explicitly confirmed QEMU=gem5 for it.
// RUN: %llvm-mc -triple=dadao -filetype=obj -o %t.crt0.o %S/../../../scripts/crt0.s
// RUN: %clang --target=dadao-unknown-elf -nostdlib -Wl,-T,%S/../../../scripts/dadao.ld %t.crt0.o %S/Inputs/divrem.c -o %t.elf
// RUN: %llvm-objcopy -O binary %t.elf %t.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.bin >/dev/null 2>&1; test $? -eq 217'
// RUN: bash -c '%gem5 %gem5_se %t.elf >/dev/null 2>&1; test $? -eq 217'
