// llvm-test-suite SingleSource slice (ADR-0012 D4, ML-004c). See
// Inputs/popcount_clz_ctz.c header for upstream provenance. Previously failed under
// codegen-call-clobbers-gprb-not-declared; passes both backends after
// ML-004c (CALL RegMask attach + GPRB spill/reload fix).
// RUN: %llvm-mc -triple=dadao -filetype=obj -o %t.crt0.o %S/../../../scripts/crt0.s
// RUN: %clang --target=dadao-unknown-elf -nostdlib -Wl,-T,%S/../../../scripts/dadao.ld %t.crt0.o %S/Inputs/popcount_clz_ctz.c -o %t.elf
// RUN: %llvm-objcopy -O binary %t.elf %t.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.bin >/dev/null 2>&1; test $? -eq 185'
// RUN: bash -c '%gem5 %gem5_se %t.elf >/dev/null 2>&1; test $? -eq 185'
