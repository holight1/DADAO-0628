// ML-025a: real integer-format scanf() E2E, mirroring musl_printf_int.test's
// pipeline (real clang --target=dadao compile, real ld.lld link against
// crt1.o + libc.a, real QEMU/gem5 dual-backend run). The RUN lines below
// assert the INTENDED (bug-fixed) behavior of scanf("%d", &x): read "42"
// from stdin (fed via ordinary shell stdin redirection -- there is no
// existing lit.cfg stdin substitution to reuse, and none was needed: plain
// `<` redirection composes fine inside the existing `bash -c '...'` RUN
// pattern every other E2E test already uses for stdout redirection),
// parse it, print it back, and exit with that value.
//
// DL-072a removed the former XFAIL after replacing the RD-only callee spill
// with the wiki-defined caller-populated unified save area.  The RB-bank &x
// pointer now remains in declaration order and is consumed correctly by
// scanf/vfscanf on both backends.
//
// RUN: %clang --target=dadao -std=c99 -nostdinc -ffreestanding -O2 \
// RUN:   -I%S/../../../.work/source/musl/arch/dadao \
// RUN:   -I%S/../../../.work/source/musl/arch/generic \
// RUN:   -I%S/../../../.work/source/musl/include \
// RUN:   -I%S/../../../.work/build/musl/obj/include \
// RUN:   -c -o %t.o %S/Inputs/musl_scanf_int.c
// RUN: %ld.lld -T %S/../../scripts/dadao.ld \
// RUN:   --start-group %S/../../../.work/build/musl/lib/crt1.o %t.o %S/../../../.work/build/musl/lib/libc.a --end-group \
// RUN:   -o %t.elf
// RUN: %llvm-objcopy -O binary %t.elf %t.bin
// RUN: echo 42 > %t.stdin
// RUN: bash -c '%qemu -M dadao-m1 -display none -nodefaults -bios %trampoline -kernel %t.bin < %t.stdin > %t.out 2>&1; test $? -eq 42'
// RUN: %FileCheck %s --check-prefix=MARKER < %t.out
// RUN: bash -c '%gem5 %gem5_se %t.elf < %t.stdin > %t.gout 2>&1; test $? -eq 42'
// RUN: %FileCheck %s --check-prefix=MARKER < %t.gout
//
// MARKER: got=42
