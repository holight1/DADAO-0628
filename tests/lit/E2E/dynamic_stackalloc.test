// ML-033a: runtime-sized stack allocation, stacksave/stackrestore lifetime,
// ABI alignment, fixed-frame references, nested/sequential VLA regions,
// both 8-byte and 2272-byte outgoing call frames, and a >imms12 allocation
// all share one discriminating runtime probe.  Each ELF is run unchanged on
// QEMU and gem5.  The negative builds deliberately expect the wrong value
// returned from the final stack arguments of the 300-argument call; both
// simulators must return 1, proving the successful runs really traverse the
// large outgoing area while the volatile VLA remains live.
//
// RUN: %llvm-mc -triple=dadao -filetype=obj -o %t.crt0.o %S/../../scripts/crt0.s
// RUN: %clang --target=dadao-unknown-elf -O0 -nostdlib -Wl,-T,%S/../../scripts/dadao.ld %t.crt0.o %S/Inputs/dynamic_stackalloc.c -o %t.o0.elf
// RUN: %llvm-objcopy -O binary %t.o0.elf %t.o0.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.o0.bin >/dev/null 2>&1; test $? -eq 42'
// RUN: bash -c '%gem5 %gem5_se %t.o0.elf >/dev/null 2>&1; test $? -eq 42'
// RUN: %clang --target=dadao-unknown-elf -O2 -nostdlib -Wl,-T,%S/../../scripts/dadao.ld %t.crt0.o %S/Inputs/dynamic_stackalloc.c -o %t.o2.elf
// RUN: %llvm-objcopy -O binary %t.o2.elf %t.o2.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.o2.bin >/dev/null 2>&1; test $? -eq 42'
// RUN: bash -c '%gem5 %gem5_se %t.o2.elf >/dev/null 2>&1; test $? -eq 42'
// RUN: %clang --target=dadao-unknown-elf -O0 -DNEGATIVE_CONTROL -nostdlib -Wl,-T,%S/../../scripts/dadao.ld %t.crt0.o %S/Inputs/dynamic_stackalloc.c -o %t.o0.neg.elf
// RUN: %llvm-objcopy -O binary %t.o0.neg.elf %t.o0.neg.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.o0.neg.bin >/dev/null 2>&1; test $? -eq 1'
// RUN: bash -c '%gem5 %gem5_se %t.o0.neg.elf >/dev/null 2>&1; test $? -eq 1'
// RUN: %clang --target=dadao-unknown-elf -O2 -DNEGATIVE_CONTROL -nostdlib -Wl,-T,%S/../../scripts/dadao.ld %t.crt0.o %S/Inputs/dynamic_stackalloc.c -o %t.o2.neg.elf
// RUN: %llvm-objcopy -O binary %t.o2.neg.elf %t.o2.neg.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.o2.neg.bin >/dev/null 2>&1; test $? -eq 1'
// RUN: bash -c '%gem5 %gem5_se %t.o2.neg.elf >/dev/null 2>&1; test $? -eq 1'
