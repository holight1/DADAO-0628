// ML-030a: a large compile-time constant offset added to a global address
// (e.g. `a[i - 2000000000L]`) must materialize the constant into a register
// and do register-register address arithmetic instead of folding it into
// the 18-bit-range RELA_RIII/ADDI_RBRRII relocation operand (see
// DADAOTargetLowering::isOffsetFoldingLegal). Covers both signs and three
// magnitudes (just past the 18-bit boundary, ~2^31, ~2^42) on both backends.
//
// The second build deliberately corrupts one expected value; both simulators
// must reject that negative control, proving the checks were not folded
// away or otherwise vacuous.
//
// RUN: %llvm-mc -triple=dadao -filetype=obj -o %t.crt0.o %S/../../scripts/crt0.s
// RUN: %clang --target=dadao-unknown-elf -O0 -nostdlib -Wl,-T,%S/../../scripts/dadao.ld %t.crt0.o %S/Inputs/global_offset_large.c -o %t.elf
// RUN: %llvm-objcopy -O binary %t.elf %t.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.bin >/dev/null 2>&1; test $? -eq 42'
// RUN: bash -c '%gem5 %gem5_se %t.elf >/dev/null 2>&1; test $? -eq 42'
// RUN: %clang --target=dadao-unknown-elf -O0 -DNEGATIVE_CONTROL=1 -nostdlib -Wl,-T,%S/../../scripts/dadao.ld %t.crt0.o %S/Inputs/global_offset_large.c -o %t.negative.elf
// RUN: %llvm-objcopy -O binary %t.negative.elf %t.negative.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.negative.bin >/dev/null 2>&1; test $? -eq 3'
// RUN: bash -c '%gem5 %gem5_se %t.negative.elf >/dev/null 2>&1; test $? -eq 3'
