// ML-029a: large prologue/epilogue adjustments and frame-index references
// must be materialized instead of silently wrapping the signed imms12 field.
//
// The volatile arrays force real stack writes and read-backs.  The second
// build deliberately changes one expected value; both simulators must reject
// that negative control, proving the memory checks were not optimized away.
//
// RUN: %llvm-mc -triple=dadao -filetype=obj -o %t.crt0.o %S/../../scripts/crt0.s
// RUN: %clang --target=dadao-unknown-elf -O0 -nostdlib -Wl,-T,%S/../../scripts/dadao.ld %t.crt0.o %S/Inputs/frame_offset_large.c -o %t.elf
// RUN: %llvm-objcopy -O binary %t.elf %t.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.bin >/dev/null 2>&1; test $? -eq 42'
// RUN: bash -c '%gem5 %gem5_se %t.elf >/dev/null 2>&1; test $? -eq 42'
// RUN: %clang --target=dadao-unknown-elf -O0 -DNEGATIVE_CONTROL=1 -nostdlib -Wl,-T,%S/../../scripts/dadao.ld %t.crt0.o %S/Inputs/frame_offset_large.c -o %t.negative.elf
// RUN: %llvm-objcopy -O binary %t.negative.elf %t.negative.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.negative.bin >/dev/null 2>&1; test $? -eq 1'
// RUN: bash -c '%gem5 %gem5_se %t.negative.elf >/dev/null 2>&1; test $? -eq 1'
