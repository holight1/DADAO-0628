// goal② malloc test: real C → clang → picolibc → QEMU
//
// Verifies malloc/free via picolibc's nano-malloc, backed by our _sbrk
// trap syscall.  Requires `make build-picolibc` to have been run first.
//
// RUN: %llvm-mc -triple=dadao -filetype=obj %S/../../scripts/crt0.s -o %t.crt0.o
// RUN: %llvm-mc -triple=dadao -filetype=obj %S/../../scripts/pico_stubs.s -o %t.stubs.o
// RUN: %clang --target=dadao -nostdlib -nostdinc -ffreestanding -O0 -c \
// RUN:   -I%pico_include -I%pico_stdio -I%pico_locale -I%pico_root \
// RUN:   -I%pico_build -I%{clanginc} \
// RUN:   -D_LIBC -DNEWLIB_NANO_MALLOC \
// RUN:   %S/../../scripts/stdout_min.c -o %t.stdout.o
// RUN: %clang --target=dadao -nostdlib -nostdinc -ffreestanding -O0 -c \
// RUN:   -I%pico_include -I%pico_stdio -I%pico_locale -I%pico_root \
// RUN:   -I%pico_build -I%{clanginc} \
// RUN:   -D_LIBC -DNEWLIB_NANO_MALLOC \
// RUN:   %S/Inputs/malloc_hello.c -o %t.hello.o
// RUN: %ld.lld -T %S/../../scripts/dadao.ld -nostdlib \
// RUN:   %t.crt0.o %t.stubs.o %t.stdout.o %t.hello.o \
// RUN:   %S/../../../.work/picolibc/build-dadao/libc.a -o %t.elf
// RUN: %llvm-objcopy -O binary %t.elf %t.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.bin > %t.out 2>&1; test $? -eq 0'
// RUN: grep -c "OK OK2" %t.out | xargs test 1 -eq
// gem5 skipped — issue gem5-se-heap-not-covered-by-elf-segment is RESOLVED
// (DG-007b: dadao.ld's .heap NOLOAD section now gives the heap real PT_LOAD
// memsz coverage; gem5 SE no longer page-faults on the heap and runs the
// malloc/memset/strcmp logic to completion). codegen-indirect-call-rb0-misuse
// is also FIXED (DL-066a; see indirect_call.test for a dual-backend regression
// probe). Still skipped because this test links a prebuilt
// .work/picolibc/build-dadao/libc.a compiled before the fix — the my_putc
// indirect-call site (same as printf_hello.test) is baked into old libc.a
// object code. See issue picolibc-libc-rebuild-blocked.
