// ML-024c: lite_malloc small-allocation memory-discrimination test. This
// translation unit references only `malloc()` (never `free()`), so the
// final weak `W malloc` resolves to musl's separate lite_malloc.c bump
// allocator rather than mallocng's strong entry point. Volatile first/last
// byte write-read checks ensure an unbacked non-NULL pointer cannot pass.
// See Inputs/musl_malloc_sizeclass_liteonly.c for the linkage boundary and
// the AT_PAGESZ regression that motivated the negative control.
//
// RUN: %clang --target=dadao -std=c99 -nostdinc -ffreestanding -O2 \
// RUN:   -I%S/../../../.work/source/musl/arch/dadao \
// RUN:   -I%S/../../../.work/source/musl/arch/generic \
// RUN:   -I%S/../../../.work/source/musl/include \
// RUN:   -I%S/../../../.work/build/musl/obj/include \
// RUN:   -c -o %t.o %S/Inputs/musl_malloc_sizeclass_liteonly.c
// RUN: %ld.lld -T %S/../../scripts/dadao.ld \
// RUN:   --start-group %S/../../../.work/build/musl/lib/crt1.o %t.o %S/../../../.work/build/musl/lib/libc.a --end-group \
// RUN:   -o %t.elf
// RUN: %llvm-objcopy -O binary %t.elf %t.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.bin > %t.out 2>&1; test $? -eq 42'
// RUN: %FileCheck %s --check-prefix=MARKER < %t.out
// RUN: bash -c '%gem5 %gem5_se %t.elf > %t.gout 2>&1; test $? -eq 42'
// RUN: %FileCheck %s --check-prefix=MARKER < %t.gout
//
// MARKER: SIZECLASS_LITE_OK
