// RUN: %llvm-mc -triple=dadao -filetype=obj -o %t.o %s
// RUN: %llvm-objcopy -O binary --only-section=.text %t.o %t.bin
// RUN: bash -c '%qemu -M dadao-m1 -nographic -bios %trampoline -kernel %t.bin >/dev/null 2>&1; test $? -eq 42'
.text
addi rd1, rd0, 10
addi rd2, rd0, 32
add  rd0, rd3, rd1, rd2
halt rd3
